+// MEASUREMENT ONLY (memory-pressure, not committed): TOIT_VERIFY_ALLOCLOG=N
+// logs every allocation event of a verification to stderr, with the
+// verifier frames of a backtrace for allocations of N bytes or more.
+thread_local! {
+    static IN_LOG: Cell<bool> = const { Cell::new(false) };
+}
+pub static LOG_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static LOG_SEQ: AtomicUsize = AtomicUsize::new(0);
+
+pub fn log_event(kind: &str, ptr: *mut u8, old: *mut u8, size: usize, old_size: usize) {
+    if !LOG_ON.load(Ordering::Relaxed) { return; }
+    IN_LOG.with(|f| {
+        if f.get() { return; }
+        f.set(true);
+        let min: usize = std::env::var("TOIT_VERIFY_ALLOCLOG").ok().and_then(|s| s.parse().ok()).unwrap_or(usize::MAX);
+        let seq = LOG_SEQ.fetch_add(1, Ordering::Relaxed);
+        let mut where_ = String::new();
+        if size >= min && kind != "F" {
+            let bt = std::backtrace::Backtrace::force_capture().to_string();
+            let mut n = 0;
+            for line in bt.lines() {
+                let l = line.trim();
+                if l.starts_with("at ") { continue; }
+                if (l.contains("toit_spec") || l.contains("toit_vmverify")) && !l.contains("counting") {
+                    let name = l.splitn(2, ": ").nth(1).unwrap_or(l);
+                    where_.push_str(" <");
+                    where_.push_str(name);
+                    where_.push('>');
+                    n += 1;
+                    if n == 4 { break; }
+                }
+            }
+        }
+        eprintln!("VALLOC {} {} {:p} {:p} {} {}{}", seq, kind, ptr, old, size, old_size, where_);
+        f.set(false);
+    });
+}
