# Controller-only Bluetooth for the Toit BLE host (lib/ble/experimental):
# the vendor controller stays, NimBLE goes. Layered over sdkconfig.defaults by
# `make BLE_HOST=1 esp32`.
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
