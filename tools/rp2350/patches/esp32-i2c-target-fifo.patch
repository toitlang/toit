+        i2c_ll_get_rxfifo_cnt(hal->dev, &rx_fifo_exist_len);
         pxHigherPriorityTaskWoken |= i2c_slave_handle_stretch_event(i2c_slave, rx_fifo_exist_len, slave_rw);
     }
 #endif
