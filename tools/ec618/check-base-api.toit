// Copyright (C) 2026 Toit contributors.

// Run from the repository root. The reviewed manifest, never the current ELF,
// defines the peripheral ABI that a base must retain.
import cli
import crypto.sha256 show sha256
import encoding.hex
import encoding.json
import host.directory
import host.file
import host.pipe

CONTRACT ::= "toolchains/ec618/base-api.json"
INCLUDE ::= "toolchains/ec618/project/inc/peripheral_keep.inc"
KEEP ::= "toolchains/ec618/project/src/plat_keep.c"
SDK ::= "third_party/luatos-soc-ec618"

main args:
  command := cli.Command "check-base-api"
      --options=[
        cli.Flag "write" --help="Regenerate retention entries after reviewing the manifest.",
        cli.Option "elf" --help="Check defined global exports in this linked base ELF.",
        cli.Option "nm" --default="arm-none-eabi-nm" --help="Symbol listing executable.",
      ]
      --run=:: |invocation/cli.Invocation|
        error := catch:
          symbols := check-retention "." --write=invocation["write"]
          if elf := invocation["elf"]:
            check-exports symbols (pipe.backticks [invocation["nm"], "-g", "--defined-only", elf])
          print "EC618 base API: reviewed headers, retention and requested exports PASS"
        if error: invocation.cli.ui.abort "EC618 base API: $error"
  command.run args

// Returns all required exports, including the explicitly retained platform API.
check-retention root/string --write/bool=false -> Set:
  contract := json.decode (file.read-contents "$root/$CONTRACT")
  headers/Map := contract["headers"]
  excluded-headers/Map := contract["excluded_headers"]
  excluded-headers.do: |name reason|
    if not reason or reason == "": throw "Excluded headers require a reason: $name"
  contract["header_directories"].do: |path/string|
    stream := directory.DirectoryStream "$root/$SDK/$path"
    try:
      while entry := stream.next:
        name := "$path/$entry"
        if entry.ends-with ".h" and not headers.contains name and not excluded-headers.contains name:
          throw "New SDK headers need API review: $name"
    finally:
      stream.close
  symbols := Set
  headers.do: |name/string header/Map|
    digest := header-digest (file.read-contents "$root/$SDK/$name")
    if digest != header["sha256"]: throw "SDK header changed; review peripheral ABI: $name"
    excluded/Map := header["excluded"]
    excluded.do: |symbol reason|
      if not reason or reason == "": throw "Invalid exclusions in $name"
    header["symbols"].do: |symbol/string|
      if excluded.contains symbol: throw "Invalid exclusions in $name"
      if not valid-symbol symbol: throw "Invalid symbol: $symbol"
      symbols.add symbol
  explicit := explicit-exports (file.read-contents "$root/$KEEP").to-string
  generated := "// Copyright (C) 2026 Toit contributors.\n"
      + "// Generated by tools/ec618/check-base-api.toit --write.\n"
      + "// Reviewed source: toolchains/ec618/base-api.json.\n\n"
  names := symbols.to-list
  names = names.sort
  names.do: |symbol/string|
    if not explicit.contains symbol: generated += "EC618_BASE_API($symbol)\n"
  if write:
    file.write-contents generated --path="$root/$INCLUDE"
  else if not file.is-file "$root/$INCLUDE" or (normalize-lines (file.read-contents "$root/$INCLUDE")).to-string != generated:
    throw "Stale peripheral_keep.inc; run check-base-api.toit --write"
  explicit.do: symbols.add it
  return symbols

// Git may check text out as CRLF on Windows. Only normalize line endings;
// declarations, comments and other whitespace remain part of the contract.
normalize-lines source/ByteArray -> ByteArray:
  // Some vendor comments are not UTF-8. Preserve all non-CRLF bytes exactly.
  result := ByteArray source.size
  size := 0
  source.size.repeat: |i/int|
    if source[i] == '\r' and i + 1 < source.size and source[i + 1] == '\n': continue.repeat
    result[size++] = source[i]
  return result.copy 0 size

header-digest source/ByteArray -> string:
  return hex.encode (sha256 (normalize-lines source))

valid-symbol symbol/string -> bool:
  if symbol.is-empty: return false
  symbol.size.repeat: |index/int|
    c := symbol[index]
    if c == '_' or 'A' <= c <= 'Z' or 'a' <= c <= 'z': continue.repeat
    if index > 0 and '0' <= c <= '9': continue.repeat
    return false
  return true

explicit-exports source/string -> Set:
  symbols := Set
  prefix := "(const void*)&"
  (source.split "\n").do: |line/string|
    line = line.trim
    if not line.starts-with prefix or not line.ends-with ",": continue.do
    symbol := line[prefix.size..line.size - 1]
    if valid-symbol symbol: symbols.add symbol
  return symbols

check-exports required/Set listing/string:
  linked := Set
  (listing.split "\n").do: |line/string|
    parts := (line.trim.replace --all "\t" " ").split " "
    parts = parts.filter: not it.is-empty
    if parts.size != 3: continue.do
    // GNU nm's default ELF format is address, type, name. Undefined weak
    // symbols (w/v) and local symbols cannot satisfy the global contract.
    kind/string := parts[1]
    if kind.size != 1 or not ("ABCDGIRSTVWu".contains kind): continue.do
    address/string := parts[0]
    valid-address := not address.is-empty
    address.do: |c/int|
      if not ('0' <= c <= '9' or 'a' <= c <= 'f' or 'A' <= c <= 'F'):
        valid-address = false
    if valid-address: linked.add parts[2]
  missing := required.to-list.filter: not (linked.contains it)
  missing = missing.sort
  if not missing.is-empty: throw "Base lacks required exports: $(missing.join ", ")"
