diff -ruN a/components/log/Kconfig.dict b/components/log/Kconfig.dict
--- a/components/log/Kconfig.dict
+++ b/components/log/Kconfig.dict
@@ -0,0 +1,53 @@
+menu "Dictionary logging"
+
+    choice LOG_CHECK_MESSAGES
+        prompt "Messages of failed ESP_RETURN_ON_* / ESP_GOTO_ON_* checks"
+        default LOG_CHECK_MESSAGES_TEXT
+        depends on !COMPILER_OPTIMIZATION_CHECKS_SILENT
+        help
+            What a failed check of esp_check.h prints (the checks themselves
+            and the returned error codes do not change).
+
+        config LOG_CHECK_MESSAGES_TEXT
+            bool "Text"
+            help
+                The message as a log line: "E (time) tag: function(line): message".
+
+        config LOG_CHECK_MESSAGES_ADDRESS
+            bool "Address marker"
+            help
+                "E chk <address> <error code>": the call site's return address
+                and the error code. No strings per check; a host maps the
+                address to file and line with the ELF file's debug information.
+
+        config LOG_CHECK_MESSAGES_DICT
+            bool "Dictionary"
+            help
+                The message's id and raw argument values (esp_log_dict.h).
+                Format string, file and line stay in the non-loaded section
+                .esp_log_dict of the ELF file; a host formats the message.
+    endchoice
+
+    config LOG_CHECK_MESSAGES_ISR_SILENT
+        bool "No messages for the ISR variants of the checks"
+        default n
+        depends on LOG_CHECK_MESSAGES_ADDRESS || LOG_CHECK_MESSAGES_DICT
+        help
+            The *_ISR variants of the checks (usable with the cache disabled)
+            log text with ESP_EARLY_LOGE in the address and dictionary modes,
+            since the shared functions of those modes are in flash. With this
+            option they print nothing, as with COMPILER_OPTIMIZATION_CHECKS_SILENT.
+
+    config LOG_DICT_ESP_LOG
+        bool "ESP_LOGE and ESP_LOGW as dictionary messages"
+        default n
+        help
+            ESP_LOGE and ESP_LOGW print dictionary lines (esp_log_dict.h)
+            instead of formatting their message on the device.
+
+    config LOG_DICT_STRING_MAX
+        int "Maximum length of a string argument in a dictionary line"
+        default 48
+        range 8 120
+
+endmenu
diff -ruN a/components/log/src/os/log_dict.c b/components/log/src/os/log_dict.c
--- a/components/log/src/os/log_dict.c
+++ b/components/log/src/os/log_dict.c
@@ -0,0 +1,169 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Toit contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/* The device side of dictionary logging (esp_log_dict.h). */
+
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <inttypes.h>
+#include "esp_log.h"
+#include "esp_log_dict.h"
+#include "sdkconfig.h"
+
+#ifndef CONFIG_LOG_DICT_STRING_MAX
+#define CONFIG_LOG_DICT_STRING_MAX 48
+#endif
+
+#define LINE_SIZE 200
+/* Room after the arguments: " +", " cccc}" and the NUL. */
+#define TAIL_SIZE 9
+
+/* The ELF file's SHA-256 in hex (esp_app_format fills it in at startup).
+ * Weak, so that the log component does not need esp_app_format. */
+extern char app_elf_sha256_str[] __attribute__((weak));
+
+static const char s_hex[] = "0123456789abcdef";
+
+typedef struct {
+    char *p;
+    char *end;
+} out_t;
+
+static void put(out_t *o, char c)
+{
+    if (o->p < o->end) {
+        *o->p++ = c;
+    }
+}
+
+static void put_hex(out_t *o, uint32_t v, int digits)
+{
+    while (digits-- > 0) {
+        put(o, s_hex[(v >> (4 * digits)) & 0xf]);
+    }
+}
+
+static void put_str(out_t *o, const char *s)
+{
+    if (s == NULL) {
+        put(o, '-');
+        return;
+    }
+    put(o, '"');
+    for (int n = 0; s[n] != 0; n++) {
+        if (n == CONFIG_LOG_DICT_STRING_MAX) {
+            put(o, '"');
+            put(o, '+');
+            return;
+        }
+        unsigned char c = (unsigned char)s[n];
+        if (c < 0x20 || c > 0x7e || c == '"' || c == '\\') {
+            put(o, '\\');
+            put(o, 'x');
+            put_hex(o, c, 2);
+        } else {
+            put(o, (char)c);
+        }
+    }
+    put(o, '"');
+}
+
+static uint32_t crc16(const char *p, const char *end)
+{
+    uint32_t crc = 0xffff;
+    while (p < end) {
+        crc ^= (uint32_t)(unsigned char)*p++ << 8;
+        for (int i = 0; i < 8; i++) {
+            crc = (crc & 0x8000) ? (crc << 1) ^ 0x1021 : crc << 1;
+        }
+    }
+    return crc & 0xffff;
+}
+
+static void dict_writev(const char *tag, uint32_t word, uint32_t kinds, va_list ap)
+{
+    esp_log_level_t level = (esp_log_level_t)((word >> ESP_LOG_DICT_LEVEL_SHIFT) & 7);
+    char line[LINE_SIZE];
+    out_t o = { line, line + LINE_SIZE - TAIL_SIZE };
+    put(&o, '{');
+    put(&o, 'D');
+    put(&o, '1');
+    put(&o, ' ');
+    const char *build = app_elf_sha256_str;
+    for (int i = 0; i < 8; i++) {
+        char c = (build != NULL) ? build[i] : 0;
+        if (c == 0) {
+            build = NULL;
+            c = '0';
+        }
+        put(&o, c);
+    }
+    put(&o, ' ');
+    put_hex(&o, word & ((1u << ESP_LOG_DICT_ID_BITS) - 1), 5);
+    for (; kinds != 0; kinds >>= 2) {
+        char *start = o.p;
+        put(&o, ' ');
+        switch (kinds & 3) {
+        case ESP_LOG_DICT_W64: {
+            uint64_t v = va_arg(ap, uint64_t);
+            put_hex(&o, (uint32_t)(v >> 32), 8);
+            put_hex(&o, (uint32_t)v, 8);
+            break;
+        }
+        case ESP_LOG_DICT_STR:
+            put_str(&o, va_arg(ap, const char *));
+            break;
+        default:
+            put_hex(&o, va_arg(ap, uint32_t), 8);
+            break;
+        }
+        if (o.p == o.end) {
+            /* The argument did not fit (or just fit): drop it and the rest. */
+            o.p = start;
+            *o.p++ = ' ';
+            *o.p++ = '+';
+            break;
+        }
+    }
+    uint32_t crc = crc16(line, o.p);
+    o.end = line + LINE_SIZE;
+    put(&o, ' ');
+    put_hex(&o, crc, 4);
+    put(&o, '}');
+    *o.p = 0;
+#if CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM
+    esp_log_write(level, tag, "%c (%s) %s: %s\n", "NEWIDV"[level], esp_log_system_timestamp(), tag, line);
+#else
+    esp_log_write(level, tag, "%c (%" PRIu32 ") %s: %s\n", "NEWIDV"[level], esp_log_timestamp(), tag, line);
+#endif
+}
+
+void esp_log_dict_write(const char *tag, uint32_t word, ...)
+{
+    va_list ap;
+    va_start(ap, word);
+    dict_writev(tag, word, (word >> ESP_LOG_DICT_KINDS_SHIFT) & 0xff, ap);
+    va_end(ap);
+}
+
+void esp_log_dict_write_kinds(const char *tag, uint32_t word, uint32_t kinds, ...)
+{
+    va_list ap;
+    va_start(ap, kinds);
+    dict_writev(tag, word, kinds, ap);
+    va_end(ap);
+}
+
+void __attribute__((noinline)) esp_log_check_failed(uint32_t code)
+{
+    uint32_t pc = (uint32_t)(uintptr_t)__builtin_return_address(0);
+#if __XTENSA__
+    /* The windowed ABI keeps the window increment in the top bits. */
+    pc = (pc & 0x3fffffff) | 0x40000000;
+#endif
+    esp_log_write(ESP_LOG_ERROR, "chk", "E chk %08" PRIx32 " %" PRIx32 "\n", pc, code);
+}
