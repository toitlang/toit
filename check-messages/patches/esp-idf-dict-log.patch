+            ESP_CHECK_LOG_ISR_(log_tag, format, ##__VA_ARGS__);                                 \
+            return;                                                                             \
+        }                                                                                       \
+    } while(0)
+
+#define ESP_GOTO_ON_FALSE(a, err_code, goto_tag, log_tag, format, ...) do {                     \
+        if (unlikely(!(a))) {                                                                   \
+            ESP_CHECK_LOG_(err_code, log_tag, format, ##__VA_ARGS__);                           \
+            ret = err_code;                                                                     \
+            goto goto_tag;                                                                      \
+        }                                                                                       \
