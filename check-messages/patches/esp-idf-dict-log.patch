+        ESP_EARLY_LOGE(log_tag, "%s(%d): " format, __FUNCTION__, __LINE__, ##__VA_ARGS__)
+#endif
+
+#define ESP_RETURN_ON_ERROR(x, log_tag, format, ...) do {                                       \
