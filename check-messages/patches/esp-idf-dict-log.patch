+ * CONFIG_LOG_CHECK_MESSAGES_ISR_SILENT.
+ */
+#if defined(CONFIG_LOG_CHECK_MESSAGES_DICT)
+#define ESP_CHECK_LOG_(code, log_tag, format, ...)                                              \
