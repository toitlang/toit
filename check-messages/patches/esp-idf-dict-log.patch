+            ESP_CHECK_LOG_(err_rc_, log_tag, format, ##__VA_ARGS__);                            \
+            return;                                                                             \
+        }                                                                                       \
+    } while(0)
+
+#define ESP_RETURN_VOID_ON_ERROR_ISR(x, log_tag, format, ...) do {                              \
+        esp_err_t err_rc_ = (x);                                                                \
+        if (unlikely(err_rc_ != ESP_OK)) {                                                      \
+            ESP_CHECK_LOG_ISR_(log_tag, format, ##__VA_ARGS__);                                 \
+            return;                                                                             \
+        }                                                                                       \
+    } while(0)
+
+#define ESP_GOTO_ON_ERROR(x, goto_tag, log_tag, format, ...) do {                               \
+        esp_err_t err_rc_ = (x);                                                                \
+        if (unlikely(err_rc_ != ESP_OK)) {                                                      \
+            ESP_CHECK_LOG_(err_rc_, log_tag, format, ##__VA_ARGS__);                            \
+            ret = err_rc_;                                                                      \
+            goto goto_tag;                                                                      \
+        }                                                                                       \
+    } while(0)
+
+#define ESP_GOTO_ON_ERROR_ISR(x, goto_tag, log_tag, format, ...) do {                           \
+        esp_err_t err_rc_ = (x);                                                                \
+        if (unlikely(err_rc_ != ESP_OK)) {                                                      \
+            ESP_CHECK_LOG_ISR_(log_tag, format, ##__VA_ARGS__);                                 \
