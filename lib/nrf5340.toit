/**
Names the nRF5340 GPIO pins by port and local pin number.

For example, $P1-04 is GPIO number 36. These are chip pins, not connector
  positions or the GPIO numbers of a connected test fixture.
Passing the integer constant to a peripheral reserves that pin until close.
Board-reserved or unavailable pins are rejected by the peripheral.
*/

/** GPIO P0.00. */
P0-00 ::= 0
/** GPIO P0.01. */
P0-01 ::= 1
/** GPIO P0.02. */
P0-02 ::= 2
/** GPIO P0.03. */
P0-03 ::= 3
/** GPIO P0.04. */
