/*@
lemma void unsigned_of_int32(int x)
  requires -2147483648 <= x &*& x <= 2147483647;
  ensures x < 0 ? truncate_unsigned(x, 32) == x + 4294967296 : truncate_unsigned(x, 32) == x;
{
  assert pow_nat(2, N16) == 65536;
  assert pow_nat(2, N32) == 4294967296;
  assert int_of_nat(N32) == 32;
  truncate_unsigned_def(x, N32);
  assert [_]divrem(x, pow_nat(2, N32), ?q, ?r);
  assert x == q * 4294967296 + r &*& 0 <= r &*& r < 4294967296;
  if (x >= 0) {
    if (q < 0) { mul_mono_l(q, -1, 4294967296); assert false; }
    if (q > 0) { mul_mono_l(1, q, 4294967296); assert false; }
    assert q * 4294967296 == 0;
  } else {
    if (q >= 0) { mul_mono_l(0, q, 4294967296); assert false; }
    if (q < -1) { mul_mono_l(q, -2, 4294967296); assert false; }
    assert q * 4294967296 == -4294967296;
  }
  assert truncate_unsigned(x, 32) == r;
}
@*/

// Wave 12: bit_cast of a double (contract only), List<uint16> and the
// arithmetic shift's helper.
int64 bit_cast_int64__double(double src);
//@ requires true;
//@ ensures true;
typedef unsigned short uint16;
typedef struct List_uint16 { uint16 *data_; word length_; } List_uint16;
word List_uint16_length(List_uint16 *self)
//@ requires [?f]self->length_ |-> ?n;
//@ ensures [f]self->length_ |-> n &*& result == n;
{ return self->length_; }
uint16 *List_uint16_data(List_uint16 *self)
//@ requires [?f]self->data_ |-> ?p;
//@ ensures [f]self->data_ |-> p &*& result == p;
{ return self->data_; }
int64 asr_int64(int64 x, int64 n)
//@ requires 0 <= n &*& n < 64;
//@ ensures true;
{
  if (x >= 0) {
    //@ shiftright_div(x, nat_of_int(n));
    //@ pow2_pos(nat_of_int(n));
    //@ div_rem_nonneg(x, pow_nat(2, nat_of_int(n)));
    return (int64)((uint64)x >> n);
  }
  //@ shiftright_div(-1 - x, nat_of_int(n));
  //@ pow2_pos(nat_of_int(n));
  //@ div_rem_nonneg(-1 - x, pow_nat(2, nat_of_int(n)));
  return -1 - (int64)((uint64)(-1 - x) >> n);
}

