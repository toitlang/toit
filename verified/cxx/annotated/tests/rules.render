@render verified/cxx/annotated/tests/rules.cc toit::small_unsigned unsigned-word-conversion
inline bool small_unsigned(int x)
// A negative x becomes x + 2^32: not small.
//@ requires true;
//@ ensures result == (0 <= x && x <= 8);
{
  //@ unsigned_of_int32(x);
  unsigned u = x;
  return u <= 8;
}

@render verified/cxx/annotated/tests/rules.cc toit::shift_in truncating
inline uint64 shift_in(uint64 v)
// The shift discards the high byte (no overflow check).
//@ requires true;
//@ ensures true;
{
  v <<= 8;
  return v;
}

@render verified/cxx/annotated/tests/rules.cc toit::shift_bits truncating
inline int64 shift_bits(int64 x, int64 bits)
// The count is checked by VeriFast (the self-test shift-bits-count widens
// it by one), the shift is modular.
//@ requires 0 <= bits &*& bits <= 63;
//@ ensures true;
{
  return static_cast<int64>(static_cast<uint64>(x) << bits);
}

@render verified/cxx/annotated/tests/rules.cc toit::sign_byte truncating
inline int64 sign_byte(uint8 b)
//@ requires true;
//@ ensures -128 <= result &*& result <= 127;
{
  //@ truncate_signed_limits(b, N7);
  //@ assert pow_nat(2, N7) == 128;
  return static_cast<int8>(b);
}

@render verified/cxx/annotated/tests/rules.cc toit::shift_down truncating
inline int64 shift_down(int64 v)
// The floor of v / 256, for a negative v too (the arithmetic shift).
//@ requires true;
//@ ensures v >= 0 ? result == v / 256 : result < 0 &*& result * 256 <= v &*& v < result * 256 + 256;
{
  //@ assert pow_nat(2, N8) == 256;
  //@ if (v < 0) { shiftright_div(-1 - v, N8); div_rem_nonneg(-1 - v, 256); }
  //@ if (v >= 0) shiftright_div(v, N8);
  v >>= 8;
  return v;
}

