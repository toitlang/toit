// The translator's self-test: the rules of rules.cc, rendered and
// verified (run.sh). A changed rule changes rules.gen.c, which
// `render.sh --check` reports.
@constants rules_constants.h
@expand-typedef uhalf_word
@overloaded Over::f
@modular-arguments Tagged::Tagged
@verbatim
#include <stdint.h>
#include "rules_constants.h"
typedef intptr_t word;
typedef uintptr_t uword;
typedef unsigned int uint32;
struct Tagged { uword tag_; };
typedef struct Tagged Tagged;
struct Outer_Inner { word v_; };
typedef struct Outer_Inner Outer_Inner;
struct Pair { word a_; word b_; };
typedef struct Pair Pair;
struct Over { char unused_; };
typedef struct Over Over;
typedef short narrow_t;
struct plain_c { int a; };
// The implicit default constructor (initializes nothing).
void plain_c_ctor(struct plain_c *self);
//@ requires self->a |-> _;
//@ ensures self->a |-> _;

@prototypes
@render verified/cxx/annotated/tests/rules.cc toit::Outer::Inner::Inner
    explicit Inner(word x) : v_(x + K)
    //@ requires self->v_ |-> _ &*& x < 100;
    //@ ensures self->v_ |-> x + 3;
    {}

@render verified/cxx/annotated/tests/rules.cc toit::Outer::Inner::v
    word v()
    //@ requires self->v_ |-> ?v;
    //@ ensures self->v_ |-> v &*& result == v;
    { return v_; }

@render verified/cxx/annotated/tests/rules.cc toit::Pair::Pair
  Pair(word x, word y) : a_(x), b_(y)
  //@ requires self->a_ |-> _ &*& self->b_ |-> _;
  //@ ensures self->a_ |-> x &*& self->b_ |-> y;
  {}

@render verified/cxx/annotated/tests/rules.cc toit::assign_pair
inline void assign_pair(Pair* p, word x)
//@ requires p->a_ |-> _ &*& p->b_ |-> _ &*& x < 100;
//@ ensures p->a_ |-> x &*& p->b_ |-> x + 1;
{
  *p = Pair(x, x + 1);
}

@render verified/cxx/annotated/tests/rules.cc toit::low_half
inline uhalf_word low_half(uhalf_word h)
//@ requires true;
//@ ensures result == h;
{
  return h;
}

@render verified/cxx/annotated/tests/rules.cc toit::use_inner
inline word use_inner(word x)
//@ requires x < 100;
//@ ensures result == x + 3;
{
  Outer::Inner inner(x);
  return inner.v();
}

@render verified/cxx/annotated/tests/rules.cc toit::with_default
inline word with_default(word x, bool flag = false)
//@ requires x < 100;
//@ ensures result == (flag ? x : x + 1);
{
  return flag ? x : x + 1;
}

@render verified/cxx/annotated/tests/rules.cc toit::call_default
inline word call_default(word x)
//@ requires x < 100;
//@ ensures result == x + 1;
{
  return with_default(x);
}

@render verified/cxx/annotated/tests/rules.cc toit::Over::f type=word(word)
inline word Over::f(word x)
//@ requires true;
//@ ensures result == x;
{
  return x;
}

@render verified/cxx/annotated/tests/rules.cc toit::call_over
inline word call_over(Over* o)
//@ requires true;
//@ ensures result == 1;
{
  return o->f(1);
}

@render verified/cxx/annotated/tests/rules.cc toit::narrow truncating
inline int narrow(word x)
//@ requires true;
//@ ensures result == -1 || result == x;
{
  int n = x;
  if (n != x) return -1;
  return n;
}

@render verified/cxx/annotated/tests/rules.cc toit::signed_length truncating
inline word signed_length(uword u)
//@ requires true;
//@ ensures -1 <= result;
{
  word length = u;
  if (length < 0) return -1;
  return length;
}

@render verified/cxx/annotated/tests/rules.cc toit::classify
inline word classify(int tag)
//@ requires true;
//@ ensures tag == 1 || tag == 2 ? result == 10 : tag == 3 ? result == 7 : result == 0;
{
  switch (tag) {
    case 1:
    case 2:
      return 10;
    case 3: {
      word x = 7;
      //@ assert x == 7;
      return x;
    }
    default:
      break;
  }
  return 0;
}

@render verified/cxx/annotated/tests/rules.cc toit::advance
inline word advance(word cursor)
//@ requires 0 <= cursor &*& cursor < 100;
//@ ensures result == cursor + 4;
{
  cursor += sizeof(uint32);
  return cursor;
}

@render verified/cxx/annotated/tests/rules.cc toit::Tagged::Tagged
  explicit Tagged(uword tag) : tag_(tag)
  //@ requires self->tag_ |-> _;
  //@ ensures self->tag_ |-> tag;
  {}

@render verified/cxx/annotated/tests/rules.cc toit::negative_tag
inline uword negative_tag(word offset)
//@ requires 0 <= offset &*& offset < 100;
//@ ensures true;
{
  Tagged t(-100 + offset);
  return t.tag_;
}

@render verified/cxx/annotated/tests/rules.cc toit::clamp
inline word clamp(word x)
//@ requires true;
//@ ensures result == (x < 0 ? 0 : x);
{
  CLAMP_TO_ZERO(x);
  return x;
}

@render verified/cxx/annotated/tests/rules.cc toit::fits_narrow truncating
inline bool fits_narrow(int x)
//@ requires true;
//@ ensures true;
{
  narrow_t n = static_cast<narrow_t>(x);
  return static_cast<int>(n) == x;
}

@render verified/cxx/annotated/tests/rules.cc toit::use_plain
inline int use_plain()
//@ requires true;
//@ ensures result == 1;
{
  struct plain_c p;
  p.a = 1;
  return p.a;
}
