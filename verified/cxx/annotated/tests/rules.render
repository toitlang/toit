@render verified/cxx/annotated/tests/rules.cc toit::hash_step truncating
inline uint16 hash_step(uint16 h, char c)
//@ requires true;
//@ ensures true;
{
  //@ assert int_of_nat(N8) == 8 && pow_nat(2, N8) == 256;
  //@ truncate_limits(c, N8);
  return 31 * h + static_cast<uint8>(c);
}

@render verified/cxx/annotated/tests/rules.cc toit::clamp_add
inline word clamp_add(word x, word y)
//@ requires 0 <= x &*& x < 1000;
//@ ensures x <= result &*& result <= x + 100;
{
  if (y > 0) {
    word other = y;
    if (other > 100) goto big;
    return x + other;
  }
  big:
  word other = 100;
  return x + other;
}
