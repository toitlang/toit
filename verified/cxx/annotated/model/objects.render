@render src/objects.h toit::String::Bytes::Bytes tu=src/objects.cc type=void(constString*)
    explicit Bytes(const String* string)
    //@ requires self->address_ |-> _ &*& self->length_ |-> _ &*& [?f]heap(?objs, ?H) &*& mem(string, objs) == true &*& has_tag(H, string, STRING_TAG) == true;
    //@ ensures self->address_ |-> blob_base(H, string) &*& self->length_ |-> blob_len(H, string) &*& [f]heap(objs, H);
    {
      word len = string->_internal_length();
      if (len != SENTINEL) {
        address_ = string->_as_utf8bytes();
        //@ string_open(string);
        //@ open [f]string_body(string, _, _);
        //@ close [f]string_body(string, o_len(H(string)), o_aux(H(string)));
        //@ string_close(string);
        length_ = len;
      } else {
        address_ = string->as_external();
        length_ = string->_external_length();
      }
      ASSERT(length() >= 0);
    }

