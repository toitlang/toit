  {
    //@ byte_array_open(self);
    //@ open [f]byte_array_body(self, _, _);
    ASSERT(has_external_address());
    return _word_at(EXTERNAL_TAG_OFFSET);
    //@ close [f]byte_array_body(self, o_len(H(self)), o_aux(H(self)));
    //@ byte_array_close(self);
  }

