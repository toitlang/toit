@render src/objects.h toit::Double::value tu=src/objects.cc trusted
  double value()
  // The value word of a double (not modelled: the heap model has no body
  // for doubles; reading it is reading inside the object).
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& header_tag2(o_hw(H(self))) == 2 * DOUBLE_TAG;
  //@ ensures [f]heap(objs, H);
  { return _double_at(VALUE_OFFSET); }

@render src/objects.h toit::LargeInteger::value tu=src/objects.cc trusted
  int64 value()
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& header_tag2(o_hw(H(self))) == 2 * LARGE_INTEGER_TAG;
  //@ ensures [f]heap(objs, H);
  { return _int64_at(VALUE_OFFSET); }

@render src/objects.h toit::HeapObject::_raw tu=src/objects.cc
  INLINE uword _raw() const
  //@ requires 1 <= (uword)self;
  //@ ensures result == (uword)self - 1;
  { return reinterpret_cast<uword>(this) - HEAP_TAG; }

@render src/objects.h toit::HeapObject::_raw_at tu=src/objects.cc type=constuword*(word)const
  INLINE const uword* _raw_at(word offset) const
  //@ requires addr_ok(self) == true &*& 0 <= offset &*& offset <= 4 * WORD_SIZE;
  //@ ensures result == (uword *)((uword)self - 1 + offset);
  { return reinterpret_cast<const uword*>(reinterpret_cast<uword>(this) - HEAP_TAG + offset); }

@render src/objects.h toit::HeapObject::_half_word_at tu=src/objects.cc
  INLINE uhalf_word _half_word_at(word offset) const
  //@ requires addr_ok(self) == true &*& 0 <= offset &*& offset <= 4 * WORD_SIZE &*& [?f]half_word((uint8 *)raw(self) + offset, ?v);
  //@ ensures [f]half_word((uint8 *)raw(self) + offset, v) &*& result == v;
  {
    //@ open [f]half_word(_, _);
    return *reinterpret_cast<const uhalf_word*>(_raw_at(offset));
    //@ close [f]half_word((uint8 *)raw(self) + offset, v);
  }

@render src/objects.h toit::String::_internal_length tu=src/objects.cc
  word _internal_length() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, STRING_TAG) == true;
  //@ ensures [f]heap(objs, H) &*& result == head(o_aux(H(self))) &*& 0 <= result;
  {
    //@ string_open(self);
    //@ open [f]string_body(self, _, _);
     return _half_word_at(INTERNAL_LENGTH_OFFSET);
    //@ close [f]string_body(self, o_len(H(self)), o_aux(H(self)));
    //@ string_close(self);
  }

@render src/objects.h toit::String::content_on_heap tu=src/objects.cc
  bool content_on_heap() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, STRING_TAG) == true;
  //@ ensures [f]heap(objs, H) &*& result == !is_external(H, self);
  { return _internal_length() != SENTINEL; }

@render src/objects.h toit::String::_external_length tu=src/objects.cc
  word _external_length() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, STRING_TAG) == true &*& is_external(H, self) == true;
  //@ ensures [f]heap(objs, H) &*& result == blob_len(H, self);
  {
    //@ string_open(self);
    //@ open [f]string_body(self, _, _);
     ASSERT(_internal_length() == SENTINEL);
     return _word_at(EXTERNAL_LENGTH_OFFSET);
    //@ close [f]string_body(self, o_len(H(self)), o_aux(H(self)));
    //@ string_close(self);
  }

@render src/objects.h toit::String::_external_address tu=src/objects.cc
  uint8* _external_address() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, STRING_TAG) == true &*& is_external(H, self) == true;
  //@ ensures [f]heap(objs, H) &*& result == blob_base(H, self);
  {
    //@ string_open(self);
    //@ open [f]string_body(self, _, _);
    return reinterpret_cast<uint8*>(_word_at(EXTERNAL_ADDRESS_OFFSET));
    //@ close [f]string_body(self, o_len(H(self)), o_aux(H(self)));
    //@ string_close(self);
  }

@render src/objects.h toit::String::as_external tu=src/objects.cc type=constuint8*()const
  const uint8* as_external() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, STRING_TAG) == true;
  //@ ensures [f]heap(objs, H) &*& result == (is_external(H, self) ? blob_base(H, self) : 0);
  {
    if (!content_on_heap()) return unsigned_cast(_external_address());
    return null;
  }

@render src/objects.h toit::String::_as_utf8bytes tu=src/objects.cc type=constuint8*()const
  const uint8* _as_utf8bytes() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, STRING_TAG) == true;
  //@ ensures [f]heap(objs, H) &*& result == blob_base(H, self);
  {
    //@ heap_facts(self);
    if (content_on_heap()) {
      return reinterpret_cast<const uint8*>(_raw_at(INTERNAL_HEADER_SIZE));
    }
    return _external_address();
  }

@render src/objects.h toit::String::cast tu=src/objects.cc type=constString*(constObject*)
  static const String* cast(const Object* object)
  //@ requires true;
  //@ ensures result == object;
  {
     ASSERT(is_string(object));
     return static_cast<const String*>(object);
  }

@render src/objects.h toit::String::Bytes::Bytes tu=src/objects.cc type=void(constString*)
    explicit Bytes(const String* string)
    //@ requires self->address_ |-> _ &*& self->length_ |-> _ &*& [?f]heap(?objs, ?H) &*& mem(string, objs) == true &*& has_tag(H, string, STRING_TAG) == true;
    //@ ensures self->address_ |-> blob_base(H, string) &*& self->length_ |-> blob_len(H, string) &*& [f]heap(objs, H);
    {
      word len = string->_internal_length();
      if (len != SENTINEL) {
        address_ = string->_as_utf8bytes();
        //@ string_open(string);
        //@ open [f]string_body(string, _, _);
        //@ close [f]string_body(string, o_len(H(string)), o_aux(H(string)));
        //@ string_close(string);
        length_ = len;
      } else {
        address_ = string->as_external();
        length_ = string->_external_length();
      }
      ASSERT(length() >= 0);
    }

@render src/objects.h toit::String::Bytes::address tu=src/objects.cc
    const uint8* address()
    //@ requires [?f]self->address_ |-> ?a;
    //@ ensures [f]self->address_ |-> a &*& result == a;
    { return address_; }

@render src/objects.h toit::String::Bytes::length tu=src/objects.cc
    word length()
    //@ requires [?f]self->length_ |-> ?l;
    //@ ensures [f]self->length_ |-> l &*& result == l;
    { return length_; }

@render src/objects.h toit::ByteArray::raw_length tu=src/objects.cc trusted
  word raw_length() const
  // The length word read as a uword and converted to word: for an external
  // byte array the word is negative, and that conversion is
  // implementation-defined before C++20 (GCC/Clang: modular), which
  // VeriFast refuses, as for Smi::value: trusted.
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, BYTE_ARRAY_TAG) == true;
  //@ ensures [f]heap(objs, H) &*& result == o_len(H(self));
  { return _word_at(LENGTH_OFFSET); }

@render src/objects.h toit::ByteArray::has_external_address tu=src/objects.cc
  bool has_external_address() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, BYTE_ARRAY_TAG) == true;
  //@ ensures [f]heap(objs, H) &*& result == is_external(H, self);
  { return raw_length() < 0; }

@render src/objects.h toit::ByteArray::external_tag tu=src/objects.cc
  word external_tag() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, BYTE_ARRAY_TAG) == true &*& is_external(H, self) == true;
  //@ ensures [f]heap(objs, H) &*& result == nth(1, o_aux(H(self)));
  {
    //@ byte_array_open(self);
    //@ open [f]byte_array_body(self, _, _);
    ASSERT(has_external_address());
    return _word_at(EXTERNAL_TAG_OFFSET);
    //@ close [f]byte_array_body(self, o_len(H(self)), o_aux(H(self)));
    //@ byte_array_close(self);
  }

@render src/objects.h toit::ByteArray::_offset_from tu=src/objects.cc
  static word _offset_from(word index)
  //@ requires 0 <= index &*& index <= WORD_SIZE * MAX_OBJECT_WORDS;
  //@ ensures result == ByteArray_HEADER_SIZE + index;
  {
    ASSERT(index >= 0);
    ASSERT(index <= max_internal_size());
    return HEADER_SIZE + index;
  }

@render src/objects.h toit::ByteArray::content tu=src/objects.cc type=constuint8*()const
  const uint8* content() const
  //@ requires addr_ok(self) == true;
  //@ ensures result == (uint8 *)((uword)self - 1 + 2 * WORD_SIZE);
  { return reinterpret_cast<const uint8*>(_raw() + _offset_from(0)); }

@render src/objects.h toit::ByteArray::content tu=src/objects.cc type=uint8*()
  uint8* content()
  //@ requires addr_ok(self) == true;
  //@ ensures result == (uint8 *)((uword)self - 1 + 2 * WORD_SIZE);
  { return reinterpret_cast<uint8*>(_raw() + _offset_from(0)); }

@render src/objects.h toit::ByteArray::_external_address tu=src/objects.cc
  uint8* _external_address() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, BYTE_ARRAY_TAG) == true &*& is_external(H, self) == true;
  //@ ensures [f]heap(objs, H) &*& result == blob_base(H, self);
  {
    //@ byte_array_open(self);
    //@ open [f]byte_array_body(self, _, _);
    return reinterpret_cast<uint8*>(_word_at(EXTERNAL_ADDRESS_OFFSET));
    //@ close [f]byte_array_body(self, o_len(H(self)), o_aux(H(self)));
    //@ byte_array_close(self);
  }

@render src/objects.h toit::ByteArray::as_external tu=src/objects.cc type=constuint8*()const
  const uint8* as_external() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, BYTE_ARRAY_TAG) == true;
  //@ ensures [f]heap(objs, H) &*& result == (is_external(H, self) ? blob_base(H, self) : 0);
  {
    ASSERT(external_tag() == RawByteTag || external_tag() == NullStructTag);
    if (has_external_address()) return unsigned_cast(_external_address());
    return 0;
  }

@render src/objects.h toit::ByteArray::as_external tu=src/objects.cc type=uint8*()
  uint8* as_external()
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, BYTE_ARRAY_TAG) == true;
  //@ ensures [f]heap(objs, H) &*& result == (is_external(H, self) ? blob_base(H, self) : 0);
  {
    ASSERT(external_tag() == RawByteTag || external_tag() == NullStructTag);
    if (has_external_address()) return unsigned_cast(_external_address());
    return 0;
  }

@render src/objects.h toit::ByteArray::cast tu=src/objects.cc type=constByteArray*(constObject*)
