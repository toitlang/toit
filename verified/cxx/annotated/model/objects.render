@render src/objects.h toit::ByteArray::as_external tu=src/objects.cc type=constuint8*()const
  const uint8* as_external() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, BYTE_ARRAY_TAG) == true;
  //@ ensures [f]heap(objs, H) &*& result == (is_external(H, self) ? blob_base(H, self) : 0);
  {
    ASSERT(external_tag() == RawByteTag || external_tag() == NullStructTag);
    if (has_external_address()) return unsigned_cast(_external_address());
    return 0;
  }

