@render src/objects.h toit::Object::unmark tu=src/objects.cc
inline HeapObject* Object::unmark()
  //@ requires (uword)self % 4 == 3;
  //@ ensures result == (HeapObject *)((uword)self - 2);
{
  ASSERT(is_marked());
  //@ uword x = (uword)self;
  //@ div_rem_nonneg(x, 4);
  //@ shiftright_div(x, N2);
  uword address = reinterpret_cast<uword>(this) >> Object::NON_SMI_TAG_SIZE;
  //@ shiftleft_def(address, N2);
  address = address << Object::NON_SMI_TAG_SIZE;
  HeapObject* result = reinterpret_cast<HeapObject*>(address + Object::HEAP_TAG);
  ASSERT(!result->is_marked());
  return result;
}

@render src/objects.h toit::HeapObject::mark tu=src/objects.cc
  HeapObject* mark()
  //@ requires true;
  /*@ ensures (uword)result == ((uword)self | 3) &*& (uword)result % 4 == 3 &*&
              (uword)result / 4 == (uword)self / 4; @*/
  {
    ASSERT(!is_marked());
    //@ uword x = (uword)self;
    //@ div_rem_nonneg(x, 4);
    //@ Z high = int_of_Z_of_uintN(x / 4, N64);
    //@ int r = x % 4;
    //@ if (r < 1) { assert r == 0; } else if (r < 2) { assert r == 1; } else if (r < 3) { assert r == 2; } else { assert r == 3; }
    //@ bitor_def(x, Zdigit(Zdigit(high, r >= 2), r == 1 || r == 3), 3, Zdigit(Zdigit(Zsign(false), true), true));
    //@ switch (high) { case Zsign(b): case Zdigit(z, b): }
    //@ div_rem_nonneg_unique(4 * (x / 4) + 3, 4, x / 4, 3);
    uword raw = reinterpret_cast<uword>(this) | Error::ERROR_TAG;
    HeapObject* result = reinterpret_cast<HeapObject*>(raw);
    ASSERT(result->is_marked());
    return result;
  }

@render src/objects.h toit::Error::from tu=src/objects.cc
inline Error* Error::from(String* string)
//@ requires true;
//@ ensures (uword)result == ((uword)string | 3) &*& (uword)result % 4 == 3;
{
  return reinterpret_cast<Error*>(string->mark());
}

