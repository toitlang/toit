  INLINE void _int64_at_put(word offset, int64 value)
  /*@ requires addr_ok(self) == true &*& 0 <= offset &*& offset <= 4 * WORD_SIZE &*&
               chars_((char *)raw(self) + offset, 8, _); @*/
  //@ ensures boxed_bytes((void *)((uint8 *)raw(self) + offset), value);
