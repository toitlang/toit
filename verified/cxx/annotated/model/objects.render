// Copyright (C) 2026 Toit contributors.
//
// The Toit object model for VeriFast: the predicates that say what a VM
// object is, and the accessors of src/objects.h, rendered mechanically
// from the C++ (verified/tools/cxx_render.toit) and verified against them.
// Generates objects.gen.h (types, predicates, contracts: what the targets
// include) and objects.gen.c (the accessor bodies).
//
// In the annotations `this` is `self`, as in the rendering.
@include model.cfg
@header objects.gen.h
@verbatim
#include <stdint.h>
#include <stdbool.h>
#include "constants.h"
#include "program_class_ids.h"
//@ #include <listex.gh>
//@ #include <bitops.gh>
//@ #include <maps.gh>

typedef intptr_t word;
typedef uintptr_t uword;
typedef unsigned char uint8;
typedef unsigned short uint16;
typedef unsigned int uint32;
typedef long long int64;
typedef unsigned long long uint64;
typedef int TypeTag;

// Every class is one opaque struct: the C++ classes have no data members,
// `this` is the tagged word.
struct Object;
typedef struct Object Object;
typedef struct Object HeapObject;
typedef struct Object Smi;
typedef struct Object Instance;
typedef struct Object Array;
typedef struct Object ByteArray;
typedef struct Object Double;
typedef struct Object LargeInteger;
typedef struct Object String;
typedef int BlobKind;

// The views of blob content (src/objects.h): plain structs.
struct String_Bytes { uint8 *address_; word length_; };
typedef struct String_Bytes String_Bytes;
struct String_MutableBytes { uint8 *address_; word length_; };
typedef struct String_MutableBytes String_MutableBytes;
struct ByteArray_Bytes { uint8 *address_; word length_; };
typedef struct ByteArray_Bytes ByteArray_Bytes;
struct ByteArray_ConstBytes { uint8 *address_; word length_; };
typedef struct ByteArray_ConstBytes ByteArray_ConstBytes;
struct Blob { uint8 *address_; word length_; };
typedef struct Blob Blob;
struct MutableBlob { uint8 *address_; word length_; };
typedef struct MutableBlob MutableBlob;

// src/utils.h unsigned_cast: a template (no rendering rule): the
// reinterpret_cast to the unsigned pointee type, here the identity.
uint8 *unsigned_cast(uint8 *t);
//@ requires true;
//@ ensures result == t;


/*@

// ---------------------------------------------------------------------------
// Tagged words.

fixpoint bool is_smi_w(uword w) { return w % 2 == 0; }
fixpoint bool is_heap_w(uword w) { return w % 4 == 1; }

// The value of a smi: the word read as a signed integer, halved (exact for
// an even word, so C's truncating division and the arithmetic shift agree).
fixpoint int signed_of(uword w) { return w <= UINTPTR_MAX / 2 ? w : w - UINTPTR_MAX - 1; }
fixpoint int smi_val(uword w) { return signed_of(w) / 2; }
fixpoint bool smi_range(int v) { return -(UINTPTR_MAX / 4) - 1 <= v && v <= UINTPTR_MAX / 4; }

// The word Smi::from(v) makes, for 0 <= v (class ids).
fixpoint void *smi_ptr(int v) { return (void *)(2 * v); }

// The raw (untagged) address of a heap object, as the code computes it:
// `reinterpret_cast<uword*>(reinterpret_cast<uword>(this) - HEAP_TAG)`.
// VeriFast gives an integer-to-pointer cast the null provenance, and so do
// these definitions: object memory is addressed by integer, which is what
// the VM does (the heap is exposed memory). That this memory is the object
// is the content of the predicates below, i.e. an assumption about the
// allocator and the GC (TRUSTED.md V2).
fixpoint uword *raw(void *o) { return (uword *)((uword)o - 1); }
predicate copied_header(void *object; list<char> bytes) =
  chars((char *)raw(object),sizeof(word),bytes);
predicate installed_forwarding(void *original,void *target) =
  pointer((void **)raw(original),target) &*& is_heap_w((uword)target) == true;

// ---------------------------------------------------------------------------
// Headers. A header is a smi whose value is (class_id << 5) | (finalizer
// bit << 4) | class_tag. The heap model keeps class ids in [0,
// MAX_CLASS_IDS): on ILP32 every non-negative id whose header is a smi
// (2^25), on LP64 the ids below 2^31 (the encoder keeps a problematic class
// id in an `int`; an id of 2^31 would need a program class table, two bytes
// per class, of 4 GB). The C++ takes any class id of the program
// (CLASS_ID_BIT_SIZE, 10, is declared but used nowhere; the mask is the
// whole word). Until wave 7 the model kept ids below 1024, a gap for
// programs with more classes. Negative ids are the GC's free-memory pseudo
// objects, which the code under proof never sees.
#define MAX_CLASS_IDS (UINTPTR_MAX > 0xffffffff ? 0x80000000 : 0x2000000)

fixpoint bool header_ok(uword hw) { return 0 <= hw && hw % 2 == 0 && hw < MAX_CLASS_IDS * 64; }
fixpoint int header_cid(uword hw) { return hw / 64; }
// has_class_tag compares `header_word & (CLASS_TAG_MASK << 1)` with `tag << 1`.
fixpoint int header_tag2(uword hw) { return hw & 30; }

// The program's classes (src/program.h roots and class bits). Global and
// uninterpreted: one program per proof.
fixpoint int class_tag(int cid);
fixpoint int class_fields(int cid);

inductive prog_ids = prog_ids(
    int array_cid, int list_cid, int list_slice_cid, int map_cid,
    int large_array_cid, int tombstone_cid,
    int byte_array_cow_cid, int byte_array_slice_cid, int string_slice_cid,
    int string_byte_slice_cid);

fixpoint int array_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return a; } }
fixpoint int list_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return l; } }
fixpoint int list_slice_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return s; } }
fixpoint int map_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return m; } }
fixpoint int large_array_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return la; } }
fixpoint int tombstone_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return t; } }
fixpoint int byte_array_cow_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return c; } }
fixpoint int byte_array_slice_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return bs; } }
fixpoint int string_slice_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return ss; } }
fixpoint int string_byte_slice_cid(prog_ids ids) { switch (ids) { case prog_ids(a, l, s, m, la, t, c, bs, ss, sbs): return sbs; } }

// The blob classes (byte_content): instances with at least the fields the
// VM reads (the copy-on-write byte array: backing, is_mutable; the slices:
// backing, from, to).
fixpoint bool blob_classes_ok(prog_ids ids) {
  return 0 <= byte_array_cow_cid(ids) && byte_array_cow_cid(ids) < MAX_CLASS_IDS &&
         0 <= byte_array_slice_cid(ids) && byte_array_slice_cid(ids) < MAX_CLASS_IDS &&
         0 <= string_slice_cid(ids) && string_slice_cid(ids) < MAX_CLASS_IDS &&
         0 <= string_byte_slice_cid(ids) && string_byte_slice_cid(ids) < MAX_CLASS_IDS &&
         class_tag(byte_array_cow_cid(ids)) == INSTANCE_TAG && class_fields(byte_array_cow_cid(ids)) >= 2 &&
         class_tag(byte_array_slice_cid(ids)) == INSTANCE_TAG && class_fields(byte_array_slice_cid(ids)) >= 3 &&
         class_tag(string_slice_cid(ids)) == INSTANCE_TAG && class_fields(string_slice_cid(ids)) >= 3 &&
         class_tag(string_byte_slice_cid(ids)) == INSTANCE_TAG && class_fields(string_byte_slice_cid(ids)) >= 3;
}

// What VerifierImpl::check_builtin_classes (src/verifier.cc) establishes
// for an accepted program, and the class tags of the builtin classes.
fixpoint bool prog_ok(prog_ids ids) {
  return 0 <= array_cid(ids) && array_cid(ids) < MAX_CLASS_IDS &&
         0 <= list_cid(ids) && list_cid(ids) < MAX_CLASS_IDS &&
         0 <= list_slice_cid(ids) && list_slice_cid(ids) < MAX_CLASS_IDS &&
         0 <= map_cid(ids) && map_cid(ids) < MAX_CLASS_IDS &&
         0 <= large_array_cid(ids) && large_array_cid(ids) < MAX_CLASS_IDS &&
         0 <= tombstone_cid(ids) && tombstone_cid(ids) < MAX_CLASS_IDS &&
         class_tag(array_cid(ids)) == ARRAY_TAG &&
         class_tag(list_cid(ids)) == INSTANCE_TAG && class_fields(list_cid(ids)) >= 2 &&
         class_tag(list_slice_cid(ids)) == INSTANCE_TAG && class_fields(list_slice_cid(ids)) >= 3 &&
         class_tag(map_cid(ids)) == INSTANCE_TAG && class_fields(map_cid(ids)) >= 4 &&
         blob_classes_ok(ids);
}

// ---------------------------------------------------------------------------
// Objects. The abstract heap `H` maps each object to its ghost content:
// the header word, a length (fields of an instance, length of an array, the
// raw length word of a byte array, the content length of a string), the
// words of its body (fields, elements; nil for blobs) and the auxiliary
// words of a blob (`aux`: for a string the internal length half-word and,
// when external, the address; for an external byte array the address and
// the external tag). The heap is a list of distinct tagged addresses `objs`;
// every reference word in an object is a smi or one of `objs` (heap
// integrity, TRUSTED.md V2). The number field holds the signed 64-bit payload of a LargeInteger. The values of fields are otherwise arbitrary: a
// size field can be any smi, a backing field anything (the code must not
// trust them).

inductive oinfo = oinfo(uword hw, int len, list<void *> words, list<uword> aux, int64 number);
fixpoint uword o_hw(oinfo i) { switch (i) { case oinfo(hw, l, ws, ax, n): return hw; } }
fixpoint int o_len(oinfo i) { switch (i) { case oinfo(hw, l, ws, ax, n): return l; } }
fixpoint list<void *> o_words(oinfo i) { switch (i) { case oinfo(hw, l, ws, ax, n): return ws; } }
fixpoint list<uword> o_aux(oinfo i) { switch (i) { case oinfo(hw, l, ws, ax, n): return ax; } }

fixpoint int64 o_number(oinfo i) { switch (i) { case oinfo(hw, l, ws, ax, n): return n; } }

fixpoint bool good(list<void *> objs, void *w) { return is_smi_w((uword)w) || mem(w, objs); }

// The upper bound of an object's size: objects are in pages far below the
// top of the address space (pages are at most a few hundred KB).
#define MAX_OBJECT_WORDS 0x100000
// The upper bound of a blob's length, per width as the Verus heap model's
// (TRUSTED.md, "Word size": byte lengths are below 2^62 on 64-bit, 2^30 on
// 32-bit): 2^62 - 1 on LP64, 2^30 - 1 on ILP32. Blob lengths fit a Smi.
// Until wave 7 it was 2^30 - 1 on ILP32 and at most INT_MAX on LP64,
// narrower than the C++ on 64-bit (a gap). The core's allocation entry
// points check it (V2_MAX_BLOB_LENGTH, ffi/).
#define MAX_BLOB (UINTPTR_MAX / 4)

fixpoint bool addr_ok(void *o) {
  return is_heap_w((uword)o) && 1 < (uword)o &&
         (uword)o + sizeof(word) * (MAX_OBJECT_WORDS + 2) <= UINTPTR_MAX;
}

predicate header(void *o; uword hw) =
  addr_ok(o) == true &*&
  pointer((void **)raw(o) + LAYOUT_HEADER_WORD, ?hp) &*& hw == (uword)hp &*& header_ok(hw) == true;

predicate instance_body(void *o, int n; list<void *> fields) =
  addr_ok(o) == true &*&
  pointers((void **)raw(o) + LAYOUT_INSTANCE_FIELDS_WORD, n, fields) &*& 0 <= n &*& n <= MAX_OBJECT_WORDS &*& length(fields) == n;

predicate array_body(void *o; int len, list<void *> elems) =
  addr_ok(o) == true &*&
  uintptr(raw(o) + LAYOUT_ARRAY_LENGTH_WORD, len) &*& len <= MAX_OBJECT_WORDS &*&
  pointers((void **)raw(o) + LAYOUT_ARRAY_ELEMENTS_WORD, len, elems) &*& length(elems) == len;

// External memory: the bytes at an address word (VeriFast's integer to
// pointer cast, as the code makes it), owned by the object that points to
// them (malloced and freed by its finalizer, or memory the VM maps for it:
// TRUSTED.md V2, V5).
predicate external_bytes(uword address, int length;) =
  uchars((uint8 *)address, length, _) &*& address + length <= UINTPTR_MAX;

// A byte array: [header][raw length][content] or, external, [header]
// [-1 - length][address][tag]. Only an external byte array tagged
// RawByteTag holds bytes; others point to a C struct (proxies, V5: opaque).
predicate byte_array_body(void *o, int raw_length, list<uword> aux;) =
  addr_ok(o) == true &*&
  uintptr(raw(o) + LAYOUT_BYTE_ARRAY_LENGTH_WORD, ?rw) &*& signed_of(rw) == raw_length &*&
  raw_length >= 0 ?
    uchars((uint8 *)raw(o) + LAYOUT_BYTE_ARRAY_CONTENT_BYTE, raw_length, _) &*& raw_length <= WORD_SIZE * MAX_OBJECT_WORDS &*& aux == nil
  :
    -1 - raw_length <= MAX_BLOB &*&
    uintptr(raw(o) + LAYOUT_BYTE_ARRAY_EXTERNAL_ADDRESS_WORD, ?ea) &*& uintptr(raw(o) + LAYOUT_BYTE_ARRAY_EXTERNAL_TAG_WORD, ?et) &*& et <= 0xffff &*&
    aux == cons(ea, cons(et, nil)) &*&
    (et == RawByteTag ? external_bytes(ea, -1 - raw_length) : true);

// A half word at a byte address: `uhalf_word` is unsigned int on LP64 and
// unsigned short on ILP32.
predicate half_word(void *p; int v) =
  sizeof(word) == 8 ? u_integer((unsigned int *)p, v) : u_short_integer((unsigned short *)p, v);

// A string: [header][hash:h][length:h][content][0] or, external, [header]
// [hash:h][SENTINEL:h][length][address]. `len` is the content length.
predicate string_body(void *o, int len, list<uword> aux;) =
  addr_ok(o) == true &*&
  half_word((uint8 *)raw(o) + LAYOUT_STRING_HASH_CODE_BYTE, _) &*&
  half_word((uint8 *)raw(o) + LAYOUT_STRING_INTERNAL_LENGTH_BYTE, ?il) &*&
  il != String_SENTINEL ?
    aux == cons(il, nil) &*& len == il &*& il <= WORD_SIZE * MAX_OBJECT_WORDS &*&
    uchars((uint8 *)raw(o) + LAYOUT_STRING_CONTENT_BYTE, il, _) &*& u_character((uint8 *)raw(o) + LAYOUT_STRING_CONTENT_BYTE + il, 0)
  :
    uintptr(raw(o) + LAYOUT_STRING_EXTERNAL_LENGTH_WORD, len) &*& uintptr(raw(o) + LAYOUT_STRING_EXTERNAL_ADDRESS_WORD, ?ea) &*& len <= MAX_BLOB &*&
    aux == cons(il, cons(ea, nil)) &*& external_bytes(ea, len) &*& u_character((uint8 *)ea + len, 0);

predicate boxed_bytes(void *p; int value) =
  chars(p, 8, ?cs) &*& value == head(integers_of_chars(8, true, cs)) &*& integers_of_chars(8, true, cs) == cons(value, nil);

predicate body(void *o, int tag2, int len, list<uword> aux, int64 number; list<void *> words) =
  tag2 == 2 * INSTANCE_TAG ? instance_body(o, len, words) &*& aux == nil :
  tag2 == 2 * ARRAY_TAG ? array_body(o, len, words) &*& aux == nil :
  tag2 == 2 * BYTE_ARRAY_TAG ? byte_array_body(o, len, aux) &*& words == nil :
  tag2 == 2 * STRING_TAG ? string_body(o, len, aux) &*& words == nil :
  tag2 == 2 * LARGE_INTEGER_TAG ?
    boxed_bytes((void *)(raw(o) + 1), number) &*& len == 0 &*& words == nil &*& aux == nil :
  len == 0 &*& words == nil &*& aux == nil;  // Other objects: only the header is used here.

predicate_ctor heap_obj(list<void *> objs, fixpoint(void *, oinfo) H)(void *o) =
  header(o, o_hw(H(o))) &*&
  header_tag2(o_hw(H(o))) == 2 * class_tag(header_cid(o_hw(H(o)))) &*&
  (class_tag(header_cid(o_hw(H(o)))) == INSTANCE_TAG ? o_len(H(o)) == class_fields(header_cid(o_hw(H(o)))) : true) &*&
  body(o, header_tag2(o_hw(H(o))), o_len(H(o)), o_aux(H(o)), o_number(H(o)), o_words(H(o))) &*&
  forall(o_words(H(o)), (good)(objs)) == true;

predicate heap(list<void *> objs, fixpoint(void *, oinfo) H) =
  foreach(objs, heap_obj(objs, H)) &*& distinct(objs) == true;

// The facts about one object besides its memory.
fixpoint bool obj_facts(list<void *> objs, fixpoint(void *, oinfo) H, void *o) {
  return header_tag2(o_hw(H(o))) == 2 * class_tag(header_cid(o_hw(H(o)))) &&
         (class_tag(header_cid(o_hw(H(o)))) == INSTANCE_TAG ? o_len(H(o)) == class_fields(header_cid(o_hw(H(o)))) : true) &&
         forall(o_words(H(o)), (good)(objs));
}

predicate heap_rest(list<void *> objs, fixpoint(void *, oinfo) H, void *o) =
  foreach(remove(o, objs), heap_obj(objs, H)) &*& distinct(objs) == true;

fixpoint bool has_tag(fixpoint(void *, oinfo) H, void *o, int tag) {
  return is_heap_w((uword)o) && header_tag2(o_hw(H(o))) == 2 * tag;
}

// ---------------------------------------------------------------------------
// Blobs: the content of a string or a byte array.

fixpoint bool is_external(fixpoint(void *, oinfo) H, void *o) {
  return has_tag(H, o, BYTE_ARRAY_TAG) ? o_len(H(o)) < 0 : head(o_aux(H(o))) == String_SENTINEL;
}

// Where the content starts: inside the object after two words, or at the
// external address.
fixpoint uint8 *blob_base(fixpoint(void *, oinfo) H, void *o) {
  return !is_external(H, o) ? (uint8 *)raw(o) + 2 * WORD_SIZE :
         has_tag(H, o, BYTE_ARRAY_TAG) ? (uint8 *)head(o_aux(H(o))) : (uint8 *)nth(1, o_aux(H(o)));
}

fixpoint int blob_len(fixpoint(void *, oinfo) H, void *o) {
  return has_tag(H, o, BYTE_ARRAY_TAG) && o_len(H(o)) < 0 ? -1 - o_len(H(o)) : o_len(H(o));
}

// The objects whose content byte_content returns for `kind`: strings, and
// (STRINGS_OR_BYTE_ARRAYS) byte arrays with internal or raw external bytes.
fixpoint bool blob_ok(fixpoint(void *, oinfo) H, void *o, int kind) {
  return has_tag(H, o, STRING_TAG) ||
         (kind == STRINGS_OR_BYTE_ARRAYS && has_tag(H, o, BYTE_ARRAY_TAG) &&
          (o_len(H(o)) >= 0 || nth(1, o_aux(H(o))) == RawByteTag));
}

// [a, a + l) lies in the content of o (and has its provenance).
fixpoint bool blob_in(fixpoint(void *, oinfo) H, void *o, uint8 *a, int l) {
  return 0 <= l && blob_base(H, o) <= a && a + l <= blob_base(H, o) + blob_len(H, o) &&
         a == blob_base(H, o) + ((uword)a - (uword)blob_base(H, o));
}

// The postcondition of byte_content: the range is in the content of a
// live blob of the kind asked for.
predicate blob_result(list<void *> objs, fixpoint(void *, oinfo) H, int kind, uint8 *a, int l, void *b) =
  mem(b, objs) == true &*& blob_ok(H, b, kind) == true &*& blob_in(H, b, a, l) == true;

// A string can copy an independent native buffer or a slice of a live
// heap object. The latter's bytes are already owned by the heap.
inductive string_input = native_bytes(real, list<unsigned char>) | heap_bytes(void *);
predicate string_source(string_input source, list<void *> objs, fixpoint(void *, oinfo) H, uint8 *p, int n) =
  switch (source) {
    case native_bytes(f, bs): return [f]uchars(p, n, bs);
    case heap_bytes(b): return mem(b, objs) == true &*& blob_ok(H, b, STRINGS_OR_BYTE_ARRAYS) == true &*& blob_in(H, b, p, n) == true;
  };

// Lemmas about the model (proved in objects.gen.c).

// A string or byte array taken out of the heap with its body, and back.
lemma void string_open(void *s);
  requires [?f]heap(?objs, ?H) &*& mem(s, objs) == true &*& has_tag(H, s, STRING_TAG) == true;
  ensures [f]heap_rest(objs, H, s) &*& [f]header(s, o_hw(H(s))) &*&
          [f]string_body(s, o_len(H(s)), o_aux(H(s))) &*& obj_facts(objs, H, s) == true &*&
          o_words(H(s)) == nil &*& addr_ok(s) == true;

lemma void string_close(void *s);
  requires [?f]heap_rest(?objs, ?H, s) &*& [f]header(s, o_hw(H(s))) &*&
           [f]string_body(s, o_len(H(s)), o_aux(H(s))) &*& obj_facts(objs, H, s) == true &*&
           o_words(H(s)) == nil &*& mem(s, objs) == true &*& has_tag(H, s, STRING_TAG) == true;
  ensures [f]heap(objs, H);

lemma void byte_array_open(void *s);
  requires [?f]heap(?objs, ?H) &*& mem(s, objs) == true &*& has_tag(H, s, BYTE_ARRAY_TAG) == true;
  ensures [f]heap_rest(objs, H, s) &*& [f]header(s, o_hw(H(s))) &*&
          [f]byte_array_body(s, o_len(H(s)), o_aux(H(s))) &*& obj_facts(objs, H, s) == true &*&
          o_words(H(s)) == nil &*& addr_ok(s) == true;

lemma void byte_array_close(void *s);
  requires [?f]heap_rest(?objs, ?H, s) &*& [f]header(s, o_hw(H(s))) &*&
           [f]byte_array_body(s, o_len(H(s)), o_aux(H(s))) &*& obj_facts(objs, H, s) == true &*&
           o_words(H(s)) == nil &*& mem(s, objs) == true &*& has_tag(H, s, BYTE_ARRAY_TAG) == true;
  ensures [f]heap(objs, H);

// The content of a readable blob fits in the address space and the heap model’s length bound.
lemma void blob_facts(void *b);
  requires [?f]heap(?objs, ?H) &*& mem(b, objs) == true &*& blob_ok(H, b, STRINGS_OR_BYTE_ARRAYS) == true;
  ensures [f]heap(objs, H) &*& 0 <= blob_len(H, b) &*& blob_len(H, b) <= MAX_BLOB &*&
          (uword)blob_base(H, b) + blob_len(H, b) <= UINTPTR_MAX &*&
          (is_external(H, b) ? true : blob_base(H, b) == (uint8 *)raw(b) + 2 * WORD_SIZE);

// ---------------------------------------------------------------------------
// The heap with the contents of some blobs taken out (for a copy between
// two blobs, or a write into one): `holes` are the objects taken out, each
// a `blob_hole` (its header and the rest of its body) and its content as a
// separate `uchars` chunk.

predicate heap_holes(list<void *> objs, fixpoint(void *, oinfo) H, list<void *> holes) =
  foreach(remove_all(holes, objs), heap_obj(objs, H)) &*& distinct(objs) == true;

predicate blob_shell(void *b, int tag2, int len, list<uword> aux) =
  tag2 == 2 * BYTE_ARRAY_TAG ?
    addr_ok(b) == true &*& uintptr(raw(b) + LAYOUT_BYTE_ARRAY_LENGTH_WORD, ?rw) &*& signed_of(rw) == len &*&
    (len >= 0 ?
       len <= WORD_SIZE * MAX_OBJECT_WORDS &*& aux == nil
     :
       -1 - len <= MAX_BLOB &*& uintptr(raw(b) + LAYOUT_BYTE_ARRAY_EXTERNAL_ADDRESS_WORD, ?ea) &*& uintptr(raw(b) + LAYOUT_BYTE_ARRAY_EXTERNAL_TAG_WORD, ?et) &*& et <= 0xffff &*&
       aux == cons(ea, cons(et, nil)) &*& et == RawByteTag &*& ea + (-1 - len) <= UINTPTR_MAX)
  :
    addr_ok(b) == true &*&
    half_word((uint8 *)raw(b) + LAYOUT_STRING_HASH_CODE_BYTE, _) &*&
    half_word((uint8 *)raw(b) + LAYOUT_STRING_INTERNAL_LENGTH_BYTE, ?il) &*&
    (il != String_SENTINEL ?
       aux == cons(il, nil) &*& len == il &*& il <= WORD_SIZE * MAX_OBJECT_WORDS &*& u_character((uint8 *)raw(b) + LAYOUT_STRING_CONTENT_BYTE + il, 0)
     :
       uintptr(raw(b) + LAYOUT_STRING_EXTERNAL_LENGTH_WORD, len) &*& uintptr(raw(b) + LAYOUT_STRING_EXTERNAL_ADDRESS_WORD, ?ea) &*& len <= MAX_BLOB &*&
       aux == cons(il, cons(ea, nil)) &*& ea + len <= UINTPTR_MAX &*& u_character((uint8 *)ea + len, 0));

predicate blob_hole(list<void *> objs, fixpoint(void *, oinfo) H, void *b) =
  header(b, o_hw(H(b))) &*& blob_shell(b, header_tag2(o_hw(H(b))), o_len(H(b)), o_aux(H(b))) &*&
  obj_facts(objs, H, b) == true &*& o_words(H(b)) == nil &*& mem(b, objs) == true &*&
  blob_ok(H, b, STRINGS_OR_BYTE_ARRAYS) == true;

lemma void heap_holes_open();
  requires [?f]heap(?objs, ?H);
  ensures [f]heap_holes(objs, H, nil);

lemma void heap_holes_close();
  requires [?f]heap_holes(?objs, ?H, nil);
  ensures [f]heap(objs, H);

lemma void blob_take(void *b);
  requires [?f]heap_holes(?objs, ?H, ?hs) &*& mem(b, objs) == true &*& mem(b, hs) == false &*&
           blob_ok(H, b, STRINGS_OR_BYTE_ARRAYS) == true;
  ensures [f]heap_holes(objs, H, cons(b, hs)) &*& [f]blob_hole(objs, H, b) &*&
          [f]uchars(blob_base(H, b), blob_len(H, b), _);

lemma void blob_give(void *b);
  requires [?f]heap_holes(?objs, ?H, cons(b, ?hs)) &*& mem(b, hs) == false &*& [f]blob_hole(objs, H, b) &*&
           [f]uchars(blob_base(H, b), blob_len(H, b), _);
  ensures [f]heap_holes(objs, H, hs);

lemma void good_nth(list<void *> objs, list<void *> ws, int i);
  requires forall(ws, (good)(objs)) == true &*& 0 <= i &*& i < length(ws);
  ensures good(objs, nth(i, ws)) == true;

// Take one object out of (a fraction of) the heap, and put it back.
lemma void heap_open(void *o);
  requires [?f]heap(?objs, ?H) &*& mem(o, objs) == true;
  ensures [f]heap_rest(objs, H, o) &*& [f]header(o, o_hw(H(o))) &*&
          [f]body(o, header_tag2(o_hw(H(o))), o_len(H(o)), o_aux(H(o)), o_number(H(o)), o_words(H(o))) &*&
          obj_facts(objs, H, o) == true &*& addr_ok(o) == true;

lemma void heap_close(void *o);
  requires [?f]heap_rest(?objs, ?H, o) &*& [f]header(o, o_hw(H(o))) &*&
           [f]body(o, header_tag2(o_hw(H(o))), o_len(H(o)), o_aux(H(o)), o_number(H(o)), o_words(H(o))) &*&
           obj_facts(objs, H, o) == true &*& mem(o, objs) == true;
  ensures [f]heap(objs, H);

// A good word that is not a smi is an object of the heap.
lemma void good_mem(list<void *> objs, void *w);
  requires good(objs, w) == true &*& is_smi_w((uword)w) == false;
  ensures mem(w, objs) == true;

// A heap-tagged word that is a good reference is an object of the heap.
lemma void good_heap(list<void *> objs, void *w);
  requires good(objs, w) == true &*& is_heap_w((uword)w) == true &*& 0 <= (uword)w;
  ensures mem(w, objs) == true;

// An object of the heap with a given tag (for the casts' callers).
lemma void heap_facts(void *o);
  requires [?f]heap(?objs, ?H) &*& mem(o, objs) == true;
  ensures [f]heap(objs, H) &*& obj_facts(objs, H, o) == true &*& addr_ok(o) == true &*&
          header_ok(o_hw(H(o))) == true;

// The code indexes object words from the object's start, the predicates
// hold the body as an array after the header: focus on one element of
// such an array, and back.
lemma void pointers_focus(void **base, int i);
  requires [?f]pointers(base, ?n, ?ps) &*& 0 <= i &*& i < n;
  ensures [f]pointers(base, i, take(i, ps)) &*& [f]pointer(base + i, nth(i, ps)) &*&
          [f]pointers(base + i + 1, n - i - 1, drop(i + 1, ps));

lemma void pointers_unfocus(void **base, int i, list<void *> ps);
  requires [?f]pointers(base, i, take(i, ps)) &*& [f]pointer(base + i, ?v) &*&
           [f]pointers(base + i + 1, ?m, drop(i + 1, ps)) &*& 0 <= i &*& i < length(ps);
  ensures [f]pointers(base, i + 1 + m, update(i, v, ps));

@*/

// ---------------------------------------------------------------------------
// Projected fields of the loaded program image (src/program.h).

typedef struct FlashAllocation_Header { uint16 size_in_pages_; } FlashAllocation_Header;
typedef struct BytecodeList { uint8 *data_; word length_; } BytecodeList;
struct Program {
  FlashAllocation_Header header_;
  Object *roots_[Program_ROOT_COUNT];
  Smi *_builtin_class_ids[Program_BUILTIN_CLASS_IDS_COUNT];
  BytecodeList bytecodes;
};
typedef struct Program FlashAllocation;
typedef struct Program Program;

