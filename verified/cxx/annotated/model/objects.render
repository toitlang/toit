    //@ open [f]process(self, prog, ids);
    uword address = reinterpret_cast<uword>(object);
    uword start = reinterpret_cast<uword>(program_);
    return address >= start && address - start < program_heap_size_;
    //@ close [f]process(self, prog, ids);
  }

@render src/objects_inline.h toit::HeapObject::on_program_heap tu=src/objects_runtime.cc
inline bool HeapObject::on_program_heap(Process* process) const
//@ requires [?f]process(process, ?prog, ?ids);
//@ ensures [f]process(process, prog, ids) &*& result == in_program_heap(process, self);
{
  return process->on_program_heap(this);
}
