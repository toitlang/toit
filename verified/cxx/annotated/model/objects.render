  return is_heap_object(o) && HeapObject::cast(o)->has_class_tag(STRING_TAG);
}

@render src/objects.h toit::is_large_integer tu=src/objects.cc
inline bool is_large_integer(const Object* o)
//@ requires [?f]heap(?objs, ?H) &*& good(objs, o) == true;
//@ ensures [f]heap(objs, H) &*& result == has_tag(H, o, LARGE_INTEGER_TAG);
{
  //@ if (is_heap_w((uword)o)) good_heap(objs, o);
  return is_heap_object(o) && HeapObject::cast(o)->has_class_tag(LARGE_INTEGER_TAG);
}

@render src/objects.h toit::HeapObject::class_tag tu=src/objects.cc
  INLINE TypeTag class_tag() const
  //@ requires [?f]heap(?objs, ?H) &*& mem(self, objs) == true;
  //@ ensures [f]heap(objs, H) &*& 0 <= result &*& result < 16;
  {
    //@ heap_open(self);
    //@ uword hw = o_hw(H(self));
    //@ open [f]header(self, hw);
    //@ close [f]header(self, hw);
    //@ div_rem_nonneg(hw, 2);
    //@ shiftright_div(smi_val(hw), zero);
    //@ div_rem_nonneg_unique(smi_val(hw), 1, smi_val(hw), 0);
    //@ bitand_limits(hw / 2, 15, N4);
    return static_cast<TypeTag>((Smi::value(header()) >> HeapObject::CLASS_TAG_OFFSET) & HeapObject::CLASS_TAG_MASK);
    //@ heap_close(self);
  }

