/*@

lemma void good_nth(list<void *> objs, list<void *> ws, int i)
  requires forall(ws, (good)(objs)) == true &*& 0 <= i &*& i < length(ws);
  ensures good(objs, nth(i, ws)) == true;
{
  switch (ws) {
    case nil:
    case cons(w, ws0):
      if (i > 0) good_nth(objs, ws0, i - 1);
  }
}

lemma void good_mem(list<void *> objs, void *w)
  requires good(objs, w) == true &*& is_smi_w((uword)w) == false;
  ensures mem(w, objs) == true;
{
}

lemma void good_heap(list<void *> objs, void *w)
  requires good(objs, w) == true &*& is_heap_w((uword)w) == true &*& 0 <= (uword)w;
  ensures mem(w, objs) == true;
{
  div_rem_nonneg((uword)w, 4);
  div_rem_nonneg_unique((uword)w, 2, 2 * ((uword)w / 4), 1);
}

lemma void foreach_remove_frac<t>(t x, list<t> xs)
  requires [?f]foreach(xs, ?p) &*& mem(x, xs) == true;
  ensures [f]foreach(remove(x, xs), p) &*& [f]p(x);
{
  open [f]foreach(xs, p);
  switch (xs) {
    case nil:
    case cons(x0, xs0):
      if (x0 != x) {
        foreach_remove_frac(x, xs0);
        close [f]foreach(remove(x, xs), p);
      }
  }
}

lemma void foreach_unremove_frac<t>(t x, list<t> xs)
  requires [?f]foreach(remove(x, xs), ?p) &*& mem(x, xs) == true &*& [f]p(x);
  ensures [f]foreach(xs, p);
{
  switch (xs) {
    case nil:
    case cons(x0, xs0):
      if (x0 == x) {
        close [f]foreach(xs, p);
      } else {
        open [f]foreach(remove(x, xs), p);
        foreach_unremove_frac(x, xs0);
        close [f]foreach(xs, p);
      }
  }
}

lemma void heap_open(void *o)
  requires [?f]heap(?objs, ?H) &*& mem(o, objs) == true;
  ensures [f]heap_rest(objs, H, o) &*& [f]header(o, o_hw(H(o))) &*&
          [f]body(o, header_tag2(o_hw(H(o))), o_len(H(o)), o_aux(H(o)), o_number(H(o)), o_words(H(o))) &*&
          obj_facts(objs, H, o) == true &*& addr_ok(o) == true;
{
  open [f]heap(objs, H);
  foreach_remove_frac(o, objs);
  open [f]heap_obj(objs, H)(o);
  open [f]header(o, o_hw(H(o)));
  close [f]header(o, o_hw(H(o)));
  close [f]heap_rest(objs, H, o);
}

lemma void heap_close(void *o)
  requires [?f]heap_rest(?objs, ?H, o) &*& [f]header(o, o_hw(H(o))) &*&
           [f]body(o, header_tag2(o_hw(H(o))), o_len(H(o)), o_aux(H(o)), o_number(H(o)), o_words(H(o))) &*&
           obj_facts(objs, H, o) == true &*& mem(o, objs) == true;
  ensures [f]heap(objs, H);
{
  open [f]heap_rest(objs, H, o);
  close [f]heap_obj(objs, H)(o);
  foreach_unremove_frac(o, objs);
  close [f]heap(objs, H);
}

lemma void heap_facts(void *o)
  requires [?f]heap(?objs, ?H) &*& mem(o, objs) == true;
  ensures [f]heap(objs, H) &*& obj_facts(objs, H, o) == true &*& addr_ok(o) == true &*&
          header_ok(o_hw(H(o))) == true;
{
  heap_open(o);
  open [f]header(o, _);
  close [f]header(o, o_hw(H(o)));
  heap_close(o);
}

lemma void string_open(void *s)
  requires [?f]heap(?objs, ?H) &*& mem(s, objs) == true &*& has_tag(H, s, STRING_TAG) == true;
  ensures [f]heap_rest(objs, H, s) &*& [f]header(s, o_hw(H(s))) &*&
          [f]string_body(s, o_len(H(s)), o_aux(H(s))) &*& obj_facts(objs, H, s) == true &*&
          o_words(H(s)) == nil &*& addr_ok(s) == true;
{
  heap_open(s);
  open [f]body(s, _, _, _, _, _);
}

lemma void string_close(void *s)
  requires [?f]heap_rest(?objs, ?H, s) &*& [f]header(s, o_hw(H(s))) &*&
           [f]string_body(s, o_len(H(s)), o_aux(H(s))) &*& obj_facts(objs, H, s) == true &*&
           o_words(H(s)) == nil &*& mem(s, objs) == true &*& has_tag(H, s, STRING_TAG) == true;
  ensures [f]heap(objs, H);
{
  close [f]body(s, 2 * STRING_TAG, o_len(H(s)), o_aux(H(s)), o_number(H(s)), nil);
  heap_close(s);
}

lemma void byte_array_open(void *s)
  requires [?f]heap(?objs, ?H) &*& mem(s, objs) == true &*& has_tag(H, s, BYTE_ARRAY_TAG) == true;
  ensures [f]heap_rest(objs, H, s) &*& [f]header(s, o_hw(H(s))) &*&
          [f]byte_array_body(s, o_len(H(s)), o_aux(H(s))) &*& obj_facts(objs, H, s) == true &*&
          o_words(H(s)) == nil &*& addr_ok(s) == true;
{
  heap_open(s);
  open [f]body(s, _, _, _, _, _);
}

lemma void byte_array_close(void *s)
  requires [?f]heap_rest(?objs, ?H, s) &*& [f]header(s, o_hw(H(s))) &*&
           [f]byte_array_body(s, o_len(H(s)), o_aux(H(s))) &*& obj_facts(objs, H, s) == true &*&
           o_words(H(s)) == nil &*& mem(s, objs) == true &*& has_tag(H, s, BYTE_ARRAY_TAG) == true;
  ensures [f]heap(objs, H);
{
  close [f]body(s, 2 * BYTE_ARRAY_TAG, o_len(H(s)), o_aux(H(s)), o_number(H(s)), nil);
  heap_close(s);
}

lemma void blob_facts(void *b)
  requires [?f]heap(?objs, ?H) &*& mem(b, objs) == true &*& blob_ok(H, b, STRINGS_OR_BYTE_ARRAYS) == true;
  ensures [f]heap(objs, H) &*& 0 <= blob_len(H, b) &*& blob_len(H, b) <= MAX_BLOB &*&
          (uword)blob_base(H, b) + blob_len(H, b) <= UINTPTR_MAX &*&
          (is_external(H, b) ? true : blob_base(H, b) == (uint8 *)raw(b) + 2 * WORD_SIZE);
{
  if (has_tag(H, b, STRING_TAG)) {
    string_open(b);
    open [f]string_body(b, _, _);
    if (is_external(H, b)) {
      open [f]external_bytes(_, _);
      close [f]external_bytes(nth(1, o_aux(H(b))), o_len(H(b)));
    }
    close [f]string_body(b, o_len(H(b)), o_aux(H(b)));
    string_close(b);
  } else {
    byte_array_open(b);
    open [f]byte_array_body(b, _, _);
    if (is_external(H, b)) {
      open [f]external_bytes(_, _);
      close [f]external_bytes(head(o_aux(H(b))), -1 - o_len(H(b)));
    }
    close [f]byte_array_body(b, o_len(H(b)), o_aux(H(b)));
    byte_array_close(b);
  }
}

lemma void heap_holes_open()
  requires [?f]heap(?objs, ?H);
  ensures [f]heap_holes(objs, H, nil);
{
  open [f]heap(objs, H);
  close [f]heap_holes(objs, H, nil);
}

lemma void heap_holes_close()
  requires [?f]heap_holes(?objs, ?H, nil);
  ensures [f]heap(objs, H);
{
  open [f]heap_holes(objs, H, nil);
  close [f]heap(objs, H);
}

lemma void blob_take(void *b)
  requires [?f]heap_holes(?objs, ?H, ?hs) &*& mem(b, objs) == true &*& mem(b, hs) == false &*&
           blob_ok(H, b, STRINGS_OR_BYTE_ARRAYS) == true;
  ensures [f]heap_holes(objs, H, cons(b, hs)) &*& [f]blob_hole(objs, H, b) &*&
          [f]uchars(blob_base(H, b), blob_len(H, b), _);
{
  open [f]heap_holes(objs, H, hs);
  mem_remove_all(b, hs, objs);
  foreach_remove_frac(b, remove_all(hs, objs));
  open [f]heap_obj(objs, H)(b);
  open [f]body(b, _, _, _, _, _);
  if (has_tag(H, b, BYTE_ARRAY_TAG)) {
    open [f]byte_array_body(b, _, _);
    if (o_len(H(b)) < 0) open [f]external_bytes(_, _);
  } else {
    open [f]string_body(b, _, _);
    if (is_external(H, b)) open [f]external_bytes(_, _);
  }
  close [f]blob_shell(b, header_tag2(o_hw(H(b))), o_len(H(b)), o_aux(H(b)));
  close [f]blob_hole(objs, H, b);
  close [f]heap_holes(objs, H, cons(b, hs));
}

lemma void blob_give(void *b)
  requires [?f]heap_holes(?objs, ?H, cons(b, ?hs)) &*& mem(b, hs) == false &*& [f]blob_hole(objs, H, b) &*&
           [f]uchars(blob_base(H, b), blob_len(H, b), _);
  ensures [f]heap_holes(objs, H, hs);
{
  open [f]heap_holes(objs, H, cons(b, hs));
  open [f]blob_hole(objs, H, b);
  open [f]blob_shell(b, _, _, _);
  if (has_tag(H, b, BYTE_ARRAY_TAG)) {
    if (o_len(H(b)) < 0) close [f]external_bytes(head(o_aux(H(b))), -1 - o_len(H(b)));
    close [f]byte_array_body(b, o_len(H(b)), o_aux(H(b)));
  } else {
    if (is_external(H, b)) close [f]external_bytes(nth(1, o_aux(H(b))), o_len(H(b)));
    close [f]string_body(b, o_len(H(b)), o_aux(H(b)));
  }
  close [f]body(b, header_tag2(o_hw(H(b))), o_len(H(b)), o_aux(H(b)), o_number(H(b)), nil);
  close [f]heap_obj(objs, H)(b);
  mem_remove_all(b, hs, objs);
  foreach_unremove_frac(b, remove_all(hs, objs));
  close [f]heap_holes(objs, H, hs);
}

lemma void forall_kept_refl(list<void *> xs, fixpoint(void *, oinfo) H)
  requires true;
  ensures forall(xs, (kept)(H, H)) == true;
{
  switch (xs) { case nil: case cons(x, xs0): forall_kept_refl(xs0, H); }
}

lemma void grows_refl(list<void *> objs, fixpoint(void *, oinfo) H)
  requires true;
  ensures grows(objs, H, objs, H) == true;
{
  forall_kept_refl(objs, H);
}

lemma void forall_kept_trans(list<void *> xs, fixpoint(void *, oinfo) H, list<void *> objs2, fixpoint(void *, oinfo) H2, fixpoint(void *, oinfo) H3)
  requires forall(xs, (kept)(H, H2)) == true &*& subset(xs, objs2) == true &*& forall(objs2, (kept)(H2, H3)) == true;
  ensures forall(xs, (kept)(H, H3)) == true;
{
  switch (xs) {
    case nil:
    case cons(x, xs0):
      forall_mem(x, objs2, (kept)(H2, H3));
      forall_kept_trans(xs0, H, objs2, H2, H3);
  }
}

lemma void grows_trans(list<void *> objs, fixpoint(void *, oinfo) H, list<void *> objs2, fixpoint(void *, oinfo) H2, list<void *> objs3, fixpoint(void *, oinfo) H3)
  requires grows(objs, H, objs2, H2) == true &*& grows(objs2, H2, objs3, H3) == true;
  ensures grows(objs, H, objs3, H3) == true;
{
  subset_trans(objs, objs2, objs3);
  forall_kept_trans(objs, H, objs2, H2, H3);
}

lemma void forall_kept_put(list<void *> xs, fixpoint(void *, oinfo) H, void *o, int index, void *v)
  requires true;
  ensures forall(xs, (kept)(H, put_field(H, o, index, v))) == true;
{
  switch (xs) { case nil: case cons(x, xs0): forall_kept_put(xs0, H, o, index, v); }
}

lemma void grows_put_field(list<void *> objs, fixpoint(void *, oinfo) H, void *o, int index, void *v)
  requires true;
  ensures grows(objs, H, objs, put_field(H, o, index, v)) == true;
{
  forall_kept_put(objs, H, o, index, v);
}

lemma void forall_same_kept(list<void *> xs, fixpoint(void *, oinfo) H, fixpoint(void *, oinfo) H2)
  requires forall(xs, (same_obj)(H, H2)) == true;
  ensures forall(xs, (kept)(H, H2)) == true;
{
  switch (xs) { case nil: case cons(x, xs0): forall_same_kept(xs0, H, H2); }
}

lemma void grows_alloc(list<void *> objs, fixpoint(void *, oinfo) H, void *r, fixpoint(void *, oinfo) H2)
  requires forall(objs, (same_obj)(H, H2)) == true;
  ensures grows(objs, H, cons(r, objs), H2) == true;
{
  forall_same_kept(objs, H, H2);
  subset_cons(r, objs);
}

lemma void blob_result_grows(list<void *> objs, fixpoint(void *, oinfo) H, list<void *> objs2, fixpoint(void *, oinfo) H2, int kind, uint8 *a, int l, void *b)
  requires [_]blob_result(objs, H, kind, a, l, b) &*& grows(objs, H, objs2, H2) == true;
  ensures [_]blob_result(objs2, H2, kind, a, l, b);
{
  open [_]blob_result(objs, H, kind, a, l, b);
  forall_mem(b, objs, (kept)(H, H2));
  mem_subset(b, objs, objs2);
  close blob_result(objs2, H2, kind, a, l, b); leak blob_result(objs2, H2, kind, a, l, b);
}

lemma void same_obj_kept(list<void *> objs, fixpoint(void *, oinfo) H, fixpoint(void *, oinfo) H2, void *o)
  requires forall(objs, (same_obj)(H, H2)) == true &*& mem(o, objs) == true;
  ensures H2(o) == H(o);
{
  forall_mem(o, objs, (same_obj)(H, H2));
}

// The other objects after a field write: unchanged.
lemma void heap_rest_put(list<void *> xs, list<void *> objs, fixpoint(void *, oinfo) H, void *o, int index, void *v)
  requires foreach(xs, heap_obj(objs, H)) &*& mem(o, xs) == false;
  ensures foreach(xs, heap_obj(objs, put_field(H, o, index, v)));
{
  open foreach(xs, _);
  switch (xs) {
    case nil:
      close foreach(nil, heap_obj(objs, put_field(H, o, index, v)));
    case cons(x, xs0):
      open heap_obj(objs, H)(x);
      close heap_obj(objs, put_field(H, o, index, v))(x);
      heap_rest_put(xs0, objs, H, o, index, v);
      close foreach(xs, heap_obj(objs, put_field(H, o, index, v)));
  }
}

lemma void forall_good_update(list<void *> ws, list<void *> objs, int i, void *v)
  requires forall(ws, (good)(objs)) == true &*& good(objs, v) == true;
  ensures forall(update(i, v, ws), (good)(objs)) == true;
{
  switch (ws) { case nil: case cons(w, ws0): if (i != 0) forall_good_update(ws0, objs, i - 1, v); }
}

lemma void update_take_drop<t>(list<t> ps, int i, t v)
  requires 0 <= i &*& i < length(ps);
  ensures append(take(i, ps), cons(v, drop(i + 1, ps))) == update(i, v, ps);
{
  switch (ps) {
    case nil:
    case cons(p, ps0):
      if (i > 0) update_take_drop(ps0, i - 1, v);
  }
}

lemma void pointers_focus(void **base, int i)
  requires [?f]pointers(base, ?n, ?ps) &*& 0 <= i &*& i < n;
  ensures [f]pointers(base, i, take(i, ps)) &*& [f]pointer(base + i, nth(i, ps)) &*&
          [f]pointers(base + i + 1, n - i - 1, drop(i + 1, ps));
{
  pointers_split(base, i);
  open [f]pointers(base + i, n - i, drop(i, ps));
  drop_n_plus_one(i, ps);
}

lemma void pointers_unfocus(void **base, int i, list<void *> ps)
  requires [?f]pointers(base, i, take(i, ps)) &*& [f]pointer(base + i, ?v) &*&
           [f]pointers(base + i + 1, ?m, drop(i + 1, ps)) &*& 0 <= i &*& i < length(ps);
  ensures [f]pointers(base, i + 1 + m, update(i, v, ps));
{
  close [f]pointers(base + i, m + 1, cons(v, drop(i + 1, ps)));
  pointers_join(base);
  update_take_drop(ps, i, v);
}

@*/

@render src/objects.h toit::is_smi tu=src/objects.cc
inline bool is_smi(const Object* o)
//@ requires true;
//@ ensures result == is_smi_w((uword)o);
//@ terminates;
{
  //@ bitand_pow_nat((uword)o, N1);
  return (reinterpret_cast<uword>(o) & Object::SMI_TAG_MASK) == Object::SMI_TAG;
}

@render src/objects.h toit::is_heap_object tu=src/objects.cc
inline bool is_heap_object(const Object* o)
//@ requires true;
//@ ensures result == is_heap_w((uword)o);
//@ terminates;
{
  //@ bitand_pow_nat((uword)o, N2);
  return (reinterpret_cast<uword>(o) & Object::NON_SMI_TAG_MASK) == Object::HEAP_TAG;
}

