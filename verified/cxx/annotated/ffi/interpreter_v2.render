@render src/interpreter_v2.cc v2_report_allocation_failure trusted
static void v2_report_allocation_failure(Process* process, const char* reason, word parameter1, word parameter2)
//@ requires true;
//@ ensures allocation_reported(process, (char *)reason, parameter1, parameter2);
{
  static const int BUFFER_SIZE = 50;
  char buffer[BUFFER_SIZE];
  snprintf(buffer, BUFFER_SIZE, "out of memory in %s %" PRIdPTR ":%" PRIdPTR,
           reason, parameter1, parameter2);
  buffer[BUFFER_SIZE - 1] = '\0';
  OS::heap_summary_report(0, buffer, process);
  if (VM::current()->scheduler()->is_boot_process(process)) {
    OS::out_of_memory("Out of memory in system process");
  }
}

@render src/interpreter_v2.cc v2_gc
static void v2_gc(Process* process, bool malloc_failed, int attempts, bool force_cross_process,
                  const char* reason, word parameter1 = 0, word parameter2 = 0)
// Under the scheduler collection contract, the current task's stack
// may be another (moved) object, possibly shrunk, with the same records,
// header fields and used slots, every root rewritten; the heap's objects
// moved. At most one collection of the process's heap (Process::gc), which
// moves the epoch; when the epoch did not move, nothing did (attempt 3
// only reports).
//@ requires vm(process, ?a, ?n);
/*@ ensures vm(process, ?b, ?n2) &*& n <= n2 &*& n2 <= n + GC_EPOCHS &*& same_frames(a, b) == true &*&
            (n2 == n ? b == a : gc_equiv(a, b) == true) &*& (attempts == 3 ? b == a && n2 == n : true) &*&
            gc_action(process, attempts, malloc_failed, force_cross_process, (char *)reason, parameter1, parameter2); @*/
{
  if (attempts == 3) {
    v2_report_allocation_failure(process, reason, parameter1, parameter2);
    //@ switch (a) { case vmv(st,l,t,rt,ft,fin,bci,bs,os,H): }
    //@ close gc_action(process, attempts, malloc_failed, force_cross_process, (char *)reason, parameter1, parameter2);
    return;
  }
  //@ open vm(process, a, n);
  GcMetadata::insert_into_remembered_set(process->task()->stack());
  //@ close vm(process, a, n);
  v2_validate(process, "gc");
  VM::current()->scheduler()->gc(process, malloc_failed, attempts > 1 || force_cross_process);
  v2_validate(process, "after gc");
  //@ close gc_action(process, attempts, malloc_failed, force_cross_process, (char *)reason, parameter1, parameter2);
}

@render src/objects_runtime.cc toit::Stack::v2_copy_to
void Stack::v2_copy_to(Stack* other)
/*@ requires stack(self, ?len, ?top, ?rtop, ?ft, ?fin, ?bci, ?bs) &*& stack_ok(len, top, rtop, bs) == true &*&
             fresh_stack(other, ?olen) &*&
             olen <= STACK_MAX_BOUND &*& olen >= (len - top) + rtop; @*/
/*@ ensures stack(self, len, top, rtop, ft, fin, bci, bs) &*&
            stack(other, olen, ?otop, rtop, ft, fin, bci, ?obs2) &*& stack_ok(olen, otop, rtop, obs2) == true &*&
            same_abstraction(len, top, rtop, bs, olen, otop, rtop, obs2) == true; @*/
{
  //@ open stack(self, len, top, rtop, ft, fin, bci, bs);
  //@ open fresh_stack(other, olen);
  word used = length() - top();
  word records = v2_record_top();
  ASSERT(other->length() >= used + records);
  word displacement = other->length() - length();
  //@ int W = sizeof(word);
  //@ uint8 *sa = stack_array(self);
  //@ uint8 *oa = stack_array(other);
  //@ assert uchars(sa, records * W, ?o1);
  //@ assert uchars(sa + records * W, (top - records) * W, ?oldgap);
  //@ assert uchars(sa + top * W, (len - top) * W, ?o3);
  //@ uchars_split(oa, (top + displacement) * W);
  //@ uchars_split(oa, records * W);
  //@ assert uchars(oa + records * W, (top + displacement - records) * W, ?newgap);
  memcpy(other->_array_address(0), _array_address(0), records * WORD_SIZE);
  memcpy(other->_array_address(top() + displacement), _array_address(top()), used * WORD_SIZE);
  other->_set_top(displacement + top());
  other->v2_set_records(v2_frame_top(), v2_fin_count(), v2_bci());
  GcMetadata::insert_into_remembered_set(other);
  //@ leak remembered_stack(_);
  //@ take_append_bytes(o1, oldgap, o3, records * W);
  //@ drop_append_bytes(o1, oldgap, o3, top * W);
  //@ take_append_bytes(o1, newgap, o3, records * W);
  //@ drop_append_bytes(o1, newgap, o3, (top + displacement) * W);
  //@ close stack(self, len, top, rtop, ft, fin, bci, bs);
}

@render src/interpreter_v2.cc toit_v2_grow_stack
uword toit_v2_grow_stack(void* raw_process, uword needed)
//@ requires vm((Process *)raw_process, ?a, ?n);
/*@ ensures vm((Process *)raw_process, ?b, ?n2) &*& vm_equiv(a, b) == true &*& n <= n2 &*&
            (result == TOIT_V2_OK ? v_top(b) - v_rtop(b) >= needed :
             result == TOIT_V2_STACK_OVERFLOW || result == TOIT_V2_OUT_OF_MEMORY); @*/
{
  Process* process = v2_process(raw_process);
  // More free words than the longest stack has: an overflow (checked here, so
  // that the casts to `word` below never see a value of 2^(WORD_BITS-1) or
  // more; the core passes less than 2^20, GROW_STACK_MAX_NEEDED in
  // verified/core/src/layout.rs).
  if (needed > static_cast<uword>(Stack::max_length())) return TOIT_V2_STACK_OVERFLOW;
  //@ open vm(process, a, n);
  //@ assert current_stack(process, _, ?s) &*& stack(s, ?len, ?top, ?rtop, ?ft, ?fin, ?bci, ?bs);
  Stack* stack = process->task()->stack();
  // The core has written into the stack since it was last remembered. The
  // old stack becomes garbage, but the collector still scans it whenever
  // its card is dirty (old space is swept, not traced, between scavenges),
  // so its new-space pointers must stay up to date: remember it now, as
  // Interpreter::store_stack does for format 1.
  GcMetadata::insert_into_remembered_set(stack);
  //@ leak remembered_stack(_);
  //@ open stack(s, len, top, rtop, ft, fin, bci, bs);
  word length = stack->length();
  word free = stack->top() - stack->v2_record_top();
  //@ close stack(s, len, top, rtop, ft, fin, bci, bs);
  //@ close vm(process, a, n);
  word new_length = -1;
  if (length < Stack::max_length()) {
    //@ shiftright_1(length);
    //@ div_rem_nonneg(length, 2);
    new_length = Utils::max(length + (length >> 1), (length - free) + static_cast<word>(needed));
    new_length = Utils::min(Stack::max_length(), new_length);
    if (free + (new_length - length) < static_cast<word>(needed)) new_length = -1;
  }
  if (new_length < 0) return TOIT_V2_STACK_OVERFLOW;
  Stack* new_stack = process->object_heap()->allocate_stack(new_length);
  for (int attempts = 1; new_stack == null && attempts < 4; attempts++)
  /*@ invariant vm(process, ?c, ?nc) &*& vm_equiv(a, c) == true &*& same_frames(a, c) == true &*& n <= nc &*&
                (new_stack == 0 ? true : fresh_stack(new_stack, new_length)) &*&
                1 <= attempts; @*/
  {
    v2_gc(process, false, attempts, false, "'stack grow'", length, new_length);
    //@ leak gc_action(_, _, _, _, _, _, _);
    //@ assert vm(process, ?c2, ?nc2);
    //@ vm_equiv_trans(a, c, c2);
    //@ same_frames_trans(a, c, c2);
    new_stack = process->object_heap()->allocate_stack(new_length);
  }
  process->object_heap()->leave_primitive();
  if (new_stack == null) return TOIT_V2_OUT_OF_MEMORY;
  // The GC may have moved or shrunk the old stack.
  //@ assert vm(process, ?c, ?nc);
  //@ open vm(process, c, nc);
  //@ assert current_stack(process, _, ?sc) &*& stack(sc, ?lenc, ?topc, rtop, ft, fin, bci, ?bsc) &*& heap(?objsc, ?Hc);
  stack = process->task()->stack();
  stack->v2_copy_to(new_stack);
  //@ assert stack(new_stack, new_length, ?top3, rtop, ft, fin, bci, ?bs3);
  process->task()->set_stack(new_stack);
  //@ leak remembered_instance(_);
  // The old stack is now eligible for collection.
  //@ leak stack(sc, _, _, _, _, _, _, _);
  //@ stack_copy_equiv(c, new_stack, new_length, top3, bs3);
  //@ vm_equiv_trans(a, c, vmv(new_stack, new_length, top3, rtop, ft, fin, bci, bs3, objsc, Hc));
  //@ close vm(process, vmv(new_stack, new_length, top3, rtop, ft, fin, bci, bs3, objsc, Hc), nc);
  return TOIT_V2_OK;
}

@render src/interpreter_v2.cc toit_v2_current_stack
uword toit_v2_current_stack(void* process)
//@ requires [?f]current_stack((Process *)process, ?t, ?s);
//@ ensures [f]current_stack((Process *)process, t, s) &*& result == (uword)s;
{
  return reinterpret_cast<uword>(v2_process(process)->task()->stack());
}

@render src/interpreter_v2.cc v2_allocate lambda=toit_v2_allocate_instance
static uword v2_allocate(Process* process, const char* reason, F allocate)
/*@ requires [?fc]allocate->process |-> process &*& [fc]allocate->class_id |-> ?c &*& [?fp]process(process, ?prog, ?ids) &*&
             vm(process, ?a, ?n) &*& c < MAX_CLASS_IDS &*& class_tag(c) == INSTANCE_TAG; @*/
/*@ ensures [fc]allocate->process |-> process &*& [fc]allocate->class_id |-> c &*& [fp]process(process, prog, ids) &*&
            vm(process, ?b, ?n2) &*& alloc_post(process, a, n, b, n2, ?r, ?objsm, ?Hm) &*& result == (uword)r &*&
            (r == 0 ? true : instance_new(v_H(b), r, c) == true); @*/
{
  //@ open vm(process, a, n);
  //@ assert heap(?objs0, ?H0);
  HW_PERF_SCOPE(HWP_ALLOC);
  HeapObject* result = allocate();
  //@ open allocated(objs0, H0, process, result, ?objs1, ?H1);
  //@ if (result != 0) heap_facts(result);
  //@ close vm(process, with_heap(a, objs1, H1), n);
  //@ with_heap_twice(a, objs1, H1, objs0, H0);
  //@ with_heap_id(a);
  //@ close alloc_post(process, a, n, with_heap(a, objs1, H1), n, result, objs0, H0);
  for (int attempts = 1; result == null && attempts < 4; attempts++)
  /*@ invariant [fc]allocate->process |-> process &*& [fc]allocate->class_id |-> c &*& [fp]process(process, prog, ids) &*&
                vm(process, ?b, ?nb) &*& alloc_post(process, a, n, b, nb, result, ?objsm, ?Hm) &*&
                1 <= attempts &*& attempts <= 4 &*& nb <= n + (attempts - 1) * GC_EPOCHS &*&
                (result == 0 ? true : instance_new(v_H(b), result, c) == true); @*/
  {
    //@ open alloc_post(process, a, n, b, nb, result, objsm, Hm);
    //@ with_heap_id(b);
    v2_gc(process, false, attempts, false, reason);
    //@ leak gc_action(_, _, _, _, _, _, _);
    //@ assert vm(process, ?b2, ?nb2);
    //@ vm_equiv_trans(a, b, b2);
    //@ same_frames_trans(a, b, b2);
    //@ open vm(process, b2, nb2);
    //@ assert heap(?objs3, ?H3);
    result = allocate();
    //@ open allocated(objs3, H3, process, result, ?objs4, ?H4);
    //@ if (result != 0) heap_facts(result);
    //@ close vm(process, with_heap(b2, objs4, H4), nb2);
    //@ with_heap_twice(b2, objs4, H4, objs3, H3);
    //@ with_heap_id(b2);
    //@ same_frames_trans(a, b2, with_heap(b2, objs4, H4));
    //@ if (epoch_word(nb2) == epoch_word(n)) epoch_unchanged(n, nb2);
    //@ close alloc_post(process, a, n, with_heap(b2, objs4, H4), nb2, result, objs3, H3);
  }
  process->object_heap()->leave_primitive();
  return reinterpret_cast<uword>(result);
}

@render src/interpreter_v2.cc toit_v2_allocate_instance
uword toit_v2_allocate_instance(void* raw_process, uword class_id)
/*@ requires [?fp]process((Process *)raw_process, ?prog, ?ids) &*& vm((Process *)raw_process, ?a, ?n) &*&
             class_id < MAX_CLASS_IDS &*& class_tag(class_id) == INSTANCE_TAG; @*/
/*@ ensures [fp]process((Process *)raw_process, prog, ids) &*& vm((Process *)raw_process, ?b, ?n2) &*&
            alloc_post((Process *)raw_process, a, n, b, n2, ?r, ?objsm, ?Hm) &*& result == (uword)r &*&
            (r == 0 ? true : instance_new(v_H(b), r, class_id) == true); @*/
{
  Process* process = v2_process(raw_process);
  return v2_allocate(process, "'allocate instance'", [&]() -> HeapObject*
  /*@ requires [?fc]closure->process |-> ?p &*& [fc]closure->class_id |-> ?c &*& [?fp]process(p, ?prog, ?ids) &*& heap(?objs, ?H) &*&
               c < MAX_CLASS_IDS &*& class_tag(c) == INSTANCE_TAG; @*/
  /*@ ensures [fc]closure->process |-> p &*& [fc]closure->class_id |-> c &*& [fp]process(p, prog, ids) &*&
              allocated(objs, H, p, result, ?objs2, ?H2) &*& (result == 0 ? true : instance_new(H2, result, c) == true); @*/
  {
    return process->object_heap()->allocate_instance(Smi::from(class_id));
  });
}

@render src/interpreter_v2.cc v2_allocate lambda=toit_v2_allocate_double
static uword v2_allocate(Process* process, const char* reason, F allocate)
/*@ requires [?fc]allocate->process |-> process &*& [fc]allocate->value |-> ?v &*& [?fp]process(process, ?prog, ?ids) &*&
             vm(process, ?a, ?n); @*/
/*@ ensures [fc]allocate->process |-> process &*& [fc]allocate->value |-> v &*& [fp]process(process, prog, ids) &*&
            vm(process, ?b, ?n2) &*& alloc_post(process, a, n, b, n2, ?r, ?objsm, ?Hm) &*& result == (uword)r &*&
            (r == 0 ? true : has_tag(v_H(b), r, DOUBLE_TAG) == true); @*/
{
  //@ open vm(process, a, n);
