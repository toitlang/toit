// Copyright (C) 2026 Toit contributors.
//
// The C++ side of the boundary between the verified core (Rust/Verus) and
// the VM (src/interpreter_v2.cc): the functions the core calls that may
// collect garbage (toit_v2_grow_stack, toit_v2_allocate_instance,
// toit_v2_allocate_double, toit_v2_allocate_array, toit_v2_primitive with
// its retry protocol), the allocation without a GC of the Rust primitives
// (toit_v2_try_allocate_*), and toit_v2_current_stack, rendered from the
// sources against the leaf contracts the Verus proof assumes
// (verified/CONTRACTS.toml: both sides of each pair are checked).
//
// The VM state at a GC point is `vm(p, v, n)`: the current task's stack
// (the object, its header fields, the array's bytes), the heap and the
// epoch counter `n` (ObjectHeap::v2_epoch_ is n modulo the word). Two such
// states represent the same state of the spec when `vm_equiv` (the GC
// preserves that; a stack copied with the same observables too). Trusted
// (contracts below, each still compared with the sources): the GC
// (Scheduler::gc), the allocator, the policy
// table and the primitives' contract (a function
// pointer type), the write barrier. Verified: the retry loops (at most
// three collections: a changed epoch cannot return to its initial word), the bound checks before the
// allocator and before the conversions, the arity check before a
// primitive reads its arguments, the stack re-read after a GC, the copies
// of stack growth, and the epoch accounting the core relies on (an
// unchanged epoch word means nothing moved).
@include ../model/model.cfg
@verbatim
#include "../model/objects.gen.h"
//@ #include "../model/arith.gh"
// Verify the native field accessors here with ownership of one field and
// require the barrier before publishing a pointer. The shared model also
// verifies those bodies with ownership of a whole instance.
#define Instance_at Instance_at_field
#define Instance_at_put__word_Objectp Instance_at_put_field
#define HeapObject__at_put HeapObject_store_remembered_field

typedef struct Object Stack;
typedef struct Object Task;
typedef unsigned long size_t;
// The native process-epoch and current-task checks use the full C++ layout.
//@ inductive epoch_count = epoch_count(int);
struct ObjectHeap {
  Task *task_;
  uword v2_epoch_;
  //@ epoch_count history;
};

// Stack::max_length() = (ObjectHeap::max_allocation_size() - HEADER_SIZE) /
// WORD_SIZE: a few thousand words (pages of 32 KB on the host, 4 KB on
// devices); a generous upper bound here.
#define STACK_MAX_BOUND 0x100000
// The epoch increments of one GC call (v2_gc: Process::gc, one
// ObjectHeap::gc) and of one primitive call (a task switch,
// ObjectHeap::set_task; no primitive collects: TRUSTED.md, Epoch).
#define GC_EPOCHS 1
#define PRIM_EPOCHS 2

/*@
// A Stack object: length, top, record top, the header fields the core
// keeps (frame top, finally count, bci), and the array as bytes.
predicate stack_hdr(Stack *s; int len, int top, int rtop, int ftop, int fin, int bci) =
  1 <= (uword)s &*&
  uintptr(raw(s) + 2, ?l) &*& uintptr(raw(s) + 3, ?t) &*&
  len == l &*& top == t &*& 0 <= top &*& top <= len &*& len <= STACK_MAX_BOUND &*&
  (uword)s - 1 + Stack_HEADER_SIZE + len * sizeof(word) <= UINTPTR_MAX &*&
  uintptr(raw(s) + 4, ?records) &*& 0 <= records &*& records <= UINTPTR_MAX &*&
  rtop == records % Stack_V2_MAX_LENGTH &*& ftop == records / Stack_V2_MAX_LENGTH &*&
  fin == (rtop - ftop) / Stack_V2_FIN_WORDS &*&
  uintptr(raw(s) + 5, ?bits) &*& bci == truncate_signed(bits, 8 * sizeof(word) - 1);
fixpoint uint8 *stack_array(Stack *s) { return (uint8 *)((uword)s - 1 + Stack_HEADER_SIZE); }
fixpoint int stack_max_length() { return (TOIT_PAGE_SIZE - 96 - Stack_HEADER_SIZE) / sizeof(word); }
// Reading back a signed bytecode index stored as an unsigned machine word.
lemma void signed_word_bits(Z z, nat n)
  requires 0 <= int_of_Z(z) &*& int_of_Z(z) < 2 * pow_nat(2,n);
  ensures int_of_Z(Z_truncate_signed(z,n)) ==
    (int_of_Z(z) < pow_nat(2,n) ? int_of_Z(z) : int_of_Z(z) - 2 * pow_nat(2,n));
{
  switch (n) {
    case zero:
      switch (z) { case Zsign(b): case Zdigit(high,low): }
    case succ(k):
      pow2_pos(k);
      switch (z) {
        case Zsign(b): signed_word_bits(z,k);
        case Zdigit(high,low): signed_word_bits(high,k);
      }
  }
}

lemma void signed_word_roundtrip(int x, nat n)
  requires -pow_nat(2,n) <= x &*& x < pow_nat(2,n);
  ensures truncate_signed(truncate_unsigned(x,int_of_nat(succ(n))),int_of_nat(n)) == x;
{
  int modulus = 2 * pow_nat(2,n);
  int bits = x < 0 ? x + modulus : x;
  divrem_intro(x,modulus,x < 0 ? -1 : 0,bits);
  truncate_unsigned_def(x,succ(n));
  Z z = int_of_Z_of_uintN(bits,succ(n));
  signed_word_bits(z,n);
  truncate_signed_def(bits,z,n);
}
// Stack::V2_FIN_WORDS and the native accessor round trip are checked by stack-records.
predicate records_of(int ftop, int fin; int rtop) =
  rtop == ftop + Stack_V2_FIN_WORDS * fin &*& 0 <= ftop &*& 0 <= fin &*& rtop <= stack_max_length();
// The format-2 allocator initializes every slot before Rust constructs StackMem.
predicate fresh_stack(Stack *s; int len) =
  stack_hdr(s, len, _, _, _, _, _) &*& uchars(stack_array(s), len * sizeof(word), _);
predicate stack(Stack *s; int len, int top, int rtop, int ftop, int fin, int bci, list<uint8> bs) =
  stack_hdr(s, len, top, rtop, ftop, fin, bci) &*&
  uchars(stack_array(s), rtop * sizeof(word), ?prefix) &*&
  uchars(stack_array(s) + rtop * sizeof(word), (top - rtop) * sizeof(word), ?gap) &*&
  uchars(stack_array(s) + top * sizeof(word), (len - top) * sizeof(word), ?suffix) &*&
  bs == append(prefix, append(gap, suffix)) &*&
  [_]records_of(ftop, fin, rtop);

// The current task's stack, and the process's task (an Instance).
// Both addresses can change at a GC point or a task switch.
predicate task_stack_field(Task *task; Stack *s) =
  1 <= (uword)task &*& pointer((void **)raw(task) + 1 + Task_STACK_INDEX, s);
predicate current_stack(Process *p; Task *task, Stack *s) =
  ObjectHeap_task_(process_heap_address(p), task) &*& task_stack_field(task, s);

// The observables of a stack the core relies on: same records, header
// fields and used slots (by position from the end).
fixpoint bool same_abstraction(int len, int top, int rtop, list<uint8> bs,
                               int len2, int top2, int rtop2, list<uint8> bs2) {
  return rtop2 == rtop && len2 - top2 == len - top &&
         take(rtop * sizeof(word), bs2) == take(rtop * sizeof(word), bs) &&
         drop(top2 * sizeof(word), bs2) == drop(top * sizeof(word), bs);
}

fixpoint bool stack_ok(int len, int top, int rtop, list<uint8> bs) {
  return 0 <= rtop && rtop <= top && top <= len && len <= STACK_MAX_BOUND &&
         length(bs) == len * sizeof(word);
}

// ---------------------------------------------------------------------------
// The VM state at a GC point: the current stack, its header fields and
// bytes, the heap.
inductive vmv = vmv(Stack *s, int len, int top, int rtop, int ft, int fin, int bci, list<uint8> bs,
                    list<void *> objs, fixpoint(void *, oinfo) H);
fixpoint Stack *v_s(vmv v) { switch (v) { case vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H): return s; } }
fixpoint int v_len(vmv v) { switch (v) { case vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H): return len; } }
fixpoint int v_top(vmv v) { switch (v) { case vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H): return top; } }
fixpoint int v_rtop(vmv v) { switch (v) { case vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H): return rtop; } }
fixpoint list<void *> v_objs(vmv v) { switch (v) { case vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H): return objs; } }
fixpoint fixpoint(void *, oinfo) v_H(vmv v) { switch (v) { case vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H): return H; } }
fixpoint vmv with_heap(vmv v, list<void *> objs2, fixpoint(void *, oinfo) H2) {
  switch (v) { case vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H): return vmv(s, len, top, rtop, ft, fin, bci, bs, objs2, H2); }
}
// The records and header fields the GC keeps, the height of the object
// stack (by position from the end).
fixpoint bool same_frames(vmv a, vmv b) {
  switch (a) { case vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H):
    return switch (b) { case vmv(s2, len2, top2, rtop2, ft2, fin2, bci2, bs2, objs2, H2):
      return rtop2 == rtop && ft2 == ft && fin2 == fin && bci2 == bci && len2 - top2 == len - top; }; }
}
// The stack the core keeps across a call that did not change the epoch:
// the same object, header fields and bytes (the heap may have grown).
fixpoint bool same_stack(vmv a, vmv b) { return with_heap(b, v_objs(a), v_H(a)) == a; }

// The epoch: ObjectHeap::v2_epoch_ is `epoch_word(n)`; n counts the
// collections of the process's heap and its task switches.
fixpoint int epoch_word(int n) { return n % (UINTPTR_MAX + 1); }
predicate heap_epoch(ObjectHeap *h; int n) =
  h->history |-> epoch_count(n) &*& 0 <= n &*& h->v2_epoch_ |-> epoch_word(n);
predicate epoch(Process *p; int n) = heap_epoch(process_heap_address(p), n);

lemma void init_heap_epoch(ObjectHeap *h)
  requires h->history |-> _ &*& h->v2_epoch_ |-> 0;
  ensures heap_epoch(h, 0);
{
  h->history = epoch_count(0);
  close heap_epoch(h, 0);
}

// The loaded program has the TBC2 bytecode header throughout this process.
fixpoint bool format2_heap(ObjectHeap *h);
predicate vm(Process *p, vmv v, int n) =
  format2_heap(process_heap_address(p)) == true &*&
  current_stack(p, _, ?s) &*& stack(s, ?len, ?top, ?rtop, ?ft, ?fin, ?bci, ?bs) &*& stack_ok(len, top, rtop, bs) == true &*&
  heap(?objs, ?H) &*& epoch(p, n) &*& 0 <= n &*&
  v == vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H);

// Two VM states represent the same state of the spec (the bridges
// `stack` and `heap` of CONTRACTS.toml): equal, or related by the GC
// (objects moved, every root rewritten; `gc_equiv` is what v2_gc
// guarantees, an uninterpreted relation).
fixpoint bool gc_equiv(vmv a, vmv b);
fixpoint bool vm_equiv(vmv a, vmv b) { return a == b || gc_equiv(a, b); }

// What a primitive's call leaves (CONTRACTS.toml, gc_call_primitive): the
// state b and the result r are a completion of primitive fn's step on a
// (the spec's prim_call_post); uninterpreted.
fixpoint bool prim_out(void *fn, vmv a, vmv b, Object *r);
// The number of arguments primitive fn reads.
fixpoint int prim_arity(void *fn);

// The object-stack position (from the bottom) of a primitive's first
// argument (carried from the caller: C has no ghost parameters).
predicate prim_frame(int first) = true;

// is_marked, unmarked, oom_error, other_error: model/objects.render.

// The postcondition of an allocation that may collect: the state before
// the allocation (`with_heap(b, objsm, Hm)`) is a's after the GCs, at
// most three, so an unchanged epoch word means none moved anything; the
// allocation appended r (or nothing).
predicate alloc_post(Process *p, vmv a, int n, vmv b, int n2, void *r, list<void *> objsm, fixpoint(void *, oinfo) Hm) =
  vm_equiv(a, with_heap(b, objsm, Hm)) == true &*& same_frames(a, b) == true &*& n <= n2 &*& n2 <= n + 3 * GC_EPOCHS &*&
  (epoch_word(n2) == epoch_word(n) ? with_heap(b, objsm, Hm) == a : true) &*&
  (r == 0 ? objsm == v_objs(b) &*& Hm == v_H(b) :
     v_objs(b) == cons(r, objsm) &*& mem(r, objsm) == false &*&
     forall(objsm, (same_obj)(Hm, v_H(b))) == true &*& in_program_heap(p, r) == false);

lemma void drop_append_one(list<uint8> b, list<uint8> c, int n)
  requires n == length(b);
  ensures drop(n, append(b, c)) == c;
{
  switch (b) {
    case nil:
    case cons(y, b0): drop_append_one(b0, c, n - 1);
  }
}

lemma void drop_append_bytes(list<uint8> a, list<uint8> b, list<uint8> c, int n)
  requires n == length(a) + length(b);
  ensures drop(n, append(a, append(b, c))) == c;
{
  switch (a) {
    case nil: drop_append_one(b, c, n);
    case cons(x, a0): drop_append_bytes(a0, b, c, n - 1);
  }
}

lemma void take_append_bytes(list<uint8> a, list<uint8> b, list<uint8> c, int n)
  requires n == length(a);
  ensures take(n, append(a, append(b, c))) == a;
{
  switch (a) {
    case nil:
    case cons(x, a0): take_append_bytes(a0, b, c, n - 1);
  }
}

// The epoch moves forward by less than the word's range in one call of
// the core: an unchanged epoch word is an unchanged count.
lemma void epoch_unchanged(int n, int n2)
  requires 0 <= n &*& n <= n2 &*& n2 - n <= UINTPTR_MAX &*& epoch_word(n2) == epoch_word(n);
  ensures n2 == n;
{
  div_rem_nonneg(n, UINTPTR_MAX + 1);
  div_rem_nonneg(n2, UINTPTR_MAX + 1);
  if (n2 / (UINTPTR_MAX + 1) > n / (UINTPTR_MAX + 1)) {
    mul_mono_l(n / (UINTPTR_MAX + 1) + 1, n2 / (UINTPTR_MAX + 1), UINTPTR_MAX + 1);
  }
}
@*/

// The GC's side (TRUSTED: GC-class code). Each is an assumption of
// CONTRACTS.toml ([[assumption]]).
/*@
// The GC's relation composes (a collection of an equivalent state).
lemma void gc_equiv_trans(vmv a, vmv b, vmv c);
  requires gc_equiv(a, b) == true &*& gc_equiv(b, c) == true;
  ensures gc_equiv(a, c) == true;

// A stack copied with the same observables (same_abstraction) represents
// the same state: the `stack` bridge (the core re-derives everything from
// these observables; which object holds them is not one).
lemma void stack_copy_equiv(vmv a, Stack *s2, int len2, int top2, list<uint8> bs2);
  requires a == vmv(?s, ?len, ?top, ?rtop, ?ft, ?fin, ?bci, ?bs, ?objs, ?H) &*&
           same_abstraction(len, top, rtop, bs, len2, top2, rtop, bs2) == true;
  ensures vm_equiv(a, vmv(s2, len2, top2, rtop, ft, fin, bci, bs2, objs, H)) == true;

// The retry protocol of the C++ primitives: a call that failed for want
// of memory has no effect the spec sees, so the call after the GC
// completes the original step. (Each primitive must allocate before it
// changes anything visible; TRUSTED.md section 8.)
lemma void prim_retry(Program *prog, void *fn, vmv a, vmv b, Object *e, vmv b2, vmv c, Object *r);
  requires prim_out(fn, a, b, e) == true &*& oom_error(prog, e) == true &*& vm_equiv(b, b2) == true &*& prim_out(fn, b2, c, r) == true;
  ensures prim_out(fn, a, c, r) == true;

lemma void vm_equiv_trans(vmv a, vmv b, vmv c)
  requires vm_equiv(a, b) == true &*& vm_equiv(b, c) == true;
  ensures vm_equiv(a, c) == true;
{
  if (a != b && b != c) gc_equiv_trans(a, b, c);
}

lemma void same_frames_trans(vmv a, vmv b, vmv c)
  requires same_frames(a, b) == true &*& same_frames(b, c) == true;
  ensures same_frames(a, c) == true;
{
  switch (a) { case vmv(s, len, top, rtop, ft, fin, bci, bs, objs, H):
    switch (b) { case vmv(s2, len2, top2, rtop2, ft2, fin2, bci2, bs2, objs2, H2):
      switch (c) { case vmv(s3, len3, top3, rtop3, ft3, fin3, bci3, bs3, objs3, H3): } } }
}
