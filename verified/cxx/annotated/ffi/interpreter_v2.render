// The C++ primitives (TRUSTED.md section 8: each satisfies this, the
// default contract of the spec's PRIMITIVE): on a state a whose object
// stack holds its arguments, the primitive leaves a state b and a result
// that are a completion of its step (prim_out); it may switch the task
// (at most PRIM_EPOCHS epoch steps, no collection); an unchanged epoch
// means the stack is untouched; a call that fails for want of memory
// switched no task and left the stack alone (the retry protocol needs
// it, with prim_retry).
typedef Object *Primitive_Entry(Process *process, Object **arguments);
/*@ requires [?fp]process(process, ?prog, ?ids) &*& vm(process, ?a, ?n) &*& prim_frame(?first) &*& remembered_stack(v_s(a)) &*&
             0 <= first &*& first + prim_arity((void *)this) <= v_len(a) - v_top(a) &*&
             (void *)arguments == stack_array(v_s(a)) + (v_len(a) - 1 - first) * sizeof(word); @*/
/*@ ensures [fp]process(process, prog, ids) &*& vm(process, ?b, ?n2) &*& n <= n2 &*& n2 <= n + PRIM_EPOCHS &*&
            prim_out((void *)this, a, b, result) == true &*&
            (n2 == n || oom_error(prog, result) ? n2 == n &*& same_stack(a, b) == true : true); @*/

// The policy table of the process (src/primitive_policy.h,
// PrimitivePolicy::at): null when the module or index is out of the
// table, else an entry whose arity is the number of arguments its
// function reads (the tables are made from the PRIMITIVE macros' arities;
// a denied primitive keeps the arity, TRUSTED.md section 7,
// `core_arities`).
struct PrimitivePolicy;
typedef struct PrimitivePolicy PrimitivePolicy;
struct PrimitiveEntry { void *function; int arity; };
typedef struct PrimitiveEntry PrimitiveEntry;
/*@
fixpoint PrimitivePolicy *policy_of(Process *p);
// The function the policy resolves (module, index) to, or 0.
fixpoint void *policy_fn(PrimitivePolicy *policy, int module, int index);
predicate entry_ok(PrimitiveEntry *e; void *fn, int arity) =
  e->function |-> fn &*& e->arity |-> arity &*& is_Primitive_Entry(fn) == true &*& prim_arity(fn) == arity &*& 0 <= arity;

// What a call of toit_v2_primitive leaves: fn's completion on a, from its
// last call (`raw`, after at most three collections and four calls), and
// the status and result word the core gets for it; an unchanged epoch
// word means no collection, no task switch and the stack untouched.
predicate prim_done(Program *prog, void *fn, vmv a, int n, vmv b, int n2, uword status, uword w, Object *raw) =
  prim_out(fn, a, b, raw) == true &*& n <= n2 &*& n2 <= n + 4 * PRIM_EPOCHS + 3 * GC_EPOCHS &*&
  (epoch_word(n2) == epoch_word(n) ? same_stack(a, b) == true : true) &*&
  (status == TOIT_V2_PRIMITIVE_SUCCESS ? is_marked(raw) == false &*& w == (uword)raw :
   status == TOIT_V2_PRIMITIVE_FAILURE ? other_error(prog, raw) == true &*& w == (uword)unmarked(prog, raw) :
   status == TOIT_V2_PRIMITIVE_THROW &*& oom_error(prog, raw) == true &*& w == (uword)unmarked(prog, raw));
@*/
PrimitivePolicy *Process_policy(Process *self);
//@ requires true;
//@ ensures result == policy_of(self);
PrimitiveEntry *PrimitivePolicy_at(PrimitivePolicy *self, unsigned module, unsigned index);
//@ requires true;
//@ ensures result == 0 ? policy_fn(self, module, index) == 0 : [_]entry_ok(result, policy_fn(self, module, index), _);
Object *Program_malloc_failed(Program *self);
//@ requires [_]program(self, ?ids);
//@ ensures result == root_malloc_failed(self);
Object *Program_cross_process_gc(Program *self);
//@ requires [_]program(self, ?ids);
//@ ensures result == root_cross_process_gc(self);
@prototypes
@render src/primitive.cc toit::Primitive::unmark_from_error
Object* Primitive::unmark_from_error(Program* program, Object* marked_error)
//@ requires [_]program(program, ?ids) &*& is_marked(marked_error) == true;
//@ ensures result == unmarked(program, marked_error);
{
  ASSERT((reinterpret_cast<uword>(marked_error) & 3) == Error::ERROR_TAG);
  if (reinterpret_cast<uword>(marked_error) < Error::MAX_TAGGED_ERROR) {
    //@ shiftright_div((uword)marked_error, N2);
    int index = reinterpret_cast<uword>(marked_error) >> Error::ERROR_SHIFT;
    if (index >= Program::ROOT_COUNT) index = Program::INVALID_ARGUMENT_INDEX;
    return program->root(index);
  }
  return marked_error->unmark();
}

@render src/primitive.h toit::Primitive::is_error tu=src/interpreter_v2.cc
  static bool is_error(Object* object)
  //@ requires true;
  //@ ensures result == is_marked(object);
  {
    //@ bitand_pow_nat((uword)object, N2);
    return (reinterpret_cast<uword>(object) & Object::NON_SMI_TAG_MASK) == Object::MARKED_TAG;
  }

