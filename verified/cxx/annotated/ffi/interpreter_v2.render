// A new instance of class c (the allocator's contract).
fixpoint bool instance_new(fixpoint(void *, oinfo) H, void *r, int c) {
  return has_tag(H, r, INSTANCE_TAG) && header_cid(o_hw(H(r))) == c && o_len(H(r)) == class_fields(c);
}

// Carries ghost values from a caller to a callee (C has no ghost
// parameters).
predicate ghost_start(vmv a, int n) = true;
