            result == (uword)r &*& (r == 0 ? true : has_tag(H2, r, STRING_TAG) == true &*& blob_len(H2, r) == length); @*/
{
  if (length > V2_MAX_BLOB_LENGTH)
  //@ close allocated(objs, H, (Process *)raw_process, 0, objs, H);
  return 0;
  return reinterpret_cast<uword>(v2_process(raw_process)->allocate_string(length));
}

@render src/interpreter_v2.cc toit_v2_try_allocate_byte_array
uword toit_v2_try_allocate_byte_array(void* raw_process, uword length)
//@ requires [?fp]process((Process *)raw_process, ?prog, ?ids) &*& heap(?objs, ?H);
// (The model's Process::allocate_byte_array states `allocated` written out:
// the new object is the head of the heap's list.)
/*@ ensures [fp]process((Process *)raw_process, prog, ids) &*& heap(?objs2, ?H2) &*&
            (result == 0 ? objs2 == objs &*& H2 == H :
               objs2 == cons(head(objs2), objs) &*& result == (uword)head(objs2) &*& mem(head(objs2), objs) == false &*&
               forall(objs, (same_obj)(H, H2)) == true &*& in_program_heap((Process *)raw_process, head(objs2)) == false &*&
               has_tag(H2, head(objs2), BYTE_ARRAY_TAG) == true &*& blob_ok(H2, head(objs2), STRINGS_OR_BYTE_ARRAYS) == true &*&
               blob_len(H2, head(objs2)) == length); @*/
{
  if (length > V2_MAX_BLOB_LENGTH) return 0;
  return reinterpret_cast<uword>(v2_process(raw_process)->allocate_byte_array(length));
  //@ assert heap(?objs2, ?H2);
  //@ if (objs2 != objs) heap_facts(head(objs2));
}

@render src/interpreter_v2.cc v2_validate trusted
static void v2_validate(Process* process, const char* where)
// TRUSTED: a debugging aid (TOIT_V2_VALIDATE=1); reads the stacks and the
// heap, aborts on a bad slot.
//@ requires true;
//@ ensures true;
{
  static int enabled = -1;
  if (enabled < 0) enabled = getenv("TOIT_V2_VALIDATE") != null ? 1 : 0;
  if (!enabled) return;
  Program* program = process->program();
  auto check = [&](Stack* stack, const char* which) {
  word length = stack->length();
  word top = stack->top();
  uword from = reinterpret_cast<uword>(program->bytecodes.data());
  uword to = from + program->bytecodes.length();
  for (word i = top; i < length; i++) {
    uword w = stack->v2_word_at(i);
    if ((w & 1) == 0) continue;
    if (from <= w && w < to) continue;
    uword header = *reinterpret_cast<uword*>(w - 1);
    word tag = (header >> 1) & 15;
    if ((header & 1) != 0 || (w & 3) != 1 || tag > 9) {
      fprintf(stderr, "v2_validate(%s, %s stack %p): bad slot %" PRIdPTR " (position %" PRIdPTR ") = %p header %p; top %" PRIdPTR " length %" PRIdPTR " frame top %" PRIdPTR " bci %" PRIdPTR "\n",
              where, which, reinterpret_cast<void*>(stack), i, length - 1 - i, reinterpret_cast<void*>(w), reinterpret_cast<void*>(header),
              top, length, stack->v2_frame_top(), stack->v2_bci());
      abort();
    }
  }
  };
  Stack* current = process->task()->stack();
  check(current, "current");
  process->object_heap()->do_objects([&](HeapObject* object) {
    if (!is_task(object)) return;
    Task* task = Task::cast(object);
    if (!task->has_stack()) return;
    Stack* stack = task->stack();
    if (stack != current) check(stack, "other task's");
  });
}

@render src/interpreter_v2.cc v2_primitive_failed
static __attribute__((noinline)) V2_HOT uword v2_primitive_failed(
    Process* process, Primitive::Entry* entry, uword first_argument, Object* result, uword* result_out)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& ghost_start(?a, ?n) &*& vm(process, ?b, ?nb) &*& *result_out |-> _ &*&
             is_Primitive_Entry(entry) == true &*& prim_out(entry, a, b, result) == true &*& is_marked(result) == true &*&
             first_argument + prim_arity(entry) <= v_len(a) - v_top(a) &*& first_argument < v_len(a) - v_top(a) + v_rtop(a) &*& 0 <= prim_arity(entry) &*&
             0 <= n &*& n <= nb &*& nb <= n + PRIM_EPOCHS &*& (nb == n || oom_error(prog, result) ? nb == n &*& same_stack(a, b) == true : true); @*/
/*@ ensures [fp]process(process, prog, ids) &*& vm(process, ?b2, ?n2) &*& *result_out |-> ?w &*&
            prim_done(prog, entry, a, n, b2, n2, result, w, ?raw) &*& result != TOIT_V2_PRIMITIVE_ABSENT; @*/
{
  //@ open ghost_start(a, n);
  Program* program = process->program();
  v2_validate(process, "primitive failure");
  //@ Object *raw = result;
  //@ if (oom_error(prog, result)) same_stack_frames(a, b);
  for (int attempts = 1; true; attempts++)
  /*@ invariant [fp]process(process, prog, ids) &*& [_]program(prog, ids) &*& vm(process, ?bc, ?nc) &*& *result_out |-> _ &*& result == raw &*&
                prim_out(entry, a, bc, raw) == true &*& 1 <= attempts &*& attempts <= 4 &*&
                n <= nc &*& nc <= n + attempts * PRIM_EPOCHS + (attempts - 1) * GC_EPOCHS &*&
                (nc == n ? same_stack(a, bc) == true : true) &*&
                (oom_error(prog, raw) ? same_frames(a, bc) == true : true); @*/
  {
    if (!Primitive::is_error(result)) {
      process->object_heap()->leave_primitive();
      *result_out = reinterpret_cast<uword>(result);
      //@ if (epoch_word(nc) == epoch_word(n)) epoch_unchanged(n, nc);
      //@ close prim_done(prog, entry, a, n, bc, nc, TOIT_V2_PRIMITIVE_SUCCESS, (uword)raw, raw);
      return TOIT_V2_PRIMITIVE_SUCCESS;
    }
    result = Primitive::unmark_from_error(program, result);
    bool malloc_failed = (result == program->malloc_failed());
    bool allocation_failed = (result == program->allocation_failed());
    bool force_cross_process = false;
    if (result == program->cross_process_gc()) {
      force_cross_process = true;
      malloc_failed = true;
    } else if (!(malloc_failed || allocation_failed)) {
      //@ if (epoch_word(nc) == epoch_word(n)) epoch_unchanged(n, nc);
      //@ close prim_done(prog, entry, a, n, bc, nc, TOIT_V2_PRIMITIVE_FAILURE, (uword)unmarked(prog, raw), raw);
      break;
    }
    if (attempts > 3) {
      process->object_heap()->leave_primitive();
      *result_out = reinterpret_cast<uword>(result);
      //@ if (epoch_word(nc) == epoch_word(n)) epoch_unchanged(n, nc);
      //@ close prim_done(prog, entry, a, n, bc, nc, TOIT_V2_PRIMITIVE_THROW, (uword)unmarked(prog, raw), raw);
      return TOIT_V2_PRIMITIVE_THROW;
    }
    v2_gc(process, malloc_failed, attempts, force_cross_process, "primitive");
    //@ leak gc_action(_, _, _, _, _, _, _);
    //@ assert vm(process, ?bg, ?ng);
    //@ same_frames_trans(a, bc, bg);
    //@ open vm(process, bg, ng);
    //@ same_frames_facts(a, bg);
    Stack* stack = process->task()->stack();
    GcMetadata::insert_into_remembered_set(stack);
    //@ close vm(process, bg, ng);
    //@ close prim_frame(first_argument);
    result = entry(process, stack->v2_slot_address(first_argument));
    //@ assert vm(process, ?bn, ?nn);
    //@ prim_retry(prog, entry, a, bc, raw, bg, bn, result);
    //@ if (oom_error(prog, result)) { same_stack_frames(bg, bn); same_frames_trans(a, bg, bn); }
    //@ if (nn == n) { same_stack_trans(a, bg, bn); }
    //@ raw = result;
  }
  process->object_heap()->leave_primitive();
  *result_out = reinterpret_cast<uword>(result);
  return TOIT_V2_PRIMITIVE_FAILURE;
}

@render src/interpreter_v2.cc toit_v2_primitive
uword toit_v2_primitive(void* raw_process, uword module, uword index, uword arity,
                        uword first_argument, uword* result_out)
/*@ requires [?fp]process((Process *)raw_process, ?prog, ?ids) &*& vm((Process *)raw_process, ?a, ?n) &*& *result_out |-> _ &*&
             module < 256 &*& index < 65536 &*& first_argument < v_len(a) - v_top(a) + v_rtop(a) &*& first_argument + arity <= v_len(a) - v_top(a); @*/
/*@ ensures [fp]process((Process *)raw_process, prog, ids) &*& vm((Process *)raw_process, ?b, ?n2) &*&
            (result == TOIT_V2_PRIMITIVE_ABSENT ?
               *result_out |-> _ &*& b == a &*& n2 == n &*&
               (policy_fn(policy_of((Process *)raw_process), module, index) == 0 ||
                prim_arity(policy_fn(policy_of((Process *)raw_process), module, index)) != arity) :
               *result_out |-> ?w &*& prim_arity(policy_fn(policy_of((Process *)raw_process), module, index)) == arity &*&
               prim_done(prog, policy_fn(policy_of((Process *)raw_process), module, index), a, n, b, n2, result, w, ?raw)); @*/
{
  Process* process = v2_process(raw_process);
  const PrimitiveEntry* primitive = process->policy()->at(module, index);
  if (Flags::primitives) printf("[invoking primitive %d::%d]\n", static_cast<int>(module), static_cast<int>(index));
  if (primitive == null || static_cast<uword>(primitive->arity) != arity) return TOIT_V2_PRIMITIVE_ABSENT;
  Primitive::Entry* entry = reinterpret_cast<Primitive::Entry*>(primitive->function);
  // The core stores into the stack without the write barrier: a GC during
  // the primitive must find the stack in the remembered set.
  //@ open vm(process, a, n);
  Stack* stack = process->task()->stack();
  GcMetadata::insert_into_remembered_set(stack);
  //@ close vm(process, a, n);
  //@ close prim_frame(first_argument);
  HW_PERF_PRIMITIVE_START(hw_perf_start);
  Object* result = entry(process, stack->v2_slot_address(first_argument));
  HW_PERF_PRIMITIVE_END(hw_perf_start, module, index);
  if (Primitive::is_error(result)) {
    //@ close ghost_start(a, n);
    return v2_primitive_failed(process, entry, first_argument, result, result_out);
  }
  process->object_heap()->leave_primitive();
  *result_out = reinterpret_cast<uword>(result);
  //@ assert vm(process, ?b1, ?n1);
  //@ if (epoch_word(n1) == epoch_word(n)) epoch_unchanged(n, n1);
  //@ close prim_done(prog, entry, a, n, b1, n1, TOIT_V2_PRIMITIVE_SUCCESS, (uword)result, result);
  return TOIT_V2_PRIMITIVE_SUCCESS;
}
