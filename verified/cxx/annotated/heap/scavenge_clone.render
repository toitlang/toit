@include ../model/model.cfg
@overloaded ScavengeVisitor::clone_into_space
@verbatim
#include "semispace.gen.h"

// The size dispatcher supplies the extent of a live, unforwarded object.
/*@
predicate object_extent(Program *p, HeapObject *o; int bytes);
predicate clone_source(Program *p, HeapObject *o; int bytes, list<char> contents) =
  object_extent(p,o,bytes) &*& 1 <= (uword)o &*& sizeof(word) <= bytes &*& bytes <= INT_MAX &*&
  chars((char *)raw(o),bytes,contents);
fixpoint uword copied_address(HeapObject *target) { return target == 0 ? 0 : (uword)raw(target); }
predicate clone_result(Program *p, HeapObject *original, HeapObject *result, int bytes, list<char> contents) =
  result == 0 ? clone_source(p,original,bytes,contents) :
  object_extent(p,original,bytes) &*& installed_forwarding(original,result) &*&
  chars((char *)raw(original)+sizeof(word),bytes-sizeof(word),drop(sizeof(word),contents)) &*&
  copied_header(result,take(sizeof(word),contents)) &*&
  chars((char *)raw(result)+sizeof(word),bytes-sizeof(word),drop(sizeof(word),contents)) &*& raw(original) != raw(result);
@*/
word HeapObject_size(HeapObject *o,Program *p);
//@ requires [?f]object_extent(p,o,?n);
//@ ensures [f]object_extent(p,o,n) &*& result == n;
void *memcpy(void *destination,void *source,uintptr_t bytes);
//@ requires chars_(destination,bytes,_) &*& [?f]chars(source,bytes,?contents);
//@ ensures chars(destination,bytes,contents) &*& [f]chars(source,bytes,contents) &*& result == destination;

@prototypes
@render src/objects.h toit::HeapObject::from_address tu=src/third_party/dartino/two_space_heap.cc
  static HeapObject* from_address(uword address)
  //@ requires 0 < address &*& address < UINTPTR_MAX &*& address % sizeof(word) == 0;
  //@ ensures (uword)result == address + 1 &*& raw(result) == (uword *)address &*& is_heap_w((uword)result) == true;
  {
    ASSERT((address & NON_SMI_TAG_MASK) == SMI_TAG);
    //@ div_rem_nonneg(address,sizeof(word));
    //@ div_rem_nonneg_unique(address+1,4,(address/sizeof(word))*(sizeof(word)/4),1);
    return reinterpret_cast<HeapObject*>(address + HEAP_TAG);
  }
@render src/objects.h toit::HeapObject::set_forwarding_address tu=src/third_party/dartino/two_space_heap.cc
  INLINE void set_forwarding_address(HeapObject* destination)
  //@ requires 1 <= (uword)self &*& pointer_((void **)raw(self),_);
  //@ ensures pointer((void **)raw(self),destination);
  {
    _at_put(HEADER_OFFSET, destination);
  }

@render src/third_party/dartino/two_space_heap.cc toit::ScavengeVisitor::clone_into_space type=HeapObject*(Program*,HeapObject*,toit::OldSpace*)
HeapObject* ScavengeVisitor::clone_into_space(Program* program, HeapObject* original, SomeSpace* to)
/*@ requires clone_source(program,original,?n,?contents) &*& n % sizeof(word) == 0 &*&
    old_window(to,?top,?limit,?slots) &*& old_controls(to,?tracking,?used,?failed) &*&
    old_request(to,n,top,limit,tracking,used,!tracking && used > 0 && failed,?free_addr,?chunk_addr); @*/
/*@ ensures clone_result(program,original,result,n,contents) &*&
    old_window(to,?next,?last,?rest) &*& old_controls(to,?tracking1,?used1,?failed1) &*&
    (n <= limit - top ? copied_address(result) == top &*& result != 0 &*& next == top+n &*& last == limit &*&
       track_words(top,next) == n/sizeof(word) &*& forall_int((promotion_transfer)(top,next,last)) == true &*&
       rest == drop(n/sizeof(word),slots) &*& tracking1 == tracking &*& used1 == used &*& failed1 == failed &*&
       start_slot(top,some((uint8)(top % 256))) :
     !tracking && used > 0 && failed ? result == 0 &*& next == top &*& last == limit &*& rest == slots &*&
       tracking1 == tracking &*& used1 == used &*& failed1 == failed :
     old_sources(to,?stage,n,free_addr,chunk_addr) &*&
       (free_addr != 0 ? copied_address(result) == free_addr && stage == 1 : copied_address(result) == chunk_addr && stage == 2)); @*/
{
  //@ open clone_source(program,original,n,contents);
  ASSERT(!to->includes(original->_raw()));
  ASSERT(!original->has_forwarding_address());
  int object_size = original->size(program);
  uword new_address = to->allocate(object_size);
  //@ open reservation(new_address,n);
  //@ div_rem_nonneg(n,sizeof(word));
  //@ if (new_address != 0) { pointers__to_chars_((void **)new_address); chars__limits((char *)new_address); }
  /*@ if (new_address == 0) {
    close clone_source(program,original,n,contents);
    close clone_result(program,original,0,n,contents);
  } @*/
  if (new_address == 0) return null;
  HeapObject* target = HeapObject::from_address(new_address);
  memcpy(reinterpret_cast<void*>(new_address), reinterpret_cast<void*>(original->_raw()), object_size);
  //@ chars_split((char *)raw(original),sizeof(word));
  //@ chars_to_pointer(raw(original));
  original->set_forwarding_address(target);
  /*@ if (raw(original) == raw(target)) {
    chars_split((char *)raw(target),sizeof(word));
    chars_to_pointer(raw(target));
    pointer_distinct(raw(original),raw(target));
  } @*/
  //@ chars_split((char *)raw(target),sizeof(word));
  //@ close copied_header(target,take(sizeof(word),contents));
  //@ close installed_forwarding(original,target);
  //@ close clone_result(program,original,target,n,contents);
  return target;
}

@render src/third_party/dartino/two_space_heap.cc toit::ScavengeVisitor::clone_into_space type=HeapObject*(Program*,HeapObject*,toit::SemiSpace*)
HeapObject* ScavengeVisitor::clone_into_space(Program* program, HeapObject* original, SomeSpace* to)
/*@ requires clone_source(program,original,?n,?contents) &*& n % sizeof(word) == 0 &*&
    to->top_ |-> ?top &*& to->limit_ |-> ?limit &*& pointers_((void **)top,?words,?slots) &*&
    0 <= words &*& limit == top+words*sizeof(word) &*& (top != 0 || words == 0) &*&
    top % sizeof(word) == 0 &*& [_]chunk_list_empty(to,words == 0); @*/
/*@ ensures clone_result(program,original,result,n,contents) &*& to->limit_ |-> limit &*&
    (n >= limit-top ? result == 0 &*& to->top_ |-> top &*&
      (words == 0 ? pointers_((void **)top,words,slots) : pointer((void **)top,0) &*& pointers_((void **)top+1,words-1,tail(slots))) :
      result != 0 &*& copied_address(result) == top &*& to->top_ |-> ?after &*& after == top+n &*&
      pointer((void **)after,0) &*& pointers_((void **)after+1,words-n/sizeof(word)-1,tail(drop(n/sizeof(word),slots))) &*&
      word_starts(top,nat_of_int(words)) == append(word_starts(top,nat_of_int(n/sizeof(word))),word_starts(after,nat_of_int(words-n/sizeof(word))))); @*/
{
  //@ open clone_source(program,original,n,contents);
  ASSERT(!to->includes(original->_raw()));
  ASSERT(!original->has_forwarding_address());
  int object_size = original->size(program);
  uword new_address = to->allocate(object_size);
  //@ div_rem_nonneg(n,sizeof(word));
  //@ if (new_address != 0) pointers__to_chars_((void **)new_address);
  /*@ if (new_address == 0) {
    close clone_source(program,original,n,contents);
    close clone_result(program,original,0,n,contents);
  } @*/
  if (new_address == 0) return null;
  HeapObject* target = HeapObject::from_address(new_address);
  memcpy(reinterpret_cast<void*>(new_address), reinterpret_cast<void*>(original->_raw()), object_size);
  //@ chars_split((char *)raw(original),sizeof(word));
  //@ chars_to_pointer(raw(original));
  original->set_forwarding_address(target);
  /*@ if (raw(original) == raw(target)) {
    chars_split((char *)raw(target),sizeof(word));
    chars_to_pointer(raw(target));
    pointer_distinct(raw(original),raw(target));
  } @*/
  //@ chars_split((char *)raw(target),sizeof(word));
  //@ close copied_header(target,take(sizeof(word),contents));
  //@ close installed_forwarding(original,target);
  //@ close clone_result(program,original,target,n,contents);
  return target;
}
