; A live, aligned, fitting free block under the heap lock. round includes
; its eight-byte header. The linked code retains round in r4 on both paths.
(set-logic QF_LIA)
(declare-const head Int)
(declare-const block Int)
(declare-const round Int)
(declare-const requested Int)
(assert (and (< 0 head) (< 0 requested) (<= (+ requested 8) round block)
             (< block 16384) (< (+ head block) 4294967296)
             (= (mod head 8) 0) (= (mod round 8) 0) (= (mod block 8) 0)))
(define-fun rest () Int (- block round))
(define-fun split () Bool (and (> rest 15) (> rest (div requested 32))))
(define-fun used () Int (ite split round block))
(define-fun payload () Int (+ head 8))
(define-fun bound () Int (- round 8))
; The live header covers the original block or the prefix; the free
; remainder has room for both links and ends at the original right neighbor.
(push)
(assert (not (and (<= (+ payload requested) (+ head used))
  (ite split (and (<= 16 rest) (= (+ head used rest) (+ head block)))
             (= (+ head used) (+ head block))))))
(check-sat)
(pop)
; Bytewise loop invariant. After i bytes, arbitrary byte q was cleared
; exactly if it lies in the processed prefix. All other bytes retain old.
(declare-const i Int)
(declare-const q Int)
(declare-const old Int)
(define-fun expected ((done Int)) Int (ite (and (<= payload q) (< q (+ payload done))) 0 old))
(push)
(assert (distinct (expected 0) old))
(check-sat)
(pop)
(assert (and (<= 0 i bound) (= (mod i 4) 0)))
(define-fun dst () Int (+ payload (* 4 (div i 4))))
(push)
(assert (< i bound))
(assert (not (and (= dst (+ payload i)) (<= (+ dst 4) (+ head used))
                  (<= (+ i 4) bound) (< (- bound (+ i 4)) (- bound i))
                  (= (ite (and (<= dst q) (< q (+ dst 4))) 0 (expected i)) (expected (+ i 4))))))
(check-sat)
(pop)
(push)
(assert (>= i bound))
(assert (or (distinct i bound) (< i requested)
            (and (<= payload q) (< q (+ payload requested)) (distinct (expected i) 0))
            (and (>= q (+ payload bound)) (distinct (expected i) old))))
(check-sat)
(pop)
; Both branches are reachable with the actual descriptor request.
(assert (= requested 28))
(assert (= round 40))
(push)
(assert split)
(check-sat)
(pop)
(assert (and (not split) (> used round)))
(check-sat)
