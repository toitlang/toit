; EC618 base Thumb memset. dst (r0) and value (r1) are unchanged throughout.
; Ordinary writable memory, sequential execution. Relative byte offsets use
; 32-bit arithmetic, including when the last address is 0xffffffff.
(set-logic QF_AUFBV)
(define-sort Word () (_ BitVec 32))
(define-sort Bytes () (Array Word (_ BitVec 8)))
(declare-const dst Word)
(declare-const value Word)
(declare-const size Word)
(declare-const i Word)
(declare-const q Word)
(declare-const M0 Bytes)
(declare-const M Bytes)
(define-fun one () Word #x00000001)
(define-fun end () Word (bvadd dst size))
(define-fun byte-value () (_ BitVec 8) ((_ extract 7 0) value))
(define-fun expected ((done Word)) (_ BitVec 8)
  (ite (bvult (bvsub q dst) done) byte-value (select M0 q)))
(define-fun invariant ((r3 Word) (done Word)) Bool
  (and (bvule done size) (= r3 (bvadd dst done))))
; mov r3,r0; add r2,r0. No bytes have been written.
(push)
(assert (not (and (invariant dst #x00000000) (= (select M0 q) (expected #x00000000)))))
(check-sat)
(pop)
(declare-const r3 Word)
(assert (invariant r3 i))
(assert (= (select M q) (expected i)))
; cmp r3,r2; bne store; bx lr. The return register still holds dst.
(push)
(assert (= r3 end))
(assert (not (and (= i size) (= (select M q) (expected size)))))
(check-sat)
(pop)
; strb.w r1,[r3],#1; b cmp. Only the old r3 is written.
(assert (distinct r3 end))
(define-fun next-i () Word (bvadd i one))
(define-fun next-memory () Bytes (store M r3 byte-value))
(push)
(assert (not (and (bvult (bvsub r3 dst) size)
                  (invariant (bvadd r3 one) next-i)
                  (bvult (bvsub size next-i) (bvsub size i)))))
(check-sat)
(pop)
(assert (distinct (select next-memory q) (expected next-i)))
(check-sat)
