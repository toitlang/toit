; ARM unsigned arithmetic compared with widened byte intervals.
(set-logic QF_BV)
(define-sort W () (_ BitVec 32))
(declare-const size W)
(declare-const start W)
(declare-const low W)
(declare-const extent W)
(define-fun wide ((v W)) (_ BitVec 33) ((_ zero_extend 1) v))
; SUBS size-1; CMN #4096; BCS rejects the request.
(define-fun admissible () Bool (bvult (bvsub size #x00000001) #xfffff000))
(define-fun rounded () W (bvand (bvadd size #x00000fff) #xfffff000))
(push)
(assert (distinct admissible (and (distinct size #x00000000) (bvule size #xfffff000))))
(check-sat)
(pop)
(assert admissible)
(push)
(assert (not (and (bvule size rounded) (bvult (bvsub rounded size) #x00001000)
                  (= (bvand rounded #x00000fff) #x00000000))))
(check-sat)
(pop)
(define-fun contained () Bool
  (and (bvuge start low) (bvule rounded extent)
       (bvule (bvsub start low) (bvsub extent rounded))))
(assert (distinct contained (and (bvuge start low)
  (bvule (bvadd (wide start) (wide rounded)) (bvadd (wide low) (wide extent))))))
(check-sat)
