@render src/third_party/dartino/object_memory.cc toit::ObjectMemory::free_chunk
void ObjectMemory::free_chunk(Chunk* chunk)
  //@ requires detached_chunk_links(chunk) &*& retirable_chunk(chunk) &*& retirement_history(?history);
  //@ ensures retirement_history(cons(chunk,history));
  //@ terminates;
{
  //@ open retirable_chunk(chunk);
#ifdef TOIT_DEBUG
  chunk->scramble();
#endif
  allocated_ -= chunk->size();
  delete chunk;
}

@render src/third_party/dartino/object_memory.cc toit::Space::free_all_chunks
void Space::free_all_chunks()
  /*@ requires pointer_within_limits(&self->chunk_list_) == true &*& chunk_sequence(&self->chunk_list_,?entries) &*&
        foreach(entries,retirable_chunk) &*& retirement_history(?before) &*& self->top_ |-> _ &*& self->limit_ |-> _; @*/
  /*@ ensures empty_chunk_list(&self->chunk_list_) &*& retirement_history(append(reverse(entries),before)) &*&
        self->top_ |-> 0 &*& self->limit_ |-> 0; @*/
  //@ terminates;
{
  while (auto it = chunk_list_.first())
    /*@ invariant chunk_sequence(&self->chunk_list_,?remaining) &*& foreach(remaining,retirable_chunk) &*& retirement_history(?history) &*&
          append(reverse(remaining),history) == append(reverse(entries),before); @*/
    //@ decreases length(remaining);
  {
    //@ switch(remaining) { case nil: case cons(h,t): append_assoc(reverse(t),cons(h,nil),history); }
    //@ open foreach(remaining,retirable_chunk);
    chunk_list_.unlink(it);
    ObjectMemory::free_chunk(it);
  }
  //@ open foreach(nil,retirable_chunk);
  //@ close empty_chunk_list(&self->chunk_list_);
  top_ = limit_ = 0;
}

@render src/third_party/dartino/object_memory.cc toit::Space::~Space
Space::~Space()
  /*@ requires pointer_within_limits(&self->chunk_list_) == true &*& chunk_sequence(&self->chunk_list_,?entries) &*&
        foreach(entries,retirable_chunk) &*& retirement_history(?before) &*& self->top_ |-> _ &*& self->limit_ |-> _; @*/
  /*@ ensures empty_chunk_list(&self->chunk_list_) &*& retirement_history(append(reverse(entries),before)) &*&
        self->top_ |-> 0 &*& self->limit_ |-> 0; @*/
  //@ terminates;
{
  free_all_chunks();
}

@render src/third_party/dartino/gc_metadata.h toit::GcMetadata::clear_mark_bits_for_chunk tu=src/third_party/dartino/object_memory.cc truncating
  static void clear_mark_bits_for_chunk(const Chunk* chunk)
  /*@ requires [?f]chunk->start_ |-> ?lo &*& [f]chunk->end_ |-> ?hi &*&
        0 <= lo &*& lo <= hi &*& mark_bytes(lo,hi,_); @*/
  /*@ ensures [f]chunk->start_ |-> lo &*& [f]chunk->end_ |-> hi &*& mark_bytes(lo,hi,true); @*/
  {
    ASSERT(in_metadata_range(chunk->start()));
    //@ open mark_bytes(lo,hi,_);
    //@ shiftright_div(hi-lo,sizeof(word) == 8 ? N6 : N5);
    //@ shiftright_div(lo,sizeof(word) == 8 ? N6 : N5);
    uword base = chunk->start();
    uword size = chunk->size() >> MARK_BITS_SHIFT;
    //@ assert size == mark_index(hi-lo);
    //@ assert base >> GcMetadata_MARK_BITS_SHIFT == mark_index(lo);
    //@ assert [_]GcMetadata_singleton_.mark_bits_bias_ |-> ?bias;
    base = (base >> MARK_BITS_SHIFT) + singleton_.mark_bits_bias_;
    //@ assert (uint8 *)base == table_address(mark_index(lo),bias);
    memset(reinterpret_cast<uint8*>(base), 0, size);
    //@ close mark_bytes(lo,hi,true);
  }

@render src/third_party/dartino/gc_metadata.h toit::GcMetadata::remembered_set_for tu=src/third_party/dartino/object_memory.cc type=uint8*(uword) truncating
  static inline uint8* remembered_set_for(uword address)
  //@ requires [_]GcMetadata_singleton_.remembered_set_bias_ |-> ?bias;
  //@ ensures result == table_address(card(address),bias);
  {
    ASSERT(in_metadata_range(address));
    //@ shiftright_div(address,sizeof(word) == 8 ? N8 : N7);
    return reinterpret_cast<uint8*>((address >> CARD_SIZE_LOG_2) +
                                    singleton_.remembered_set_bias_);
  }

@render src/third_party/dartino/gc_metadata.h toit::GcMetadata::overflow_bits_for tu=src/third_party/dartino/object_memory.cc truncating
  static inline uint8* overflow_bits_for(uword address)
  //@ requires [_]GcMetadata_singleton_.overflow_bits_bias_ |-> ?bias;
  //@ ensures result == table_address(overflow_index(address),bias);
  {
    ASSERT(in_metadata_range(address));
    //@ shiftright_div(address,sizeof(word) == 8 ? N11 : N10);
    return reinterpret_cast<uint8*>((address >> CARD_SIZE_IN_BITS_LOG_2) +
                                    singleton_.overflow_bits_bias_);
  }

@render src/third_party/dartino/gc_metadata.h toit::GcMetadata::initialize_overflow_bits_for_chunk tu=src/third_party/dartino/object_memory.cc
  static void initialize_overflow_bits_for_chunk(const Chunk* chunk)
  /*@ requires [?f]chunk->start_ |-> ?lo &*& [f]chunk->end_ |-> ?hi &*&
        overflow_slice(lo,hi,_); @*/
  /*@ ensures [f]chunk->start_ |-> lo &*& [f]chunk->end_ |-> hi &*&
        overflow_slice(lo,hi,true); @*/
  {
    ASSERT(in_metadata_range(chunk->start()));
    //@ open overflow_slice(lo,hi,_);
    uint8* from = overflow_bits_for(chunk->start());
    uint8* to = overflow_bits_for(chunk->end());
    //@ open table_slice(_,_,_,_);
    memset(from, 0, to - from);
    //@ close table_slice(from,to,overflow_index(hi)-overflow_index(lo),true);
    //@ close overflow_slice(lo,hi,true);
  }

@render src/third_party/dartino/gc_metadata.h toit::GcMetadata::initialize_remembered_set_for_chunk tu=src/third_party/dartino/object_memory.cc
  static void initialize_remembered_set_for_chunk(const Chunk* chunk, uword only_above = 0)
  /*@ requires [?f]chunk->start_ |-> ?lo &*& [f]chunk->end_ |-> ?hi &*& lo <= hi &*&
        (only_above < hi ? remembered_slice(only_above > lo ? only_above : lo,hi,_) : true); @*/
  /*@ ensures [f]chunk->start_ |-> lo &*& [f]chunk->end_ |-> hi &*&
        (only_above < hi ? remembered_slice(only_above > lo ? only_above : lo,hi,true) : true); @*/
  {
    uword start = chunk->start();
    uword end = chunk->end();
    if (only_above >= end) return;
    if (only_above > start) {
      ASSERT(only_above % CARD_SIZE == 0);
      start = only_above;
    }
    ASSERT(in_metadata_range(start));
    //@ open remembered_slice(start,hi,_);
    uint8* from = remembered_set_for(start);
    uint8* to = remembered_set_for(end);
    //@ open table_slice(_,_,_,_);
    memset(from, GcMetadata::NO_NEW_SPACE_POINTERS, to - from);
    //@ close table_slice(from,to,card(hi)-card(start),true);
    //@ close remembered_slice(start,hi,true);
  }

@render src/third_party/dartino/object_memory.cc toit::Chunk::initialize_metadata
void Chunk::initialize_metadata() const
  //@ requires [?f]self->start_ |-> ?lo &*& [f]self->end_ |-> ?hi &*& 0 <= lo &*& lo < hi &*& chunk_tables(lo,hi,_);
  //@ ensures [f]self->start_ |-> lo &*& [f]self->end_ |-> hi &*& chunk_tables(lo,hi,true);
{
  //@ open chunk_tables(lo,hi,_);
  GcMetadata::clear_mark_bits_for_chunk(this);
  GcMetadata::initialize_overflow_bits_for_chunk(this);
  GcMetadata::initialize_starts_for_chunk(this);
  GcMetadata::initialize_remembered_set_for_chunk(this);
  //@ close chunk_tables(lo,hi,true);
}

@verbatim
Chunk *Chunk_new_nothrow(void);
//@ requires true;
/*@ ensures result == 0 ? true : descriptor_storage(result) &*& chunk_link_storage(result) &*& result->owner_ |-> _ &*&
      result->start_ |-> _ &*& result->end_ |-> _ &*& result->scavenge_pointer_ |-> _; @*/
void GcMetadata_map_metadata_for_chunk(Chunk *chunk);
//@ requires [?f]chunk->start_ |-> ?lo &*& [f]chunk->end_ |-> ?hi &*& chunk_table_reservation(lo,hi);
//@ ensures [f]chunk->start_ |-> lo &*& [f]chunk->end_ |-> hi &*& chunk_tables(lo,hi,_);
void atomic_uword_add(AtomicUword *counter,uword size);
//@ requires charge_room(counter,size);
//@ ensures charged_bytes(counter,size);

@render src/third_party/dartino/object_memory.cc toit::ObjectMemory::allocate_chunk_helper
Chunk* ObjectMemory::allocate_chunk_helper(Space* owner, uword size, void* memory)
  /*@ requires owner_type(owner,?kind) &*& 0 <= kind &*& kind <= 255 &*&
        (memory == 0 ? true : 0 < size &*& (uword)memory+size <= UINTPTR_MAX &*&
          [_]GcMetadata_singleton_.lowest_address_ |-> ?lowest &*& [_]GcMetadata_singleton_.heap_extent_ |-> ?extent &*&
          metadata_contains(lowest,extent,(uword)memory) == true &*& reserved_pages((uword)memory,size) &*&
          classified_pages((uword)memory,(uword)memory+size,UNKNOWN_SPACE_PAGE) &*&
          chunk_table_reservation((uword)memory,(uword)memory+size) &*& charge_room(&ObjectMemory_allocated_,size)); @*/
  /*@ ensures owner_type(owner,kind) &*&
        (memory == 0 ? result == 0 : result == 0 ?
          released_pages((uword)memory,size) &*& classified_pages((uword)memory,(uword)memory+size,UNKNOWN_SPACE_PAGE) &*&
          chunk_table_reservation((uword)memory,(uword)memory+size) &*& charge_room(&ObjectMemory_allocated_,size) :
          detached_chunk_links(result) &*& descriptor_storage(result) &*& result->owner_ |-> owner &*&
          result->start_ |-> (uword)memory &*& result->end_ |-> (uword)memory+size &*& result->scavenge_pointer_ |-> (uword)memory &*&
          reserved_pages((uword)memory,size) &*& charged_bytes(&ObjectMemory_allocated_,size) &*&
          classified_pages((uword)memory,(uword)memory+size,kind) &*&
          chunk_tables((uword)memory,(uword)memory+size,?clean) &*& (owner == 0 || clean)); @*/
{
  if (memory == null) return null;

  uword base = reinterpret_cast<uword>(memory);
  Chunk* chunk = _new Chunk(owner, base, size);
  if (!chunk) {
    OS::free_pages(memory, size);
    return null;
  }

  ASSERT(base == Utils::round_up(base, TOIT_PAGE_SIZE));
  ASSERT(size == Utils::round_up(size, TOIT_PAGE_SIZE));

#ifdef TOIT_DEBUG
  chunk->scramble();
#endif
  GcMetadata::map_metadata_for_chunk(chunk);
  //@ open owner_type(owner,kind);
  if (owner) {
    //@ open classified_pages(base,base+size,UNKNOWN_SPACE_PAGE);
    GcMetadata::mark_pages_for_chunk(chunk, owner->page_type());
    //@ close classified_pages(base,base+size,kind);
    chunk->initialize_metadata();
  }
  //@ close owner_type(owner,kind);
  allocated_ += size;
  return chunk;
}

@render src/third_party/dartino/object_memory.cc toit::Chunk::set_owner
void Chunk::set_owner(Space* value)
  /*@ requires self->owner_ |-> _ &*& self->start_ |-> ?lo &*& self->end_ |-> ?hi &*& page_mapping(lo,hi,true,_) &*&
        0 <= lo &*& lo < hi &*& (value != 0 ? chunk_tables(lo,hi,_) : true) &*& owner_type(value,?kind) &*& 0 <= kind &*& kind <= 255; @*/
  /*@ ensures self->owner_ |-> value &*& self->start_ |-> lo &*& self->end_ |-> hi &*&
        owner_type(value,kind) &*& classified_pages(lo,hi,kind) &*& (value != 0 ? chunk_tables(lo,hi,true) : true); @*/
{
  //@ open owner_type(value,kind);
  owner_ = value;
  GcMetadata::mark_pages_for_chunk(this, value ? value->page_type() : UNKNOWN_SPACE_PAGE);
  //@ close classified_pages(lo,hi,kind);
  if (value) initialize_metadata();
  //@ close owner_type(value,kind);
}

@render src/third_party/dartino/object_memory.h toit::Space::remove_chunk tu=src/third_party/dartino/two_space_heap.cc
  Chunk* remove_chunk()
  /*@ requires pointer_within_limits(&self->chunk_list_) == true &*& removable_chunk(&self->chunk_list_,?entry) &*&
        removable_descriptor(entry,self,?lo,?hi); @*/
  /*@ ensures result == entry &*& empty_chunk_list(&self->chunk_list_) &*&
        (entry == 0 ? true : detached_chunk_links(entry) &*& entry->owner_ |-> 0 &*& entry->start_ |-> lo &*&
         entry->end_ |-> hi &*& classified_pages(lo,hi,UNKNOWN_SPACE_PAGE)); @*/
  {
    //@ open removable_descriptor(entry,self,lo,hi);
    Chunk* chunk = chunk_list_.remove_first();
    //@ if (chunk != 0) { close owner_type(0,UNKNOWN_SPACE_PAGE); }
    if (chunk) chunk->set_owner(nullptr);
    //@ if (chunk != 0) { open owner_type(0,UNKNOWN_SPACE_PAGE); }
    return chunk;
  }

@render src/third_party/dartino/object_memory.h toit::SemiSpace::take_survivors tu=src/third_party/dartino/two_space_heap.cc
  void take_survivors(SemiSpace& source)
  /*@ requires pointer_within_limits(&source->chunk_list_) == true &*& pointer_within_limits(&self->chunk_list_) == true &*&
        empty_chunk_list(&self->chunk_list_) &*& single_chunk(&source->chunk_list_,?entry) &*& entry != 0 &*&
        entry->owner_ |-> source &*& source->top_ |-> ?top &*& source->limit_ |-> ?limit &*&
        self->top_ |-> _ &*& self->limit_ |-> _; @*/
  /*@ ensures empty_chunk_list(&source->chunk_list_) &*& single_chunk(&self->chunk_list_,entry) &*&
        entry->owner_ |-> self &*& self->top_ |-> top &*& self->limit_ |-> limit &*&
        source->top_ |-> 0 &*& source->limit_ |-> 0; @*/
  {
    ASSERT(is_empty() && !source.is_empty() && source.chunk_list_.first() == source.chunk_list_.last());
    ASSERT(program_ == source.program_ && page_type_ == source.page_type_);
    //@ close removable_chunk(&source->chunk_list_,entry);
    Chunk* chunk = source.chunk_list_.remove_first();
    chunk_list_.append(chunk);
    chunk->owner_ = this;
    top_ = source.top_;
    limit_ = source.limit_;
    source.top_ = source.limit_ = 0;
  }

@render src/third_party/dartino/object_memory_copying.cc toit::Space::Space
Space::Space(Program* program, Space::Resizing resizeable, PageType page_type)
    : program_(program),
      page_type_(page_type)
