@render src/third_party/dartino/gc_metadata.h toit::GcMetadata::mark_pages_for_chunk tu=src/third_party/dartino/object_memory.cc truncating
  static void mark_pages_for_chunk(Chunk* chunk, PageType page_type)
  /*@ requires [?f]chunk->start_ |-> ?lo &*& [f]chunk->end_ |-> ?hi &*&
        page_mapping(lo,hi,?mapped,?before) &*& 0 <= page_type &*& page_type <= 255; @*/
  /*@ ensures [f]chunk->start_ |-> lo &*& [f]chunk->end_ |-> hi &*& page_mapping(lo,hi,mapped,?after) &*&
        (mapped ? all_eq(after,some((uint8)page_type)) == true : after == before); @*/
  //@ terminates;
  {
    //@ open page_mapping(lo,hi,mapped,before);
    //@ assert [_]GcMetadata_singleton_.lowest_address_ |-> ?lowest;
    //@ word_distance(lo,lowest);
    uword index = chunk->start() - singleton_.lowest_address_;
    //@ if (!mapped) close page_mapping(lo,hi,mapped,before);
    if (index >= singleton_.heap_extent_) return;
    //@ shiftright_div(hi-lo,N15);
    //@ shiftright_div(index,N15);
    uword size = chunk->size() >> TOIT_PAGE_SIZE_LOG2;
    memset(singleton_.page_type_bytes_ + (index >> TOIT_PAGE_SIZE_LOG2),
           page_type, size);
    //@ close page_mapping(lo,hi,mapped,_);
  }

