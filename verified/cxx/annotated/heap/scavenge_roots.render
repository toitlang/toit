@render src/third_party/dartino/object_memory_copying.cc toit::SemiSpace::used
uword SemiSpace::used() const
  /*@ requires pointer_within_limits(&self->chunk_list_) == true &*& single_chunk(&self->chunk_list_,?chunk) &*&
        [?f]self->top_ |-> ?top &*& [?g]chunk->start_ |-> ?lo &*& lo <= top; @*/
  /*@ ensures single_chunk(&self->chunk_list_,chunk) &*& [f]self->top_ |-> top &*& [g]chunk->start_ |-> lo &*&
        result == top-lo; @*/
{
  ASSERT(chunk_list_.first() == chunk_list_.last());
  return (top() - chunk_list_.last()->start());
}

