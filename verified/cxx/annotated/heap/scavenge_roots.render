void ScavengeVisitor::do_roots(Object** start, word count)
  //@ requires pointers((void **)start,count,?roots) &*& count >= 0 &*& pointer_within_limits(start) == true &*& collection(self,?c,?history) &*& forall(roots,(valid_root)(c)) == true;
  /*@ ensures pointers((void **)start,count,?outputs) &*& collection(self,c,visited(roots,outputs,history)) &*&
        outputs == map((relocate)(forwarded(c,visited(roots,outputs,history))),roots); @*/
  //@ terminates;
{
  //@ pointers_limits((void **)start);
  Object** end = start + count;
  //@ int i = 0;
  //@ close pointers((void **)start,0,nil);
  //@ close exists(nil);
  for (Object** p = start; p < end; p++)
    /*@ invariant 0 <= i &*& i <= count &*& p == start+i &*&
          pointers((void **)start,i,?done) &*& pointers((void **)p,count-i,?rest) &*&
          exists<list<void *> >(?prefix) &*& append(prefix,rest) == roots &*& length(prefix) == i &*&
          forall(rest,(valid_root)(c)) == true &*& collection(self,c,?current) &*& current == visited(prefix,done,history) &*&
          forall(prefix,(settled)(c,forwarded(c,current))) == true &*& done == map((relocate)(forwarded(c,current)),prefix); @*/
    //@ decreases count-i;
  {
    //@ open exists(prefix);
    //@ open pointers((void **)p,count-i,rest);
    scavenge_root(p);
    //@ assert pointer((void **)p,?q);
    //@ void *h = head(rest);
    //@ visit v = visit(h,q);
    //@ list<visit> copies = forwarded(c,current);
    //@ frame_processed(c,copies,v,prefix);
    //@ close pointers((void **)p+1,0,nil);
    //@ close pointers((void **)p,1,cons(q,nil));
    //@ pointers_join((void **)start);
    //@ append_assoc(prefix,cons(h,nil),tail(rest));
    //@ visited_snoc(prefix,done,history,h,q);
    //@ map_append((relocate)(after_visit(c,copies,v)),prefix,cons(h,nil));
    //@ forall_append(prefix,cons(h,nil),(settled)(c,after_visit(c,copies,v)));
    //@ close exists(append(prefix,cons(h,nil)));
    //@ i++;
  }
  //@ open exists<list<void *> >(?last);
  //@ open pointers((void **)end,0,_);
}
