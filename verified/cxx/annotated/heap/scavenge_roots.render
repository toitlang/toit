        source->start_ |-> ?fs &*& source->end_ |-> ?fe &*& 0 <= fs &*& fs <= fe &*& fe <= UINTPTR_MAX &*&
        detached_chunk_links(to_chunk) &*& to_chunk->start_ |-> ?ys &*& to_chunk->end_ |-> ?ye &*& 0 <= ys &*& ys <= ye &*& ye <= UINTPTR_MAX &*&
        self->to_.page_type_ |-> _ &*& new_space_storage(&self->to_) &*& self->to_.top_ |-> _ &*& self->to_.limit_ |-> _ &*&
        0 < ys &*& ys % sizeof(word) == 0 &*& pointers_((void **)ys,?words,?slots) &*& 0 < words &*&
        ye == ys+words*sizeof(word) &*& (ye-ys)/sizeof(word) == words &*& to_chunk->owner_ |-> _ &*& page_mapping(ys,ye,true,_) &*& chunk_tables(ys,ye,_); @*/
  /*@ ensures visitor_fields(self,plan(chunk_bounds(fs,fe-fs),chunk_bounds(ys,ye-ys),self,program,&heap->old_space_,w,&self->dummy_record_,initial,false),nil) &*&
        initialized_space(&self->to_,program,to_chunk,ys,ye,slots) &*& heap->water_mark_ |-> w &*& single_chunk(&heap->semi_space_.chunk_list_,source) &*&
        source->start_ |-> fs &*& source->end_ |-> fe &*& to_chunk->start_ |-> ys &*& to_chunk->end_ |-> ye; @*/
  {
    //@ close visitor_fields(self,plan(chunk_bounds(fs,fe-fs),chunk_bounds(ys,ye-ys),self,program,&heap->old_space_,w,&self->dummy_record_,initial,false),nil);
  }

@render src/third_party/dartino/two_space_heap.h toit::ScavengeVisitor::in_from_space tu=src/third_party/dartino/two_space_heap.cc truncating
  inline bool in_from_space(Object* object)
  //@ requires self->from_start_ |-> ?start &*& self->from_size_ |-> ?size &*& 0 <= start &*& start <= UINTPTR_MAX &*& start+size <= UINTPTR_MAX+1;
  //@ ensures self->from_start_ |-> start &*& self->from_size_ |-> size &*& result == (!is_smi_w((uword)object) && contains_address(chunk_bounds(start,size),object));
  //@ terminates;
  {
    if (is_smi(object)) return false;
    //@ word_distance((uword)object,start);
    return reinterpret_cast<uword>(object) - from_start_ < from_size_;
  }

@render src/third_party/dartino/two_space_heap.h toit::ScavengeVisitor::in_to_space tu=src/third_party/dartino/two_space_heap.cc truncating
  inline bool in_to_space(HeapObject* object)
  //@ requires self->to_start_ |-> ?start &*& self->to_size_ |-> ?size &*& 0 <= start &*& start <= UINTPTR_MAX &*& start+size <= UINTPTR_MAX+1;
  //@ ensures self->to_start_ |-> start &*& self->to_size_ |-> size &*& result == contains_address(chunk_bounds(start,size),object);
  //@ terminates;
  {
    //@ word_distance((uword)object,start);
    return reinterpret_cast<uword>(object) - to_start_ < to_size_;
  }

@render src/objects.h toit::HeapObject::has_forwarding_address tu=src/third_party/dartino/two_space_heap.cc
  INLINE bool has_forwarding_address() const
  //@ requires 1 <= (uword)self &*& [?f]pointer((void **)raw(self),?header);
  //@ ensures [f]pointer((void **)raw(self),header) &*& result == is_heap_w((uword)header);
  //@ terminates;
  {
    return is_heap_object(_at(HEADER_OFFSET));
  }

@render src/objects.h toit::HeapObject::forwarding_address tu=src/third_party/dartino/two_space_heap.cc
  INLINE HeapObject* forwarding_address() const
  //@ requires 1 <= (uword)self &*& [?f]pointer((void **)raw(self),?header) &*& is_heap_w((uword)header) == true;
  //@ ensures [f]pointer((void **)raw(self),header) &*& result == header;
  //@ terminates;
  {
    ASSERT(has_forwarding_address());
    return HeapObject::cast(_at(HEADER_OFFSET));
  }

@render src/third_party/dartino/two_space_heap.cc toit::ScavengeVisitor::scavenge_root
inline void ScavengeVisitor::scavenge_root(Object** p)
  //@ requires collection(self,?dest,?history) &*& pointer((void **)p,?original) &*& valid_root(dest,original) == true;
  /*@ ensures pointer((void **)p,?result) &*& collection(self,dest,cons(visit(original,result),history)) &*&
        result == relocate(forwarded(dest,cons(visit(original,result),history)),original); @*/
  //@ terminates;
{
  //@ open collection(self,dest,history);
  //@ open visitor_fields(self,dest,history);
  //@ switch(dest) { case plan(f,y,owner,program,old,w,card,r,g): switch(f) { case chunk_bounds(fs,fn): } switch(y) { case chunk_bounds(ys,yn): } }
  if (!in_from_space(*p)) {
    //@ outside_unchanged(dest,history,original);
    //@ close visitor_fields(self,dest,cons(visit(original,original),history));
    //@ close collection(self,dest,cons(visit(original,original),history));
    return;
  }
  HeapObject* old_object = reinterpret_cast<HeapObject*>(*p);
  //@ list<visit> installed = forwarded(dest,history);
  //@ open forwarding_heap(dest,installed);
  //@ foreach_remove(original,source_objects(dest));
  //@ open source_header(installed)(original);
  if (old_object->has_forwarding_address()) {
    HeapObject* destination = old_object->forwarding_address();
    //@ close source_header(installed)(original);
    //@ foreach_unremove(original,source_objects(dest));
    //@ close forwarding_heap(dest,installed);
    *p = destination;
    if (in_to_space(destination)) *record_ = GcMetadata::NEW_SPACE_POINTERS;
  } else {
    if (old_object->_raw() < water_mark_) {
      HeapObject* moved_object = clone_into_space(program_, old_object, old_);
      // The old space may fill up.  This is a bad moment for a GC, so we
      // promote to the to-space instead.
      if (moved_object == NULL) {
        trigger_old_space_gc_ = true;
        moved_object = clone_into_space(program_, old_object, &to_);
        *record_ = GcMetadata::NEW_SPACE_POINTERS;
      }
      *p = moved_object;
    } else {
      *p = clone_into_space(program_, old_object, &to_);
      *record_ = GcMetadata::NEW_SPACE_POINTERS;
    }
    //@ assert pointer((void **)p,?target);
    //@ fresh_survivor(target,installed);
    //@ close survivor_header(visit(original,target));
    //@ close foreach(cons(visit(original,target),installed),survivor_header);
    //@ open installed_forwarding(original,target);
    //@ distinct_mem_remove(original,source_objects(dest));
    //@ frame_other_headers(installed,original,target,remove(original,source_objects(dest)));
    //@ close source_header(cons(visit(original,target),installed))(original);
    //@ foreach_unremove(original,source_objects(dest));
    //@ close forwarding_heap(dest,cons(visit(original,target),installed));
    ASSERT(*p != NULL);  // In an emergency we can move to to-space.
  }
  //@ assert pointer((void **)p,?value);
  //@ close visitor_fields(self,dest,cons(visit(original,value),history));
  //@ close collection(self,dest,cons(visit(original,value),history));
}

