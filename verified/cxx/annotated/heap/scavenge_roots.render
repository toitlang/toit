@include ../model/model.cfg
@static-member GcMetadata::singleton_
@static-member ObjectMemory::allocated_
@overloaded ScavengeVisitor::clone_into_space
@overloaded GcMetadata::remembered_set_for
@verbatim
#include "semispace.gen.h"
typedef struct AtomicUword { char opaque; } AtomicUword;
extern AtomicUword ObjectMemory_allocated_;
typedef struct TwoSpaceHeap { SemiSpace semi_space_; OldSpace old_space_; uword water_mark_; } TwoSpaceHeap;
// Only fields accessed by the rendered visitor are modeled here.
typedef struct ScavengeVisitor {
  Program *program_;
  SemiSpace to_;
  OldSpace *old_;
  uword from_start_;
  uword from_size_;
  uword to_start_;
  uword to_size_;
  uword water_mark_;
  bool trigger_old_space_gc_;
  uint8 *record_;
  uint8 dummy_record_;
} ScavengeVisitor;

/*@
// The collector fixes the two spaces for one collection.
inductive chunk_bounds = chunk_bounds(uword,uword);
fixpoint bool contains_address(chunk_bounds space,void *p) {
  switch(space) { case chunk_bounds(start,size): return start <= (uword)p && (uword)p < start+size; }
}
fixpoint uword region_start(chunk_bounds space) { switch(space) { case chunk_bounds(start,size): return start; } }
fixpoint uword region_size(chunk_bounds space) { switch(space) { case chunk_bounds(start,size): return size; } }

lemma void word_distance(uword address,uword base)
  requires 0 <= address &*& address <= UINTPTR_MAX &*& 0 <= base &*& base <= UINTPTR_MAX;
  ensures truncate_unsigned(address-base,sizeof(uword)*8) == (base <= address ? address-base : UINTPTR_MAX+1+address-base);
{
  int delta = address-base;
  divrem_intro(delta,UINTPTR_MAX+1,delta < 0 ? -1 : 0,delta < 0 ? UINTPTR_MAX+1+delta : delta);
  truncate_unsigned_def(delta,sizeof(uword) == 8 ? N64 : N32);
}
inductive plan = plan(chunk_bounds,chunk_bounds,
                      ScavengeVisitor *,Program *,OldSpace *,uword,uint8 *,option<uint8>,bool);
fixpoint bool from_space(plan c,void *p) {
  switch(c) { case plan(f,y,owner,program,old,w,card,r,g): return !is_smi_w((uword)p) && contains_address(f,p); }
}
fixpoint bool young_destination(plan c,void *p) {
  switch(c) { case plan(f,y,owner,program,old,w,card,r,g): return contains_address(y,p); }
}
fixpoint ScavengeVisitor *visitor_of(plan c) {
  switch(c) { case plan(f,y,owner,program,old,w,card,r,g): return owner; }
}
fixpoint Program *program_of(plan c) {
  switch(c) { case plan(f,y,owner,program,old,w,card,r,g): return program; }
}
fixpoint OldSpace *old_space_of(plan c) {
  switch(c) { case plan(f,y,owner,program,old,w,card,r,g): return old; }
}
inductive visit = visit(void *source,void *target);
fixpoint void *source(visit v) { switch(v) { case visit(p,q): return p; } }
fixpoint void *target(visit v) { switch(v) { case visit(p,q): return q; } }

fixpoint void *relocate(list<visit> copies,void *p) {
  switch(copies) {
    case nil: return p;
    case cons(v,t): return source(v) == p ? target(v) : relocate(t,p);
  }
}
fixpoint list<visit> after_visit(plan c,list<visit> copies,visit v) {
  return from_space(c,source(v)) && !mem(source(v),map(source,copies)) ? cons(v,copies) : copies;
}
fixpoint list<visit> forwarded(plan c,list<visit> history) {
  switch(history) {
    case nil: return nil;
    case cons(v,t): return after_visit(c,forwarded(c,t),v);
  }
}
lemma void outside_unchanged(plan c,list<visit> history,void *p)
  requires !from_space(c,p);
  ensures relocate(forwarded(c,history),p) == p;
{
  switch(history) { case nil: case cons(v,t): outside_unchanged(c,t,p); }
}
fixpoint bool young_reference(plan c,visit v) {
  return from_space(c,source(v)) && young_destination(c,target(v));
}
fixpoint option<uint8> recorded(plan c,list<visit> history,option<uint8> initial) {
  switch(history) {
    case nil: return initial;
    case cons(v,t): return young_reference(c,v) ? some((uint8)GcMetadata_NEW_SPACE_POINTERS) : recorded(c,t,initial);
  }
}
fixpoint bool requested(plan c,list<visit> history,uword watermark,bool initial) {
  switch(history) {
    case nil: return initial;
    case cons(v,t): return requested(c,t,watermark,initial) ||
        (young_reference(c,v) && !mem(source(v),map(source,forwarded(c,t))) && (uword)source(v)-1 < watermark);
  }
}
fixpoint bool settled(plan c,list<visit> copies,void *p) {
  return !from_space(c,p) || mem(p,map(source,copies));
}
lemma void frame_processed(plan c,list<visit> copies,visit v,list<void *> prefix)
  requires forall(prefix,(settled)(c,copies)) == true;
  ensures forall(prefix,(settled)(c,after_visit(c,copies,v))) == true &*&
          map((relocate)(after_visit(c,copies,v)),prefix) == map((relocate)(copies),prefix);
{
  switch(prefix) {
    case nil:
    case cons(h,t): frame_processed(c,copies,v,t);
  }
}

// The collection starts with an inventory of valid source objects.
fixpoint list<void *> source_objects(plan c);
fixpoint bool valid_root(plan c,void *p) {
  return !from_space(c,p) || mem(p,source_objects(c));
}
predicate_ctor source_header(list<visit> installed)(void *p) =
  1 <= (uword)p &*& pointer((void **)raw(p),?header) &*&
  is_heap_w((uword)header) == mem(p,map(source,installed)) &*&
  (mem(p,map(source,installed)) ? header == relocate(installed,p) : true);
predicate forwarding_heap(plan c,list<visit> installed) =
  distinct(source_objects(c)) == true &*& foreach(source_objects(c),(source_header)(installed));

// Adding one forwarding entry leaves the physical headers of all other objects intact.
lemma void frame_other_headers(list<visit> installed,void *original,void *destination,list<void *> others)
  requires !mem(original,others) &*& foreach(others,(source_header)(installed));
  ensures foreach(others,(source_header)(cons(visit(original,destination),installed)));
{
  switch(others) {
    case nil:
      open foreach(others,_);
      close foreach(others,(source_header)(cons(visit(original,destination),installed)));
    case cons(h,t):
      open foreach(others,_);
      open source_header(installed)(h);
      close source_header(cons(visit(original,destination),installed))(h);
      frame_other_headers(installed,original,destination,t);
      close foreach(others,(source_header)(cons(visit(original,destination),installed)));
  }
}
predicate survivor_header(visit v) = copied_header(target(v),_);
lemma void fresh_survivor(void *destination,list<visit> copies)
  requires copied_header(destination,?bytes) &*& foreach(copies,survivor_header);
  ensures copied_header(destination,bytes) &*& foreach(copies,survivor_header) &*& !mem(destination,map(target,copies));
{
  switch(copies) {
    case nil:
    case cons(v,t):
      open foreach(copies,survivor_header);
      if (destination == target(v)) {
        open copied_header(destination,bytes);
        open survivor_header(v);
        open copied_header(target(v),_);
        chars_to_pointer(raw(destination));
        chars_to_pointer(raw(target(v)));
        pointer_distinct(raw(destination),raw(target(v)));
      }
      fresh_survivor(destination,t);
      close foreach(copies,survivor_header);
  }
}
// The allocator retains the payloads and unused storage. The visitor holds the copied headers.
predicate copy_storage(plan c,list<visit> installed);
predicate visitor_fields(ScavengeVisitor *visitor,plan c,list<visit> history) =
  switch(c) { case plan(f,y,owner,program,old,w,card,r,g): return
    visitor->from_start_ |-> region_start(f) &*& visitor->from_size_ |-> region_size(f) &*&
    visitor->to_start_ |-> region_start(y) &*& visitor->to_size_ |-> region_size(y) &*&
    0 <= region_start(f) &*& region_start(f) <= UINTPTR_MAX &*& 0 <= region_start(y) &*& region_start(y) <= UINTPTR_MAX &*&
    region_start(f)+region_size(f) <= UINTPTR_MAX+1 &*& region_start(y)+region_size(y) <= UINTPTR_MAX+1 &*&
    visitor == owner &*& pointer_within_limits(&visitor->to_) == true &*&
    visitor->program_ |-> program &*& visitor->old_ |-> old &*& visitor->water_mark_ |-> w &*&
    visitor->trigger_old_space_gc_ |-> requested(c,history,w,g) &*& visitor->record_ |-> card &*&
    uchar_(card,recorded(c,history,r));
  };

predicate collection(ScavengeVisitor *visitor,plan c,list<visit> history) =
  visitor_fields(visitor,c,history) &*& foreach(forwarded(c,history),survivor_header) &*&
  distinct(map(target,forwarded(c,history))) == true &*& copy_storage(c,forwarded(c,history)) &*&
  forwarding_heap(c,forwarded(c,history));

predicate chunk_sequence(ChunkList *list; list<Chunk *> entries);
predicate single_chunk(ChunkList *list; Chunk *chunk) =
  chunk_sequence(list,?entries) &*& chunk == head(entries) &*& entries == cons(chunk,nil);
predicate chunk_list_storage(ChunkList *list;);
predicate empty_chunk_list(ChunkList *list;) = chunk_sequence(list,nil);
predicate retirement_history(list<Chunk *> history);
predicate detached_chunk_links(Chunk *chunk;);
predicate chunk_link_storage(Chunk *chunk;);
predicate invalid_chunk_abort();
predicate removable_chunk(ChunkList *list,Chunk *chunk) =
  chunk == 0 ? empty_chunk_list(list) : single_chunk(list,chunk);
predicate new_space_storage(SemiSpace *space;) =
  space->program_ |-> _ &*& pointer_within_limits(&space->chunk_list_) == true &*& chunk_list_storage(&space->chunk_list_);
predicate empty_space(SemiSpace *space; Program *program) =
  space->program_ |-> program &*& pointer_within_limits(&space->chunk_list_) == true &*& empty_chunk_list(&space->chunk_list_);
predicate attached_chunk(SemiSpace *space,Program *program,Chunk *chunk) =
  space->program_ |-> program &*& single_chunk(&space->chunk_list_,chunk);
// Global mappings supply exclusive ownership of the metadata slices for this chunk.
predicate owner_type(Space *space; int kind) =
  space == 0 ? kind == UNKNOWN_SPACE_PAGE : space->page_type_ |-> kind;
fixpoint int page_index(int bytes) { return bytes/TOIT_PAGE_SIZE; }
predicate page_mapping(uword lo,uword hi; bool mapped,list<option<uint8> > entries) =
  [_]GcMetadata_singleton_.lowest_address_ |-> ?lowest &*& [_]GcMetadata_singleton_.heap_extent_ |-> ?extent &*&
  [_]GcMetadata_singleton_.page_type_bytes_ |-> ?table &*&
  0 <= lowest &*& lowest <= UINTPTR_MAX &*& 0 <= extent &*& lowest+extent <= UINTPTR_MAX+1 &*&
  0 <= lo &*& lo <= hi &*& hi <= UINTPTR_MAX &*&
  mapped == (lowest <= lo && lo < lowest+extent) &*&
  (mapped ? hi <= lowest+extent &*& (lo-lowest) % TOIT_PAGE_SIZE == 0 &*&
            (hi-lo) % TOIT_PAGE_SIZE == 0 &*&
            pointer_within_limits(table+page_index(lo-lowest)) == true &*&
            uchars_(table+page_index(lo-lowest),page_index(hi-lo),entries) : entries == nil);
predicate classified_pages(uword lo,uword hi,int kind) =
  page_mapping(lo,hi,true,?entries) &*& all_eq(entries,some((uint8)kind)) == true;
predicate reserved_pages(uword start,uword size;);
predicate released_pages(uword start,uword size;);
predicate charged_bytes(AtomicUword *counter,uword amount;);
predicate charge_room(AtomicUword *counter,uword amount;);
predicate chunk_table_reservation(uword lo,uword hi;);
predicate debited_bytes(AtomicUword *counter,uword amount;);
predicate descriptor_storage(Chunk *chunk;);
predicate retirable_chunk(Chunk *chunk) =
  chunk->start_ |-> ?lo &*& chunk->end_ |-> ?hi &*& lo < hi &*&
  page_mapping(lo,hi,true,_) &*& reserved_pages(lo,hi-lo) &*& charged_bytes(&ObjectMemory_allocated_,hi-lo) &*&
  descriptor_storage(chunk) &*& chunk->owner_ |-> _ &*& chunk->scavenge_pointer_ |-> _;
predicate removable_descriptor(Chunk *entry,Space *space; uword lo,uword hi) =
  entry == 0 ? lo == 0 &*& hi == 0 :
    entry->owner_ |-> space &*& entry->start_ |-> lo &*& entry->end_ |-> hi &*&
    0 <= lo &*& lo < hi &*& page_mapping(lo,hi,true,_);
fixpoint int mark_index(int address) { return address/(8*sizeof(word)); }
predicate mark_bytes(uword lo,uword hi; bool clear) =
  [_]GcMetadata_singleton_.mark_bits_bias_ |-> ?bias &*&
  lo % (8*sizeof(word)) == 0 &*& (hi-lo) % (8*sizeof(word)) == 0 &*&
  uchars_(table_address(mark_index(lo),bias),mark_index(hi-lo),?values) &*& clear == all_eq(values,some((uint8)0));
fixpoint int overflow_index(uword address) { return address/(8*GcMetadata_CARD_SIZE); }
predicate table_slice(uint8 *first,uint8 *end,int bytes; bool clear) =
  0 <= bytes &*& bytes <= UINTPTR_MAX/2 &*& end == first+bytes &*&
  uchars_(first,bytes,?values) &*& clear == all_eq(values,some((uint8)0));
predicate remembered_slice(uword lo,uword hi; bool clear) =
  [_]GcMetadata_singleton_.remembered_set_bias_ |-> ?bias &*&
  table_slice(table_address(card(lo),bias),table_address(card(hi),bias),card(hi)-card(lo),clear);
predicate overflow_slice(uword lo,uword hi; bool clear) =
  [_]GcMetadata_singleton_.overflow_bits_bias_ |-> ?bias &*&
  table_slice(table_address(overflow_index(lo),bias),table_address(overflow_index(hi),bias),overflow_index(hi)-overflow_index(lo),clear);
predicate chunk_tables(uword lo,uword hi; bool clean) =
  mark_bytes(lo,hi,?marked) &*& starts_state(lo,hi,?starts) &*&
  remembered_slice(lo,hi,?remembered) &*&
  overflow_slice(lo,hi,?overflow) &*&
  clean == (marked && starts && remembered && overflow);
predicate borrowed_chunk(Chunk *chunk; uword lo,uword hi,list<option<void *> > slots) =
  chunk == 0 ? lo == 0 &*& hi == 0 &*& slots == nil :
    detached_chunk_links(chunk) &*& chunk->start_ |-> lo &*& chunk->end_ |-> hi &*& 0 < lo &*& lo % sizeof(word) == 0 &*&
    pointers_((void **)lo,(hi-lo)/sizeof(word),slots) &*& 0 < length(slots) &*& hi == lo+length(slots)*sizeof(word);
predicate initialized_space(SemiSpace *space,Program *program,Chunk *chunk,uword lo,uword hi,list<option<void *> > slots) =
  attached_chunk(space,program,chunk) &*& chunk->owner_ |-> space &*& space->page_type_ |-> NEW_SPACE_PAGE &*&
  classified_pages(lo,hi,NEW_SPACE_PAGE) &*& chunk_tables(lo,hi,true) &*& space->top_ |-> lo &*& space->limit_ |-> hi &*&
  pointer((void **)lo,0) &*& pointers_((void **)lo+1,length(slots)-1,tail(slots));

// Reverse chronological history after visiting corresponding input and output slots.
fixpoint list<visit> visited(list<void *> inputs,list<void *> outputs,list<visit> history) {
  switch(inputs) {
    case nil: return history;
    case cons(h,t): return visited(t,tail(outputs),cons(visit(h,head(outputs)),history));
  }
}
lemma void visited_snoc(list<void *> inputs,list<void *> outputs,list<visit> history,void *p,void *q)
  requires length(inputs) == length(outputs);
  ensures visited(append(inputs,cons(p,nil)),append(outputs,cons(q,nil)),history) ==
          cons(visit(p,q),visited(inputs,outputs,history));
{
  switch(inputs) {
    case nil: switch(outputs) { case nil: case cons(x,xs): }
    case cons(h,t): switch(outputs) { case nil: case cons(q0,qs): visited_snoc(t,qs,cons(visit(h,q0),history),p,q); }
  }
}
@*/

