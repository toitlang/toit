}

@render src/third_party/dartino/object_memory_copying.cc toit::SemiSpace::append
void SemiSpace::append(Chunk* chunk)
  /*@ requires self != 0 &*& empty_space(self,?program) &*& detached_chunk_links(chunk) &*&
        self->page_type_ |-> NEW_SPACE_PAGE &*& chunk->owner_ |-> _ &*&
        chunk->start_ |-> ?lo &*& chunk->end_ |-> ?hi &*& 0 <= lo &*& lo < hi &*&
        page_mapping(lo,hi,true,_) &*& chunk_tables(lo,hi,_); @*/
  /*@ ensures attached_chunk(self,program,chunk) &*& self->page_type_ |-> NEW_SPACE_PAGE &*&
        chunk->owner_ |-> self &*& chunk->start_ |-> lo &*& chunk->end_ |-> hi &*&
        classified_pages(lo,hi,NEW_SPACE_PAGE) &*& chunk_tables(lo,hi,true); @*/
{
  //@ open empty_space(self,program);
  //@ close owner_type(self,NEW_SPACE_PAGE);
  chunk->set_owner(this);
  //@ open owner_type(self,NEW_SPACE_PAGE);
  chunk_list_.append(chunk);
  //@ close attached_chunk(self,program,chunk);
}

@render src/third_party/dartino/object_memory_copying.cc toit::SemiSpace::SemiSpace
SemiSpace::SemiSpace(Program* program, Chunk* chunk)
    : Space(program, CANNOT_RESIZE, NEW_SPACE_PAGE)
  /*@ requires self != 0 &*& self->page_type_ |-> _ &*& new_space_storage(self) &*& self->top_ |-> _ &*& self->limit_ |-> _ &*&
        borrowed_chunk(chunk,?lo,?hi,?slots) &*& (chunk != 0 ? chunk->owner_ |-> _ &*& page_mapping(lo,hi,true,_) &*& chunk_tables(lo,hi,_) : true); @*/
  /*@ ensures chunk == 0 ? self->page_type_ |-> NEW_SPACE_PAGE &*& empty_space(self,program) &*& self->top_ |-> 0 &*& self->limit_ |-> 0 :
        chunk->start_ |-> lo &*& chunk->end_ |-> hi &*& initialized_space(self,program,chunk,lo,hi,slots); @*/
{
  //@ open borrowed_chunk(chunk,lo,hi,slots);
  if (!chunk) return;
  append(chunk);
  //@ open classified_pages(lo,hi,NEW_SPACE_PAGE);
  //@ open page_mapping(lo,hi,true,?entries);
  //@ close page_mapping(lo,hi,true,entries);
  //@ open chunk_tables(lo,hi,_);
  update_base_and_limit(chunk, chunk->start());
  //@ close chunk_tables(lo,hi,_);
  //@ close owner_type(self,NEW_SPACE_PAGE);
  chunk->set_owner(this);
  //@ open owner_type(self,NEW_SPACE_PAGE);
  //@ close initialized_space(self,program,chunk,lo,hi,slots);
}

