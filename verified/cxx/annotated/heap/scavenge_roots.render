@render src/third_party/dartino/object_memory.cc toit::Chunk::Chunk
Chunk::Chunk(Space* owner, uword start, uword size)
      : owner_(owner),
        start_(start),
        end_(start + size),
        scavenge_pointer_(start_)
  /*@ requires chunk_link_storage(self) &*& self->owner_ |-> _ &*& self->start_ |-> _ &*& self->end_ |-> _ &*&
        self->scavenge_pointer_ |-> _ &*& start+size <= UINTPTR_MAX &*&
        [_]GcMetadata_singleton_.lowest_address_ |-> ?base &*& [_]GcMetadata_singleton_.heap_extent_ |-> ?extent &*&
        (metadata_contains(base,extent,start) ? true : invalid_chunk_abort()); @*/
  /*@ ensures metadata_contains(base,extent,start) == true &*& detached_chunk_links(self) &*& self->owner_ |-> owner &*& self->start_ |-> start &*&
        self->end_ |-> start+size &*& self->scavenge_pointer_ |-> start; @*/
{
  if (!GcMetadata::in_metadata_range(start)) {
    FATAL("Not in metadata range: %p\n", (void*)start);
  }
}

