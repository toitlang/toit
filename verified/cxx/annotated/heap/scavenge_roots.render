@render src/third_party/dartino/object_memory.cc toit::Chunk::~Chunk
Chunk::~Chunk()
  /*@ requires self->start_ |-> ?lo &*& self->end_ |-> ?hi &*& lo < hi &*&
        page_mapping(lo,hi,true,_) &*& reserved_pages(lo,hi-lo); @*/
  /*@ ensures self->start_ |-> lo &*& self->end_ |-> hi &*&
        classified_pages(lo,hi,UNKNOWN_SPACE_PAGE) &*& released_pages(lo,hi-lo); @*/
