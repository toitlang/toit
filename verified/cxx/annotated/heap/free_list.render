@verbatim
#include "../model/objects.gen.h"
#include "free_region.h"
typedef uword size_t;
struct FreeList { FreeListRegion *buckets_[FreeList_NUMBER_OF_BUCKETS]; };
typedef struct FreeList FreeList;

/*@
inductive region = region_entry(pair<FreeListRegion *, int>);
fixpoint region region(FreeListRegion *p, int n) { return region_entry(pair(p,n)); }
fixpoint FreeListRegion *address(region r) { switch (r) { case region_entry(e): return fst(e); } }
fixpoint int extent(region r) { switch (r) { case region_entry(e): return snd(e); } }
fixpoint FreeListRegion *first_fit(list<region> items, int size) {
  switch (items) {
    case nil: return 0;
    case cons(h,t): return extent(h) >= size ? address(h) : first_fit(t,size);
  }
}
fixpoint list<region> remaining(list<region> items, int size) {
  switch (items) {
    case nil: return nil;
    case cons(h,t): return extent(h) >= size ? t : cons(h,remaining(t,size));
  }
}

// Count bytes in chainable regions. Short fillers are outside the free list.
fixpoint int chain_bytes(list<region> xs) {
  switch(xs) { case nil: return 0; case cons(h,t): return (extent(h) > 0 ? extent(h) : 0) + chain_bytes(t); }
}
fixpoint int free_bytes(list<list<region> > bs) {
  switch(bs) { case nil: return 0; case cons(h,t): return chain_bytes(h) + free_bytes(t); }
}
fixpoint int fit_bytes(list<region> xs, int size) {
  switch(xs) { case nil: return 0; case cons(h,t): return extent(h) >= size ? extent(h) : fit_bytes(t,size); }
}
lemma void chain_bytes_nonnegative(list<region> xs)
  requires true;
  ensures chain_bytes(xs) >= 0;
{
  switch(xs) { case nil: case cons(h,t): chain_bytes_nonnegative(t); }
}
lemma void free_bytes_nonnegative(list<list<region> > bs)
  requires true;
  ensures free_bytes(bs) >= 0;
{
  switch(bs) { case nil: case cons(h,t): chain_bytes_nonnegative(h); free_bytes_nonnegative(t); }
}
lemma void replace_bytes(list<list<region> > bs, int i, list<region> xs)
  requires 0 <= i &*& i < length(bs);
  ensures free_bytes(update(i,xs,bs)) == free_bytes(bs) - chain_bytes(nth(i,bs)) + chain_bytes(xs);
{
  switch(bs) { case nil: case cons(h,t): if (i != 0) replace_bytes(t,i-1,xs); }
}
lemma void remove_bytes(list<region> xs, int size)
  requires size > 0;
  ensures chain_bytes(remaining(xs,size)) + fit_bytes(xs,size) == chain_bytes(xs);
{
  switch(xs) { case nil: case cons(h,t): if (extent(h) < size) remove_bytes(t,size); }
}

// Ownership of a chainable region, including its payload, follows its link.
predicate block(FreeListRegion *p, int size, FreeListRegion *next) =
  region_storage(p,?base,?count,next,?slots) &*& size == count * sizeof(word);
predicate chain(FreeListRegion *p, list<region> items) =
  p == 0 ? items == nil :
    block(p, ?n, ?next) &*& chain(next, ?tail) &*& items == cons(region(p,n),tail);

// Keep the last skipped node separately so its link can be rewritten.
predicate skipped(FreeListRegion *p, FreeListRegion *stop, list<region> items, int min) =
  switch (items) {
    case nil: return p == stop;
    case cons(h,t): return p != 0 &*& p == address(h) &*& extent(h) < min &*&
      block(p, extent(h), ?next) &*& skipped(next,stop,t,min);
  };

lemma void extend_skipped(FreeListRegion *p, FreeListRegion *last, FreeListRegion *next, list<region> xs, int min, int n)
  requires skipped(p,last,xs,min) &*& last != 0 &*& block(last,n,next) &*& n < min;
  ensures skipped(p,next,append(xs,cons(region(last,n),nil)),min);
{
  open skipped(p,last,xs,min);
  switch (xs) {
    case nil:
      close skipped(next,next,nil,min);
    case cons(h,t):
      assert block(p,extent(h),?q);
      extend_skipped(q,last,next,t,min,n);
  }
  close skipped(p,next,append(xs,cons(region(last,n),nil)),min);
}

lemma void restore_skipped(FreeListRegion *p, FreeListRegion *stop, list<region> xs, int min)
  requires skipped(p,stop,xs,min) &*& chain(stop,?ys);
  ensures chain(p,append(xs,ys));
{
  open skipped(p,stop,xs,min);
  switch (xs) {
    case nil:
    case cons(h,t):
      assert block(p,extent(h),?q);
      restore_skipped(q,stop,t,min);
      switch (h) { case region_entry(e): switch(e) { case pair(a,n): } }
      close chain(p,append(xs,ys));
  }
}

fixpoint int size_bucket(int n) {
  return n < 2 ? 0 : n < 4 ? 1 : n < 8 ? 2 : n < 16 ? 3 : n < 32 ? 4 :
         n < 64 ? 5 : n < 128 ? 6 : n < 256 ? 7 : n < 512 ? 8 : n < 1024 ? 9 : n < 2048 ? 10 : 11;
}
fixpoint bool in_bucket(int i, region r) { return extent(r) > 0 && size_bucket(extent(r)) == i; }
fixpoint bool empty_bank(list<region> xs) { return xs == nil; }
fixpoint int highest_nonempty(list<list<region> > bs) {
  switch (bs) {
    case nil: return -1;
    case cons(h,t): return highest_nonempty(t) >= 0 ? 1 + highest_nonempty(t) : h == nil ? -1 : 0;
  }
}
fixpoint int search_bucket(list<list<region> > bs, int size) {
  return highest_nonempty(bs) > size_bucket(size) ? highest_nonempty(bs) : size_bucket(size);
}
fixpoint list<region> searched_regions(list<list<region> > bs, int size) {
  return nth(search_bucket(bs,size),bs);
}
fixpoint list<list<region> > banks_after_search(list<list<region> > bs, int size) {
  return update(search_bucket(bs,size),remaining(searched_regions(bs,size),size),bs);
}
lemma void all_banks_empty(list<list<region> > bs)
  requires forall(bs,empty_bank) == true;
  ensures highest_nonempty(bs) == -1;
{
  switch(bs) { case nil: case cons(h,t): all_banks_empty(t); }
}
lemma void highest_bank_bound(list<list<region> > bs, int i)
  requires 0 <= i &*& i < length(bs) &*& forall(drop(i+1,bs),empty_bank) == true;
  ensures highest_nonempty(bs) <= i &*& (nth(i,bs) != nil ? highest_nonempty(bs) == i : true);
{
  switch(bs) {
    case nil:
    case cons(h,t): if (i == 0) all_banks_empty(t); else highest_bank_bound(t,i-1);
  }
}
// Bucket contents after returning the active suffix to the free list.
fixpoint list<list<region> > flushed_banks(list<list<region> > banks, FreeListRegion *inserted, int bytes) {
  return inserted == 0 ? banks : update(size_bucket(bytes),cons(region(inserted,bytes),nth(size_bucket(bytes),banks)),banks);
}
predicate bank(FreeListRegion **cell, int i, list<region> xs) =
  *cell |-> ?root &*& chain(root,xs) &*& forall(xs,(in_bucket)(i)) == true;
predicate banks(FreeListRegion **cells, int i, list<list<region> > bs) =
  switch (bs) {
    case nil: return true;
    case cons(h,t): return bank(cells,i,h) &*& banks(cells+1,i+1,t);
  };
// Clearing the bucket heads leaves every previous chain available to sweep.
fixpoint list<list<region> > empty_banks_like(list<list<region> > bs) {
  switch(bs) { case nil: return nil; case cons(h,t): return cons(nil,empty_banks_like(t)); }
}
predicate detached_banks(list<list<region> > bs) =
  switch(bs) {
    case nil: return true;
    case cons(h,t): return chain(?root,h) &*& detached_banks(t);
  };
lemma void detach_banks(FreeListRegion **cells, int i, list<list<region> > bs)
  requires banks(cells,i,bs);
  ensures pointers((void **)cells,length(bs),_) &*& detached_banks(bs);
{
  open banks(cells,i,bs);
  switch(bs) {
    case nil: close pointers((void **)cells,0,nil);
    case cons(h,t):
      open bank(cells,i,h);
      detach_banks(cells+1,i+1,t);
      close pointers((void **)cells,length(bs),_);
  }
  close detached_banks(bs);
}
fixpoint bool null_head(void *p) { return p == 0; }
lemma void install_empty_banks(FreeListRegion **cells, int i, list<list<region> > bs)
  requires pointers((void **)cells,length(bs),?heads) &*& forall(heads,null_head) == true;
  ensures banks(cells,i,empty_banks_like(bs));
{
  open pointers((void **)cells,length(bs),heads);
  switch(bs) {
    case nil:
    case cons(h,t):
      close chain(0,nil);
      close bank(cells,i,nil);
      install_empty_banks(cells+1,i+1,t);
  }
  close banks(cells,i,empty_banks_like(bs));
}
predicate before_bank(FreeListRegion **cells, int i, list<list<region> > bs, int count) =
  count == 0 ? true : bank(cells,i,head(bs)) &*& before_bank(cells+1,i+1,tail(bs),count-1);

lemma void focus_bank(FreeListRegion **cells, int i, list<list<region> > bs, int k)
  requires banks(cells,i,bs) &*& 0 <= k &*& k < length(bs);
  ensures before_bank(cells,i,bs,k) &*& bank(cells+k,i+k,nth(k,bs)) &*& banks(cells+k+1,i+k+1,drop(k+1,bs));
{
  open banks(cells,i,bs);
  switch(bs) {
    case nil:
    case cons(h,t):
      if (k != 0) focus_bank(cells+1,i+1,t,k-1);
      close before_bank(cells,i,bs,k);
  }
}

lemma void replace_bank(FreeListRegion **cells, int i, list<list<region> > bs, int k, list<region> xs)
  requires before_bank(cells,i,bs,k) &*& bank(cells+k,i+k,xs) &*& banks(cells+k+1,i+k+1,drop(k+1,bs)) &*& 0 <= k &*& k < length(bs);
  ensures banks(cells,i,update(k,xs,bs));
{
  open before_bank(cells,i,bs,k);
  switch(bs) {
    case nil:
    case cons(h,t):
      if (k != 0) replace_bank(cells+1,i+1,t,k-1,xs);
      close banks(cells,i,update(k,xs,bs));
  }
}

lemma void skip_empty(int i, list<list<region> > bs)
  requires 0 <= i &*& i < length(bs) &*& nth(i,bs) == nil &*& forall(drop(i+1,bs),empty_bank) == true;
  ensures forall(drop(i,bs),empty_bank) == true &*& update(i,nth(i,bs),bs) == bs;
{
  switch (bs) { case nil: case cons(h,t): if (i != 0) skip_empty(i-1,t); }
}

lemma void remove_fit(int i, list<region> xs, int size)
  requires forall(xs,(in_bucket)(i)) == true;
  ensures forall(remaining(xs,size),(in_bucket)(i)) == true;
{
  switch(xs) { case nil: case cons(h,t): if (extent(h) < size) remove_fit(i,t,size); }
}
@*/
int Utils_clz(uword size);
//@ requires size > 0;
//@ ensures 0 <= result &*& result < 8 * sizeof(word) &*& size_bucket(size) == (8 * sizeof(word) - result >= 12 ? 11 : 8 * sizeof(word) - result - 1);
//@ terminates;

@render src/objects.h toit::FreeListRegion::cast type=FreeListRegion*(Object*) tu=src/third_party/dartino/object_memory_mark_sweep.cc
  static FreeListRegion* cast(Object* value)
  //@ requires true;
  //@ ensures result == value;
  {
    ASSERT(is_free_list_region(value));
    return static_cast<FreeListRegion*>(value);
  }

