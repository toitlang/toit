  FreeListRegion* next_region()
  //@ requires block(self,?n,?next);
  //@ ensures block(self,n,next) &*& result == next;
  {
    ASSERT(can_be_daisychained());
    //@ open block(self,n,next);
    //@ open region_storage(self,?base,?count,next,?slots);
    //@ open pointers_((void **)base,count,slots);
    //@ open pointers_((void **)base+1,count-1,_);
    //@ open pointers_((void **)base+2,count-2,_);
    Object* result = _at(NEXT_OFFSET);
    //@ close pointers_((void **)base+2,count-2,drop(2,slots));
    //@ close pointers_((void **)base+1,count-1,tail(slots));
    //@ close pointers_((void **)base,count,slots);
    //@ close region_storage(self,base,count,next,slots);
    //@ close block(self,n,next);
    if (result == null) return null;
    return FreeListRegion::cast(result);
  }

