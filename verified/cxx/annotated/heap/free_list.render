@render src/third_party/dartino/object_memory.h toit::FreeList::add_region tu=src/third_party/dartino/object_memory_mark_sweep.cc
  void add_region(uword free_start, uword free_size)
  /*@ requires free_storage(free_start,free_size) &*& banks(self->buckets_,0,?bs) &*& length(bs) == 12; @*/
  /*@ ensures free_table_after(self,bs,free_start,free_size); @*/
  //@ terminates;
  {
    FreeListRegion* result = FreeListRegion::create_at(free_start, free_size);
    if (!result) {
      //@ close free_table_after(self,bs,free_start,free_size);
      return;
    }
    const int WORD_BITS = sizeof(uword) * BYTE_BIT_SIZE;
    int bucket = WORD_BITS - Utils::clz(free_size) - 1;
    if (bucket >= NUMBER_OF_BUCKETS) bucket = NUMBER_OF_BUCKETS - 1;
    //@ focus_bank(self->buckets_,0,bs,bucket);
    //@ open bank(self->buckets_+bucket,bucket,nth(bucket,bs));
    result->set_next_region(buckets_[bucket]);
    buckets_[bucket] = result;
    //@ list<region> xs = cons(region(result,free_size),nth(bucket,bs));
    //@ close chain(result,xs);
    //@ close bank(self->buckets_+bucket,bucket,xs);
    //@ replace_bank(self->buckets_,0,bs,bucket,xs);
    //@ close exists(result);
    //@ close free_table_after(self,bs,free_start,free_size);
  }

@render src/third_party/dartino/object_memory.h toit::FreeList::take_first_fit tu=src/third_party/dartino/object_memory_mark_sweep.cc
  static FreeListRegion* take_first_fit(FreeListRegion** head, uword min_size)
  /*@ requires *head |-> ?p &*& chain(p,?items); @*/
  /*@ ensures *head |-> ?q &*& chain(q,remaining(items,min_size)) &*& result == first_fit(items,min_size) &*&
              (result == 0 ? fit_bytes(items,min_size) == 0 : block(result,fit_bytes(items,min_size),0) &*& min_size <= fit_bytes(items,min_size)); @*/
  {
    FreeListRegion* previous = null;
    FreeListRegion* current = *head;
    //@ list<region> prefix = nil;
    while (current != null)
    /*@ invariant *head |-> ?root &*& chain(current,?tail) &*&
          first_fit(items,min_size) == first_fit(tail,min_size) &*& fit_bytes(items,min_size) == fit_bytes(tail,min_size) &*&
          (previous == 0 ? root == current &*& prefix == nil &*& remaining(items,min_size) == remaining(tail,min_size) :
            skipped(root,previous,prefix,min_size) &*& block(previous,?pn,current) &*& pn < min_size &*&
            remaining(items,min_size) == append(prefix,cons(region(previous,pn),remaining(tail,min_size)))); @*/
    {
      //@ open chain(current,tail);
      //@ open block(current,_,_);
      if (current->size() >= min_size) {
        //@ close block(current,_,_);
        if (previous != null) {
          previous->set_next_region(current->next_region());
          //@ assert block(previous,?pn,?after);
          //@ assert chain(after,?ys);
          //@ close chain(previous,cons(region(previous,pn),ys));
          //@ restore_skipped(root,previous,prefix,min_size);
        } else {
          *head =
              reinterpret_cast<FreeListRegion*>(current->next_region());
        }
        current->set_next_region(null);
        return current;
      }
      //@ close block(current,_,_);
      /*@ if (previous == 0) {
        close skipped(root,current,nil,min_size);
      } else {
        assert block(previous,?pn,current);
        extend_skipped(root,previous,current,prefix,min_size,pn);
        append_assoc(prefix,cons(region(previous,pn),nil),remaining(tail,min_size));
        prefix = append(prefix,cons(region(previous,pn),nil));
      } @*/
      previous = current;
      current = reinterpret_cast<FreeListRegion*>(current->next_region());
    }

    /*@ { open chain(current,tail);
        close chain(current,nil);
        if (previous != 0) {
          assert block(previous,?pn,current);
          close chain(previous,cons(region(previous,pn),nil));
          restore_skipped(root,previous,prefix,min_size);
        } } @*/
    return null;
  }

@render src/third_party/dartino/object_memory.h toit::FreeList::get_region tu=src/third_party/dartino/object_memory_mark_sweep.cc
  FreeListRegion* get_region(uword min_size)
  /*@ requires banks(self->buckets_,0,?bs) &*& length(bs) == 12 &*& min_size > 0; @*/
  /*@ ensures exists<int>(?i) &*& size_bucket(min_size) <= i &*& i < 12 &*& forall(drop(i+1,bs),empty_bank) == true &*&
              banks(self->buckets_,0,update(i,remaining(nth(i,bs),min_size),bs)) &*&
              result == first_fit(nth(i,bs),min_size) &*&
              free_bytes(update(i,remaining(nth(i,bs),min_size),bs)) == free_bytes(bs) - fit_bytes(nth(i,bs),min_size) &*&
              (result == 0 ? i == size_bucket(min_size) &*& fit_bytes(nth(i,bs),min_size) == 0 :
                block(result,fit_bytes(nth(i,bs),min_size),0) &*& fit_bytes(nth(i,bs),min_size) >= min_size); @*/
  {
    const int WORD_BITS = sizeof(uword) * BYTE_BIT_SIZE;
    int smallest_bucket = WORD_BITS - Utils::clz(min_size);
    ASSERT(smallest_bucket > 0);

    // Take the first region in the largest list guaranteed to satisfy the
    // allocation.
    //@ drop_length(bs);
    for (int i = NUMBER_OF_BUCKETS - 1; i >= smallest_bucket; i--)
    /*@ invariant banks(self->buckets_,0,bs) &*& i < 12 &*& 0 <= i &*&
                  size_bucket(min_size) <= i &*& forall(drop(i+1,bs),empty_bank) == true; @*/
    {
      //@ focus_bank(self->buckets_,0,bs,i);
      //@ open bank(self->buckets_+i,i,nth(i,bs));
      FreeListRegion* result = buckets_[i];
      //@ open chain(result,nth(i,bs));
      if (result != null) {
        ASSERT(result->size() >= min_size);
        FreeListRegion* next_region =
            reinterpret_cast<FreeListRegion*>(result->next_region());
        result->set_next_region(null);
        buckets_[i] = next_region;
        //@ assert block(result,?n,0);
        //@ assert chain(next_region,?rest);
        //@ close bank(self->buckets_+i,i,rest);
        //@ replace_bank(self->buckets_,0,bs,i,rest);
        //@ replace_bytes(bs,i,rest);
        //@ close exists(i);
        return result;
      }
      //@ close chain(result,nil);
      //@ close bank(self->buckets_+i,i,nil);
      //@ replace_bank(self->buckets_,0,bs,i,nil);
      //@ skip_empty(i,bs);
    }

    // Search the bucket containing regions that could, but are not
    // guaranteed to, satisfy the allocation.
    if (smallest_bucket > NUMBER_OF_BUCKETS) smallest_bucket = NUMBER_OF_BUCKETS;
    //@ int k = smallest_bucket - 1;
    //@ focus_bank(self->buckets_,0,bs,k);
    //@ open bank(self->buckets_+k,k,nth(k,bs));
    //@ pointer_limits(self->buckets_+k);
    return take_first_fit(&buckets_[smallest_bucket - 1], min_size);
    //@ remove_fit(k,nth(k,bs),min_size);
    //@ close bank(self->buckets_+k,k,remaining(nth(k,bs),min_size));
    //@ replace_bank(self->buckets_,0,bs,k,remaining(nth(k,bs),min_size));
    //@ remove_bytes(nth(k,bs),min_size);
    //@ replace_bytes(bs,k,remaining(nth(k,bs),min_size));
    //@ close exists(k);
  }

@verbatim
typedef HeapObject PromotedTrack;
struct OldSpace {
  FreeList free_list_;
  uword top_;
  uword limit_;
  uword used_;
  bool tracking_allocations_;
  bool promotion_failed_;
  PromotedTrack *promoted_track_;
  Program *program_;
};
typedef struct OldSpace OldSpace;
/*@
predicate track_end(PromotedTrack *p, uword end) =
  (uword)p >= 1 &*& uintptr(raw(p) + 1,end);
@*/

@prototypes
@render src/objects.h toit::HeapObject::_word_at_put tu=src/third_party/dartino/object_memory_mark_sweep.cc
  INLINE void _word_at_put(word offset, uword value)
  //@ requires 1 <= (uword)self &*& 0 <= offset &*& offset % sizeof(word) == 0 &*& uintptr(raw(self) + offset / sizeof(word),_);
  //@ ensures uintptr(raw(self) + offset / sizeof(word),value);
  //@ terminates;
  { _raw_at()[offset / WORD_SIZE] = value; }

@render src/objects.h toit::PromotedTrack::set_end tu=src/third_party/dartino/object_memory_mark_sweep.cc
  void set_end(uword end)
  //@ requires track_end(self,_);
  //@ ensures track_end(self,end);
  //@ terminates;
  {
    //@ open track_end(self,_);
    _word_at_put(END_OFFSET, end);
    //@ close track_end(self,end);
  }

@render src/objects.h toit::PromotedTrack::header_size tu=src/third_party/dartino/object_memory_mark_sweep.cc
  static inline uword header_size()
  //@ requires true;
  //@ ensures result == 3 * sizeof(word);
  { return HEADER_SIZE; }

@render src/third_party/dartino/object_memory_mark_sweep.cc toit::OldSpace::flush
void OldSpace::flush()
/*@ requires self->top_ |-> ?top &*& self->limit_ |-> ?limit &*& self->used_ |-> ?used &*&
    top <= limit &*& limit - top <= used &*& (top == 0 ? limit == 0 : free_storage(top,limit-top)) &*&
    banks(self->free_list_.buckets_,0,?bs) &*& length(bs) == 12 &*&
    self->tracking_allocations_ |-> ?tracking &*& self->promoted_track_ |-> ?track &*&
    exists<uword>(?end) &*& (tracking && track != 0 ? track_end(track,end) : true); @*/
/*@ ensures self->top_ |-> 0 &*& self->limit_ |-> 0 &*& self->used_ |-> used - (limit-top) &*&
    (top == 0 ? banks(self->free_list_.buckets_,0,bs) : free_table_after(&self->free_list_,bs,top,limit-top)) &*&
    self->tracking_allocations_ |-> tracking &*& self->promoted_track_ |-> track &*&
    (tracking && track != 0 ? track_end(track,top == 0 ? end : top) : true); @*/
//@ terminates;
{
  if (top_ != 0) {
    uword free_size = limit_ - top_;
    free_list_.add_region(top_, free_size);
    if (tracking_allocations_ && promoted_track_ != null) {
      ASSERT(promoted_track_ != null);
      ASSERT(promoted_track_->end() >= top_);
      promoted_track_->set_end(top_);
    }
    top_ = 0;
    limit_ = 0;
    used_ -= free_size;
    ASSERT(static_cast<word>(used_) >= 0);
  }
}

@render src/third_party/dartino/object_memory_mark_sweep.cc toit::OldSpace::take_free_region
FreeListRegion* OldSpace::take_free_region(uword size)
/*@ requires self->top_ |-> ?top &*& self->limit_ |-> ?limit &*& self->used_ |-> ?used &*&
    top <= limit &*& limit-top <= used &*& (top == 0 ? limit == 0 : free_storage(top,limit-top)) &*&
    banks(self->free_list_.buckets_,0,?bs) &*& length(bs) == 12 &*& used + free_bytes(bs) <= UINTPTR_MAX &*&
    self->tracking_allocations_ |-> ?tracking &*& self->promoted_track_ |-> ?track &*&
    exists<uword>(?end) &*& (tracking && track != 0 ? track_end(track,end) : true) &*&
    size > 0 &*& size + (tracking ? 3 : 0)*sizeof(word) <= UINTPTR_MAX; @*/
/*@ ensures self->top_ |-> 0 &*& self->limit_ |-> 0 &*& self->used_ |-> used-(limit-top) &*&
    self->tracking_allocations_ |-> tracking &*& self->promoted_track_ |-> track &*&
    (tracking && track != 0 ? track_end(track,top == 0 ? end : top) : true) &*&
    (top != 0 && limit-top < 3*sizeof(word) ? filler_words(top,limit-top) : true) &*&
    exists<FreeListRegion *>(?inserted) &*& (limit-top >= 3*sizeof(word) ?
      inserted != 0 && inserted == (FreeListRegion *)(top+1) && (uword)inserted == top+1 : inserted == 0) &*&
    result == first_fit(searched_regions(flushed_banks(bs,inserted,limit-top),size+(tracking ? 3 : 0)*sizeof(word)),
                        size+(tracking ? 3 : 0)*sizeof(word)) &*&
    banks(self->free_list_.buckets_,0,?after) &*& length(after) == 12 &*& exists<int>(?taken) &*&
    after == banks_after_search(flushed_banks(bs,inserted,limit-top),size+(tracking ? 3 : 0)*sizeof(word)) &*&
    used-(limit-top) + free_bytes(after) + taken ==
      used + free_bytes(bs) - (limit-top < 3*sizeof(word) ? limit-top : 0) &*&
    (result == 0 ? taken == 0 : block(result,taken,0) &*& taken >= size + (tracking ? 3 : 0)*sizeof(word) &*&
      used-(limit-top)+taken <= UINTPTR_MAX); @*/
{
  flush();
  //@ FreeListRegion *inserted = 0;
  /*@ if (top != 0) {
    open free_table_after(&self->free_list_,bs,top,limit-top);
    if (limit-top >= 3*sizeof(word)) {
      open exists(?fresh);
      inserted = fresh;
      int k = size_bucket(limit-top);
      replace_bytes(bs,k,cons(region(fresh,limit-top),nth(k,bs)));
    }
  } @*/
  //@ assert banks(self->free_list_.buckets_,0,?flushed);
  return free_list_.get_region(
      tracking_allocations_ ? size + PromotedTrack::header_size() : size);
  //@ open exists(?i);
  //@ int request = size + (tracking ? 3 : 0)*sizeof(word);
  //@ list<list<region> > rest = update(i,remaining(nth(i,flushed),request),flushed);
  //@ highest_bank_bound(flushed,i);
  //@ free_bytes_nonnegative(rest);
  //@ close exists(fit_bytes(nth(i,flushed),request));
  //@ close exists(inserted);
}
