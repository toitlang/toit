@include ../model/model.cfg
@verbatim
#include "../model/objects.gen.h"
struct FixPointersVisitor;
typedef struct FixPointersVisitor FixPointersVisitor;
typedef int PageType;

/*@
predicate compaction_tables(fixpoint(void *,bool) old, fixpoint(void *,uword) destination);
fixpoint void *fixed_root(fixpoint(void *,bool) old, fixpoint(void *,uword) destination, void *root) {
  return old(root) ? (void *)(destination(root) + 1) : root;
}
fixpoint list<void *> fixed_roots(list<void *> roots, fixpoint(void *,bool) old, fixpoint(void *,uword) destination) {
  switch (roots) {
    case nil: return nil;
    case cons(x,r): return cons(fixed_root(old,destination,x),fixed_roots(r,old,destination));
  }
}
@*/
PageType GcMetadata_get_page_type(Object *object);
//@ requires compaction_tables(?old,?dest);
//@ ensures compaction_tables(old,dest) &*& (result == OLD_SPACE_PAGE) == old(object);
//@ terminates;

uword GcMetadata_get_destination(HeapObject *object);
//@ requires compaction_tables(?old,?dest) &*& old(object) == true;
//@ ensures compaction_tables(old,dest) &*& result == dest(object) &*& result < UINTPTR_MAX &*& result % sizeof(word) == 0;
//@ terminates;

@render src/objects.h toit::HeapObject::from_address tu=src/third_party/dartino/object_memory_mark_sweep.cc
  static HeapObject* from_address(uword address)
  //@ requires address < UINTPTR_MAX &*& address % sizeof(word) == 0;
  //@ ensures result == (void *)(address + 1);
  //@ terminates;
  {
    ASSERT((address & NON_SMI_TAG_MASK) == SMI_TAG);
    return reinterpret_cast<HeapObject*>(address + HEAP_TAG);
  }

@render src/third_party/dartino/object_memory_mark_sweep.cc toit::FixPointersVisitor::do_roots
void FixPointersVisitor::do_roots(Object** start, word length)
/*@ requires pointers((void **)start,length,?xs) &*& 0 <= length &*&
             pointer_within_limits(start) == true &*& compaction_tables(?old,?dest); @*/
//@ ensures pointers((void **)start,length,fixed_roots(xs,old,dest)) &*& compaction_tables(old,dest);
//@ terminates;
{
  //@ pointers_limits((void **)start);
  Object** end = start + length;
  //@ int i = 0;
  //@ close pointers((void **)start,0,nil);
  for (Object** current = start; current < end; current++)
  /*@ invariant 0 <= i &*& i <= length &*& current == start+i &*&
      pointers((void **)start,i,?done) &*& pointers((void **)current,length-i,?rest) &*&
      append(done,fixed_roots(rest,old,dest)) == fixed_roots(xs,old,dest) &*& compaction_tables(old,dest); @*/
  //@ decreases length-i;
  {
    //@ open pointers((void **)current,length-i,rest);
    Object* object = *current;
    if (GcMetadata::get_page_type(object) == OLD_SPACE_PAGE) {
      HeapObject* heap_object = HeapObject::cast(object);
      uword destination = GcMetadata::get_destination(heap_object);
      *current = HeapObject::from_address(destination);
      ASSERT(GcMetadata::get_page_type(*current) == OLD_SPACE_PAGE);
    }
    //@ close pointers((void **)current+1,0,nil);
    //@ close pointers((void **)current,1,cons(fixed_root(old,dest,head(rest)),nil));
    //@ pointers_join((void **)start);
    //@ append_assoc(done,cons(fixed_root(old,dest,head(rest)),nil),fixed_roots(tail(rest),old,dest));
    //@ i++;
  }
  //@ open pointers((void **)end,0,_);
  //@ assert pointers((void **)start,length,?out);
  //@ append_nil(out);
}
