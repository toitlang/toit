; Induction for both countdowns: pending-ready list length after removal,
; and r4 after each completed tick call. Counts are unsigned machine words.
(set-logic QF_LIA)
(declare-const total Int)
(declare-const remaining Int)
(declare-const completed Int)
(define-fun invariant ((r Int) (c Int)) Bool
  (and (<= 0 r) (<= 0 c) (= (+ r c) total)))
(assert (<= 0 total 4294967295))
(push)
(assert (not (invariant total 0)))
(check-sat)
(pop)
(assert (invariant remaining completed))
(push)
(assert (> remaining 0))
(define-fun next () Int (mod (- remaining 1) 4294967296))
(assert (not (and (< next remaining) (invariant next (+ completed 1)))))
(check-sat)
(pop)
(push)
(assert (= remaining 0))
(assert (distinct completed total))
(check-sat)
(pop)

; Ready queue offset, unsigned priority comparison and sticky yield flag.
; A replayed tick may return any word. It preserves prior pending requests.
(declare-const priority Int)
(declare-const current Int)
(declare-const highest Int)
(declare-const tick Int)
(declare-const pending Int)
(assert (and (<= 0 priority 55) (<= 0 current 55) (<= 0 highest 55)
             (<= 0 pending 4294967295) (<= 0 tick 4294967295)))
(define-fun slot () Int (mod (* priority 20) 4294967296))
(define-fun newTop () Int (ite (> priority highest) priority highest))
(define-fun readyYield () Int (ite (< priority current) pending 1))
(define-fun tickYield () Int (ite (= tick 0) readyYield 1))
(assert (not (and (<= 0 slot) (<= (+ slot 20) 1120) (= (div slot 20) priority)
                  (>= newTop priority) (>= newTop highest) (or (= newTop priority) (= newTop highest))
                  (= (distinct tickYield 0)
                     (or (distinct pending 0) (>= priority current) (distinct tick 0))))))
(check-sat)
