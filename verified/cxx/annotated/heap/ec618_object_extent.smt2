; 32-bit EC618 header, immutable class bits, admitted ordinary class id.
(set-logic QF_AUFBV)
(define-sort W () (_ BitVec 32))
(declare-const id W)
(declare-const bits (Array W (_ BitVec 16)))
(assert (bvule id #x01ffffff))
(define-fun entry ((i W)) W ((_ zero_extend 16) (select bits i)))
(define-fun tag ((i W)) W (bvand (entry i) #x0000000f))
(define-fun fixed ((i W)) W (bvshl (bvashr (entry i) #x00000005) #x00000002))
(define-fun smi () W (bvshl id #x00000001))
(define-fun index () W (bvashr smi #x00000001))
(define-fun header () W (bvshl (bvor (tag index) (bvshl index #x00000005)) #x00000001))
(define-fun gc-index () W (bvashr header #x00000006))
(define-fun gc-tag () W (bvand (bvlshr header #x00000001) #x0000000f))
(push)
(assert (or (distinct index id) (distinct gc-index id) (distinct gc-tag (tag id))
            (distinct (fixed gc-index) (fixed index))))
(check-sat)
(pop)
; The bump advances precisely by the size the collector reads. With a
; positive fixed size the header and every loop iteration fit in the grant.
(declare-const base W)
(declare-const limit W)
(declare-const off W)
(define-fun aligned ((n W)) Bool (= (bvand n #x00000003) #x00000000))
(assert (and (distinct base #x00000000) (aligned base) (aligned limit) (bvult base limit)))
(define-fun bytes () W (fixed index))
(push)
(assert (and (distinct bytes #x00000000) (bvugt (bvsub limit base) bytes)))
(define-fun end () W (bvadd base bytes))
(assert (or (bvule end base) (bvugt end (bvsub limit #x00000004))
            (not (aligned end)) (bvult bytes #x00000004)
            (distinct (bvsub end base) (fixed gc-index))))
(check-sat)
(pop)
(push)
(assert (and (aligned off) (bvuge off #x00000004) (bvslt off bytes) (bvsge off #x00000000)))
(assert (or (bvugt (bvadd off #x00000004) bytes) (bvule (bvadd off #x00000004) off)))
(check-sat)
(pop)
; The pointer-based field loop starts at base+4 and stops on equality
; with base+bytes. Every nonterminal iteration makes forward progress.
(push)
(assert (and (distinct bytes #x00000000) (bvugt (bvsub limit base) bytes)
             (aligned off) (bvuge off #x00000004) (bvule off bytes)))
(define-fun cursor () W (bvadd base off))
(define-fun stop () W (bvadd base bytes))
(assert (or (distinct (= cursor stop) (= off bytes))
            (and (distinct cursor stop)
                 (or (bvule (bvadd cursor #x00000004) cursor)
                     (bvugt (bvadd cursor #x00000004) stop)))))
(check-sat)
(pop)
; For an array or internal byte array, the length word is at raw+4.
; The returned pointer is raw+1. Assert a live grant of the requested extent.
(declare-const len W)
(declare-const memory (Array W W))
(define-fun ptr () W (bvadd base #x00000001))
(define-fun published () (Array W W)
  (store (store memory base header) (bvadd ptr #x00000003) len))
(define-fun n () W (select published (bvadd (bvsub ptr #x00000001) #x00000004)))
(define-fun arr ((k W)) W (bvadd (bvshl k #x00000002) #x00000008))
(define-fun blob ((k W)) W (bvand (bvadd k #x0000000b) #xfffffffc))
(push)
(assert (and (= (fixed index) #x00000000) (= (tag index) #x00000000) (bvule len #x000003e6)))
(assert (or (distinct (select published base) header) (distinct gc-tag #x00000000)
            (distinct (fixed gc-index) #x00000000) (distinct (arr n) (arr len))
            (bvugt (arr len) #x00000fa0) (bvult (arr len) #x00000008)))
(check-sat)
(pop)
; r3 points to the length word on entry to the fill loop and then to
; the last filled element. Each preindexed store is within the payload.
(push)
(assert (and (bvule len #x000003e6) (bvult off len)
             (bvule (arr len) (bvsub limit base))))
(define-fun last () W (bvadd (bvadd ptr #x00000003) (bvshl off #x00000002)))
(define-fun next () W (bvadd last #x00000004))
(assert (or (bvult next (bvadd base #x00000008))
            (bvugt (bvadd next #x00000004) (bvadd base (arr len)))
            (bvule next last) (bvugt next (bvadd (bvadd ptr #x00000003) (bvshl len #x00000002)))))
(check-sat)
(pop)
(push)
(assert (and (= (fixed index) #x00000000) (= (tag index) #x00000005) (bvule len #x00000f98)))
(define-fun raw-len () W (select published (bvadd ptr #x00000003)))
(assert (or (distinct (select published base) header) (distinct gc-tag #x00000005)
            (distinct (fixed gc-index) #x00000000) (bvslt raw-len #x00000000)
            (distinct (blob raw-len) (blob len)) (not (aligned (blob len)))
            (bvuge (bvsub (blob len) (bvadd #x00000008 len)) #x00000004)
            (bvugt (bvadd #x00000008 len) (blob len)) (bvugt (blob len) #x00000fa0)))
(check-sat)
(pop)
; The internal string reserves header, data and a terminating zero. Its
; callers must supply a length in range (the constructor has a debug assert).
(define-fun string-bytes ((k W)) W (bvand (bvadd k #x0000000c) #xfffffffc))
(define-fun stored-length () W ((_ zero_extend 16) ((_ extract 15 0) len)))
(push)
(assert (and (= (fixed index) #x00000000) (= (tag index) #x00000001)
             (bvult len #x0000ffff) (bvule (string-bytes len) (bvsub limit base))))
(define-fun terminator () W (bvadd (bvadd ptr #x00000007) stored-length))
(assert (or (distinct gc-tag #x00000001) (distinct stored-length len)
            (= stored-length #x0000ffff) (distinct (string-bytes stored-length) (string-bytes len))
            (bvult terminator (bvadd base #x00000008))
            (bvuge terminator (bvadd base (string-bytes len)))))
(check-sat)
(pop)
; The stack writes its length at tagged+7. Initialization's last word
; ends at raw+40. Admit only lengths whose mathematical byte size fits.
(define-fun stack-bytes ((k W)) W (bvadd #x00000028 (bvshl k #x00000002)))
(push)
(assert (and (= (fixed index) #x00000000) (= (tag index) #x00000007)
             (bvule len #x3ffffff5) (bvule (stack-bytes len) (bvsub limit base))))
(define-fun stack-mem () (Array W W) (store (store memory base header) (bvadd ptr #x00000007) len))
(define-fun stack-n () W (select stack-mem (bvadd (bvsub ptr #x00000001) #x00000008)))
(assert (or (distinct gc-tag #x00000007) (distinct (select stack-mem base) header)
            (distinct (stack-bytes stack-n) (stack-bytes len))
            (bvult (bvadd base (stack-bytes len)) (bvadd base #x00000028))))
(check-sat)
(pop)
; Both numeric constructors request 12 bytes and store two payload words.
; Their class descriptor either supplies the fixed size or selects the
; numeric switch arm. Both routes through HeapObject::size agree.
(push)
(assert (and (or (= (tag index) #x00000004) (= (tag index) #x00000006))
             (or (= (fixed index) #x00000000) (= (fixed index) #x0000000c))))
(define-fun numeric-size () W
  (ite (distinct (fixed gc-index) #x00000000) (fixed gc-index)
       (ite (or (= gc-tag #x00000004) (= gc-tag #x00000006)) #x0000000c #xffffffff)))
(assert (or (distinct numeric-size #x0000000c)
            (distinct (bvadd ptr #x00000003) (bvadd base #x00000004))
            (distinct (bvadd ptr #x00000007) (bvadd base #x00000008))))
(check-sat)
(pop)
