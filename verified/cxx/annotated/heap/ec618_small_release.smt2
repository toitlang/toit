; Three adjacent, intact boundary-tag headers. Sizes include their headers.
(set-logic QF_BV)
(define-sort W () (_ BitVec 32))
(declare-const h W)
(declare-const header W)
(declare-const left W)
(declare-const right W)
(define-fun size ((x W)) W (bvlshr x #x00000010))
(define-fun low ((x W)) W (bvand x #x0000ffff))
(define-fun tagged ((x W)) Bool (= ((_ extract 0 0) x) #b1))
(define-fun wide ((x W)) (_ BitVec 33) ((_ zero_extend 1) x))
(assert (not (tagged header)))
(assert (= (low header) (size left)))
(assert (= (bvand right #x0000fffe) (size header)))
(assert (and (bvuge h (size left)) (bvuge (size header) #x00000008)
             (bvuge (size left) #x00000008) (or (not (tagged right)) (bvuge (size right) #x00000008))))
(define-fun after () (_ BitVec 33) (bvadd (wide h) (wide (size header)) (wide (size right))))
(assert (bvult after (_ bv4294967296 33)))
; All combinations of neighbor state are represented.
(push)
(assert (and (tagged left) (tagged right)))
(check-sat)
(pop)
(push)
(assert (and (tagged left) (not (tagged right))))
(check-sat)
(pop)
(push)
(assert (and (not (tagged left)) (tagged right)))
(check-sat)
(pop)
(push)
(assert (and (not (tagged left)) (not (tagged right))))
(check-sat)
(pop)
; Reconstruct the free_memory arguments from the four matched paths.
(define-fun r7 () W (bvsub h (bvand header #x0000fffe)))
(define-fun r6 () W (bvadd h (size header)))
(define-fun begin () W (ite (tagged left) r7 h))
(define-fun length () W
  (ite (tagged left)
    (ite (tagged right) (bvadd (size right) (size left) (size header)) (bvadd (size header) (size left)))
    (ite (tagged right) (bvadd (size right) (size header)) (size header))))
; Independent first and one-past addresses in widened arithmetic.
(define-fun first () (_ BitVec 33) (ite (tagged left) (bvsub (wide h) (wide (size left))) (wide h)))
(define-fun limit () (_ BitVec 33) (ite (tagged right) after (bvadd (wide h) (wide (size header)))))
(push)
(assert (or (distinct (wide begin) first)
            (distinct (bvadd (wide begin) (wide length)) limit)
            (distinct (wide r6) (bvadd (wide h) (wide (size header))))))
(check-sat)
(pop)
; A valid arena's merged block fits the even 16-bit boundary-tag distance.
; fix_left_size updates the following header while retaining its size and tag.
(declare-const following W)
(assert (bvule length #x0000fffe))
(assert (= (bvand length #x00000001) #x00000000))
(define-fun dist () W (bvsub ((_ extract 31 0) limit) begin))
(define-fun fixed () W (bvor (bvshl (size following) #x00000010)
                             (bvadd (bvand following #x00000001) dist)))
(assert (or (distinct (size fixed) (size following))
            (distinct (tagged fixed) (tagged following))
            (distinct (bvand fixed #x0000fffe) length)))
(check-sat)
