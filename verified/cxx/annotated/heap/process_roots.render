@include ../model/model.cfg
@verbatim
#include <stdint.h>
#include <stdbool.h>
typedef intptr_t word;
typedef struct Object { char unused; } Object;
typedef struct Task { char unused; } Task;
typedef struct RootCallback { char unused; } RootCallback;
typedef struct Table { int length_; } Table;
typedef struct Program { Table global_variables; } Program;
// Both lists use the native mutable forward cursor. The flag in the chain
// predicate selects the payload field belonging to the concrete node type.
typedef struct RootNode { struct RootNode *next_; Object *obj_; Object *object_; } RootNode;
typedef RootNode HeapRoot;
typedef RootNode ObjectNotifier;
typedef struct RootList { RootNode anchor_; } RootList;
typedef RootList HeapRootList;
typedef RootList ObjectNotifierList;
typedef struct ObjectHeap {
  Task *task_; Object **global_variables_; Program *program_;
  HeapRootList external_roots_; ObjectNotifierList object_notifiers_;
} ObjectHeap;

/*@
inductive range = span(Object **, int);
predicate visits(RootCallback *cb, list<range> remaining);
predicate link(RootNode *p, RootNode *anchor, bool notifier; RootNode *next) =
  p != anchor &*& (uintptr_t)p != (uintptr_t)anchor &*& p->next_ |-> next &*&
  pointer_within_limits(notifier ? &p->object_ : &p->obj_) == true;
fixpoint range root_range(RootNode *p, bool notifier) {
  return span(notifier ? &p->object_ : &p->obj_, 1);
}
predicate chain(RootNode *p, RootNode *anchor, bool notifier, list<range> after; list<range> remaining) =
  p == anchor ? remaining == after :
  link(p,anchor,notifier,?next) &*& chain(next,anchor,notifier,after,?tail) &*&
  remaining == cons(root_range(p,notifier),tail);
predicate prefix(list<RootNode *> done, RootNode *first, RootNode *anchor, bool notifier,
                 RootNode *cursor, list<range> all, list<range> remaining) =
  switch(done) {
    case nil: return cursor == first &*& remaining == all;
    case cons(last,rest): return link(last,anchor,notifier,cursor) &*&
      prefix(rest,first,anchor,notifier,last,all,cons(root_range(last,notifier),remaining));
  };
lemma void restore(list<RootNode *> done, RootNode *first, RootNode *anchor, bool notifier, RootNode *cursor)
  requires prefix(done,first,anchor,notifier,cursor,?all,?remaining) &*& chain(cursor,anchor,notifier,?after,remaining);
  ensures chain(first,anchor,notifier,after,all);
{
  open prefix(done,first,anchor,notifier,cursor,all,remaining);
  switch(done) {
    case nil:
    case cons(last, rest):
      open link(last,anchor,notifier,cursor);
      close link(last,anchor,notifier,cursor);
      close chain(last,anchor,notifier,after,cons(root_range(last,notifier),remaining));
      restore(rest,first,anchor,notifier,last);
  }
}
@*/
void RootCallback_do_roots(RootCallback *self,Object **roots,word count);
//@ requires visits(self,cons(span(roots,count),?tail));
//@ ensures visits(self,tail);
//@ terminates;
// The native gc-process-roots harness checks this getter for symbolic global counts.
int Program_ObjectTable_length(Table *self);
//@ requires [?f]self->length_ |-> ?n;
//@ ensures [f]self->length_ |-> n &*& result == n;
//@ terminates;
@prototypes
@render src/objects.h toit::RootCallback::do_root tu=src/heap.cc
  void do_root(Object** root)
  //@ requires visits(self,cons(span(root,1),?tail));
  //@ ensures visits(self,tail);
  //@ terminates;
  { do_roots(root, 1); }
@render src/heap_roots.h toit::HeapRoot::slot tu=src/heap.cc
  Object** slot()
  //@ requires pointer_within_limits(&self->obj_) == true;
  //@ ensures result == &self->obj_;
  //@ terminates;
  { return &obj_; }
@render src/heap.cc toit::ObjectNotifier::roots_do
void ObjectNotifier::roots_do(RootCallback* cb)
//@ requires pointer_within_limits(&self->object_) == true &*& visits(cb,cons(span(&self->object_,1),?tail));
//@ ensures visits(cb,tail);
//@ terminates;
{
  cb->do_root(reinterpret_cast<Object**>(&object_));
}
@render src/heap.h toit::ObjectHeap::program tu=src/heap.cc
  Program* program() const
  //@ requires [?f]self->program_ |-> ?p;
  //@ ensures [f]self->program_ |-> p &*& result == p;
  //@ terminates;
  { return program_; }
@render src/heap.cc toit::ObjectHeap::iterate_roots
void ObjectHeap::iterate_roots(RootCallback* callback)
/*@ requires self->program_ |-> ?image &*& self->global_variables_ |-> ?globals &*&
      image->global_variables.length_ |-> ?count &*& pointer_within_limits(&image->global_variables) == true &*&
      pointer_within_limits(&self->task_) == true &*& pointer_within_limits(&self->external_roots_) == true &*&
      pointer_within_limits(&self->object_notifiers_) == true &*&
      pointer_within_limits(&self->external_roots_.anchor_) == true &*& pointer_within_limits(&self->object_notifiers_.anchor_) == true &*&
      self->external_roots_.anchor_.next_ |-> ?ext &*& self->object_notifiers_.anchor_.next_ |-> ?notifiers &*&
      chain(notifiers,&self->object_notifiers_.anchor_,true,?after,?ns) &*&
      chain(ext,&self->external_roots_.anchor_,false,ns,?es) &*&
      visits(callback,cons(span((Object **)&self->task_,1),cons(span(globals,count),es))); @*/
/*@ ensures self->program_ |-> image &*& self->global_variables_ |-> globals &*& image->global_variables.length_ |-> count &*&
      self->external_roots_.anchor_.next_ |-> ext &*& self->object_notifiers_.anchor_.next_ |-> notifiers &*&
      chain(notifiers,&self->object_notifiers_.anchor_,true,after,ns) &*&
      chain(ext,&self->external_roots_.anchor_,false,ns,es) &*& visits(callback,after); @*/
//@ terminates;
{
  callback->do_root(reinterpret_cast<Object**>(&task_));
  callback->do_roots(global_variables_, program()->global_variables.length());
  //@ RootNode *anchor = &self->external_roots_.anchor_;
  //@ list<RootNode *> done = nil;
  //@ close prefix(done,ext,anchor,false,ext,es,es);
  for (auto root : external_roots_)
    /*@ invariant __end1 == anchor &*& prefix(done,ext,anchor,false,__begin1,es,?remaining) &*&
          chain(__begin1,anchor,false,ns,remaining) &*& visits(callback,remaining); @*/
    //@ decreases length(remaining);
  {
    //@ open chain(root,anchor,false,ns,remaining);
    //@ open link(root,anchor,false,?next);
    callback->do_roots(root->slot(), 1);
    //@ close link(root,anchor,false,next);
    //@ close prefix(cons(root,done),ext,anchor,false,next,es,tail(remaining));
    //@ done = cons(root,done);
  }
  /*@ if (__begin1 != anchor) {
    open chain(__begin1,anchor,false,ns,_);
    open link(__begin1,anchor,false,_);
  } @*/
  //@ assert __begin1 == anchor;
  //@ open chain(anchor,anchor,false,ns,_);
  //@ close chain(anchor,anchor,false,ns,ns);
  //@ restore(done,ext,anchor,false,anchor);
  //@ RootNode *anchor_1 = &self->object_notifiers_.anchor_;
  //@ list<RootNode *> done_1 = nil;
  //@ close prefix(done_1,notifiers,anchor_1,true,notifiers,ns,ns);
  for (ObjectNotifier* n : object_notifiers_)
    /*@ invariant __end1_1 == anchor_1 &*& prefix(done_1,notifiers,anchor_1,true,__begin1_1,ns,?remaining_ns) &*&
          chain(__begin1_1,anchor_1,true,after,remaining_ns) &*& visits(callback,remaining_ns); @*/
    //@ decreases length(remaining_ns);
  {
    //@ open chain(n,anchor_1,true,after,remaining_ns);
    //@ open link(n,anchor_1,true,?next_ns);
    n->roots_do(callback);
    //@ close link(n,anchor_1,true,next_ns);
    //@ close prefix(cons(n,done_1),notifiers,anchor_1,true,next_ns,ns,tail(remaining_ns));
    //@ done_1 = cons(n,done_1);
  }
  /*@ if (__begin1_1 != anchor_1) {
    open chain(__begin1_1,anchor_1,true,after,_);
    open link(__begin1_1,anchor_1,true,_);
  } @*/
  //@ assert __begin1_1 == anchor_1;
  //@ open chain(anchor_1,anchor_1,true,after,_);
  //@ close chain(anchor_1,anchor_1,true,after,after);
  //@ restore(done_1,notifiers,anchor_1,true,anchor_1);
}
