; Word-aligned source, exclusive survivor grant, truthful positive object
; size and valid top/limit. One arbitrary observable word q models the
; destination frame and preservation of original object fields.
(set-logic QF_AUFLIA)
(declare-const src Int)
(declare-const dst Int)
(declare-const limit Int)
(declare-const n Int)
(declare-const q Int)
(declare-const before (Array Int Int))
(define-fun word ((x Int)) Int (mod x 4294967296))
(assert (and (< 0 src) (< 0 dst limit 4294967296) (< 0 n 4294967296)
             (<= (+ src n) 4294967296)
             (= (mod src 4) 0) (= (mod dst 4) 0) (= (mod limit 4) 0)
             (= (mod n 4) 0) (= (mod q 4) 0)
             (or (<= (+ src n) dst) (<= limit src))))
(define-fun fits () Bool (> (word (- limit dst)) n))
(push)
(assert (distinct fits (<= (+ dst n 4) limit)))
(check-sat)
(pop)
(assert fits)
(define-fun sentinel () Int (+ dst n))
(define-fun initial ((x Int)) Int (ite (= x sentinel) 0 (select before x)))
(define-fun copied ((x Int) (done Int)) Int
  (ite (and (<= dst x) (< x (+ dst done))) (select before (+ src (- x dst))) (initial x)))
(push)
(assert (distinct (copied q 0) (initial q)))
(check-sat)
(pop)
(declare-const i Int)
(assert (and (<= 0 i n) (= (mod i 4) 0)))
(push)
(assert (< i n))
(define-fun loaded () Int (copied (+ src i) i))
(assert (or (> (+ i 4) n) (distinct loaded (select before (+ src i)))
            (distinct (ite (= q (+ dst i)) loaded (copied q i)) (copied q (+ i 4)))))
(check-sat)
(pop)
; Before invoking each unrolled group the assembly tests unsigned carry.
; Entering a smaller group adds the difference to the failed subtraction.
(declare-const group Int)
(declare-const smaller Int)
(declare-const remaining Int)
(assert (or (and (= group 64) (= smaller 16)) (and (= group 16) (= smaller 4))))
(assert (and (<= 0 remaining) (< remaining group) (= (mod remaining 4) 0)))
(push)
(assert (distinct (>= (+ (word (- remaining group)) (- group smaller)) 4294967296)
                  (>= remaining smaller)))
(check-sat)
(pop)
(push)
(assert (or (distinct (word (+ (word (- remaining group)) (- group smaller))) (word (- remaining smaller)))
            (and (< remaining 4) (distinct (word (+ (word (- remaining 4)) 4)) 0))))
(check-sat)
(pop)
; Each taken 64-, 16-, or 4-byte group copies its words in order. At
; entry r2 holds remaining-group. SUBS/BCS takes the back edge exactly
; when the next group fits. The remaining byte count strictly decreases.
(declare-const g Int)
(declare-const off Int)
(push)
(assert (or (= g 64) (= g 16) (= g 4)))
(assert (and (<= g (- n i)) (<= 0 off) (< off g) (= (mod off 4) 0)))
(define-fun r2 () Int (word (- n i g)))
(assert (or (> (+ i off 4) n)
            (distinct (>= r2 g) (>= (- n (+ i g)) g))
            (distinct (word (- r2 g)) (word (- n (+ i g) g)))
            (>= (- n (+ i g)) (- n i))))
(check-sat)
(pop)
; Installing the forwarding address happens after copying. A second root
; reading the same header sees tag 01 and reuses the destination.
(define-fun tagged () Int (word (+ dst 1)))
(define-fun final ((x Int)) Int (ite (= x src) tagged (copied x n)))
(push)
(assert (or (distinct (mod (final src) 4) 1) (distinct (- (final src) 1) dst)
            (distinct (final sentinel) 0)
            (and (<= dst q) (< q sentinel) (distinct (final q) (select before (+ src (- q dst)))))
            (and (distinct q src) (or (< q dst) (> q sentinel)) (distinct (final q) (select before q)))))
(check-sat)
(pop)
; A valid root array admits a four-byte load on every taken loop edge,
; and its cursor reaches the encoded end without wrapping.
(declare-const roots Int)
(declare-const count Int)
(declare-const k Int)
(assert (and (<= 0 roots) (= (mod roots 4) 0) (<= 0 k count)
             (< (+ roots (* 4 count)) 4294967296)))
(define-fun cursor () Int (word (+ roots (* 4 k))))
(define-fun stop () Int (word (+ roots (* 4 count))))
(push)
(assert (or (distinct (< cursor stop) (< k count))
            (and (< cursor stop) (or (> (+ cursor 4) stop) (<= (+ cursor 4) cursor)))))
(check-sat)
(pop)
; Membership uses unsigned subtraction of a tagged pointer. For any
; nonwrapping heap interval that gives the exact half-open bounds.
(declare-const lo Int)
(declare-const extent Int)
(declare-const obj Int)
(assert (and (<= 0 lo) (<= 0 extent) (<= (+ lo extent) 4294967296)
             (< lo 4294967296) (<= 0 obj) (< obj 4294967296)))
(push)
(assert (distinct (< (word (- obj lo)) extent) (and (<= lo obj) (< obj (+ lo extent)))))
(check-sat)
(pop)
; Capacity accounting for one fresh copy. Given disjoint true-sized source
; objects, unforwarded bytes include this object; promoted objects consume
; source budget but no to-space bytes. A repeated forwarded root changes
; neither count. The collection caller must establish the initial budget.
(reset)
(set-logic QF_LIA)
(declare-const n Int)
(assert (> n 0))
(declare-const capacity Int)
(declare-const copiedBytes Int)
(declare-const unforwarded Int)
(assert (and (<= 0 copiedBytes) (<= n unforwarded)
             (<= (+ copiedBytes unforwarded 4) capacity)))
(push)
(assert (or (< capacity (+ copiedBytes n 4))
            (> (+ copiedBytes n (- unforwarded n) 4) capacity)
            (> (+ copiedBytes (- unforwarded n) 4) capacity)))
(check-sat)
(pop)
