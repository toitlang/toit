@include ../model/model.cfg
@static-member GcMetadata::singleton_
@header remembered_card.gen.h
@verbatim
#include "semispace.gen.h"
// The metadata setup check establishes these fields for the published heap.
/*@
predicate published_card(uword address; uint8 *slot) =
    [_]GcMetadata_singleton_.lowest_address_ |-> ?first &*&
    [_]GcMetadata_singleton_.heap_extent_ |-> ?extent &*&
    [_]GcMetadata_singleton_.remembered_set_ |-> ?table &*&
    [_]GcMetadata_singleton_.remembered_set_bias_ |-> ?bias &*&
    first % GcMetadata_CARD_SIZE == 0 &*& extent % GcMetadata_CARD_SIZE == 0 &*&
    first <= address &*& address < first + extent &*& first + extent <= UINTPTR_MAX &*&
    (uword)table + card(extent) <= UINTPTR_MAX &*&
    bias == truncate_unsigned((uword)table - card(first),8*sizeof(word)) &*&
    slot == (uint8 *)((uword)table + card(address-first));

lemma void published_card_address(uword address)
    requires published_card(address,?slot);
    ensures published_card(address,slot) &*& [_]GcMetadata_singleton_.remembered_set_bias_ |-> ?bias &*&
            slot == table_address(card(address),bias);
{
    open published_card(address,slot);
    assert [_]GcMetadata_singleton_.lowest_address_ |-> ?first;
    assert [_]GcMetadata_singleton_.heap_extent_ |-> ?extent;
    assert [_]GcMetadata_singleton_.remembered_set_ |-> ?table;
    assert [_]GcMetadata_singleton_.remembered_set_bias_ |-> ?bias;
    div_rem_nonneg(first,GcMetadata_CARD_SIZE);
    div_rem_nonneg(extent,GcMetadata_CARD_SIZE);
    div_rem_nonneg(address-first,GcMetadata_CARD_SIZE);
    div_rem_nonneg_unique(address,GcMetadata_CARD_SIZE,card(first)+card(address-first),(address-first)%GcMetadata_CARD_SIZE);
    int delta = (uword)table-card(first);
    int modulus = UINTPTR_MAX+1;
    divrem_intro(delta,modulus,delta < 0 ? -1 : 0,delta < 0 ? modulus+delta : delta);
    truncate_unsigned_def(delta,sizeof(word) == 8 ? N64 : N32);
    divrem_intro(card(address)+bias,modulus,delta < 0 ? 1 : 0,(uword)table+card(address-first));
    truncate_unsigned_def(card(address)+bias,sizeof(word) == 8 ? N64 : N32);
    close published_card(address,slot);
}
@*/
@prototypes
@render src/third_party/dartino/gc_metadata.h toit::GcMetadata::insert_into_remembered_set tu=src/third_party/dartino/two_space_heap.cc type=void(unsignedlong)|void(unsignedint) truncating
  INLINE static void insert_into_remembered_set(T address)
  /*@ requires [_]GcMetadata_singleton_.remembered_set_bias_ |-> ?bias &*&
               uchar_(table_address(card(address),bias),_); @*/
  /*@ ensures u_character(table_address(card(address),bias),GcMetadata_NEW_SPACE_POINTERS); @*/
  {
    static_assert(sizeof(T) == sizeof(uword), "invalid type size");
    //@ shiftright_div(address,sizeof(word) == 8 ? N8 : N7);
    uword mark_byte = reinterpret_cast<uword>(address) >> CARD_SIZE_LOG_2;
    mark_byte += singleton_.remembered_set_bias_;
    *reinterpret_cast<uint8*>(mark_byte) = NEW_SPACE_POINTERS;
  }

@render src/third_party/dartino/gc_metadata.h toit::GcMetadata::is_marked_dirty tu=src/third_party/dartino/two_space_heap.cc truncating
  inline static bool is_marked_dirty(uword address)
  /*@ requires [_]GcMetadata_singleton_.remembered_set_bias_ |-> ?bias &*&
               [?f]u_character(table_address(card(address),bias),?value); @*/
  /*@ ensures [f]u_character(table_address(card(address),bias),value) &*& result == (value != 0); @*/
  {
    //@ shiftright_div(address,sizeof(word) == 8 ? N8 : N7);
    address >>= CARD_SIZE_LOG_2;
    address += singleton_.remembered_set_bias_;
    return *reinterpret_cast<uint8*>(address) != NO_NEW_SPACE_POINTERS;
  }
