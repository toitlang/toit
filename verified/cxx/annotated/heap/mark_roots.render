#include "../model/objects.gen.h"

typedef struct MarkingStack {
  Program *program_;
  HeapObject **next_;
  HeapObject **limit_;
  HeapObject *backing_[128];
  bool overflowed_;
} MarkingStack;
typedef struct MarkingVisitor { Program *program_; MarkingStack *marking_stack_; } MarkingVisitor;

/*@
fixpoint bool located(void *object);
fixpoint bool object_start(void *object);
fixpoint bool valid_root(void *word) { return !located(word) || object_start(word); }
predicate marked(list<void *> seen);
// Deferred objects on overflow cards, including work present when a pass cleared the flag.
predicate overflow_cards(list<void *> objects);
inductive work = work(list<void *>,list<void *>,bool);
fixpoint bool flagged(work w) { switch(w) { case work(q,m,f): return f; } }
fixpoint list<void *> queued(work w) { switch(w) { case work(q,m,f): return q; } }
fixpoint work enqueue(void *o,work w) {
  switch(w) { case work(q,missed,f): return length(q) == 128 ? work(q,cons(o,missed),true) : work(append(q,cons(o,nil)),missed,f); }
}
predicate pending(MarkingStack *s, work w) =
  switch(w) { case work(q,missed,f): return
    forall(q,located) == true &*& forall(q,object_start) == true &*& length(q) <= 128 &*& pointer_within_limits(s->backing_) == true &*&
    pointer_within_limits(s->backing_+128) == true &*& s->next_ |-> s->backing_+length(q) &*& s->limit_ |-> s->backing_+128 &*&
    pointers((void **)s->backing_,length(q),q) &*& pointers_((void **)s->backing_+length(q),128-length(q),_) &*&
    s->overflowed_ |-> f &*& overflow_cards(missed);
  };
inductive tracing = tracing(list<void *>,work);
fixpoint tracing discover(void *o,tracing t) {
  switch(t) { case tracing(seen,w): return located(o) && !mem(o,seen) ? tracing(cons(o,seen),enqueue(o,w)) : t; }
}
fixpoint tracing trace_roots(list<void *> roots,tracing t) {
  switch(roots) { case nil: return t; case cons(h,r): return trace_roots(r,discover(h,t)); }
}
fixpoint list<void *> seen_objects(tracing t) {
  switch(t) { case tracing(seen,w): return seen; }
}
lemma void root_membership(void *target,list<void *> roots,tracing t)
  requires true;
  ensures mem(target,seen_objects(trace_roots(roots,t))) ==
          (mem(target,seen_objects(t)) || (located(target) && mem(target,roots)));
{
  switch(roots) {
    case nil:
    case cons(h,r):
      switch(t) { case tracing(seen,w): root_membership(target,r,discover(h,t)); }
  }
}
predicate visitor(MarkingVisitor *v,tracing t) =
  switch(t) { case tracing(seen,w): return [1/2]v->marking_stack_ |-> ?s &*& marked(seen) &*& pending(s,w); };
@*/
bool GcMetadata_in_new_or_old_space(Object *object);
//@ requires true;
//@ ensures result == located(object);
bool GcMetadata_mark_grey_if_not_marked(HeapObject *object);
//@ requires marked(?seen) &*& located(object) == true;
//@ ensures result == mem(object,seen) &*& marked(result ? seen : cons(object,seen));
void GcMetadata_mark_stack_overflow(HeapObject *object);
//@ requires overflow_cards(?missed) &*& located(object) == true;
//@ ensures overflow_cards(cons(object,missed));

@render src/third_party/dartino/mark_sweep.h toit::MarkingStack::MarkingStack tu=src/third_party/dartino/object_memory_mark_sweep.cc
  explicit MarkingStack(Program* program)
    : program_(program)
    , next_(&backing_[0])
    , limit_(&backing_[CHUNK_SIZE])
  /*@ requires self->program_ |-> _ &*& self->next_ |-> _ &*& self->limit_ |-> _ &*&
               self->overflowed_ |-> _ &*& pointer_within_limits(self->backing_) == true &*&
               pointer_within_limits(self->backing_+128) == true &*& pointers_((void **)self->backing_,128,_) &*& overflow_cards(nil); @*/
  //@ ensures self->program_ |-> program &*& pending(self,work(nil,nil,false));
  {
    //@ close pointers((void **)self->backing_,0,nil);
    //@ close pending(self,work(nil,nil,false));
  }

@render src/third_party/dartino/mark_sweep.h toit::MarkingStack::push tu=src/third_party/dartino/object_memory_mark_sweep.cc
  void push(HeapObject* object)
  //@ requires pending(self,?w) &*& located(object) == true &*& object_start(object) == true;
  //@ ensures pending(self,enqueue(object,w));
  {
    //@ open pending(self,w);
    //@ list<void *> q = queued(w);
    //@ switch(w) { case work(items,missed,f): }
    ASSERT(GcMetadata::is_marked(object));
    if (next_ < limit_) {
      //@ open pointers_((void **)self->backing_+length(q),128-length(q),_);
      *(next_++) = object;
      //@ close pointers((void **)self->backing_+length(q)+1,0,nil);
      //@ close pointers((void **)self->backing_+length(q),1,cons((void *)object,nil));
      //@ pointers_join((void **)self->backing_);
      //@ forall_append(q,cons((void *)object,nil),located);
      //@ forall_append(q,cons((void *)object,nil),object_start);
    } else {
      overflowed_ = true;
      GcMetadata::mark_stack_overflow(object);
    }
    //@ close pending(self,enqueue(object,w));
  }

@render src/third_party/dartino/mark_sweep.h toit::MarkingVisitor::mark_pointer tu=src/third_party/dartino/object_memory_mark_sweep.cc
  void INLINE mark_pointer(Object* object)
  //@ requires visitor(self,?t) &*& valid_root(object) == true;
  //@ ensures visitor(self,discover(object,t));
  {
    //@ open visitor(self,t);
    //@ switch(t) { case tracing(seen,w): }
    //@ if (!located(object)) close visitor(self,t);
    if (!GcMetadata::in_new_or_old_space(object)) return;
    HeapObject* heap_object = HeapObject::cast(object);
    if (!GcMetadata::mark_grey_if_not_marked(heap_object)) {
      marking_stack_->push(heap_object);
    }
    //@ close visitor(self,discover(object,t));
  }

@render src/third_party/dartino/mark_sweep.h toit::MarkingVisitor::do_roots tu=src/third_party/dartino/object_memory_mark_sweep.cc
  virtual void do_roots(Object** start, word length) override
  //@ requires pointers((void **)start,length,?roots) &*& visitor(self,?t) &*& forall(roots,valid_root) == true &*& length >= 0 &*& pointer_within_limits(start) == true;
  //@ ensures pointers((void **)start,length,roots) &*& visitor(self,trace_roots(roots,t));
  {
    //@ pointers_limits((void **)start);
    Object** end = start + length;
    //@ int i = 0;
    //@ close pointers((void **)start,0,nil);
    for (Object** p = start; p < end; p++)
    /*@ invariant 0 <= i &*& i <= length &*& p == start+i &*&
        pointers((void **)start,i,?prefix) &*& pointers((void **)p,length-i,?rest) &*& append(prefix,rest) == roots &*&
        forall(rest,valid_root) == true &*& visitor(self,?current) &*& trace_roots(rest,current) == trace_roots(roots,t); @*/
    {
      //@ open pointers((void **)p,length-i,rest);
      mark_pointer(*p);
      //@ close pointers((void **)p+1,0,nil);
      //@ close pointers((void **)p,1,cons(head(rest),nil));
      //@ pointers_join((void **)start);
      //@ append_assoc(prefix,cons(head(rest),nil),tail(rest));
      //@ i++;
    }
    //@ open pointers((void **)end,0,_);
  }

@verbatim
bool HeapObject_has_active_finalizer(HeapObject *self);
//@ requires [?f]heap(?objs,?H) &*& mem(self,objs) == true;
//@ ensures [f]heap(objs,H) &*& result == ((o_hw(H(self)) & 32) != 0);

@render src/third_party/dartino/mark_sweep.h toit::MarkingVisitor::skip_marking tu=src/third_party/dartino/object_memory_mark_sweep.cc
  bool skip_marking(HeapObject* object) const override
  /*@ requires [?f]heap(?objs,?H) &*& mem(object,objs) == true &*&
               [?v]self->program_ |-> ?image &*& [?g]program(image,?ids); @*/
  /*@ ensures [f]heap(objs,H) &*& [v]self->program_ |-> image &*& [g]program(image,ids) &*&
        result == ((o_hw(H(object)) & 32) != 0 && has_tag(H,object,INSTANCE_TAG) &&
                   smi_ptr(header_cid(o_hw(H(object)))) == smi_ptr(map_cid(ids))); @*/
  {
    if (!object->has_active_finalizer()) return false;
    if (!is_instance(object)) return false;
    if (object->class_id() != program_->map_class_id()) return false;
    return true;
  }

@verbatim
typedef MarkingVisitor RootCallback;
/*@
fixpoint bool stack_slot(uword lo,uword hi,void *o) {
  return (lo <= (uword)o && (uword)o < hi) || valid_root(o);
}
fixpoint tracing stack_trace(list<void *> slots,uword lo,uword hi,tracing t) {
  switch(slots) {
    case nil: return t;
    case cons(h,r): return stack_trace(r,lo,hi,
      lo <= (uword)h && (uword)h < hi ? t : discover(h,t));
  }
}
@*/
// Specialization of the virtual callback to the marking visitor's proved range method.
void RootCallback_do_roots(RootCallback *self,Object **roots,word length);
//@ requires pointers((void **)roots,length,?xs) &*& visitor(self,?t) &*& forall(xs,valid_root) == true &*& length >= 0 &*& pointer_within_limits(roots) == true;
//@ ensures pointers((void **)roots,length,xs) &*& visitor(self,trace_roots(xs,t));

@render src/objects.h toit::RootCallback::do_root tu=src/objects.cc
  void do_root(Object** root)
  //@ requires *root |-> ?o &*& visitor(self,?t) &*& valid_root(o) == true;
  //@ ensures *root |-> o &*& visitor(self,discover(o,t));
  {
    //@ pointer_limits((void **)root);
    //@ close pointers((void **)root+1,0,nil);
    //@ close pointers((void **)root,1,cons((void *)o,nil));
    do_roots(root, 1);
    //@ open pointers((void **)root,1,_);
    //@ open pointers((void **)root+1,0,_);
  }

@render src/objects.cc toit::visit_stack_roots
static void visit_stack_roots(Object** slots, word top, word length, uword bytecodes_from, uword bytecodes_to, RootCallback* cb)
/*@ requires 0 <= top &*& top <= length &*& pointer_within_limits(slots) == true &*&
             pointer_within_limits(slots+top) == true &*& pointers((void **)slots+top,length-top,?xs) &*&
             forall(xs,(stack_slot)(bytecodes_from,bytecodes_to)) == true &*& visitor(cb,?t); @*/
/*@ ensures pointers((void **)slots+top,length-top,xs) &*& visitor(cb,stack_trace(xs,bytecodes_from,bytecodes_to,t)); @*/
{
  Object** roots = slots + top;
  word used = length - top;
  //@ pointers_limits((void **)roots);
  //@ close pointers((void **)roots,0,nil);
  for (word i = 0; i < used; i++)
  /*@ invariant 0 <= i &*& i <= used &*& pointers((void **)roots,i,?prefix) &*&
                pointers((void **)roots+i,used-i,?rest) &*& append(prefix,rest) == xs &*&
                forall(rest,(stack_slot)(bytecodes_from,bytecodes_to)) == true &*& visitor(cb,?current) &*& stack_trace(rest,bytecodes_from,bytecodes_to,current) == stack_trace(xs,bytecodes_from,bytecodes_to,t); @*/
  {
    //@ open pointers((void **)roots+i,used-i,rest);
    //@ pointer_limits((void **)roots+i);
    uword value = reinterpret_cast<uword>(roots[i]);
    /*@ if (value >= bytecodes_from && value < bytecodes_to) {
      close pointers((void **)roots+i+1,0,nil);
      close pointers((void **)roots+i,1,cons(head(rest),nil));
      pointers_join((void **)roots);
      append_assoc(prefix,cons(head(rest),nil),tail(rest));
    } @*/
    if (value >= bytecodes_from && value < bytecodes_to) continue;
    cb->do_root(&roots[i]);
    //@ close pointers((void **)roots+i+1,0,nil);
    //@ close pointers((void **)roots+i,1,cons(head(rest),nil));
    //@ pointers_join((void **)roots);
    //@ append_assoc(prefix,cons(head(rest),nil),tail(rest));
  }
  //@ open pointers((void **)roots+used,0,_);
}

@verbatim
/*@
fixpoint work scheduled(tracing t) { switch(t) { case tracing(seen,w): return w; } }
fixpoint list<void *> deferred(work w) { switch(w) { case work(q,m,f): return m; } }
lemma void keeps_queue(void *target,list<void *> roots,tracing t)
  requires mem(target,queued(scheduled(t))) == true;
  ensures mem(target,queued(scheduled(trace_roots(roots,t)))) == true;
{
  switch(roots) {
    case nil:
    case cons(h,r):
      switch(t) { case tracing(seen,w): switch(w) { case work(q,m,f): } }
      keeps_queue(target,r,discover(h,t));
  }
}
fixpoint bool waiting(void *o,tracing t) {
  switch(t) { case tracing(seen,w): return mem(o,queued(w)) || mem(o,deferred(w)); }
}
lemma void trace_custody(void *o,list<void *> roots,tracing t)
  requires true;
  ensures (!waiting(o,t) && (mem(o,seen_objects(t)) || !mem(o,seen_objects(trace_roots(roots,t))))) ||
          waiting(o,trace_roots(roots,t));
{
  switch(roots) {
    case nil:
    case cons(h,r):
      switch(t) {
        case tracing(seen,w):
          switch(w) { case work(q,m,f): }
          mem_append(o,queued(w),cons(h,nil));
      }
      trace_custody(o,r,discover(h,t));
      root_membership(o,r,discover(h,t));
  }
}
// Count unmarked candidates in a finite collection heap. Repeated entries
// only increase the bound; a newly discovered candidate removes at least one.
fixpoint int white(list<void *> universe,list<void *> seen) {
  switch(universe) {
    case nil: return 0;
    case cons(h,r): return (mem(h,seen) ? 0 : 1) + white(r,seen);
  }
}
fixpoint bool in_collection(list<void *> universe,void *o) {
  return !located(o) || mem(o,universe);
}
lemma void white_nonnegative(list<void *> universe,list<void *> seen)
  requires true;
  ensures white(universe,seen) >= 0;
{
  switch(universe) { case nil: case cons(h,r): white_nonnegative(r,seen); }
}
lemma void white_after_discovery(list<void *> universe,list<void *> seen,void *o)
  requires !mem(o,seen);
  ensures white(universe,cons(o,seen)) + (mem(o,universe) ? 1 : 0) <= white(universe,seen);
{
  switch(universe) { case nil: case cons(h,r): white_after_discovery(r,seen,o); }
}
fixpoint int drain_rank(list<void *> universe,tracing t) {
  switch(t) { case tracing(seen,w): return white(universe,seen) + length(queued(w)); }
}
fixpoint int overflow_budget(list<void *> universe,tracing t) {
  switch(t) { case tracing(seen,w): return white(universe,seen) + length(deferred(w)); }
}
lemma void trace_budget(list<void *> roots,list<void *> universe,tracing t)
  requires forall(roots,(in_collection)(universe)) == true;
  ensures drain_rank(universe,trace_roots(roots,t)) <= drain_rank(universe,t) &*&
          overflow_budget(universe,trace_roots(roots,t)) <= overflow_budget(universe,t) &*&
          (!flagged(scheduled(t)) || flagged(scheduled(trace_roots(roots,t)))) &*&
          (!flagged(scheduled(trace_roots(roots,t))) || flagged(scheduled(t)) ||
            white(universe,seen_objects(trace_roots(roots,t))) < white(universe,seen_objects(t))) &*&
          length(deferred(scheduled(trace_roots(roots,t)))) >= length(deferred(scheduled(t))) &*&
          white(universe,seen_objects(trace_roots(roots,t))) <= white(universe,seen_objects(t));
{
  switch(roots) {
    case nil:
    case cons(h,r):
      switch(t) {
        case tracing(seen,w):
          switch(w) { case work(q,m,f): }
          if (located(h) && !mem(h,seen)) {
            white_after_discovery(universe,seen,h);
            length_append(queued(w),cons(h,nil));
          }
      }
      trace_budget(r,universe,discover(h,t));
  }
}
// Referents enumerated by roots_do, after applying any weak-reference policy.
fixpoint list<void *> referents(HeapObject *o);
fixpoint bool edge_closed(void *source,void *child,list<void *> black,list<void *> seen) {
  return !mem(source,black) || !located(child) || !mem(child,referents((HeapObject *)source)) || mem(child,seen);
}
// An arbitrary finite path through the strong edges enumerated by roots_do.
fixpoint bool strong_path(list<void *> path) {
  switch(path) {
    case nil: return true;
    case cons(h,r): return located(h) && (r == nil || mem(head(r),referents((HeapObject *)h))) && strong_path(r);
  }
}
fixpoint bool accounted(list<void *> path,tracing t,list<void *> black) {
  switch(path) {
    case nil: return true;
    case cons(h,r): return (!mem(h,seen_objects(t)) || waiting(h,t) || mem(h,black)) && accounted(r,t,black);
  }
}
fixpoint bool closed_path(list<void *> path,list<void *> black,list<void *> seen) {
  switch(path) {
    case nil: return true;
    case cons(h,r): return (r == nil || edge_closed(h,head(r),black,seen)) && closed_path(r,black,seen);
  }
}
fixpoint bool intersects(list<void *> path,list<void *> set) {
  switch(path) { case nil: return false; case cons(h,r): return mem(h,set) || intersects(r,set); }
}
fixpoint bool included(list<void *> path,list<void *> set) {
  switch(path) { case nil: return true; case cons(h,r): return mem(h,set) && included(r,set); }
}
lemma void drain_path_step(list<void *> path,HeapObject *object,list<void *> q,list<void *> missed,bool flag,list<void *> seen,list<void *> black)
  requires accounted(path,tracing(seen,work(append(q,cons((void *)object,nil)),missed,flag)),black) == true &*&
           closed_path(path,black,seen) == true;
  ensures accounted(path,trace_roots(referents(object),tracing(seen,work(q,missed,flag))),cons((void *)object,black)) == true &*&
          closed_path(path,cons((void *)object,black),seen_objects(trace_roots(referents(object),tracing(seen,work(q,missed,flag))))) == true;
{
  switch(path) {
    case nil:
    case cons(h,r):
      tracing popped = tracing(seen,work(q,missed,flag));
      mem_append(h,q,cons((void *)object,nil));
      trace_custody(h,referents(object),popped);
      if (r != nil) root_membership(head(r),referents(object),popped);
      drain_path_step(r,object,q,missed,flag,seen,black);
  }
}
lemma void drain_path_result(list<void *> path,list<void *> seen,list<void *> missed,bool flag,list<void *> black)
  requires strong_path(path) == true &*& (path == nil || mem(head(path),seen)) &*&
           accounted(path,tracing(seen,work(nil,missed,flag)),black) == true &*& closed_path(path,black,seen) == true;
  ensures included(path,black) || intersects(path,missed);
{
  switch(path) {
    case nil:
    case cons(h,r):
      if (mem(h,black)) {
        switch(r) {
          case nil:
          case cons(child,rest):
            drain_path_result(r,seen,missed,flag,black);
        }
      }
  }
}
// Provides the object layout contracts for a collection on this program.
predicate scan_heap(Program *image; list<void *> universe);
predicate visited_size(HeapObject *o,Program *image,word bytes);
predicate blackened(list<void *> objects);
@*/
void HeapObject_roots_do(HeapObject *self,Program *image,RootCallback *cb);
//@ requires scan_heap(image,?universe) &*& located(self) == true &*& object_start(self) == true &*& visitor(cb,?t);
//@ ensures scan_heap(image,universe) &*& forall(referents(self),(in_collection)(universe)) == true &*& visitor(cb,trace_roots(referents(self),t)) &*& visited_size(self,image,?bytes) &*& bytes > 0;
//@ terminates;
word HeapObject_size(HeapObject *self,Program *image);
//@ requires visited_size(self,image,?bytes);
//@ ensures visited_size(self,image,bytes) &*& result == bytes;
//@ terminates;
void GcMetadata_mark_all(HeapObject *object,uword bytes);
//@ requires visited_size(object,?image,bytes) &*& blackened(?done);
//@ ensures blackened(cons((void *)object,done));
//@ terminates;

@render src/third_party/dartino/mark_sweep.h toit::MarkingStack::is_empty tu=src/third_party/dartino/object_memory_mark_sweep.cc
  bool is_empty()
  //@ requires pending(self,?w);
  //@ ensures pending(self,w) &*& result == (queued(w) == nil);
  //@ terminates;
  {
    //@ open pending(self,w);
    //@ switch(w) { case work(q,m,f): }
    //@ switch(queued(w)) { case nil: case cons(h,r): }
    return next_ == &backing_[0];
    //@ close pending(self,w);
  }

@render src/third_party/dartino/mark_sweep.h toit::MarkingStack::clear_overflow tu=src/third_party/dartino/object_memory_mark_sweep.cc
  void clear_overflow()
  //@ requires pending(self,?w);
  //@ ensures pending(self,work(queued(w),deferred(w),false));
  //@ terminates;
  {
    //@ open pending(self,w);
    //@ switch(w) { case work(q,m,f): }
    overflowed_ = false;
    //@ close pending(self,work(queued(w),deferred(w),false));
  }

@render src/third_party/dartino/object_memory_mark_sweep.cc toit::MarkingStack::empty
void MarkingStack::empty(RootCallback* visitor)
/*@ requires visitor->marking_stack_ |-> self &*& marked(?seen) &*& pending(self,?w) &*&
    self->program_ |-> ?image &*& scan_heap(image,?universe) &*& blackened(?done) &*& exists<void*>(?target) &*& exists<void*>(?child) &*&
    edge_closed(target,child,done,seen) == true &*& exists<list<void *> >(?path) &*& strong_path(path) == true &*&
    (path == nil || mem(head(path),seen)) &*& accounted(path,tracing(seen,w),done) == true &*& closed_path(path,done,seen) == true; @*/
/*@ ensures visitor->marking_stack_ |-> self &*& marked(?seen_after) &*& white(universe,seen_after) <= white(universe,seen) &*& pending(self,?last) &*& queued(last) == nil &*&
    (!flagged(w) || flagged(last)) &*& (!flagged(last) || flagged(w) || white(universe,seen_after) < white(universe,seen)) &*&
    length(deferred(last)) >= length(deferred(w)) &*&
    white(universe,seen_after) + length(deferred(last)) <= white(universe,seen) + length(deferred(w)) &*&
    self->program_ |-> image &*& scan_heap(image,universe) &*& blackened(?scanned) &*&
    edge_closed(target,child,scanned,seen_after) == true &*&
    (included(path,scanned) || intersects(path,deferred(last))) &*&
    (path == nil || mem(head(path),seen_after)) &*& accounted(path,tracing(seen_after,last),scanned) == true &*&
    closed_path(path,scanned,seen_after) == true &*&
    (mem(target,seen) || !mem(target,seen_after) || mem(target,deferred(last)) || mem(target,scanned)) &*&
    (!mem(target,deferred(w)) || mem(target,deferred(last)) || mem(target,scanned)) &*&
    (!mem(target,queued(w)) && !mem(target,done) || mem(target,scanned)); @*/
//@ terminates;
