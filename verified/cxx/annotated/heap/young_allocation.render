@include ../model/model.cfg
@verbatim
#include "remembered_card.gen.h"

typedef struct AtomicUint64 { char opaque; } AtomicUint64;

typedef struct TwoSpaceHeap {
  SemiSpace semi_space_;
  OldSpace old_space_;
  ObjectHeap *process_heap_;
  bool large_allocation_failed_;
  AtomicUint64 total_bytes_allocated_;
} TwoSpaceHeap;
struct ObjectHeap { TwoSpaceHeap two_space_heap_; bool retrying_primitive_; };

// Card-table and atomic accounting resources are disjoint from the reservation.
/*@
inductive retry_source = no_old_storage | old_bump | old_provider;
// The object constructor owns the returned words separately from either
// space's cursor, sentinel, free-list and remembered-card resources.
predicate raw_reservation(HeapObject *object, int size, list<option<void *> > words) =
    object == 0 ? words == nil :
    0 < (uword)raw(object) &*& (uword)raw(object) % sizeof(word) == 0 &*&
    pointers_((void **)raw(object),size/sizeof(word),words);
predicate charge_request(AtomicUint64 *counter,int size);
predicate charged(AtomicUint64 *counter,int size);
predicate record_request(TwoSpaceHeap *heap, int address, int size) =
    pointer_within_limits(&heap->total_bytes_allocated_) == true &*& charge_request(&heap->total_bytes_allocated_,size) &*&
    published_card(address,?slot) &*& uchar_(slot,_);
predicate recorded(TwoSpaceHeap *heap, int address, int size) =
    charged(&heap->total_bytes_allocated_,size) &*&
    published_card(address,?slot) &*& u_character(slot,GcMetadata_NEW_SPACE_POINTERS);
predicate retry_request(TwoSpaceHeap *heap, int size, int expected, retry_source source, bool retry, bool large) =
    heap->large_allocation_failed_ |-> large &*& heap->process_heap_ |-> ?process &*&
    process->retrying_primitive_ |-> retry &*&
    (retry ? pointer_within_limits(&heap->old_space_) == true &*& old_window(&heap->old_space_,?t,?l,?slots) &*& old_controls(&heap->old_space_,?tracking,?used,?failed) &*&
       old_request(&heap->old_space_,size,t,l,tracking,used,!tracking && used > 0 && failed,?f,?c) &*&
       source == (size <= l-t ? old_bump : !tracking && used > 0 && failed ? no_old_storage : old_provider) &*&
       expected == (size <= l-t ? t : !tracking && used > 0 && failed ? 0 : f != 0 ? f : c) &*&
       (expected != 0 ? record_request(heap,expected,size) : true) : expected == 0 &*& source == no_old_storage);
predicate retry_result(TwoSpaceHeap *heap, int size, int expected, retry_source source, bool retry, bool large, HeapObject *object) =
    heap->large_allocation_failed_ |-> (large || size >= MINIMUM_POST_GC_SPACE) &*&
    heap->process_heap_ |-> ?process &*& process->retrying_primitive_ |-> retry &*&
    (retry ? old_window(&heap->old_space_,_,_,_) &*& old_controls(&heap->old_space_,_,_,_) : true) &*&
    (source == old_bump ? start_slot(expected,some((uint8)(expected % 256))) :
     source == old_provider ? old_sources(&heap->old_space_,?stage,size,?f,?c) &*&
       (f != 0 ? stage == 1 && expected == f : stage == 2 && expected == c) : true) &*&
    (expected == 0 ? object == 0 : object != 0 &*& (uword)object == expected+1 &*& raw(object) == (uword *)expected &*&
       recorded(heap,expected,size));
predicate allocation_window(TwoSpaceHeap *self, int size, int top, int limit, int words, list<option<void *> > slots) =
    self->semi_space_.top_ |-> top &*& self->semi_space_.limit_ |-> limit &*&
    pointers_((void **)top, words, slots) &*& 0 <= words &*& limit == top + words * sizeof(word) &*&
    (top != 0 || words == 0) &*& top % sizeof(word) == 0 &*& 0 < size &*& size % sizeof(word) == 0 &*&
    [_]chunk_list_empty(&self->semi_space_, words == 0);
predicate allocated_window(TwoSpaceHeap *self, int size, int top, int limit, int words, list<option<void *> > slots, HeapObject *result;) =
    self->semi_space_.limit_ |-> limit &*&
    (size >= limit - top ?
       self->semi_space_.top_ |-> top &*&
       (words == 0 ? pointers_((void **)top,words,slots) :
        pointer((void **)top,0) &*& pointers_((void **)top+1,words-1,tail(slots))) :
       result != 0 &*& raw(result) == (uword *)top &*&
       self->semi_space_.top_ |-> top+size &*&
       pointer((void **)(top+size),0) &*&
       pointers_((void **)(top+size)+1,words-size/sizeof(word)-1,tail(drop(size/sizeof(word),slots))));
@*/
void atomic_uint64_add_relaxed(AtomicUint64 *counter,uword size);
//@ requires charge_request(counter,size);
//@ ensures charged(counter,size);

@prototypes
@render src/heap.h toit::ObjectHeap::retrying_primitive tu=src/heap.cc
  bool retrying_primitive() const
  //@ requires [?f]self->retrying_primitive_ |-> ?retry;
  //@ ensures [f]self->retrying_primitive_ |-> retry &*& result == retry;
  { return retrying_primitive_; }

@render src/objects.h toit::HeapObject::from_address tu=src/third_party/dartino/two_space_heap.cc
  static HeapObject* from_address(uword address)
  //@ requires 0 < address &*& address < UINTPTR_MAX &*& address % sizeof(word) == 0;
  //@ ensures result == (HeapObject *)(address + 1) &*& (uword)result == address + 1 &*& raw(result) == (uword *)address;
  {
    ASSERT((address & NON_SMI_TAG_MASK) == SMI_TAG);
    return reinterpret_cast<HeapObject*>(address + HEAP_TAG);
  }
@render src/third_party/dartino/two_space_heap.cc toit::TwoSpaceHeap::allocate
HeapObject* TwoSpaceHeap::allocate(uword size)
//@ requires allocation_window(self,size,?top,?limit,?words,?slots) &*& retry_request(self,size,?expected,?source,?retry,?large);
//@ ensures raw_reservation(result,size,?grant) &*& (size < limit-top ? grant == take(size/sizeof(word),slots) : true) &*& allocated_window(self,size,top,limit,words,slots,result) &*& (size >= limit-top ? retry_result(self,size,expected,source,retry,large,result) : retry_request(self,size,expected,source,retry,large));
{
  //@ open allocation_window(self,size,top,limit,words,slots);
  uword result = semi_space_.allocate(size);
  if (result == 0) {
    return new_space_allocation_failure(size);
  }
  //@ close raw_reservation((HeapObject *)(result+1),size,take(size/sizeof(word),slots));
  return HeapObject::from_address(result);
}

@render src/heap.h toit::ObjectHeap::_allocate_raw tu=src/heap.cc
  HeapObject* _allocate_raw(word byte_size)
  //@ requires allocation_window(&self->two_space_heap_,byte_size,?top,?limit,?words,?slots) &*& retry_request(&self->two_space_heap_,byte_size,?expected,?source,?retry,?large) &*& 0 < byte_size;
  //@ ensures raw_reservation(result,byte_size,?grant) &*& (byte_size < limit-top ? grant == take(byte_size/sizeof(word),slots) : true) &*& allocated_window(&self->two_space_heap_,byte_size,top,limit,words,slots,result) &*& (byte_size >= limit-top ? retry_result(&self->two_space_heap_,byte_size,expected,source,retry,large,result) : retry_request(&self->two_space_heap_,byte_size,expected,source,retry,large));
  {
    return two_space_heap_.allocate(byte_size);
  }

@render src/third_party/dartino/two_space_heap.cc toit::TwoSpaceHeap::new_space_allocation_failure
HeapObject* TwoSpaceHeap::new_space_allocation_failure(uword size)
//@ requires retry_request(self,size,?expected,?source,?retry,?large) &*& size > 0 &*& size % sizeof(word) == 0;
//@ ensures retry_result(self,size,expected,source,retry,large,result) &*& raw_reservation(result,size,?grant);
{
  //@ open retry_request(self,size,expected,source,retry,large);
  if (size >= MINIMUM_POST_GC_SPACE) {
    large_allocation_failed_ = true;
  }
  if (process_heap_->retrying_primitive()) {
    // When we are rerunning a primitive after a GC we don't want to
    // trigger a new GC unless we abolutely have to, so we allow allocation
    // directly into old-space.
    uword result = old_space_.allocate(size);
    if (result != 0) {
      //@ open reservation(result,size);
      //@ div_rem_nonneg(size,sizeof(word));
      //@ pointers__to_chars_((void **)result);
      //@ chars__limits((char *)result);
      //@ chars__to_pointers_((void **)result,size/sizeof(word));
      //@ assert pointers_((void **)result,size/sizeof(word),?grant);
      //@ close raw_reservation((HeapObject *)(result+1),size,grant);
      record_direct_old_allocation(result, size);
      //@ close retry_result(self,size,expected,source,retry,large,(HeapObject *)(result+1));
      return HeapObject::from_address(result);
    }
    //@ open reservation(0,size);
  }
  //@ close raw_reservation(0,size,nil);
  //@ close retry_result(self,size,expected,source,retry,large,0);
  return null;
}

@render src/third_party/dartino/two_space_heap.cc toit::TwoSpaceHeap::record_direct_old_allocation
void TwoSpaceHeap::record_direct_old_allocation(uword address, uword size)
//@ requires record_request(self,address,size);
//@ ensures recorded(self,address,size);
{
  //@ open record_request(self,address,size);
  //@ published_card_address(address);
  // New-space allocations are counted through its used-byte total.
  // This primitive retry bypasses new space, so account for it here.
  total_bytes_allocated_.fetch_add(size, std::memory_order_relaxed);
  // The code that populates newly allocated objects assumes that they
  // are in new space and does not have a write barrier.  We mark the
  // object dirty immediately, so it is checked by the next GC.
  GcMetadata::insert_into_remembered_set(address);
  //@ close recorded(self,address,size);
}
