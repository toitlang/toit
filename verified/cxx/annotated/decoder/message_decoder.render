  //@ open dec(self, fb, proc, ids, fmt, b, size, cap, c, st, k);
  //@ if (fmt != MESSAGE_FORMAT_TISON) ipc_room(self, 4);
  word cursor = cursor_;
  word next = cursor + sizeof(result);
  if (next <= size_) {
    //@ uchars_split(b, c);
