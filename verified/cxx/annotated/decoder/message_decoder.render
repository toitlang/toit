@render src/heap.cc toit::ObjectHeap::next_finalizer_to_run
Object* ObjectHeap::next_finalizer_to_run()
/*@ requires [_]object_heap(self, ?p) &*& self == process_heap_address(p) &*&
             finalizer_ready(p, ?ready, ?pending, ?registered) &*&
             [?g]heap(?objs, ?H) &*& live_closures(objs, pending) == true; @*/
/*@ ensures [g]heap(objs, H) &*& good(objs, result) == true &*& live_closures(objs, tail(pending)) == true &*&
            finalizer_ready(p, _, tail(pending), ready && keep_callback(head(pending)) ? cons(head(pending), registered) : registered) &*&
            (ready ? result == closure_of(head(pending)) : true); @*/
{
  //@ open finalizer_ready(p, ready, pending, registered);
  auto node = static_cast<CallableFinalizerNode*>(runnable_finalizers_.remove_first());
  if (node == null) {
    //@ close finalizer_ready(p, false, nil, registered);
    return program()->null_object();
  }

  Object* result = node->lambda();
  if (node->keep_after_callback()) {
    //@ open registered_callbacks(self, registered);
    //@ close registered_callbacks(self, registered);
    registered_callback_finalizers_.prepend(node);
  } else {
    delete node;
  }
  //@ close finalizer_ready(p, _, tail(pending), _);
  return result;
}

@render src/heap.h toit::ObjectHeap::has_finalizer_to_run tu=src/heap.cc
  bool has_finalizer_to_run() const
  //@ requires [_]object_heap(self, ?p) &*& self == process_heap_address(p) &*& [?f]finalizer_ready(p, ?ready, ?pending, ?registered);
  //@ ensures [f]finalizer_ready(p, ready, pending, registered) &*& result == ready &*& ready == (pending != nil);
  {
    //@ open [f]finalizer_ready(p, ready, pending, registered);
    //@ open [f]runnable_callbacks(self, pending);
    //@ assert [f]callback_chain(?first, self, ?last, pending);
    //@ open [f]callback_chain(first, self, last, pending);
    //@ close [f]callback_chain(first, self, last, pending);
    return !runnable_finalizers_.is_empty();
    //@ close [f]runnable_callbacks(self, pending);
    //@ close [f]finalizer_ready(p, ready, pending, registered);
  }

@render src/primitive_core.cc toit::primitive_task_has_messages
PRIMITIVE(task_has_messages)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& [?fh]heap(?objs, ?H) &*&
             [?fa]allocation_allowance(process, ?available) &*& [?ff]finalizer_ready(process, ?ready, ?pending, ?registered) &*&
             [?fm]mailbox(process, ?m); @*/
/*@ ensures [fp]process(process, prog, ids) &*& [fh]heap(objs, H) &*& oom_clean(objs, H, objs, H, result) == true &*&
            [fa]allocation_allowance(process, available) &*& [ff]finalizer_ready(process, ready, pending, registered) &*& [fm]mailbox(process, m) &*&
            (available < 0 ? (uword)result == 4 * Program_ALLOCATION_FAILED_INDEX + 3 :
             result == process_boolean(process, ready || m != 0) &*& mem(result, objs) == true); @*/
{
  ObjectHeap* heap = process->object_heap();
  //@ error_word(Program_ALLOCATION_FAILED_INDEX);
  if (heap->max_external_allocation() < 0) FAIL(ALLOCATION_FAILED);
  if (heap->has_finalizer_to_run()) {
    return BOOL(true);
  } else {
    Message* message = process->peek_message();
    return BOOL(message != null);
  }
}

@render src/primitive_core.cc toit::primitive_task_receive_message
PRIMITIVE(task_receive_message)
/*@ requires process != 0 &*& [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             finalizer_ready(process, ?ready, ?pending, ?registered) &*& live_closures(objs, pending) == true &*& mailbox(process, ?m) &*& (m == 0 ? true : queued(m)); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows_class(objs, H, objs2, H2) == true &*&
            finalizer_ready(process, _, tail(pending), ready && keep_callback(head(pending)) ? cons(head(pending), registered) : registered) &*&
            live_closures(objs2, tail(pending)) == true &*& (ready ? result == closure_of(head(pending)) : true) &*& mailbox(process, ?m2) &*& (m2 == 0 ? true : queued(m2)) &*&
            (oom_error(prog, result) == false || m2 == m); @*/
{
  // The retry rule's part of the process: a failure for want of memory
  // leaves the mailbox (its first message queued and whole again); every
  // other result is an object, not a marked error.
  //@ process_program(process);
  //@ grows_refl(objs, H);
  //@ grows_class_of_grows(objs, H, objs, H);
  ObjectHeap* heap = process->object_heap();
  if (heap->has_finalizer_to_run()) {
    return heap->next_finalizer_to_run();
  }

  Message* message = process->peek_message();
  // The library only calls this when task_has_messages is true, but a
  // program can call it at any time (found by verified/core/fuzz).
  if (message == null) return process->null_object();
  //@ open queued(message);
  MessageType message_type = message->message_type();
  Object* result = process->null_object();
  //@ heap_facts(process_null(process));

  if (message_type == MESSAGE_MONITOR_NOTIFY) {
    ObjectNotifyMessage* object_notify = static_cast<ObjectNotifyMessage*>(message);
    ObjectNotifier* notifier = object_notify->object_notifier();
    if (notifier != null) result = notifier->object();
    //@ if (mem(result, objs)) heap_facts(result);
    //@ close dying(message);
  } else if (message_type == MESSAGE_SYSTEM) {
    Array* array = process->object_heap()->allocate_array(4, Smi::from(0));
    //@ open allocated(objs, H, process, array, ?objsA, ?HA);
    //@ if (array == 0) close queued(message); else grows_alloc(objs, H, array, HA);
    //@ if (array != 0) heap_facts(array);
    if (array == null) FAIL(ALLOCATION_FAILED);
    SystemMessage* system_message = static_cast<SystemMessage*>(message);
    //@ assert message->data_ |-> ?d;
    //@ open msg_whole(d);
    //@ assert malloc_block(d, ?cap) &*& [_]encoded(d, cap, ?ps);
    MessageDecoder decoder(process, system_message->data());

    Object* decoded = decoder.decode();
    //@ assert heap(?objs1, ?H1);
    //@ grows_trans(objs, H, objsA, HA, objs1, H1);
    if (decoder.allocation_failed()) {
      decoder.remove_disposing_finalizers();
      //@ receive_give_back(&decoder, d, objs, H, objs1, H1);
      //@ open dec_fields(&decoder);
      //@ close queued(message);
      FAIL(ALLOCATION_FAILED);
    }
    if (decoder.malformed_input()) {
      // Not produced by the encoder (it refuses what the decoder rejects).
      // Drop the message like a canceled one: the objects decoded so far
      // give their out-of-line data back to the message, and deleting it
      // frees all of it (keeping only the decoded part would leak the
      // out-of-line data after the error).
      decoder.remove_disposing_finalizers();
      //@ receive_give_back(&decoder, d, objs, H, objs1, H1);
      //@ open dec_fields(&decoder);
      //@ close dying(message);
      process->remove_first_message();
      return process->null_object();
    }
    //@ dec_finish(&decoder);
    decoder.register_external_allocations();
    system_message->free_data_but_keep_externals();
    //@ dec_done_dispose(&decoder);
    //@ open dec_fields(&decoder);
    //@ grows_keeps(objsA, HA, objs1, H1, array);

    array->at_put(0, Smi::from(system_message->type()));
    //@ assert heap(objs1, ?Ha);
    //@ put_step(objs, H, objs1, H1, Ha, array);
    array->at_put(1, Smi::from(system_message->gid()));
    //@ assert heap(objs1, ?Hb);
    //@ put_step(objs, H, objs1, Ha, Hb, array);
    array->at_put(2, Smi::from(system_message->pid()));
    //@ assert heap(objs1, ?Hc);
    //@ put_step(objs, H, objs1, Hb, Hc, array);
    array->at_put(3, decoded);
    //@ assert heap(objs1, ?Hd);
    //@ put_step(objs, H, objs1, Hc, Hd, array);
    //@ grows_class_of_grows(objs, H, objs1, Hd);
    result = array;
    //@ close dying(message);
  } else {
    UNREACHABLE();
  }

  process->remove_first_message();
  return result;
}
