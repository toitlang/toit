@render src/primitive_core.cc toit::primitive_main_arguments
PRIMITIVE(main_arguments)
/*@ requires process != 0 &*& [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*& main_args(process, ?a) &*& (a == 0 ? true : msg_whole(a)); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows_class(objs, H, objs2, H2) == true &*&
            main_args(process, ?a2) &*& (a2 == 0 ? true : msg_whole(a2)) &*&
            (oom_error(prog, result) == false || a2 == a); @*/
{
  // The retry rule's part of the process: a failure for want of memory
  // leaves the arguments slot (and the message in it whole); the other
  // results are not out-of-memory errors.
  //@ process_program(process);
  //@ error_word(Program_INVALID_ARGUMENT_INDEX);
  //@ immediate_error_not_oom(prog, Program_INVALID_ARGUMENT_INDEX);
  uint8* arguments = process->main_arguments();
  //@ grows_refl(objs, H);
  //@ grows_class_of_grows(objs, H, objs, H);
  if (!arguments) return process->program()->empty_array();
  //@ open msg_whole(arguments);
  //@ assert malloc_block(arguments, ?cap) &*& [_]encoded(arguments, cap, ?ps);

  MessageDecoder decoder(process, arguments);
  Object* decoded = decoder.decode();
  //@ assert heap(?objs1, ?H1);
  //@ if (mem(decoded, objs1)) heap_facts(decoded);
  if (decoder.allocation_failed()) {
    decoder.remove_disposing_finalizers();
    //@ receive_give_back(&decoder, arguments, objs, H, objs1, H1);
    //@ open dec_fields(&decoder);
    FAIL(ALLOCATION_FAILED);
  }
  if (decoder.malformed_input()) {
    // Not produced by the encoder: free all of it (see task_receive_message).
    decoder.remove_disposing_finalizers();
    //@ receive_give_back(&decoder, arguments, objs, H, objs1, H1);
    //@ open dec_fields(&decoder);
    process->clear_main_arguments();
    MessageDecoder::deallocate(arguments);
    FAIL(INVALID_ARGUMENT);
  }

  process->clear_main_arguments();
  //@ dec_finish(&decoder);
  //@ uchars_to_chars(arguments);
  //@ chars_to_chars_((char *)arguments);
  free(arguments);
  decoder.register_external_allocations();
  //@ dec_done_dispose(&decoder);
  //@ open dec_fields(&decoder);
  //@ grows_class_of_grows(objs, H, objs1, H1);
  return decoded;
}

@render src/primitive_core.cc toit::primitive_spawn_arguments
PRIMITIVE(spawn_arguments)
/*@ requires process != 0 &*& [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*& spawn_args(process, ?a) &*& (a == 0 ? true : msg_whole(a)); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows_class(objs, H, objs2, H2) == true &*&
            spawn_args(process, ?a2) &*& (a2 == 0 ? true : msg_whole(a2)) &*&
            (oom_error(prog, result) == false || a2 == a); @*/
{
  // As main_arguments.
  //@ process_program(process);
  //@ error_word(Program_INVALID_ARGUMENT_INDEX);
  //@ immediate_error_not_oom(prog, Program_INVALID_ARGUMENT_INDEX);
  uint8* arguments = process->spawn_arguments();
  //@ grows_refl(objs, H);
  //@ grows_class_of_grows(objs, H, objs, H);
  if (!arguments) return process->program()->empty_array();
  //@ open msg_whole(arguments);
  //@ assert malloc_block(arguments, ?cap) &*& [_]encoded(arguments, cap, ?ps);

  MessageDecoder decoder(process, arguments);
  Object* decoded = decoder.decode();
  //@ assert heap(?objs1, ?H1);
  //@ if (mem(decoded, objs1)) heap_facts(decoded);
  if (decoder.allocation_failed()) {
    decoder.remove_disposing_finalizers();
    //@ receive_give_back(&decoder, arguments, objs, H, objs1, H1);
    //@ open dec_fields(&decoder);
    FAIL(ALLOCATION_FAILED);
  }
  if (decoder.malformed_input()) {
    // Not produced by the encoder: free all of it (see task_receive_message).
    decoder.remove_disposing_finalizers();
    //@ receive_give_back(&decoder, arguments, objs, H, objs1, H1);
    //@ open dec_fields(&decoder);
    process->clear_spawn_arguments();
    MessageDecoder::deallocate(arguments);
    FAIL(INVALID_ARGUMENT);
  }

  process->clear_spawn_arguments();
  //@ dec_finish(&decoder);
  //@ uchars_to_chars(arguments);
  //@ chars_to_chars_((char *)arguments);
  free(arguments);
  decoder.register_external_allocations();
  //@ dec_done_dispose(&decoder);
  //@ open dec_fields(&decoder);
  //@ grows_class_of_grows(objs, H, objs1, H1);
  return decoded;
}

