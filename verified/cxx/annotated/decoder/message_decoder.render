  ASSERT(!decoding_tison());
  ObjectHeap* heap = process_->object_heap();
  for (unsigned i = 0; i < externals_count(); i++)
  //@ invariant self->externals_count_ |-> k &*& intptrs(self->externals_sizes_, k, ws) &*& 0 <= i &*& i <= k;
