@render src/messaging.h toit::MessageDecoder::read_uint8 tu=src/messaging.cc
  uint8 read_uint8()
  //@ requires dec(self, ?fb, ?proc, ?ids, ?fmt, ?b, ?size, ?cap, ?c, ?st, ?k) &*& c <= cap + 15;
  /*@ ensures dec(self, fb, proc, ids, fmt, b, size, cap, c + 1, st, k) &*& (c < cap || result == 0) &*&
              (fmt == MESSAGE_FORMAT_TISON || c < cap); @*/
  {
    //@ open dec(self, fb, proc, ids, fmt, b, size, cap, c, st, k);
    //@ if (fmt != MESSAGE_FORMAT_TISON) ipc_room(self, 1);
    //@ if (c < cap) uchars_nth_limits(b, c);
    word cursor = cursor_++;
    return (cursor < size_) ? buffer_[cursor] : 0;
    //@ close dec(self, fb, proc, ids, fmt, b, size, cap, c + 1, st, k);
  }

@render src/messaging.cc toit::MessageDecoder::read_uint32
uint32 MessageDecoder::read_uint32()
//@ requires dec(self, ?fb, ?proc, ?ids, ?fmt, ?b, ?size, ?cap, ?c, ?st, ?k) &*& c <= cap + 12;
//@ ensures dec(self, fb, proc, ids, fmt, b, size, cap, c + 4, st, k) &*& (c + 4 <= cap || result == 0) &*& (fmt == MESSAGE_FORMAT_TISON || c + 4 <= cap);
{
