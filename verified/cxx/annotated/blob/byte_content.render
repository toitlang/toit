// Copyright (C) 2026 Toit contributors.
//
// Object::byte_content of src/objects.cc: the decoding of a blob argument
// (a string, a byte array, a copy-on-write byte array, a byte-array slice,
// a string slice) into a pointer and a length, for nearly every primitive
// that takes bytes (the Blob argument of the ARGS macros).
//
// Property: for any heap of the object model (instance fields arbitrary:
// a program can store anything in a slice's backing, from and to), a
// successful result is a range inside the content of ONE live string or
// byte array of the heap (`blob_result`: internal content, or the external
// bytes of a string or of a byte array tagged RawByteTag; never a proxy's
// struct), and a string when STRINGS_ONLY is asked for. The recursion is
// bounded: every recursive call is at depth + 1 <= MAX_BYTE_CONTENT_DEPTH.
// The heap is only read (a fraction, given back unchanged).
//
// Self-test (run.sh): the depth limit of 1db9d6ea (#3373) taken out: the
// recursive call's precondition fails.
@include ../model/model.cfg
@header byte_content.gen.h
@verbatim
#include "../model/objects.gen.h"

@prototypes
@render src/objects.h toit::Blob::Blob tu=src/objects.cc type=void(constuint8*,word)
  Blob(const uint8* address, word length)
      : address_(address), length_(length)
  //@ requires self->address_ |-> _ &*& self->length_ |-> _;
  //@ ensures self->address_ |-> address &*& self->length_ |-> length;
  {}

@render src/objects.cc toit::Object::byte_content params=5
bool Object::byte_content(Program* program, const uint8** content, word* length, BlobKind strings_only, int depth) const
/*@ requires [_]program(program, ?ids) &*& prog_ok(ids) == true &*& [?f]heap(?objs, ?H) &*& good(objs, self) == true &*&
             pointer_((void **)content, ?oc0) &*& intptr_(length, ?ol0) &*&
             (strings_only == STRINGS_OR_BYTE_ARRAYS || strings_only == STRINGS_ONLY) &*&
             0 <= depth &*& depth <= Object_MAX_BYTE_CONTENT_DEPTH; @*/
/*@ ensures [f]heap(objs, H) &*& result ? *content |-> ?a &*& *length |-> ?l &*& [_]blob_result(objs, H, strings_only, a, l, _) :
            pointer_((void **)content, ?oc) &*& intptr_(length, ?ol) &*& (oc0 == none || oc != none) &*& (ol0 == none || ol != none); @*/
{
  if (is_string(this)) {
    //@ good_heap(objs, self);
    String::Bytes bytes(String::cast(this));
    *length = bytes.length();
    *content = bytes.address();
    //@ blob_facts(self);
    //@ close blob_result(objs, H, strings_only, blob_base(H, self), blob_len(H, self), self);
    //@ leak blob_result(objs, H, strings_only, blob_base(H, self), blob_len(H, self), self);
    return true;
  }
  if (strings_only == STRINGS_OR_BYTE_ARRAYS && is_byte_array(this)) {
    //@ good_heap(objs, self);
    const ByteArray* byte_array = ByteArray::cast(this);
    // External byte arrays can have structs in them. This is captured in the external tag.
    // We only allow extracting the byte content from an external byte arrays iff it is tagged with RawByteType.
    if (byte_array->has_external_address() && byte_array->external_tag() != RawByteTag) return false;
    ByteArray::ConstBytes bytes(byte_array);
    *length = bytes.length();
    *content = bytes.address();
    //@ blob_facts(self);
    //@ close blob_result(objs, H, strings_only, blob_base(H, self), blob_len(H, self), self);
    //@ leak blob_result(objs, H, strings_only, blob_base(H, self), blob_len(H, self), self);
    return true;
  }
  if (is_instance(this)) {
    //@ good_heap(objs, self);
    if (depth >= MAX_BYTE_CONTENT_DEPTH) return false;
    auto instance = Instance::cast(this);
    auto class_id = instance->class_id();
    //@ heap_facts(instance);
    if (strings_only == STRINGS_OR_BYTE_ARRAYS && class_id == program->byte_array_cow_class_id()) {
      auto backing = instance->at(Instance::BYTE_ARRAY_COW_BACKING_INDEX);
      return backing->byte_content(program, content, length, strings_only, depth + 1);
    } else if ((strings_only == STRINGS_OR_BYTE_ARRAYS && class_id == program->byte_array_slice_class_id())
          || class_id == program->string_slice_class_id()
          || class_id == program->string_byte_slice_class_id()) {
      ASSERT(Instance::STRING_SLICE_STRING_INDEX == Instance::BYTE_ARRAY_SLICE_BYTE_ARRAY_INDEX);
      ASSERT(Instance::STRING_BYTE_SLICE_STRING_INDEX == Instance::BYTE_ARRAY_SLICE_BYTE_ARRAY_INDEX);
      ASSERT(Instance::STRING_SLICE_FROM_INDEX == Instance::BYTE_ARRAY_SLICE_FROM_INDEX);
      ASSERT(Instance::STRING_SLICE_TO_INDEX == Instance::BYTE_ARRAY_SLICE_TO_INDEX);
      auto wrapped = instance->at(Instance::STRING_SLICE_STRING_INDEX);
      auto from = instance->at(Instance::STRING_SLICE_FROM_INDEX);
      auto to = instance->at(Instance::STRING_SLICE_TO_INDEX);
      if (!is_heap_object(wrapped)) return false;
      // TODO(florian): we could eventually accept larger integers here.
      if (!is_smi(from)) return false;
      if (!is_smi(to)) return false;
      word from_value = Smi::value(from);
      word to_value = Smi::value(to);
      bool inner_success = wrapped->byte_content(program, content, length, strings_only, depth + 1);
      if (!inner_success) return false;
      if (0 <= from_value && from_value <= to_value && to_value <= *length) {
        //@ open [_]blob_result(objs, H, strings_only, ?a1, ?l1, ?b);
        //@ blob_facts(b);
        *content += from_value;
        *length = to_value - from_value;
        //@ close blob_result(objs, H, strings_only, a1 + from_value, to_value - from_value, b);
        //@ leak blob_result(objs, H, strings_only, a1 + from_value, to_value - from_value, b);
        return true;
      }
      return false;
    }
  }
  return false;
}

@render src/objects.cc toit::Object::byte_content params=4
bool Object::byte_content(Program* program, const uint8** content, word* length, BlobKind strings_only) const
/*@ requires [_]program(program, ?ids) &*& prog_ok(ids) == true &*& [?f]heap(?objs, ?H) &*& good(objs, self) == true &*&
             pointer_((void **)content, ?oc0) &*& intptr_(length, ?ol0) &*&
             (strings_only == STRINGS_OR_BYTE_ARRAYS || strings_only == STRINGS_ONLY); @*/
/*@ ensures [f]heap(objs, H) &*& result ? *content |-> ?a &*& *length |-> ?l &*& [_]blob_result(objs, H, strings_only, a, l, _) :
            pointer_((void **)content, ?oc) &*& intptr_(length, ?ol) &*& (oc0 == none || oc != none) &*& (ol0 == none || ol != none); @*/
{
  return byte_content(program, content, length, strings_only, 0);
}

@render src/objects.cc toit::Object::byte_content type=bool(Program*,Blob*,BlobKind)const
bool Object::byte_content(Program* program, Blob* blob, BlobKind strings_only) const
/*@ requires [_]program(program, ?ids) &*& prog_ok(ids) == true &*& [?f]heap(?objs, ?H) &*& good(objs, self) == true &*&
             blob->address_ |-> _ &*& blob->length_ |-> _ &*&
             (strings_only == STRINGS_OR_BYTE_ARRAYS || strings_only == STRINGS_ONLY); @*/
/*@ ensures [f]heap(objs, H) &*& blob->address_ |-> ?a &*& blob->length_ |-> ?l &*&
            result ? [_]blob_result(objs, H, strings_only, a, l, _) : true; @*/
{
  const uint8* content = null;
  word length = 0;
  bool result = byte_content(program, &content, &length, strings_only);
  *blob = Blob(content, length);
  return result;
}
