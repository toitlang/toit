//
// GC proof pilot, route A: the ghost model shared by cheney_scan.render and
// cheney_step.render (copies, forwarding, relocation, the scanned and
// pending runs of to-space, extensions of the forwarding).

#ifndef CHENEY_GH
#define CHENEY_GH

#include <listex.gh>

// A copy in to-space: its source (tagged from-space address) and the words
// copied from it (header first), with the reference-slot mask.
inductive cp = cp(void *src, list<void *> ws, list<bool> mask);
fixpoint void *cp_src(cp c) { switch (c) { case cp(s, w, m): return s; } }
fixpoint list<void *> cp_ws(cp c) { switch (c) { case cp(s, w, m): return w; } }
fixpoint list<bool> cp_mask(cp c) { switch (c) { case cp(s, w, m): return m; } }

// A copy is well formed: at least its header, which is not the sentinel,
// and a mask per word, the header not a reference slot.
fixpoint bool wf_cp(cp c) {
  return length(cp_ws(c)) >= 1 && head(cp_ws(c)) != 0 && length(cp_mask(c)) == length(cp_ws(c)) && head(cp_mask(c)) == false;
}
fixpoint bool wf_cps(list<cp> cs) {
  switch (cs) { case nil: return true; case cons(c, t): return wf_cp(c) && wf_cps(t); }
}

// The forwarding installed so far: source -> copy.
inductive visit = visit(void *source, void *target);
fixpoint void *vsrc(visit v) { switch (v) { case visit(p, q): return p; } }
fixpoint void *vtgt(visit v) { switch (v) { case visit(p, q): return q; } }
fixpoint void *relocate(list<visit> fwd, void *p) {
  switch (fwd) {
    case nil: return p;
    case cons(v, t): return vsrc(v) == p ? vtgt(v) : relocate(t, p);
  }
}

// The collector's from-space test (ScavengeVisitor::in_from_space): the
// from-space bounds are fixed for one collection.
fixpoint uintptr_t from_lo();
fixpoint uintptr_t from_sz();
fixpoint bool in_from(void *p) { return (uintptr_t)p % 2 != 0 && from_lo() <= (uintptr_t)p && (uintptr_t)p < from_lo() + from_sz(); }
// A value whose relocation is final: not a from-space reference, or one
// whose object is already forwarded.
fixpoint bool settled(list<visit> fwd, void *w) { return !in_from(w) || mem(w, map(vsrc, fwd)); }

fixpoint bool hd_b(list<bool> m) { switch (m) { case nil: return false; case cons(b, t): return b; } }
fixpoint list<bool> tl_b(list<bool> m) { switch (m) { case nil: return nil; case cons(b, t): return t; } }

// The words of a scanned copy: its reference slots relocated.
fixpoint list<void *> blacken(list<visit> fwd, list<void *> ws, list<bool> mask) {
  switch (ws) {
    case nil: return nil;
    case cons(w, t): return cons(hd_b(mask) ? relocate(fwd, w) : w, blacken(fwd, t, tl_b(mask)));
  }
}
// Every reference slot of a scanned copy is settled.
fixpoint bool all_settled(list<visit> fwd, list<void *> ws, list<bool> mask) {
  switch (ws) {
    case nil: return true;
    case cons(w, t): return (!hd_b(mask) || settled(fwd, relocate(fwd, w)) && settled(fwd, w)) && all_settled(fwd, t, tl_b(mask));
  }
}
fixpoint bool all_settled_cps(list<visit> fwd, list<cp> cs) {
  switch (cs) { case nil: return true; case cons(c, t): return all_settled(fwd, cp_ws(c), cp_mask(c)) && all_settled_cps(fwd, t); }
}

// A run of copies from word address a to e: scanned (black) or pending
// (grey, as copied).
predicate region(void **a, list<cp> cs, bool black, list<visit> fwd; void **e) =
  switch (cs) {
    case nil: return e == a;
    case cons(c, t): return
      pointers(a, length(cp_ws(c)), black ? blacken(fwd, cp_ws(c), cp_mask(c)) : cp_ws(c)) &*&
      region(a + length(cp_ws(c)), t, black, fwd, e);
  };

// fwd2 extends fwd by new entries for from-space objects not yet forwarded.
fixpoint bool fresh_for(list<void *> olds, void *s) { return in_from(s) && !mem(s, olds); }
predicate extension(list<visit> fwd2, list<visit> fwd, list<visit> nv) =
  fwd2 == append(nv, fwd) &*& forall(map(vsrc, nv), (fresh_for)(map(vsrc, fwd))) == true;

lemma void extension_refl(list<visit> fwd)
  requires true;
  ensures extension(fwd, fwd, nil);
{
  close extension(fwd, fwd, nil);
}

// Sources fresh for n1 ++ f1 are fresh for f1.
lemma void fresh_mono(list<void *> xs, list<void *> n1, list<void *> f1)
  requires forall(xs, (fresh_for)(append(n1, f1))) == true;
  ensures forall(xs, (fresh_for)(f1)) == true;
{
  switch (xs) {
    case nil:
    case cons(x, t):
      mem_append(x, n1, f1);
      fresh_mono(t, n1, f1);
  }
}

lemma void extension_trans(list<visit> f3, list<visit> f2, list<visit> f1)
  requires extension(f3, f2, ?n2) &*& extension(f2, f1, ?n1);
  ensures extension(f3, f1, append(n2, n1));
{
  open extension(f3, f2, n2);
  open extension(f2, f1, n1);
  append_assoc(n2, n1, f1);
  map_append(vsrc, n2, n1);
  map_append(vsrc, n1, f1);
  fresh_mono(map(vsrc, n2), map(vsrc, n1), map(vsrc, f1));
  forall_append(map(vsrc, n2), map(vsrc, n1), (fresh_for)(map(vsrc, f1)));
  close extension(f3, f1, append(n2, n1));
}

// Relocation of a settled value is the same under an extension.
lemma void relocate_ext(list<visit> nv, list<visit> fwd, void *w)
  requires settled(fwd, w) == true &*& forall(map(vsrc, nv), (fresh_for)(map(vsrc, fwd))) == true;
  ensures relocate(append(nv, fwd), w) == relocate(fwd, w) &*& settled(append(nv, fwd), w) == true;
{
  switch (nv) {
    case nil:
    case cons(v, t):
      relocate_ext(t, fwd, w);
      map_append(vsrc, nv, fwd);
      map_append(vsrc, t, fwd);
      mem_append(w, map(vsrc, t), map(vsrc, fwd));
      mem_append(w, map(vsrc, nv), map(vsrc, fwd));
  }
}

lemma void blacken_ext(list<visit> nv, list<visit> fwd, list<void *> ws, list<bool> mask)
  requires all_settled(fwd, ws, mask) == true &*& forall(map(vsrc, nv), (fresh_for)(map(vsrc, fwd))) == true;
  ensures blacken(append(nv, fwd), ws, mask) == blacken(fwd, ws, mask) &*& all_settled(append(nv, fwd), ws, mask) == true;
{
  switch (ws) {
    case nil:
    case cons(w, t):
      if (hd_b(mask)) {
        relocate_ext(nv, fwd, w);
        relocate_ext(nv, fwd, relocate(fwd, w));
      }
      blacken_ext(nv, fwd, t, tl_b(mask));
  }
}

// A scanned region stays scanned, with the same words, under an extension.
lemma void region_ext(void **a, list<cp> bs, list<visit> fwd, list<visit> fwd2)
  requires region(a, bs, true, fwd, ?e) &*& all_settled_cps(fwd, bs) == true &*& extension(fwd2, fwd, ?nv);
  ensures region(a, bs, true, fwd2, e) &*& all_settled_cps(fwd2, bs) == true &*& extension(fwd2, fwd, nv);
{
  open region(a, bs, true, fwd, e);
  open extension(fwd2, fwd, nv);
  switch (bs) {
    case nil:
      close extension(fwd2, fwd, nv);
    case cons(c, t):
      blacken_ext(nv, fwd, cp_ws(c), cp_mask(c));
      close extension(fwd2, fwd, nv);
      region_ext(a + length(cp_ws(c)), t, fwd, fwd2);
  }
  close region(a, bs, true, fwd2, e);
}

// Appending a scanned copy at the end of a scanned region.
lemma void region_snoc(void **a, list<cp> bs, list<visit> fwd, cp c)
  requires region(a, bs, true, fwd, ?e) &*& pointers(e, length(cp_ws(c)), blacken(fwd, cp_ws(c), cp_mask(c)));
  ensures region(a, append(bs, cons(c, nil)), true, fwd, e + length(cp_ws(c)));
{
  open region(a, bs, true, fwd, e);
  switch (bs) {
    case nil:
      close region(e + length(cp_ws(c)), nil, true, fwd, e + length(cp_ws(c)));
      close region(a, cons(c, nil), true, fwd, e + length(cp_ws(c)));
    case cons(h, t):
      region_snoc(a + length(cp_ws(h)), t, fwd, c);
      close region(a, append(bs, cons(c, nil)), true, fwd, e + length(cp_ws(c)));
  }
}

lemma void all_settled_cps_snoc(list<visit> fwd, list<cp> bs, cp c)
  requires all_settled_cps(fwd, bs) == true &*& all_settled(fwd, cp_ws(c), cp_mask(c)) == true;
  ensures all_settled_cps(fwd, append(bs, cons(c, nil))) == true;
{
  switch (bs) { case nil: case cons(h, t): all_settled_cps_snoc(fwd, t, c); }
}

lemma void wf_cps_append(list<cp> xs, list<cp> ys)
  requires wf_cps(xs) == true &*& wf_cps(ys) == true;
  ensures wf_cps(append(xs, ys)) == true;
{
  switch (xs) { case nil: case cons(h, t): wf_cps_append(t, ys); }
}


#endif
