@include ../model/model.cfg
@header validator.gen.h
@verbatim
#include "../model/objects.gen.h"

// Frama-C checks this leaf on the same header the VM includes.
bool utf8_is_valid(uint8 *buffer, word length);
//@ requires 0 <= length &*& [?f]uchars(buffer, length, ?cs);
//@ ensures [f]uchars(buffer, length, cs);

@prototypes
@render src/utils.cc toit::Utils::is_valid_utf_8
bool Utils::is_valid_utf_8(const uint8* buffer, word length)
//@ requires [?f]uchars(buffer, length, ?cs);
//@ ensures [f]uchars(buffer, length, cs);
{
  //@ uchars_inv();
  return utf8_is_valid(buffer, length);
}
