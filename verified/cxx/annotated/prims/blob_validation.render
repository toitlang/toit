// The UTF-8 validator receives a readable slice of a live blob. The
// validator's read-only contract is shared with the encoder and decoder.
@include ../model/model.cfg
@verbatim
#include "../utf8/validator.gen.h"
#include "../utf8/utf_8_to_16.gen.h"
#include "../utf8/utf_16_to_8.gen.h"
#include "argument_error.gen.h"
#include "blob_args.gen.h"
#include "read_slice.h"

/*@
// Each pair of owned bytes is one writable native-endian UTF-16 unit.
lemma void open_utf16_buffer(uint8 *p, int units)
  requires uchars(p, 2 * units, _) &*& 0 <= units &*& (uword)p % 2 == 0;
  ensures ushorts_((uint16 *)p, units, ?ws) &*& initialized_units(units, ws) == true;
{
  if (units == 0) {
    open uchars(p, 0, _);
  } else {
    open uchars(p, 2 * units, _);
    open uchars(p + 1, 2 * units - 1, _);
    div_rem_nonneg((uword)p, 2);
    div_rem_nonneg_unique((uword)(p + 2), 2, (uword)p / 2 + 1, 0);
    open_utf16_buffer(p + 2, units - 1);
    close uchars(p + 2, 0, nil);
    close uchars(p + 1, 1, _);
    close uchars(p, 2, _);
    uchars_to_chars(p);
    chars_to_u_short_integer(p);
  }
  close ushorts_((uint16 *)p, units, _);
}

lemma void close_utf16_buffer(uint8 *p, int units)
  requires ushorts_((uint16 *)p, units, ?ws) &*& initialized_units(units, ws) == true &*&
           0 <= units &*& pointer_within_limits(p + 2 * units) == true;
  ensures uchars(p, 2 * units, _);
{
  open ushorts_((uint16 *)p, units, ws);
  if (units == 0) {
    close uchars(p, 0, nil);
  } else {
    assert ushort_((uint16 *)p, ?v);
    switch (v) { case none: case some(w): }
    u_short_integer_to_chars(p);
    chars_to_uchars(p);
    close_utf16_buffer(p + 2, units - 1);
    uchars_join(p);
  }
}
@*/
@prototypes
@render src/primitive_core.cc toit::primitive_byte_array_is_valid_string_content truncating
PRIMITIVE(byte_array_is_valid_string_content)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?a0) &*& pointer(__args - 1, ?a1) &*& pointer(__args - 2, ?a2) &*&
             good(objs, a0) == true &*& good(objs, a1) == true &*& good(objs, a2) == true; @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(objs, H) &*&
            pointer(__args, a0) &*& pointer(__args - 1, a1) &*& pointer(__args - 2, a2) &*& (mem(result, objs) || (uword)result % 4 == 3); @*/
{
  //@ close valid_arg(a1, objs);
  //@ leak valid_arg(a1, objs);
  //@ close valid_arg(a2, objs);
  //@ leak valid_arg(a2, objs);
  //@ error_word(Program_WRONG_BYTES_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  ARGS(Blob, bytes, int, start, int, end);
  if (!(0 <= start && start <= end && end <= bytes.length())) FAIL(OUT_OF_BOUNDS);
  //@ assert [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, ?a, ?l, ?b);
  //@ open [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, a, l, b);
  //@ blob_facts(b);
  //@ borrow_slice(b, a + start, end - start);
  bool valid = Utils::is_valid_utf_8(bytes.address() + start, end - start);
  //@ return_slice(b, a + start);
  return BOOL(valid);
}

@render src/utils.h toit::char_cast tu=src/primitive_core.cc type=constchar*(constunsignedchar*)
inline const char* char_cast(const unsigned char* t)
//@ requires true;
//@ ensures result == (char *)t;
{
  return reinterpret_cast<const char*>(t);
}

@render src/primitive_core.cc toit::primitive_byte_array_convert_to_string truncating
PRIMITIVE(byte_array_convert_to_string)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?a0) &*& pointer(__args - 1, ?a1) &*& pointer(__args - 2, ?a2) &*&
             good(objs, a0) == true &*& good(objs, a1) == true &*& good(objs, a2) == true; @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            pointer(__args, a0) &*& pointer(__args - 1, a1) &*& pointer(__args - 2, a2) &*& ((uword)result % 4 == 3 ?
              objs2 == objs && H2 == H &&
                ((uword)result == 4 * Program_WRONG_BYTES_TYPE_INDEX + 3 ||
                 (uword)result == 4 * Program_WRONG_OBJECT_TYPE_INDEX + 3 ||
                 (uword)result == 4 * Program_OUT_OF_RANGE_INDEX + 3 ||
                 (uword)result == 4 * Program_OUT_OF_BOUNDS_INDEX + 3 ||
                 (uword)result == 4 * Program_ILLEGAL_UTF_8_INDEX + 3 ||
                 (uword)result == ((uword)root_allocation_failed(prog) | 3)) :
              !mem(result, objs) && mem(result, objs2) && has_tag(H2, result, STRING_TAG) &&
              blob_len(H2, result) == smi_val((uword)a2) - smi_val((uword)a1)); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_ILLEGAL_UTF_8_INDEX);
  //@ close valid_arg(a1, objs);
  //@ leak valid_arg(a1, objs);
  //@ close valid_arg(a2, objs);
  //@ leak valid_arg(a2, objs);
  //@ error_word(Program_WRONG_BYTES_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  ARGS(Blob, bytes, int, start, int, end);
  if (!(0 <= start && start <= end && end <= bytes.length())) FAIL(OUT_OF_BOUNDS);
  //@ assert [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, ?a, ?l, ?b);
  //@ open [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, a, l, b);
  //@ blob_facts(b);
  //@ borrow_slice(b, a + start, end - start);
  bool valid = Utils::is_valid_utf_8(bytes.address() + start, end - start);
  //@ return_slice(b, a + start);
  if (!valid) FAIL(ILLEGAL_UTF_8);
  //@ assert valid == true;
  //@ close string_source(heap_bytes(b), objs, H, a + start, end - start);
  return process->allocate_string_or_error(char_cast(bytes.address()) + start, end - start);
  //@ open string_source(heap_bytes(b), objs, H, a + start, end - start);
}

@render src/primitive_core.cc toit::fill_utf_16
static word fill_utf_16(const Blob* input, ByteArray::Bytes* output)
/*@ requires [?f]input->address_ |-> ?src &*& [f]input->length_ |-> ?n &*&
             [?g]output->address_ |-> ?dst &*& [g]output->length_ |-> ?cap &*&
             [?h]uchars(src, n, ?bs) &*& uchars(dst, cap, _) &*&
             0 <= n &*& n <= 0xfffffff &*& 0 <= cap &*&
             cap % 2 == 0; @*/
/*@ ensures [f]input->address_ |-> src &*& [f]input->length_ |-> n &*&
            [g]output->address_ |-> dst &*& [g]output->length_ |-> cap &*&
            [h]uchars(src, n, bs) &*& uchars(dst, cap, _) &*& (result == -1 || ((uword)dst % 2 == 0 && result == utf16_units(bs, 0, -1))) &*&
            ((uword)dst % 2 == 0 && cap == 2 * utf16_units(bs, 0, -1) ? result == cap / 2 : true); @*/
{
  if (reinterpret_cast<uword>(output->address()) % sizeof(uint16) != 0) return -1;
  //@ if (dst == 0 && cap > 0) { open uchars(dst, cap, _); u_character_limits(dst); }
  //@ assert pointer_within_limits(dst + cap) == true;
  //@ div_rem_nonneg(cap, 2);
  //@ open_utf16_buffer(dst, cap / 2);
  //@ close exists(true);
  return Utils::utf_8_to_16(input->address(), input->length(),
                            reinterpret_cast<uint16*>(output->address()), output->length() / static_cast<word>(sizeof(uint16)));
  //@ if (dst == 0) { open ushorts_((uint16 *)dst, cap / 2, _); close uchars(dst, cap, nil); } else { close_utf16_buffer(dst, cap / 2); }
}

@render src/primitive_core.cc toit::primitive_string_to_utf_16
PRIMITIVE(string_to_utf_16)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?arg) &*& good(objs, arg) == true; @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            pointer(__args, arg) &*& ((uword)result % 4 == 3 ?
              (uword)result == 4 * Program_WRONG_OBJECT_TYPE_INDEX + 3 ||
              (uword)result == 4 * Program_OUT_OF_BOUNDS_INDEX + 3 ||
              (uword)result == 4 * Program_ALLOCATION_FAILED_INDEX + 3 ||
              (uword)result == 4 * Program_INVALID_ARGUMENT_INDEX + 3 :
              !mem(result, objs) && mem(result, objs2) && has_tag(H2, result, BYTE_ARRAY_TAG) &&
              blob_ok(H2, result, STRINGS_OR_BYTE_ARRAYS) && (uword)blob_base(H2, result) % 2 == 0 && blob_len(H2, result) % 2 == 0 &&
              0 <= blob_len(H2, result) && blob_len(H2, result) <= 2 * 0xfffffff); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ error_word(Program_ALLOCATION_FAILED_INDEX);
  //@ error_word(Program_INVALID_ARGUMENT_INDEX);
  ARGS(StringOrSlice, utf_8);
  if (utf_8.length() > 0xfffffff) FAIL(OUT_OF_BOUNDS);
  //@ assert [_]blob_result(objs, H, STRINGS_ONLY, ?a, ?l, ?b);
  //@ open [_]blob_result(objs, H, STRINGS_ONLY, a, l, b);
  //@ borrow_slice(b, a, l);
  //@ close exists(false);
  int utf_16_length = Utils::utf_8_to_16(
      utf_8.address(), utf_8.length(), static_cast<uint16*>(nullptr), 0);
  //@ return_slice(b, a);

  ByteArray* result = process->allocate_byte_array(utf_16_length << 1);
  if (result == null) FAIL(ALLOCATION_FAILED);
  //@ assert heap(cons(result, objs), ?H2);
  //@ grows_alloc(objs, H, result, H2);
  //@ forall_mem(b, objs, (same_obj)(H, H2));
  ByteArray::Bytes bytes(result);

  //@ heap_holes_open();
  //@ blob_take(result);
  //@ blob_take(b);
  //@ if (a != blob_base(H2, b)) uchars_split(blob_base(H2, b), (uword)a - (uword)blob_base(H2, b));
  //@ uchars_split(a, l);
  word written = fill_utf_16(&utf_8, &bytes);
  //@ uchars_join(a);
  //@ if (a != blob_base(H2, b)) uchars_join(blob_base(H2, b));
  //@ blob_give(b);
  //@ blob_give(result);
  //@ heap_holes_close();
  if (written != utf_16_length) FAIL(INVALID_ARGUMENT);
  //@ assert written == blob_len(H2, result) / 2;
  return result;
}

@render src/primitive_core.cc toit::fill_string_from_utf_16
static bool fill_string_from_utf_16(const Blob* input, String* destination)
/*@ requires [?f]input->address_ |-> ?src &*& [f]input->length_ |-> ?n &*& heap(?objs, ?H) &*&
             [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, src, n, ?b) &*& b != destination &*&
             mem(destination, objs) == true &*& has_tag(H, destination, STRING_TAG) == true &*&
             n % 2 == 0 &*& n <= 0x3fffffff; @*/
/*@ ensures [f]input->address_ |-> src &*& [f]input->length_ |-> n &*&
            heap_holes(objs, H, cons(b, cons(destination, nil))) &*& blob_hole(objs, H, destination) &*& blob_hole(objs, H, b) &*&
            uchars(blob_base(H, b), (uword)src - (uword)blob_base(H, b), _) &*& uchars(src, n, ?sourceBytes) &*&
            uchars(src + n, blob_len(H, b) - ((uword)src - (uword)blob_base(H, b)) - n, _) &*&
            uchars(blob_base(H, destination), blob_len(H, destination), ?contentBytes) &*&
            result == (blob_len(H, destination) == length(utf8_encoding(utf16le_units(sourceBytes, false, 0), false))) &*&
            (result ? contentBytes == utf8_encoding(utf16le_units(sourceBytes, false, 0), false) : true); @*/
{
  //@ open [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, src, n, b);
  String::MutableBytes output(destination);
  //@ heap_holes_open();
  //@ blob_take(destination);
  //@ blob_take(b);
  //@ uchars_split(blob_base(H, b), (uword)src - (uword)blob_base(H, b));
  //@ uchars_split(src, n);
  //@ assert uchars(src, n, ?source);
  //@ div_rem_nonneg(n, 2);
  word written = Utils::utf_16le_to_8(input->address(), input->length() / 2, output.address(), output.length());
  /*@
  if (written == blob_len(H, destination)) {
    assert uchars(blob_base(H, destination), written, ?content);
    if (blob_base(H, destination) == 0) {
      if (written != 0) { open uchars(blob_base(H, destination), written, content); u_character_limits(blob_base(H, destination)); }
      switch (utf8_encoding(utf16le_units(source, false, 0), false)) { case nil: case cons(h, t): }
      switch (content) { case nil: case cons(h, t): }
    } else {
      take_length(content);
    }
    assert content == utf8_encoding(utf16le_units(source, false, 0), false);
  }
  @*/
  return written == output.length();
}

@render src/primitive_core.cc toit::primitive_utf_16_to_string
PRIMITIVE(utf_16_to_string)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?arg) &*& good(objs, arg) == true; @*/
/*@ ensures [fp]process(process, prog, ids) &*& pointer(__args, arg) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            ((uword)result % 4 == 3 ?
              (uword)result == 4 * Program_WRONG_BYTES_TYPE_INDEX + 3 ||
              (uword)result == 4 * Program_INVALID_ARGUMENT_INDEX + 3 ||
              (uword)result == 4 * Program_OUT_OF_BOUNDS_INDEX + 3 ||
              (uword)result == 4 * Program_ALLOCATION_FAILED_INDEX + 3 :
              !mem(result, objs) && mem(result, objs2) && has_tag(H2, result, STRING_TAG) &&
              0 <= blob_len(H2, result) && blob_len(H2, result) <= 3 * 0x1fffffff && smi_range(blob_len(H2, result))); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_BYTES_TYPE_INDEX);
  //@ error_word(Program_INVALID_ARGUMENT_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ error_word(Program_ALLOCATION_FAILED_INDEX);
  ARGS(Blob, utf_16);
  //@ assert [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, ?a, ?n, ?b);
  //@ open [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, a, n, b);
  //@ bitand_pow_nat(n, N1);
  if ((utf_16.length() & 1) != 0) FAIL(INVALID_ARGUMENT);
  if (utf_16.length() > 0x3fffffff) FAIL(OUT_OF_BOUNDS);
  //@ div_rem_nonneg(n, 2);
  //@ borrow_slice(b, a, n);
  word utf_8_length = Utils::utf_16le_to_8(utf_16.address(), utf_16.length() / 2, nullptr, 0);
  //@ return_slice(b, a);
  if (utf_8_length > Smi::MAX_SMI_VALUE) FAIL(OUT_OF_BOUNDS);
  String* result = process->allocate_string(utf_8_length);
  //@ open allocated(objs, H, process, result, ?objs1, ?H1);
  if (result == null) FAIL(ALLOCATION_FAILED);
  //@ grows_alloc(objs, H, result, H1);
  //@ forall_mem(b, objs, (same_obj)(H, H1));
  //@ close blob_result(objs1, H1, STRINGS_OR_BYTE_ARRAYS, a, n, b);
  //@ leak blob_result(objs1, H1, STRINGS_OR_BYTE_ARRAYS, a, n, b);
  bool filled = fill_string_from_utf_16(&utf_16, result);
  //@ assert uchars(a, n, ?write_input);
  //@ assert uchars(blob_base(H1, result), utf_8_length, ?output_bytes);
  //@ uchars_join(a);
  //@ if (a != blob_base(H1, b)) uchars_join(blob_base(H1, b));
  //@ blob_give(b);
  //@ blob_give(result);
  //@ heap_holes_close();
  if (!filled) FAIL(INVALID_ARGUMENT);
  //@ assert output_bytes == utf8_encoding(utf16le_units(write_input, false, 0), false);
  return result;
}
