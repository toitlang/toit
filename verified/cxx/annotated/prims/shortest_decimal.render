@verbatim
#include <stddef.h>
#include <math.h>
#include "../model/objects.gen.h"
/*@
fixpoint bool shortest_input(double value) {
  return fp_of_double(value) != fp_NaN && fp_of_double(value) != fp_pos_inf &&
         fp_of_double(value) != fp_neg_inf && fp_of_double(value) != fp_real(0);
}

predicate shortest_output(char *b, int n) =
  0 <= n &*& n < 26 &*& chars(b, n, ?prefix) &*& !mem((char)0, prefix) &*& chars_(b+n, 26-n, _);

lemma void prepare_output_byte(char *b, int n)
  requires shortest_output(b, n);
  ensures chars(b, n, ?prefix) &*& !mem((char)0, prefix) &*& char_(b+n, _) &*& chars_(b+n+1, 25-n, _);
{
  open shortest_output(b, n);
  open chars_(b+n, 26-n, _);
}

lemma void finish_output_byte(char *b, int n)
  requires chars(b, n, ?prefix) &*& !mem((char)0, prefix) &*& character(b+n, ?c) &*& c != 0 &*&
           chars_(b+n+1, 25-n, _) &*& n+1 < 26;
  ensures shortest_output(b, n+1);
{
  close chars(b+n+1, 0, nil);
  close chars(b+n, 1, cons(c, nil));
  chars_join(b);
  close shortest_output(b, n+1);
}
@*/
bool signbit(double value);
  //@ requires true;
  //@ ensures true;
@prototypes
@render src/dtoa.cc toit::write_shortest_decimal
static int write_shortest_decimal(char* buffer, const char* digits, int digit_count, int exponent, bool is_negative)
/*@ requires chars_(buffer, 26, _) &*& [?f]chars(digits, digit_count, ?ds) &*&
             !mem((char)0, ds) &*& 1 <= digit_count &*& digit_count <= 17 &*& -340 <= exponent &*& exponent <= 308; @*/
/*@ ensures chars(buffer, result, ?text) &*& !mem((char)0, text) &*& character(buffer+result, 0) &*& chars_(buffer+result+1, 25-result, _) &*& [f]chars(digits, digit_count, ds) &*&
            1 <= result &*& result < 26; @*/
//@ terminates;
{
  int pos = 0;
  //@ close chars(buffer, 0, nil);
  //@ close shortest_output(buffer, 0);
  if (is_negative) {
    //@ prepare_output_byte(buffer, pos);
    buffer[pos++] = '-';
    //@ finish_output_byte(buffer, pos-1);
  }

  // Similar to EcmaScript:
  // Anything in the range [10^-6, 10^21) is represented as a normal
  // decimal number.  Outside that range, scientific notation is used.
  int decimal_in_shortest_low = -6;
  int decimal_in_shortest_high = 21;

  int adjusted_exponent = exponent + digit_count - 1;
  if (decimal_in_shortest_low <= adjusted_exponent &&
      adjusted_exponent < decimal_in_shortest_high) {
    // Decimal representation.
    if (exponent >= 0) {
      // Integer with trailing zeros.
      for (int i = digit_count - 1; i >= 0; i--)
        /*@ invariant -1 <= i && i < digit_count &*& pos == (is_negative ? 1 : 0) + digit_count - 1 - i &*&
                      [f]chars(digits, digit_count, ds) &*& shortest_output(buffer, pos); @*/
        //@ decreases i + 1;
      {
        // Remember, that the digits are in reverse order.
        //@ prepare_output_byte(buffer, pos);
        //@ mem_nth(i, ds);
        buffer[pos++] = digits[i];
        //@ finish_output_byte(buffer, pos-1);
      }
      for (int i = 0; i < exponent; i++)
        /*@ invariant 0 <= i && i <= exponent &*& pos == (is_negative ? 1 : 0) + digit_count + i &*&
                      [f]chars(digits, digit_count, ds) &*& shortest_output(buffer, pos); @*/
        //@ decreases exponent-i;
      {
        //@ prepare_output_byte(buffer, pos);
        buffer[pos++] = '0';
        //@ finish_output_byte(buffer, pos-1);
      }
      //@ prepare_output_byte(buffer, pos);
      buffer[pos++] = '.';
      //@ finish_output_byte(buffer, pos-1);
      //@ prepare_output_byte(buffer, pos);
      buffer[pos++] = '0';
      //@ finish_output_byte(buffer, pos-1);
    } else if (adjusted_exponent >= 0) {
      // Decimal point inside the number.
      for (int i = digit_count - 1; i >= 0; i--)
        /*@ invariant -1 <= i && i < digit_count &*& pos == (is_negative ? 1 : 0) + digit_count - 1 - i + (i < -exponent ? 1 : 0) &*&
                      [f]chars(digits, digit_count, ds) &*& shortest_output(buffer, pos); @*/
        //@ decreases i + 1;
      {
        //@ prepare_output_byte(buffer, pos);
        //@ mem_nth(i, ds);
        buffer[pos++] = digits[i];
        //@ finish_output_byte(buffer, pos-1);
        if (i == -exponent) {
          //@ prepare_output_byte(buffer, pos);
          buffer[pos++] = '.';
          //@ finish_output_byte(buffer, pos-1);
        }
      }
    } else {
      // Decimal point before the number.
      //@ prepare_output_byte(buffer, pos);
      buffer[pos++] = '0';
      //@ finish_output_byte(buffer, pos-1);
      //@ prepare_output_byte(buffer, pos);
      buffer[pos++] = '.';
      //@ finish_output_byte(buffer, pos-1);
      for (int i = 0; i < -adjusted_exponent - 1; i++)
        /*@ invariant 0 <= i && i <= -adjusted_exponent-1 &*& pos == (is_negative ? 1 : 0) + 2 + i &*&
                      [f]chars(digits, digit_count, ds) &*& shortest_output(buffer, pos); @*/
        //@ decreases -adjusted_exponent-1-i;
      {
        //@ prepare_output_byte(buffer, pos);
        buffer[pos++] = '0';
        //@ finish_output_byte(buffer, pos-1);
      }
      for (int i = digit_count - 1; i >= 0; i--)
        /*@ invariant -1 <= i && i < digit_count &*& pos == (is_negative ? 1 : 0) + 1 - adjusted_exponent + digit_count - 1 - i &*&
                      [f]chars(digits, digit_count, ds) &*& shortest_output(buffer, pos); @*/
        //@ decreases i + 1;
      {
        //@ prepare_output_byte(buffer, pos);
        //@ mem_nth(i, ds);
        buffer[pos++] = digits[i];
        //@ finish_output_byte(buffer, pos-1);
      }
    }
  } else {
    // Exponential representation.
    // One digit before the decimal point.
    //@ prepare_output_byte(buffer, pos);
    //@ mem_nth(digit_count - 1, ds);
    buffer[pos++] = digits[digit_count - 1];
    //@ finish_output_byte(buffer, pos-1);
    if (digit_count > 1) {
      //@ prepare_output_byte(buffer, pos);
      buffer[pos++] = '.';
      //@ finish_output_byte(buffer, pos-1);
      for (int i = digit_count - 2; i >= 0; i--)
        /*@ invariant -1 <= i && i <= digit_count-2 &*& pos == (is_negative ? 1 : 0) + 2 + digit_count - 2 - i &*&
                      [f]chars(digits, digit_count, ds) &*& shortest_output(buffer, pos); @*/
        //@ decreases i + 1;
      {
        //@ prepare_output_byte(buffer, pos);
        //@ mem_nth(i, ds);
        buffer[pos++] = digits[i];
        //@ finish_output_byte(buffer, pos-1);
      }
    }
    //@ prepare_output_byte(buffer, pos);
    buffer[pos++] = 'e';
    //@ finish_output_byte(buffer, pos-1);
    if (adjusted_exponent < 0) {
      //@ prepare_output_byte(buffer, pos);
      buffer[pos++] = '-';
      //@ finish_output_byte(buffer, pos-1);
      adjusted_exponent = -adjusted_exponent;
    }
    // Write exponent as at least two digits.
    if (adjusted_exponent >= 100) {
      int hundreds = adjusted_exponent / 100;
      //@ prepare_output_byte(buffer, pos);
      buffer[pos++] = '0' + hundreds;
      //@ finish_output_byte(buffer, pos-1);
      adjusted_exponent -= hundreds * 100;
    }
    int tens = adjusted_exponent / 10;
    //@ prepare_output_byte(buffer, pos);
    buffer[pos++] = '0' + tens;
    //@ finish_output_byte(buffer, pos-1);
    adjusted_exponent -= tens * 10;
    //@ prepare_output_byte(buffer, pos);
    buffer[pos++] = '0' + adjusted_exponent;
    //@ finish_output_byte(buffer, pos-1);
  }
  //@ prepare_output_byte(buffer, pos);
  buffer[pos] = '\0';
  return pos;
}

@render src/dtoa.cc toit::format_shortest_decimal
static int format_shortest_decimal(char* buffer, uint64 significand, int exponent, bool is_negative)
//@ requires chars_(buffer, 26, _);
/*@ ensures result == -1 ? chars_(buffer, 26, _) &*& (significand >= 100000000000000000 || exponent < -340 || exponent > 308) :
            chars(buffer, result, ?text) &*& !mem((char)0, text) &*& character(buffer+result, 0) &*&
            chars_(buffer+result+1, 25-result, _) &*& 1 <= result &*& result < 26; @*/
//@ terminates;
{
  // A binary64 shortest decimal has at most 17 digits. Check the conversion
  // result before using it to size or index either buffer.
  if (significand >= 100000000000000000ULL || exponent < -340 || exponent > 308) return -1;
  char digits[17];
  int digit_count = 0;
  //@ close chars(digits, 0, nil);
  //@ nat_of_int_of_nat(succ(N16));
  while (true)
    /*@ invariant chars(digits, digit_count, ?prefix) &*& !mem((char)0, prefix) &*&
          chars_(digits+digit_count, 17-digit_count, _) &*& 0 <= digit_count &*& digit_count < 17 &*&
          significand < pow_nat(10, nat_of_int(17-digit_count)); @*/
    //@ decreases 17-digit_count;
  {
    //@ succ_int(16-digit_count);
    //@ div_rem_nonneg(significand, 10);
    //@ open chars_(digits+digit_count, 17-digit_count, _);
    digits[digit_count++] = '0' + (significand % 10);
    //@ close chars(digits+digit_count, 0, nil);
    //@ close chars(digits+digit_count-1, 1, cons((char)('0'+significand%10), nil));
    //@ chars_join(digits);
    significand /= 10;
    if (significand == 0) break;
  }
  return write_shortest_decimal(buffer, digits, digit_count, exponent, is_negative);
  //@ chars_to_chars_(digits);
  //@ chars__join(digits);
}

@render src/dtoa.cc toit::shortest_significand trusted
static uint64 shortest_significand(double value, int* exponent)
//@ requires shortest_input(value) == true &*& int_(exponent, _);
//@ ensures integer(exponent, _);
{
  auto v = jkj::dragonbox::to_decimal(value,
    jkj::dragonbox::policy::sign::ignore
#ifdef TOIT_FREERTOS
    , jkj::dragonbox::policy::cache::compact
#endif
  );
  *exponent = v.exponent;
  return v.significand;
}

@render src/dtoa.cc toit::double_to_shortest
int double_to_shortest(double value, char* buffer, size_t buffer_size)
/*@ requires shortest_input(value) == true &*& chars_(buffer, buffer_size < 26 ? buffer_size : 26, _); @*/
/*@ ensures result == -1 ? chars_(buffer, buffer_size < 26 ? buffer_size : 26, _) :
      chars(buffer, result, ?text) &*& !mem((char)0, text) &*& character(buffer+result, 0) &*&
      chars_(buffer+result+1, 25-result, _) &*& 1 <= result &*& result < 26; @*/
{
  if (buffer_size < MAX_BUFFER_SIZE_DOUBLE_TO_SHORTEST) {
    return -1;
  }
  bool is_negative = signbit(value);
  int exponent;
  uint64 significand = shortest_significand(value, &exponent);
  return format_shortest_decimal(buffer, significand, exponent, is_negative);
}
