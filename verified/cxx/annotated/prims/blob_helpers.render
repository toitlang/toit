// Copyright (C) 2026 Toit contributors.
//
// Blob primitives of src/primitive_core.cc behind Rust ports, contract-only
// before (wave 12): string_length and json_skip_whitespace. Their ports
// decline an opaque byte array (a resource proxy, a neutered array) and a
// string longer than a smi (unreachable); the proved decoders then give
// the C++ an empty blob or fail (README "When the C++ behind a port
// runs"). Proved here for every argument, not only those.
//
// Proved: the argument decoding (the proven Blob and StringOrSlice
// decoders; json_skip_whitespace's offset a word, INVALID_ARGUMENT when
// negative), every read inside the decoded string or byte array's content,
// the result a smi (a length or an index within [offset, length]) or an
// error; the heap unchanged.
//
// Self-test (run.sh): json_skip_whitespace's loop one byte past the end.
@include ../model/model.cfg
@verbatim
#include "argument_error.gen.h"
#include "blob_args.gen.h"
#include "read_slice.h"

@prototypes
@render src/primitive_core.cc toit::primitive_string_length
PRIMITIVE(string_length)
//@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*& pointer(__args, ?a0) &*& good(objs, a0) == true;
//@ ensures [fp]process(process, prog, ids) &*& heap(objs, H) &*& pointer(__args, a0) &*& (is_smi_w((uword)result) || (uword)result % 4 == 3);
{
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  ARGS(StringOrSlice, receiver);
  //@ assert [_]blob_result(objs, H, STRINGS_ONLY, ?a, ?l, ?b);
  //@ open [_]blob_result(objs, H, STRINGS_ONLY, a, l, b);
  //@ blob_facts(b);
  return Smi::from(receiver.length());
}

@render src/primitive_core.cc toit::primitive_json_skip_whitespace
PRIMITIVE(json_skip_whitespace)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?a0) &*& pointer(__args - 1, ?a1) &*& good(objs, a0) && good(objs, a1); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(objs, H) &*& pointer(__args, a0) &*& pointer(__args - 1, a1) &*&
            (is_smi_w((uword)result) || (uword)result % 4 == 3); @*/
{
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_INVALID_ARGUMENT_INDEX);
  //@ error_word(Program_WRONG_BYTES_TYPE_INDEX);
  //@ close valid_arg(a1, objs);
  //@ leak valid_arg(a1, objs);
  ARGS(Blob, bytes, word, offset);
  if (offset < 0) FAIL(INVALID_ARGUMENT);
  //@ assert [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, ?a, ?l, ?b);
  //@ open [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, a, l, b);
  //@ blob_facts(b);
  word i = offset;
  for ( ; i < bytes.length(); i++)
  /*@ invariant heap(objs, H) &*& bytes.address_ |-> a &*& bytes.length_ |-> l &*& offset <= i &*&
                smi_range(offset) == true &*& 0 <= l &*& l <= MAX_BLOB &*& (i == offset || i <= l); @*/
  {
    //@ borrow_slice(b, a, l);
    uint8 c = bytes.address()[i];
    //@ return_slice(b, a);
    if (c != ' ' && c != '\n' && c != '\t' && c != '\r') return Smi::from(i);
  }
  return Smi::from(i);
}
