/*@
predicate fixed_buffer(char *buf, int cap, int n; list<char> text) =
  chars(buf, n, text) &*& !mem((char)0, text) &*& character(buf+n, 0) &*&
  chars_(buf+n+1, cap-n-1, _) &*& n >= 0 &*& n < cap;

lemma void release_fixed_buffer(char *buf)
  requires fixed_buffer(buf, ?cap, ?n, _);
  ensures chars_(buf, cap, _);
{
  open fixed_buffer(buf, cap, n, _);
  close chars(buf+n+1, 0, nil);
  close chars(buf+n, 1, cons((char)0, nil));
  chars_join(buf);
  chars_to_chars_(buf);
  chars__join(buf);
}

fixpoint bool decimal_marker(char c) { return c == '.' || c == 'e' || c == 'E'; }

lemma void marker_present(list<char> xs, char c)
  requires mem(c, xs) == true &*& decimal_marker(c) == true;
  ensures exists(xs, decimal_marker) == true;
{
  switch (xs) {
    case nil:
    case cons(h, tail): if (h != c) marker_present(tail, c);
  }
}

fixpoint bool fixed_result(list<void *> objs, fixpoint(void *, oinfo) H,
                           list<void *> after, fixpoint(void *, oinfo) H2, void *r) {
  return (uword)r % 4 == 3 ? after == objs && H2 == H &&
      ((uword)r == 4 * Program_MALLOC_FAILED_INDEX + 3 || (uword)r == 4 * Program_ALLOCATION_FAILED_INDEX + 3) :
    after == cons(r, objs) && !mem(r, objs) && good(after, r) && has_tag(H2, r, STRING_TAG);
}
@*/

// The one variadic call site supplies this exact format and argument sequence.
// snprintf may fail or truncate on either attempt.
int snprintf(char *buf, size_t cap, char *fmt, int precision, double value);
/*@ requires chars_(buf, cap, _) &*& [?f]string(fmt, {'%', '.', '*', 'l', 'f'}) &*&
             cap > 0 &*& 0 <= precision &*& precision <= 64; @*/
/*@ ensures [f]string(fmt, {'%', '.', '*', 'l', 'f'}) &*&
            (0 <= result && result < cap ? fixed_buffer(buf, cap, result, _) : chars_(buf, cap, _)); @*/
//@ terminates;

int fpclassify(double value);
  //@ requires true;
  /*@ ensures (result == FP_ZERO) == (fp_of_double(value) == fp_real(0)) &*&
              (result == FP_NAN) == (fp_of_double(value) == fp_NaN) &*&
              (result == FP_INFINITE) == (fp_of_double(value) == fp_pos_inf || fp_of_double(value) == fp_neg_inf); @*/
@prototypes
@render src/primitive_core.cc toit::format_fixed_double
static int format_fixed_double(char* buffer, int capacity, int precision, double value)
//@ requires chars_(buffer, capacity, _) &*& capacity > 0 &*& 0 <= precision &*& precision <= 64;
/*@ ensures -1 <= result &*& result < INT_MAX &*&
            (0 <= result && result < capacity ? fixed_buffer(buffer, capacity, result, ?out) &*& exists(out, decimal_marker) == true :
              chars_(buffer, capacity, _)); @*/
//@ terminates;
{
  int written = snprintf(buffer, capacity, "%.*lf", precision, value);
  if (written < 0 || written > INT_MAX - 3) {
    //@ if (0 <= written && written < capacity) release_fixed_buffer(buffer);
    return -1;
  }
  if (written >= capacity) return written + 2;
  //@ open fixed_buffer(buffer, capacity, written, ?text);
  for (int i = 0; i < written; i++)
    /*@ invariant 0 <= i &*& i <= written &*& chars(buffer, written, text) &*& character(buffer+written, 0) &*& chars_(buffer+written+1, capacity-written-1, _); @*/
    //@ decreases written - i;
  {
    char c = buffer[i];
    if (c == 'e' || c == 'E' || c == '.') {
      //@ mem_nth(i, text);
      //@ marker_present(text, c);
      //@ close fixed_buffer(buffer, capacity, written, text);
      return written;
    }
  }
  if (capacity - written >= 3) {
    buffer[written] = '.';
    buffer[written + 1] = '0';
    buffer[written + 2] = '\0';
    //@ close chars(buffer + written + 2, 0, nil);
    //@ close chars(buffer + written + 1, 1, cons('0', nil));
    //@ close chars(buffer + written, 2, cons('.', cons('0', nil)));
    //@ chars_join(buffer);
    //@ marker_present(append(text, {'.', '0'}), '.');
    //@ close fixed_buffer(buffer, capacity, written+2, append(text, {'.', '0'}));
  }
  /*@ if (capacity - written < 3) {
    close fixed_buffer(buffer, capacity, written, text);
    release_fixed_buffer(buffer);
  } @*/
  return written + 2;
}

@render src/primitive_core.cc toit::copy_float_string
static Object* copy_float_string(Process* process, const char* buffer, int length)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             fixed_buffer((char *)buffer, ?cap, length, ?text) &*& length <= MAX_BLOB; @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?after, ?H2) &*& fixed_buffer((char *)buffer, cap, length, text) &*&
            grows(objs, H, after, H2) == true &*& fixed_result(objs, H, after, H2, result) == true &*&
            ((uword)result % 4 == 3 || blob_len(H2, result) == length); @*/
{
  //@ open fixed_buffer((char *)buffer, cap, length, text);
  //@ chars_to_uchars((char *)buffer);
  //@ assert uchars((uint8 *)buffer, length, ?bytes);
  //@ close string_source(native_bytes(1, bytes), objs, H, (uint8 *)buffer, length);
  //@ error_word(Program_ALLOCATION_FAILED_INDEX);
  Object* result = process->allocate_string(buffer, length);
  //@ open string_source(native_bytes(1, bytes), objs, H, (uint8 *)buffer, length);
  //@ uchars_to_chars((uint8 *)buffer);
  //@ close fixed_buffer((char *)buffer, cap, length, text);
  //@ open allocated(objs, H, process, result, ?after, ?H2);
  //@ if (result == 0) grows_refl(objs, H); else grows_alloc(objs, H, result, H2);
  if (result == null) FAIL(ALLOCATION_FAILED);
  return result;
}

@render src/primitive_core.cc toit::fixed_double_to_string
static Object* fixed_double_to_string(Process* process, int precision, double value)
//@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*& 0 <= precision &*& precision <= 64;
/*@ ensures [f]process(process, prog, ids) &*& heap(?after, ?H2) &*& grows(objs, H, after, H2) == true &*&
            fixed_result(objs, H, after, H2, result) == true; @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_MALLOC_FAILED_INDEX);
  char stack_buffer[MAX_BUFFER_SIZE_DOUBLE_TO_SHORTEST];
  int length = format_fixed_double(stack_buffer, sizeof(stack_buffer), precision, value);
  if (length >= 0 && length < static_cast<int>(sizeof(stack_buffer))) {
    return copy_float_string(process, stack_buffer, length);
    //@ release_fixed_buffer(stack_buffer);
  }
  // A legacy snprintf may report truncation as -1. A finite binary64 in
  // the C locale needs at most a sign, 309 integer digits, a point, and
  // 64 fractional digits. Allow space for ".0" and the terminator as well.
  if (!Smi::is_valid(static_cast<int64>(length))) FAIL(MALLOC_FAILED);
  int capacity = length < 0 ? 1 + 309 + 1 + 64 + 3 : length + 1;
  char* buffer = static_cast<char*>(malloc(capacity));
  if (buffer == null) FAIL(MALLOC_FAILED);
  length = format_fixed_double(buffer, capacity, precision, value);
  if (length < 0 || length >= capacity) {
    free(buffer);
    FAIL(MALLOC_FAILED);
  }
  Object* result = copy_float_string(process, buffer, length);
  //@ release_fixed_buffer(buffer);
  free(buffer);
  return result;
}

@render src/primitive_core.cc toit::primitive_float_to_string
PRIMITIVE(float_to_string)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
    pointer(__args, ?receiver_arg) &*& pointer(__args-1, ?precision_arg) &*& good(objs, receiver_arg) && good(objs, precision_arg); @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?after, ?H2) &*& grows(objs, H, after, H2) == true &*&
    pointer(__args, receiver_arg) &*& pointer(__args-1, precision_arg) &*&
    (!has_tag(H, receiver_arg, DOUBLE_TAG) ? after == objs && H2 == H && (uword)result == 4*Program_WRONG_OBJECT_TYPE_INDEX+3 :
     (uword)result % 4 == 3 ? after == objs && H2 == H &&
       ((uword)result == 4*Program_WRONG_OBJECT_TYPE_INDEX+3 || (uword)result == 4*Program_INVALID_ARGUMENT_INDEX+3 ||
        (uword)result == 4*Program_OUT_OF_BOUNDS_INDEX+3 || (uword)result == 4*Program_MALLOC_FAILED_INDEX+3 ||
        (uword)result == 4*Program_ALLOCATION_FAILED_INDEX+3 || (uword)result == ((uword)root_allocation_failed(prog) | 3)) :
      after == cons(result, objs) && good(after, result) && has_tag(H2, result, STRING_TAG)); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ error_word(Program_INVALID_ARGUMENT_INDEX);
  ARGS(double, receiver, Object, precision);
  int classification = fpclassify(receiver);
  if (classification == FP_NAN) return process->allocate_string_or_error("nan");
  bool is_negative = signbit(receiver);
  if (classification == FP_INFINITE) {
    if (is_negative) {
      return process->allocate_string_or_error("-inf");
    } else {
      return process->allocate_string_or_error("inf");
    }
  }
  if (precision == process->null_object()) {
    if (classification == FP_ZERO) {
      if (is_negative) {
        return process->allocate_string_or_error("-0.0");
      } else {
        return process->allocate_string_or_error("0.0");
      }
    }
    char stack_buffer[MAX_BUFFER_SIZE_DOUBLE_TO_SHORTEST];
    int length = double_to_shortest(receiver, stack_buffer, sizeof(stack_buffer));
    if (length < 0) FAIL(INVALID_ARGUMENT);
    //@ close fixed_buffer(stack_buffer, 26, length, _);
    return copy_float_string(process, stack_buffer, length);
    //@ release_fixed_buffer(stack_buffer);
  }
  if (is_large_integer(precision)) FAIL(OUT_OF_BOUNDS);
  if (!is_smi(precision)) FAIL(WRONG_OBJECT_TYPE);
  word prec = Smi::value(precision);
  if (prec < 0 || prec > 64) FAIL(OUT_OF_BOUNDS);
  return fixed_double_to_string(process, static_cast<int>(prec), receiver);
}
