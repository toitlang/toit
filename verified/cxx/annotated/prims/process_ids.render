@include ../model/model.cfg
@raii Locker
@verbatim
#include "../model/objects.gen.h"

struct Mutex;
typedef struct Mutex Mutex;
struct Process { int id_; };
typedef struct Scheduler { int next_process_id_; Mutex *mutex_; Process *boot_process_; } Scheduler;
typedef struct VM { Scheduler *scheduler_; } VM;
typedef struct Locker { Mutex *mutex_; } Locker;

/*@
predicate boot_mutex(Mutex *m; Scheduler *s);
predicate held_boot_lock(Locker *l, Scheduler *s, Process *boot, int id);
predicate observed_boot_id(Scheduler *s, int id);

predicate boot_fields(Scheduler *s; Process *boot, int id) =
  s->boot_process_ |-> boot &*& (boot == 0 ? id == -1 :
    [1/2]boot->id_ |-> id &*& 0 <= id &*& smi_range(id) == true);

fixpoint VM *running_vm();
@*/
VM *VM_current();
//@ requires true;
//@ ensures result == running_vm();

// The scheduler lock protects the boot-process pointer and the lifetime of
// the process it references. Each acquisition observes its own snapshot.
void Locker_ctor(Locker *self, Mutex *m);
//@ requires self->mutex_ |-> _ &*& [_]boot_mutex(m, ?s);
//@ ensures self->mutex_ |-> m &*& held_boot_lock(self, s, ?boot, ?id) &*& boot_fields(s, boot, id) &*& [_]observed_boot_id(s, id);
void Locker_dtor(Locker *self);
//@ requires self->mutex_ |-> ?m &*& held_boot_lock(self, ?s, ?boot, ?id) &*& boot_fields(s, boot, id);
//@ ensures self->mutex_ |-> m;

@prototypes
@render src/scheduler.cc toit::Scheduler::next_process_id
int Scheduler::next_process_id()
//@ requires self->next_process_id_ |-> ?before &*& -1 <= before &*& smi_range(before) == true;
/*@ ensures result == before &*& self->next_process_id_ |-> ?after &*& smi_range(after) == true &*&
            after == (before == -1 || before == INT_MAX || !smi_range(before + 1) ? -1 : before + 1); @*/
{
  ASSERT(is_locked());
  int id = next_process_id_;
  if (id == INVALID_PROCESS_ID) return id;
  int64 next = static_cast<int64>(id) + 1;
  next_process_id_ = next <= INT32_MAX && Smi::is_valid(next) ? static_cast<int>(next) : INVALID_PROCESS_ID;
  return id;
}

@render src/process.h toit::Process::id tu=src/scheduler.cc
  int id() const
  //@ requires [?f]self->id_ |-> ?id;
  //@ ensures [f]self->id_ |-> id &*& result == id;
  { return id_; }

@render src/vm.h toit::VM::scheduler tu=src/primitive_core.cc
  Scheduler* scheduler() const
  //@ requires [?f]self->scheduler_ |-> ?s;
  //@ ensures [f]self->scheduler_ |-> s &*& result == s;
  { return scheduler_; }

@render src/scheduler.cc toit::Scheduler::boot_process_id
int Scheduler::boot_process_id()
//@ requires [?f]self->mutex_ |-> ?m &*& [_]boot_mutex(m, self);
//@ ensures [f]self->mutex_ |-> m &*& [_]observed_boot_id(self, result) &*& -1 <= result &*& smi_range(result) == true;
{
  Locker locker(mutex_);
  //@ open boot_fields(self, ?boot, ?id);
  return boot_process_ ? boot_process_->id() : INVALID_PROCESS_ID;
  //@ close boot_fields(self, boot, id);
}

@render src/primitive_core.cc toit::primitive_process_current_id
PRIMITIVE(process_current_id)
//@ requires [?f]process->id_ |-> ?id &*& 0 <= id &*& smi_range(id) == true;
//@ ensures [f]process->id_ |-> id &*& is_smi_w((uword)result) == true &*& smi_val((uword)result) == id;
{
  return Smi::from(process->id());
}

@render src/primitive_core.cc toit::primitive_process_system_id
PRIMITIVE(process_system_id)
//@ requires [?f]running_vm()->scheduler_ |-> ?s &*& [?g]s->mutex_ |-> ?m &*& [_]boot_mutex(m, s);
/*@ ensures [f]running_vm()->scheduler_ |-> s &*& [g]s->mutex_ |-> m &*&
            is_smi_w((uword)result) == true &*& [_]observed_boot_id(s, smi_val((uword)result)) &*& smi_val((uword)result) >= -1; @*/
{
  return Smi::from(VM::current()->scheduler()->boot_process_id());
}
