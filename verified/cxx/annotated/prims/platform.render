@include ../model/model.cfg
@header platform.gen.h
@verbatim
#include "../model/objects.gen.h"
#include <string.h>

/*@
lemma void literal_bytes(char *s)
  requires [_]string(s, ?cs);
  ensures [_]string(s, cs) &*& [_]uchars((uint8 *)s, length(cs), map(uchar_of_char, cs));
{
  assert [?f]string(s, cs);
  split_fraction string(s, _) by 1/2;
  string_to_body_chars(s);
  chars_to_uchars(s);
  leak [?f1]character(s + length(cs), 0);
  leak [?f2]uchars((uint8 *)s, _, _);
  leak [?f3]string(s, _);
}
@*/
@prototypes
@render src/os_linux.cc toit::OS::get_platform
const char* OS::get_platform()
//@ requires true;
//@ ensures [_]string(result, ?cs) &*& cs == {'L', 'i', 'n', 'u', 'x'};
{
  return "Linux";
}

@render src/os_posix.cc toit::OS::get_architecture
const char* OS::get_architecture()
//@ requires true;
//@ ensures [_]string(result, ?cs) &*& (sizeof(word) == 8 ? cs == {'x', '8', '6', '_', '6', '4'} : cs == {'x', '8', '6'});
{
#if defined(__aarch64__)
  return "arm64";
#elif defined(__arm__)
  return "arm";
#elif defined(__amd64__)
  return "x86_64";
#elif defined(__i386__)
  return "x86";
#elif defined(__riscv) && __riscv_xlen == 64
  return "riscv64";
#else
  #error "Unknown architecture"
#endif
}

@render src/process.cc toit::Process::allocate_string_or_error params=1
