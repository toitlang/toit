{
  //@ split_fraction string((char *)content, bytes) by 1/2;
  //@ string_to_body_chars((char *)content);
  //@ chars_to_uchars((char *)content);
  //@ assert [?part]uchars((uint8 *)content, length(bytes), ?cs);
  //@ close string_source(native_bytes(part, cs), objs, H, (uint8 *)content, length(bytes));
  return allocate_string_or_error(content, strlen(content));
  //@ open string_source(native_bytes(part, cs), objs, H, (uint8 *)content, length(bytes));
  //@ uchars_to_chars((uint8 *)content);
  //@ body_chars_to_string((char *)content);
  //@ merge_fractions string((char *)content, _);
}

@render src/primitive_core.cc toit::primitive_platform
PRIMITIVE(platform)
//@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H);
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& oom_clean(objs, H, objs2, H2, result) == true &*& grows(objs, H, objs2, H2) == true &*&
            string_copy_result(prog, objs, H, objs2, H2, result, 5) == true; @*/
{
  const char* platform_name = OS::get_platform();
  //@ literal_bytes(platform_name);
  //@ assert [?part]uchars((uint8 *)platform_name, ?n, ?cs);
  //@ close string_source(native_bytes(part, cs), objs, H, (uint8 *)platform_name, n);
  return process->allocate_string_or_error(platform_name, strlen(platform_name));
  //@ open string_source(native_bytes(part, cs), objs, H, (uint8 *)platform_name, n);
  //@ leak [part]uchars((uint8 *)platform_name, n, cs);
}

@render src/primitive_core.cc toit::primitive_architecture
PRIMITIVE(architecture)
//@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H);
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& oom_clean(objs, H, objs2, H2, result) == true &*& grows(objs, H, objs2, H2) == true &*&
            string_copy_result(prog, objs, H, objs2, H2, result, sizeof(word) == 8 ? 6 : 3) == true; @*/
{
  const char* architecture_name = OS::get_architecture();
  //@ literal_bytes(architecture_name);
  //@ assert [?part]uchars((uint8 *)architecture_name, ?n, ?cs);
  //@ close string_source(native_bytes(part, cs), objs, H, (uint8 *)architecture_name, n);
  return process->allocate_string_or_error(architecture_name, strlen(architecture_name));
  //@ open string_source(native_bytes(part, cs), objs, H, (uint8 *)architecture_name, n);
  //@ leak [part]uchars((uint8 *)architecture_name, n, cs);
}
