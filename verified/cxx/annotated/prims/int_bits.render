@render src/primitive_core.cc toit::primitive_large_integer_shift_right truncating
PRIMITIVE(large_integer_shift_right)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x0) &*& pointer(__args - 1, ?x1) &*& good(objs, x0) && good(objs, x1); @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_clean(objs, H, objs2, H2, result) == true &*& pointer(__args, x0) &*& pointer(__args - 1, x1) &*&
            int_result(objs, H, objs2, H2, result) == true; @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ int_pows();
  //@ error_word(Program_NEGATIVE_ARGUMENT_INDEX);
  //@ close valid_arg(x1, objs);
  //@ leak valid_arg(x1, objs);
  ARGS(LargeInteger, receiver, int64, bits_to_shift);
  if (bits_to_shift < 0) FAIL(NEGATIVE_ARGUMENT);
  if (bits_to_shift >= LARGE_INT_BIT_SIZE) return Primitive::integer(receiver->value() < 0 ? -1 : 0, process);
  return Primitive::integer(receiver->value() >> bits_to_shift, process);
}

@render src/utils.h toit::Utils::wrapping_sub tu=src/primitive_core.cc truncating
  static inline int64 wrapping_sub(int64 x, int64 y)
  //@ requires true;
  //@ ensures true;
  {
    return static_cast<int64>(static_cast<uint64>(x) - static_cast<uint64>(y));
  }

@render src/utils.h toit::Utils::wrapping_add tu=src/primitive_core.cc truncating
  static inline int64 wrapping_add(int64 x, int64 y)
  //@ requires true;
  //@ ensures true;
  {
    return static_cast<int64>(static_cast<uint64>(x) + static_cast<uint64>(y));
  }

@render src/primitive_core.cc toit::primitive_smi_add
PRIMITIVE(smi_add)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x0) &*& pointer(__args - 1, ?x1) &*& good(objs, x0) && good(objs, x1); @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_clean(objs, H, objs2, H2, result) == true &*& pointer(__args, x0) &*& pointer(__args - 1, x1) &*&
            int_result(objs, H, objs2, H2, result) == true; @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ int_pows();
  ARGS(word, receiver, Object, arg);
  if (is_smi(arg)) {
    word other = Smi::value(arg);
    if ((receiver > 0) && (other > Smi::MAX_SMI_VALUE - receiver)) goto overflow;
    if ((receiver < 0) && (other < Smi::MIN_SMI_VALUE - receiver)) goto overflow;
    return Smi::from(receiver + other);
  }
  if (!is_large_integer(arg)) FAIL(WRONG_OBJECT_TYPE);
  overflow:
  int64 other = is_smi(arg) ? (int64) Smi::value(arg) : LargeInteger::cast(arg)->value();
  return Primitive::integer(Utils::wrapping_add(receiver, other), process);
}

@render src/primitive_core.cc toit::primitive_smi_subtract
PRIMITIVE(smi_subtract)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x0) &*& pointer(__args - 1, ?x1) &*& good(objs, x0) && good(objs, x1); @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_clean(objs, H, objs2, H2, result) == true &*& pointer(__args, x0) &*& pointer(__args - 1, x1) &*&
            int_result(objs, H, objs2, H2, result) == true; @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ int_pows();
  ARGS(word, receiver, Object, arg);
  if (is_smi(arg)) {
    // Smis have fewer bits than words, so the difference fits a word.
    return Primitive::integer(static_cast<int64>(receiver) - Smi::value(arg), process);
  }
  if (!is_large_integer(arg)) FAIL(WRONG_OBJECT_TYPE);
  int64 other = LargeInteger::cast(arg)->value();
  return Primitive::integer(Utils::wrapping_sub(receiver, other), process);
}
