// Copyright (C) 2026 Toit contributors.
//
// The string primitives of src/primitive_core.cc that allocate a string of
// a size the program chooses (wave 10): string_add (with its helper
// concat_strings), concat_strings and string_slice. Each is ported to
// Rust; its C++ runs when the port's allocation does not fit (NeedsGc: the
// C++ collects garbage and retries) or the port declines (a malformed
// StringSlice_, a sum above MAX_BLOB_LENGTH: README "When the C++ behind a
// port runs").
//
// Proved: every read inside the parts (the proven byte_content), every
// write inside the new string, the parts' lengths summed without overflow
// and below the heap model's blob bound (MAX_CONCATENATION_LENGTH), the
// length of the result (the sum of the parts; concat_strings decodes every
// part twice, before and after the allocation, and gets the same lengths:
// decoded_length depends only on the objects of the heap before the
// allocation, which it keeps), the primitive heap contract (`grows`) and
// the retry rule `oom_clean`. Not the bytes of the result.
//
// Self-tests (run.sh): the concatenation bound one too high (wave 10's
// fix reverted: a string of 2^62 or 2^30 bytes, above the heap model's
// MAX_BLOB); concat_strings without the check of byte_content's result
// (wave 10's fix reverted); string_slice copying one byte more.
@include ../model/model.cfg
@nested-type Bytes String::Bytes
@verbatim
#include "../model/objects.gen.h"
#include "argument_error.gen.h"
#include "blob_args.gen.h"
#include "platform.gen.h"
//@ #include "../model/arith.gh"

/*@
// A MutableBytes view of the string r (ghost: names the object its address
// belongs to).
predicate dest_string(void *bytes, void *r) = true;

fixpoint bool words_good(list<void *> objs, fixpoint(void *, oinfo) H, void *o) {
  return forall(o_words(H(o)), (good)(objs));
}

lemma void forall_good_cons(list<void *> ws, list<void *> objs, void *r)
  requires forall(ws, (good)(objs)) == true;
  ensures forall(ws, (good)(cons(r, objs))) == true;
{
  switch (ws) { case nil: case cons(w, ws0): forall_good_cons(ws0, objs, r); }
}

lemma void heap_words_good(list<void *> xs, list<void *> objs, fixpoint(void *, oinfo) H)
  requires [?f]foreach(xs, heap_obj(objs, H));
  ensures [f]foreach(xs, heap_obj(objs, H)) &*& forall(xs, (words_good)(objs, H)) == true;
{
  open [f]foreach(xs, _);
  switch (xs) {
    case nil:
      close [f]foreach(nil, heap_obj(objs, H));
    case cons(x, xs0):
      open [f]heap_obj(objs, H)(x);
      close [f]heap_obj(objs, H)(x);
      heap_words_good(xs0, objs, H);
      close [f]foreach(xs, heap_obj(objs, H));
  }
}

// The objects of a heap before an allocation, in the heap after it: they
// reference only each other.
lemma void foreach_restrict(list<void *> xs, void *r, list<void *> objs, fixpoint(void *, oinfo) H, fixpoint(void *, oinfo) H2)
  requires foreach(xs, heap_obj(cons(r, objs), H2)) &*& forall(xs, (words_good)(objs, H)) == true &*& forall(xs, (same_obj)(H, H2)) == true;
  ensures foreach(xs, heap_obj(objs, H2));
{
  open foreach(xs, _);
  switch (xs) {
    case nil:
      close foreach(nil, heap_obj(objs, H2));
    case cons(x, xs0):
      open heap_obj(cons(r, objs), H2)(x);
      close heap_obj(objs, H2)(x);
      foreach_restrict(xs0, r, objs, H, H2);
      close foreach(xs, heap_obj(objs, H2));
  }
}

lemma void foreach_widen(list<void *> xs, void *r, list<void *> objs, fixpoint(void *, oinfo) H)
  requires foreach(xs, heap_obj(objs, H));
  ensures foreach(xs, heap_obj(cons(r, objs), H));
{
  open foreach(xs, _);
  switch (xs) {
    case nil:
      close foreach(nil, heap_obj(cons(r, objs), H));
    case cons(x, xs0):
      open heap_obj(objs, H)(x);
      forall_good_cons(o_words(H(x)), objs, r);
      close heap_obj(cons(r, objs), H)(x);
      foreach_widen(xs0, r, objs, H);
      close foreach(xs, heap_obj(cons(r, objs), H));
  }
}

// What byte_content decodes depends only on the objects it reaches, which
// a heap that keeps every object of `objs` (an allocation) keeps.
lemma void decoded_stable(nat fuel, list<void *> objs, fixpoint(void *, oinfo) Hother, fixpoint(void *, oinfo) H, prog_ids ids, void *o, int kind)
  requires [?f]heap(objs, H) &*& good(objs, o) == true &*& forall(objs, (same_obj)(Hother, H)) == true &*& prog_ok(ids) == true;
  ensures [f]heap(objs, H) &*& decoded_length(fuel, Hother, ids, o, kind) == decoded_length(fuel, H, ids, o, kind);
{
  switch (fuel) {
    case zero:
      if (!is_smi_w((uword)o)) { good_mem(objs, o); same_obj_kept(objs, Hother, H, o); }
    case succ(rest):
      if (!is_smi_w((uword)o)) {
        good_mem(objs, o);
        same_obj_kept(objs, Hother, H, o);
        if (has_tag(H, o, INSTANCE_TAG)) {
          heap_open(o);
          open [f]body(o, _, _, _, _, _);
          open [f]instance_body(o, _, _);
          close [f]instance_body(o, o_len(H(o)), o_words(H(o)));
          close [f]body(o, header_tag2(o_hw(H(o))), o_len(H(o)), o_aux(H(o)), o_number(H(o)), o_words(H(o)));
          heap_close(o);
          if (o_len(H(o)) > 0) {
            good_nth(objs, o_words(H(o)), 0);
            decoded_stable(rest, objs, Hother, H, ids, nth(0, o_words(H(o))), kind);
          }
        }
    }
  }
}

// The words of an array: as many as its length.
lemma void array_words_length(void *o)
  requires [?f]heap(?objs, ?H) &*& mem(o, objs) == true &*& has_tag(H, o, ARRAY_TAG) == true;
  ensures [f]heap(objs, H) &*& length(o_words(H(o))) == o_len(H(o));
{
  heap_open(o);
  open [f]body(o, _, _, _, _, _);
  open [f]array_body(o, _, _);
  close [f]array_body(o, o_len(H(o)), o_words(H(o)));
  close [f]body(o, 2 * ARRAY_TAG, o_len(H(o)), o_aux(H(o)), o_number(H(o)), o_words(H(o)));
  heap_close(o);
}

// The lengths of the parts of concat_strings.
fixpoint int part_len(fixpoint(void *, oinfo) H, prog_ids ids, void *w) {
  return decoded_length(nat_of_int(Object_MAX_BYTE_CONTENT_DEPTH), H, ids, w, STRINGS_ONLY);
}
fixpoint int parts_len(fixpoint(void *, oinfo) H, prog_ids ids, list<void *> ws) {
  switch (ws) { case nil: return 0; case cons(w, ws0): return part_len(H, ids, w) + parts_len(H, ids, ws0); }
}
fixpoint bool parts_ok(fixpoint(void *, oinfo) H, prog_ids ids, list<void *> ws) {
  switch (ws) { case nil: return true; case cons(w, ws0): return part_len(H, ids, w) >= 0 && parts_ok(H, ids, ws0); }
}

lemma void parts_take_succ(fixpoint(void *, oinfo) H, prog_ids ids, list<void *> ws, int i)
  requires 0 <= i &*& i < length(ws);
  ensures parts_len(H, ids, take(i + 1, ws)) == parts_len(H, ids, take(i, ws)) + part_len(H, ids, nth(i, ws)) &*&
          parts_ok(H, ids, take(i + 1, ws)) == (parts_ok(H, ids, take(i, ws)) && part_len(H, ids, nth(i, ws)) >= 0);
{
  switch (ws) { case nil: case cons(w, ws0): if (i > 0) parts_take_succ(H, ids, ws0, i - 1); }
}

lemma void parts_nonneg(fixpoint(void *, oinfo) H, prog_ids ids, list<void *> ws)
  requires parts_ok(H, ids, ws) == true;
  ensures 0 <= parts_len(H, ids, ws);
{
  switch (ws) { case nil: case cons(w, ws0): parts_nonneg(H, ids, ws0); }
}

lemma void parts_take_le(fixpoint(void *, oinfo) H, prog_ids ids, list<void *> ws, int i)
  requires parts_ok(H, ids, ws) == true &*& 0 <= i &*& i <= length(ws);
  ensures 0 <= parts_len(H, ids, take(i, ws)) &*& parts_len(H, ids, take(i, ws)) <= parts_len(H, ids, ws);
{
  switch (ws) {
    case nil:
    case cons(w, ws0):
      if (i > 0) { parts_take_le(H, ids, ws0, i - 1); } else { parts_nonneg(H, ids, ws); }
  }
}

lemma void parts_ok_nth(fixpoint(void *, oinfo) H, prog_ids ids, list<void *> ws, int i)
  requires parts_ok(H, ids, ws) == true &*& 0 <= i &*& i < length(ws);
  ensures part_len(H, ids, nth(i, ws)) >= 0;
{
  switch (ws) { case nil: case cons(w, ws0): if (i > 0) parts_ok_nth(H, ids, ws0, i - 1); }
}
@*/

