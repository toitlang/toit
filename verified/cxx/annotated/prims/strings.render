@render src/primitive_core.cc toit::utf_8_continuation_byte
static inline bool utf_8_continuation_byte(int c)
//@ requires true;
//@ ensures true;
{
  return (c & 0xc0) == 0x80;
}

@render src/primitive_core.cc toit::is_validated_string
static bool is_validated_string(Program* program, Object* object)
//@ requires [_]program(program, ?ids) &*& [?f]heap(?objs, ?H) &*& good(objs, object) == true;
//@ ensures [f]heap(objs, H) &*& result ? is_heap_w((uword)object) == true : true;
{
  // The only objects that are known to have valid UTF-8 sequences are
  // strings and string-slices.
  if (is_string(object)) return true;
  if (!is_heap_object(object)) return false;
  //@ good_heap(objs, object);
  auto heap_object = HeapObject::cast(object);
  return heap_object->class_id() == program->string_slice_class_id();
}

@render src/primitive_core.cc toit::concat_strings
static String* concat_strings(Process* process,
                              const uint8* bytes_a, word len_a,
                              const uint8* bytes_b, word len_b)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             [_]blob_result(objs, H, STRINGS_ONLY, (uint8 *)bytes_a, len_a, ?ba) &*&
             [_]blob_result(objs, H, STRINGS_ONLY, (uint8 *)bytes_b, len_b, ?bb) &*&
             len_a <= MAX_CONCATENATION_LENGTH &*& len_b <= MAX_CONCATENATION_LENGTH - len_a; @*/
/*@ ensures [f]process(process, prog, ids) &*& allocated(objs, H, process, result, ?objs2, ?H2) &*&
            (result == 0 ? true : has_tag(H2, result, STRING_TAG) == true &*& blob_len(H2, result) == len_a + len_b); @*/
{
  //@ open [_]blob_result(objs, H, STRINGS_ONLY, (uint8 *)bytes_a, len_a, ba);
  //@ open [_]blob_result(objs, H, STRINGS_ONLY, (uint8 *)bytes_b, len_b, bb);
  ASSERT(len_a <= MAX_CONCATENATION_LENGTH && len_b <= MAX_CONCATENATION_LENGTH - len_a);
  String* result = process->allocate_string(len_a + len_b);
  if (result == null) return null;
  //@ open allocated(objs, H, process, result, ?objs1, ?H1);
  //@ same_obj_kept(objs, H, H1, ba);
  //@ same_obj_kept(objs, H, H1, bb);
  //@ blob_facts(ba);
  //@ blob_facts(bb);
  // Initialize object.
  String::MutableBytes bytes(result);
  //@ uint8 *d = blob_base(H1, result);
  //@ heap_holes_open();
  //@ blob_take(result);
  //@ uchars_split(d, len_a);
  //@ uint8 *pa = blob_base(H1, ba);
  //@ blob_take(ba);
  //@ uchars_split(pa, (uword)bytes_a - (uword)pa);
  //@ uchars_split((uint8 *)bytes_a, len_a);
  bytes._initialize(0, bytes_a, 0, len_a);
  //@ uchars_join((uint8 *)bytes_a);
  //@ uchars_join(pa);
  //@ blob_give(ba);
  //@ uint8 *pb = blob_base(H1, bb);
  //@ blob_take(bb);
  //@ uchars_split(pb, (uword)bytes_b - (uword)pb);
  //@ uchars_split((uint8 *)bytes_b, len_b);
  bytes._initialize(len_a, bytes_b, 0, len_b);
  //@ uchars_join((uint8 *)bytes_b);
  //@ uchars_join(pb);
  //@ blob_give(bb);
  //@ uchars_join(d);
  //@ blob_give(result);
  //@ heap_holes_close();
  //@ close allocated(objs, H, process, result, objs1, H1);
  return result;
}

@render src/primitive_core.cc toit::primitive_string_add
PRIMITIVE(string_add)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?a0) &*& pointer(__args - 1, ?a1) &*& good(objs, a0) && good(objs, a1); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_clean(objs, H, objs2, H2, result) == true &*&
            pointer(__args, a0) &*& pointer(__args - 1, a1) &*&
            ((uword)result % 4 == 3 ? objs2 == objs && H2 == H :
              objs2 == cons(result, objs) && !mem(result, objs) && has_tag(H2, result, STRING_TAG) &&
              blob_len(H2, result) == part_len(H, ids, a0) + part_len(H, ids, a1) && forall(objs, (same_obj)(H, H2))); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_ALLOCATION_FAILED_INDEX);
  ARGS(Object, receiver, Object, other);
  // The operator already checks that the objects are strings, but we want to
  // be really sure the primitive wasn't called in a different way. Otherwise
  // we can't be sure that the content only has valid strings.
  String* result;
  if (!is_validated_string(process->program(), receiver)) FAIL(WRONG_OBJECT_TYPE);
  if (!is_validated_string(process->program(), other)) FAIL(WRONG_OBJECT_TYPE);
  Blob receiver_blob;
  Blob other_blob;
  // These should always succeed, as the operator already checks the objects are strings.
  if (!receiver->byte_content(process->program(), &receiver_blob, STRINGS_ONLY)) FAIL(WRONG_OBJECT_TYPE);
  if (!other->byte_content(process->program(), &other_blob, STRINGS_ONLY)) FAIL(WRONG_OBJECT_TYPE);
  //@ assert receiver_blob.address_ |-> ?ra &*& receiver_blob.length_ |-> ?rl &*& [_]blob_result(objs, H, STRINGS_ONLY, ra, rl, ?rb);
  //@ assert other_blob.address_ |-> ?oa &*& other_blob.length_ |-> ?ol &*& [_]blob_result(objs, H, STRINGS_ONLY, oa, ol, ?ob);
  //@ open [_]blob_result(objs, H, STRINGS_ONLY, ra, rl, rb);
  //@ open [_]blob_result(objs, H, STRINGS_ONLY, oa, ol, ob);
  //@ close blob_result(objs, H, STRINGS_ONLY, ra, rl, rb);
  //@ leak blob_result(objs, H, STRINGS_ONLY, ra, rl, rb);
  //@ close blob_result(objs, H, STRINGS_ONLY, oa, ol, ob);
  //@ leak blob_result(objs, H, STRINGS_ONLY, oa, ol, ob);
  if (receiver_blob.length() > MAX_CONCATENATION_LENGTH ||
      other_blob.length() > MAX_CONCATENATION_LENGTH - receiver_blob.length()) {
    FAIL(OUT_OF_RANGE);
  }
  result = concat_strings(process,
                          receiver_blob.address(), receiver_blob.length(),
                          other_blob.address(), other_blob.length());
  //@ open allocated(objs, H, process, result, ?objs1, ?H1);
  if (result == null) FAIL(ALLOCATION_FAILED);
  //@ grows_alloc(objs, H, result, H1);
  return result;
}

@render src/primitive_core.cc toit::primitive_string_slice
PRIMITIVE(string_slice)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?a0) &*& pointer(__args - 1, ?a1) &*& pointer(__args - 2, ?a2) &*&
             good(objs, a0) && good(objs, a1) && good(objs, a2); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_clean(objs, H, objs2, H2, result) == true &*&
            pointer(__args, a0) &*& pointer(__args - 1, a1) &*& pointer(__args - 2, a2) &*&
            ((uword)result % 4 == 3 || result == a0 ? objs2 == objs && H2 == H :
              objs2 == cons(result, objs) && !mem(result, objs) && has_tag(H2, result, STRING_TAG) &&
              blob_len(H2, result) == smi_val((uword)a2) - smi_val((uword)a1) && forall(objs, (same_obj)(H, H2))); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ error_word(Program_ILLEGAL_UTF_8_INDEX);
  //@ error_word(Program_ALLOCATION_FAILED_INDEX);
  ARGS(String, receiver, word, from, word, to);
  //@ good_heap(objs, receiver);
  String::Bytes bytes(receiver);
  //@ blob_facts(receiver);
  word length = bytes.length();
  if (from == 0 && to == length) return receiver;
  if (from < 0 || to > length || from > to) FAIL(OUT_OF_BOUNDS);
  if (from != length) {
    //@ heap_holes_open();
    //@ blob_take(receiver);
    int first = bytes.at(from);
    //@ blob_give(receiver);
    //@ heap_holes_close();
    if (utf_8_continuation_byte(first)) FAIL(ILLEGAL_UTF_8);
  }
  if (to == from) {
    // TODO: there should be a singleton empty string in the roots in program.h.
    return process->allocate_string_or_error("");
  }
  ASSERT(from < length);  // Checked above.
  // We must guard against chopped up UTF-8 sequences.  We can do this, knowing
  // that the receiver string is valid UTF-8, so a very minimal verification is
  // enough.
  if (to != length) {
    //@ heap_holes_open();
    //@ blob_take(receiver);
    int first_after = bytes.at(to);
    //@ blob_give(receiver);
    //@ heap_holes_close();
    if (utf_8_continuation_byte(first_after)) FAIL(ILLEGAL_UTF_8);
  }
  ASSERT(from >= 0);
  ASSERT(to <= receiver->length());  // Checked above.
  ASSERT(from < to);
  word result_len = to - from;
  String* result = process->allocate_string(result_len);
  //@ open allocated(objs, H, process, result, ?objs1, ?H1);
  if (result == null) FAIL(ALLOCATION_FAILED);
  //@ same_obj_kept(objs, H, H1, receiver);
  //@ grows_alloc(objs, H, result, H1);
  // Initialize object.
  String::MutableBytes result_bytes(result);
  //@ close dest_string(&result_bytes, result);
  //@ leak dest_string(&result_bytes, result);
  result_bytes._initialize(0, receiver, from, to - from);
  return result;
}

@render src/primitive_core.cc toit::primitive_concat_strings
PRIMITIVE(concat_strings)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?a0) &*& good(objs, a0) == true; @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_clean(objs, H, objs2, H2, result) == true &*& pointer(__args, a0) &*&
            ((uword)result % 4 == 3 ? objs2 == objs && H2 == H :
              objs2 == cons(result, objs) && !mem(result, objs) && has_tag(H2, result, STRING_TAG) &&
              blob_len(H2, result) == parts_len(H, ids, o_words(H(a0))) && forall(objs, (same_obj)(H, H2))); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_ALLOCATION_FAILED_INDEX);
  ARGS(Array, array);
  //@ good_heap(objs, array);
  //@ array_words_length(array);
  //@ list<void *> ws = o_words(H(array));
  //@ int n = o_len(H(array));
  Program* program = process->program();
  // First make sure we have an array of strings.
  for (word index = 0; index < array->length(); index++)
  //@ invariant [fp]process(process, prog, ids) &*& heap(objs, H) &*& 0 <= index;
  {
    if (!is_validated_string(process->program(), array->at(index))) FAIL(WRONG_OBJECT_TYPE);
  }
  word length = 0;
  for (word index = 0; index < array->length(); index++)
  /*@ invariant [fp]process(process, prog, ids) &*& [_]program(program, ids) &*& prog_ok(ids) == true &*& heap(objs, H) &*& 0 <= index &*& index <= n &*&
                length == parts_len(H, ids, take(index, ws)) &*& parts_ok(H, ids, take(index, ws)) == true &*&
                0 <= length &*& length <= MAX_CONCATENATION_LENGTH; @*/
  {
    Blob blob;
    // A string slice whose fields are not a slice of a string (a program's
    // own library can make one) is not a part. Until wave 10 its partial
    // result was used: nothing, or the whole string it wraps.
    if (!HeapObject::cast(array->at(index))->byte_content(program, &blob, STRINGS_ONLY)) FAIL(WRONG_OBJECT_TYPE);
    //@ assert blob.address_ |-> ?ba &*& blob.length_ |-> ?bl &*& [_]blob_result(objs, H, STRINGS_ONLY, ba, bl, ?bb);
    //@ open [_]blob_result(objs, H, STRINGS_ONLY, ba, bl, bb);
    //@ parts_take_succ(H, ids, ws, index);
    if (blob.length() > MAX_CONCATENATION_LENGTH - length) FAIL(OUT_OF_RANGE);
    length += blob.length();
  }
  //@ take_length(ws);
  //@ open heap(objs, H);
  //@ heap_words_good(objs, objs, H);
  //@ close heap(objs, H);
  String* result = process->allocate_string(length);
  //@ open allocated(objs, H, process, result, ?objs1, ?H1);
  if (result == null) FAIL(ALLOCATION_FAILED);
  //@ same_obj_kept(objs, H, H1, array);
  String::MutableBytes bytes(result);
  //@ uint8 *d = blob_base(H1, result);
  //@ heap_holes_open();
  //@ blob_take(result);
  //@ open heap_holes(objs1, H1, cons(result, nil));
  //@ foreach_restrict(objs, result, objs, H, H1);
  //@ close heap(objs, H1);
  //@ close uchars(d, 0, nil);
  word pos = 0;
  for (word index = 0; index < array->length(); index++)
  /*@ invariant [fp]process(process, prog, ids) &*& [_]program(program, ids) &*& prog_ok(ids) == true &*& heap(objs, H1) &*& bytes.address_ |-> d &*& bytes.length_ |-> length &*&
                0 <= index &*& index <= n &*& pos == parts_len(H, ids, take(index, ws)) &*&
                uchars(d, pos, _) &*& uchars(d + pos, length - pos, _); @*/
  {
    Blob blob;
    //@ parts_take_le(H, ids, ws, index + 1);
    //@ parts_take_succ(H, ids, ws, index);
    //@ parts_ok_nth(H, ids, ws, index);
    HeapObject::cast(array->at(index))->byte_content(program, &blob, STRINGS_ONLY);
    //@ forall_mem(array, objs, (words_good)(objs, H));
    //@ good_nth(objs, ws, index);
    //@ decoded_stable(nat_of_int(Object_MAX_BYTE_CONTENT_DEPTH), objs, H, H1, ids, nth(index, ws), STRINGS_ONLY);
    //@ assert blob.address_ |-> ?ba &*& blob.length_ |-> ?bl &*& [_]blob_result(objs, H1, STRINGS_ONLY, ba, bl, ?bb);
    //@ open [_]blob_result(objs, H1, STRINGS_ONLY, ba, bl, bb);
    word len = blob.length();
    //@ blob_facts(bb);
    //@ uint8 *pb = blob_base(H1, bb);
    //@ heap_holes_open();
    //@ blob_take(bb);
    //@ if (ba != pb) uchars_split(pb, (uword)ba - (uword)pb);
    //@ uchars_split((uint8 *)ba, bl);
    //@ uchars_split(d + pos, len);
    bytes._initialize(pos, blob.address(), 0, len);
    //@ uchars_join((uint8 *)ba);
    //@ if (ba != pb) uchars_join(pb);
    //@ blob_give(bb);
    //@ heap_holes_close();
    //@ uchars_join(d);
    pos += len;
  }
  //@ open heap(objs, H1);
  //@ foreach_widen(objs, result, objs, H1);
  //@ close heap_holes(objs1, H1, cons(result, nil));
  //@ uchars_join(d);
  //@ blob_give(result);
  //@ heap_holes_close();
  //@ grows_alloc(objs, H, result, H1);
  return result;
}
