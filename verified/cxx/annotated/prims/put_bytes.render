// Copyright (C) 2026 Toit contributors.
//
// The byte-array writers of src/primitive_core.cc that take offsets and
// lengths from the program: byte_array_replace, put_uint_big_endian,
// put_uint_little_endian (ported to Rust; the C++ runs when the port
// declines: a copy-on-write destination not yet copied, an opaque byte
// array, see README "When the C++ behind a port runs").
//
// Each decodes a MutableBlob first (the proven mutable_byte_content: a
// copy-on-write byte array may be copied, the heap grows), then the other
// arguments in the grown heap (`valid_arg`: values of the heap at entry,
// which the grown heap contains). Proved: every write inside the
// destination's content (a writable byte array outside the program
// heap), byte_array_replace's legal memmove (the two ranges may be in
// one byte array), no overflow or lossy conversion but the modular ones
// the C++ means (`truncating`: a value's low byte, the arithmetic shift;
// `unsigned-word-conversion`: a negative width or offset becomes a large
// unsigned one and is rejected), the primitive heap contract (`grows`),
// and the retry rule `oom_unchanged` (an error after the copy-on-write
// copy is not an out-of-memory one).
//
// Self-tests (run.sh): put_uint_little_endian's old `width - 1` before
// the check (LP64: overflows for INT_MIN); put_uint_big_endian's end
// check left out; byte_array_replace's `index + length` check left out.
@include ../model/model.cfg
@verbatim
#include "../model/objects.gen.h"
#include "argument_error.gen.h"
#include "blob_args.gen.h"
#include "../blob/mutable_byte_content.gen.h"
//@ #include <listex.gh>
//@ #include "../model/arith.gh"

/*@
// memmove: one region holding both ranges, or two separate chunks (as
// string_write.render's).
inductive mm_mode = mm_one(uint8 *base, int len) | mm_two;
predicate mm_pre(mm_mode m, uint8 *dst, uint8 *src, int n) =
  switch (m) {
    case mm_one(base, len):
      return uchars(base, len, ?bs) &*& base <= src &*& src + n <= base + len &*&
             base <= dst &*& dst + n <= base + len &*& 0 <= n;
    case mm_two:
      return uchars(src, n, ?cs) &*& uchars_(dst, n, _);
  };
predicate mm_post(mm_mode m, uint8 *dst, uint8 *src, int n) =
  switch (m) {
    case mm_one(base, len): return uchars(base, len, _);
    case mm_two: return uchars(src, n, ?cs) &*& uchars(dst, n, cs);
  };

// The unsigned value of a signed one of the same width (the conversion
// C++ defines: modulo 2^n).
lemma void unsigned_of_signed(int x, nat n)
  requires -pow_nat(2, n) <= x &*& x < pow_nat(2, n);
  ensures truncate_unsigned(x, int_of_nat(n)) == (x < 0 ? x + pow_nat(2, n) : x);
{
  pow2_pos(n);
  truncate_unsigned_def(x, n);
  assert [_]divrem(x, pow_nat(2, n), ?q, ?r);
}

lemma void pow2_32()
  requires true;
  ensures pow_nat(2, N31) == 2147483648 &*& int_of_nat(N31) == 31 &*& pow_nat(2, N32) == 4294967296 &*& pow_nat(2, N64) == 18446744073709551616;
{
  assert pow_nat(2, N8) == 256;
  assert pow_nat(2, N16) == 65536;
  assert pow_nat(2, N32) == 4294967296;
  assert pow_nat(2, N31) == 2147483648;
  assert int_of_nat(N31) == 31;
  assert pow_nat(2, N64) == 18446744073709551616;
}
@*/

void *memmove(void *dest, void *src, size_t count);
//@ requires mm_pre(?m, dest, src, count);
//@ ensures mm_post(m, dest, src, count) &*& result == dest;
@prototypes
@render src/objects.h toit::MutableBlob::MutableBlob tu=src/primitive_core.cc params=0
  MutableBlob() : address_(null), length_(0)
  //@ requires self->address_ |-> _ &*& self->length_ |-> _;
  //@ ensures self->address_ |-> 0 &*& self->length_ |-> 0;
  {}

@render src/objects.h toit::MutableBlob::address tu=src/primitive_core.cc
  uint8* address()
  //@ requires [?f]self->address_ |-> ?a;
  //@ ensures [f]self->address_ |-> a &*& result == a;
  { return address_; }

@render src/objects.h toit::MutableBlob::length tu=src/primitive_core.cc
  word length()
  //@ requires [?f]self->length_ |-> ?l;
  //@ ensures [f]self->length_ |-> l &*& result == l;
  { return length_; }

@render src/primitive_core.cc toit::primitive_put_uint_big_endian truncating unsigned-word-conversion
PRIMITIVE(put_uint_big_endian)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x0) &*& pointer(__args - 1, ?x1) &*& pointer(__args - 2, ?x2) &*& pointer(__args - 3, ?x3) &*& pointer(__args - 4, ?x4) &*&
             good(objs, x1) && good(objs, x2) && good(objs, x4); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_unchanged(prog, objs, H, objs2, H2, result) == true &*&
            pointer(__args, x0) &*& pointer(__args - 1, x1) &*& pointer(__args - 2, x2) &*& pointer(__args - 3, x3) &*& pointer(__args - 4, x4); @*/
{
  // The retry rule: the copy-on-write copy can be installed before a later
  // argument or the range check fails; those errors are not out-of-memory
  // ones (the loader's error roots).
  //@ process_program(process);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ immediate_error_not_oom(prog, Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ immediate_error_not_oom(prog, Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ immediate_error_not_oom(prog, Program_OUT_OF_BOUNDS_INDEX);
  //@ close valid_arg(x2, objs);
  //@ leak valid_arg(x2, objs);
  //@ close valid_arg(x4, objs);
  //@ leak valid_arg(x4, objs);
  ARGS(Object, unused, MutableBlob, dest, int, width, word, offset, int64, value);
  //@ assert heap(?objs2, ?H2) &*& [_]mutable_result(objs2, H2, process, ?da, ?dl, ?bd);
  //@ open [_]mutable_result(objs2, H2, process, da, dl, bd);
  //@ blob_facts(bd);
  USE(unused);
  //@ pow2_32();
  //@ truncate_signed_limits(_word_width, N31);
  //@ unsigned_of_signed(width, N32);
  unsigned unsigned_width = width;
  //@ unsigned_of_signed(offset, sizeof(word) == 8 ? N64 : N32);
  uword unsigned_offset = offset;
  //@ unsigned_of_signed(dl, sizeof(word) == 8 ? N64 : N32);
  uword length = dest.length();
  //@ if (unsigned_offset <= length && unsigned_width <= 8) { unsigned_of_signed(unsigned_offset + unsigned_width, sizeof(word) == 8 ? N64 : N32); }
  // We don't need to check for <0 on unsigned values.  Can't have integer
  // overflow when they are both constrained in size (assuming the byte
  // array can't be close to 4Gbytes large).
  if (unsigned_offset > length || unsigned_width > 8 || unsigned_offset + unsigned_width > length) {
    FAIL(OUT_OF_BOUNDS);
  }
  //@ heap_holes_open();
  //@ blob_take(bd);
  //@ uint8 *db = blob_base(H2, bd);
  //@ uchars_split(db, (uword)da - (uword)db);
  //@ uchars_split(da, dl);
  for (int i = width - 1; i >= 0; i--)
  //@ invariant dest.address_ |-> da &*& dest.length_ |-> dl &*& uchars(da, dl, _) &*& -1 <= i &*& i < width;
  {
    dest.address()[offset + i] = value;
    value >>= 8;
  }
  //@ uchars_join(da);
  //@ uchars_join(db);
  //@ blob_give(bd);
  //@ heap_holes_close();
  return process->null_object();
}

@render src/primitive_core.cc toit::primitive_put_uint_little_endian truncating unsigned-word-conversion
PRIMITIVE(put_uint_little_endian)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x0) &*& pointer(__args - 1, ?x1) &*& pointer(__args - 2, ?x2) &*& pointer(__args - 3, ?x3) &*& pointer(__args - 4, ?x4) &*&
             good(objs, x1) && good(objs, x2) && good(objs, x4); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_unchanged(prog, objs, H, objs2, H2, result) == true &*&
            pointer(__args, x0) &*& pointer(__args - 1, x1) &*& pointer(__args - 2, x2) &*& pointer(__args - 3, x3) &*& pointer(__args - 4, x4); @*/
{
  //@ process_program(process);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ immediate_error_not_oom(prog, Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ immediate_error_not_oom(prog, Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ immediate_error_not_oom(prog, Program_OUT_OF_BOUNDS_INDEX);
  //@ close valid_arg(x2, objs);
  //@ leak valid_arg(x2, objs);
  //@ close valid_arg(x4, objs);
  //@ leak valid_arg(x4, objs);
  ARGS(Object, unused, MutableBlob, dest, int, width, word, offset, int64, value);
  //@ assert heap(?objs2, ?H2) &*& [_]mutable_result(objs2, H2, process, ?da, ?dl, ?bd);
  //@ open [_]mutable_result(objs2, H2, process, da, dl, bd);
  //@ blob_facts(bd);
  USE(unused);
  // A negative width becomes a large unsigned one (`width - 1` in int
  // overflowed for INT_MIN).
  //@ pow2_32();
  //@ truncate_signed_limits(_word_width, N31);
  //@ unsigned_of_signed(width, N32);
  unsigned unsigned_width = width;
  //@ unsigned_of_signed(offset, sizeof(word) == 8 ? N64 : N32);
  uword unsigned_offset = offset;
  //@ unsigned_of_signed(dl, sizeof(word) == 8 ? N64 : N32);
  uword length = dest.length();
  //@ if (unsigned_offset <= length && unsigned_width <= 8) { unsigned_of_signed(unsigned_offset + unsigned_width, sizeof(word) == 8 ? N64 : N32); }
  // We don't need to check for <0 on unsigned values.  Can't have integer
  // overflow when they are both constrained in size (assuming the byte
  // array can't be close to 4Gbytes large).
  if (unsigned_offset > length || unsigned_width == 0 || unsigned_width > 8 || unsigned_offset + unsigned_width > length) {
    FAIL(OUT_OF_BOUNDS);
  }
  uword width_minus_1 = unsigned_width - 1;
  //@ heap_holes_open();
  //@ blob_take(bd);
  //@ uint8 *db = blob_base(H2, bd);
  //@ uchars_split(db, (uword)da - (uword)db);
  //@ uchars_split(da, dl);
  for (uword i = 0; i <= width_minus_1; i++)
  //@ invariant dest.address_ |-> da &*& dest.length_ |-> dl &*& uchars(da, dl, _) &*& 0 <= i &*& i <= width_minus_1 + 1;
  {
    //@ unsigned_of_signed(offset + i, sizeof(word) == 8 ? N64 : N32);
    dest.address()[offset + i] = value;
    value >>= 8;
  }
  //@ uchars_join(da);
  //@ uchars_join(db);
  //@ blob_give(bd);
  //@ heap_holes_close();
  return process->null_object();
}

@render src/primitive_core.cc toit::primitive_byte_array_replace truncating
PRIMITIVE(byte_array_replace)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x0) &*& pointer(__args - 1, ?x1) &*& pointer(__args - 2, ?x2) &*& pointer(__args - 3, ?x3) &*& pointer(__args - 4, ?x4) &*&
             good(objs, x0) && good(objs, x1) && good(objs, x2) && good(objs, x3) && good(objs, x4); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_unchanged(prog, objs, H, objs2, H2, result) == true &*&
            pointer(__args, x0) &*& pointer(__args - 1, x1) &*& pointer(__args - 2, x2) &*& pointer(__args - 3, x3) &*& pointer(__args - 4, x4); @*/
{
  //@ process_program(process);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ immediate_error_not_oom(prog, Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ immediate_error_not_oom(prog, Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ immediate_error_not_oom(prog, Program_OUT_OF_BOUNDS_INDEX);
  //@ error_word(Program_WRONG_BYTES_TYPE_INDEX);
  //@ immediate_error_not_oom(prog, Program_WRONG_BYTES_TYPE_INDEX);
  //@ close valid_arg(x1, objs);
  //@ leak valid_arg(x1, objs);
  //@ close valid_arg(x2, objs);
  //@ leak valid_arg(x2, objs);
  //@ close valid_arg(x3, objs);
  //@ leak valid_arg(x3, objs);
  //@ close valid_arg(x4, objs);
  //@ leak valid_arg(x4, objs);
  ARGS(MutableBlob, receiver, int, index, Blob, source_object, int, from, int, to);
  //@ assert heap(?objs2, ?H2) &*& [_]mutable_result(objs2, H2, process, ?da, ?dl, ?bd);
  //@ assert [_]blob_result(objs2, H2, STRINGS_OR_BYTE_ARRAYS, ?sa, ?sl, ?bs);
  //@ open [_]mutable_result(objs2, H2, process, da, dl, bd);
  //@ open [_]blob_result(objs2, H2, STRINGS_OR_BYTE_ARRAYS, sa, sl, bs);
  //@ blob_facts(bd);
  //@ blob_facts(bs);
  //@ pow2_32();
  //@ truncate_signed_limits(_word_from, N31);
  //@ truncate_signed_limits(_word_to, N31);
  if (index < 0 || from < 0 || to < 0 || to > source_object.length()) FAIL(OUT_OF_BOUNDS);
  word length = to - from;
  if (length < 0 || index + length > receiver.length()) FAIL(OUT_OF_BOUNDS);

  uint8* dest = receiver.address() + index;
  const uint8* source = source_object.address() + from;
  //@ heap_holes_open();
  //@ blob_take(bd);
  //@ if (bs != bd) blob_take(bs);
  //@ uint8 *sb = blob_base(H2, bs);
  //@ uint8 *db = blob_base(H2, bd);
  /*@
  if (bs == bd) {
    close mm_pre(mm_one(db, blob_len(H2, bd)), dest, (uint8 *)source, length);
  } else {
    uchars_split(sb, (uword)source - (uword)sb);
    uchars_split((uint8 *)source, length);
    uchars_split(db, (uword)dest - (uword)db);
    uchars_split(dest, length);
    close mm_pre(mm_two, dest, (uint8 *)source, length);
  }
  @*/
  memmove(dest, source, length);
  /*@
  if (bs == bd) {
    open mm_post(_, _, _, _);
  } else {
    open mm_post(_, _, _, _);
    uchars_join((uint8 *)source);
    uchars_join(sb);
    uchars_join(dest);
    uchars_join(db);
    blob_give(bs);
  }
  @*/
  //@ blob_give(bd);
  //@ heap_holes_close();
  return process->null_object();
}
