            filled_from(o_words(H(self)), o_words(H2(self)), from, filler) == true; @*/
{
  GcMetadata::insert_into_remembered_set(this);
  word len = length();
  //@ heap_open(self);
  //@ open body(self, _, _, _, _, _);
  //@ open array_body(self, _, _);
  //@ void **base = (void **)raw(self) + LAYOUT_ARRAY_ELEMENTS_WORD;
  //@ list<void *> ws0 = o_words(H(self));
  for (word index = from; index < len; index++)
  /*@ invariant pointers(base, len, ?cur) &*& from <= index &*& (from <= len ? index <= len : index == from) &*&
                length(cur) == len &*& take(from, cur) == take(from, ws0) &*&
                (from <= len ? all_eq(take(index - from, drop(from, cur)), filler) == true : cur == ws0); @*/
  {
    //@ pointers_focus(base, index);
    at_put_no_write_barrier(index, filler);
    //@ pointers_unfocus(base, index, cur);
    //@ take_update_above(cur, from, index, filler);
    //@ drop_update_filled(cur, from, index, filler);
  }
  //@ assert pointers(base, len, ?ws);
  //@ if (from <= len) { assert all_eq(take(len - from, drop(from, ws)), filler) == true; assert length(drop(from, ws)) == len - from; take_length(drop(from, ws)); } else { all_eq_drop(nil, 0, filler); }
  //@ fixpoint(void *, oinfo) H2 = put_words(H, self, ws);
  //@ close array_body(self, len, ws);
  //@ close body(self, 2 * ARRAY_TAG, o_len(H2(self)), o_aux(H2(self)), o_number(H2(self)), o_words(H2(self)));
  //@ open heap_rest(objs, H, self);
  //@ distinct_mem_remove(self, objs);
  //@ heap_rest_put_words(remove(self, objs), objs, H, self, ws);
  //@ close heap_rest(objs, H2, self);
  //@ open header(self, _);
  //@ close header(self, o_hw(H2(self)));
  //@ if (from <= len) { forall_good_take(ws0, from, objs); all_eq_good(drop(from, ws), filler, objs); forall_good_append(take(from, ws), drop(from, ws), objs); append_take_drop_n(ws, from); } else { drop_beyond(ws, from); }
  //@ heap_close(self);
}

@render src/primitive_core.cc toit::primitive_array_expand
PRIMITIVE(array_expand)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?a0) &*& pointer(__args - 1, ?a1) &*& pointer(__args - 2, ?a2) &*& pointer(__args - 3, ?a3) &*&
             good(objs, a0) && good(objs, a1) && good(objs, a2) && good(objs, a3); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_clean(objs, H, objs2, H2, result) == true &*&
            pointer(__args, a0) &*& pointer(__args - 1, a1) &*& pointer(__args - 2, a2) &*& pointer(__args - 3, a3) &*&
            ((uword)result % 4 == 3 ? objs2 == objs && H2 == H :
             (objs2 == objs && H2 == H && result == empty_array_root(prog)) ||
             (objs2 == cons(result, objs) && !mem(result, objs) && has_tag(H2, result, ARRAY_TAG) &&
              o_len(H2(result)) == smi_val((uword)a2) &&
              take(copied(a1, a2), o_words(H2(result))) == take(copied(a1, a2), o_words(H(a0))) &&
              all_eq(drop(copied(a1, a2), o_words(H2(result))), a3) &&
              forall(objs, (same_obj)(H, H2)))); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_ALLOCATION_FAILED_INDEX);
  ARGS(Array, old, word, old_length, word, length, Object, filler);
  if (length == 0) return process->program()->empty_array();
  if (length < 0) FAIL(OUT_OF_BOUNDS);
  if (length > Array::ARRAYLET_SIZE) FAIL(OUT_OF_RANGE);
  if (old_length < 0 || old_length > old->length()) FAIL(OUT_OF_RANGE);
  Object* result = process->object_heap()->allocate_array(length, filler);
  //@ open allocated(objs, H, process, result, ?objs1, ?H1);
  if (result == null) FAIL(ALLOCATION_FAILED);
  //@ grows_alloc(objs, H, result, H1);
  //@ same_obj_kept(objs, H, H1, old);
  Array* new_array = Array::cast(result);
  //@ word m = length <= old_length ? length : old_length;
  //@ heap_open(new_array);
  //@ open body(new_array, _, _, _, _, _);
  //@ open array_body(new_array, _, _);
  //@ list<void *> fills = o_words(H1(new_array));
  //@ void **nb = (void **)raw(new_array) + LAYOUT_ARRAY_ELEMENTS_WORD;
  //@ pointers_split(nb, m);
  //@ open heap_rest(objs1, H1, new_array);
  //@ distinct_mem_remove(new_array, objs1);
  //@ assert mem(old, remove(new_array, objs1)) == true;
  //@ foreach_remove(old, remove(new_array, objs1));
  //@ open heap_obj(objs1, H1)(old);
  //@ open body(old, _, _, _, _, _);
  //@ open array_body(old, _, _);
  //@ list<void *> ows = o_words(H1(old));
  //@ void **ob = (void **)raw(old) + LAYOUT_ARRAY_ELEMENTS_WORD;
  //@ pointers_split(ob, m);
  new_array->copy_from(old, Utils::min(length, old_length));
  //@ pointers_join(ob);
  //@ append_take_drop_n(ows, m);
  //@ close array_body(old, o_len(H1(old)), ows);
  //@ close body(old, 2 * ARRAY_TAG, o_len(H1(old)), o_aux(H1(old)), o_number(H1(old)), ows);
  //@ close heap_obj(objs1, H1)(old);
  //@ foreach_unremove(old, remove(new_array, objs1));
  //@ list<void *> ws = append(take(m, ows), drop(m, fills));
  //@ pointers_join(nb);
  //@ fixpoint(void *, oinfo) H3 = put_words(H1, new_array, ws);
