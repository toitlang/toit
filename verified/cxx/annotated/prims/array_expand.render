//
// PRIMITIVE(array_expand) of src/primitive_core.cc (wave 10): a new array
// of `length` elements, the first min(length, old_length) copied from
// `old`, the others the filler. Ported to Rust; the C++ runs when the
// port's allocation does not fit (NeedsGc; README "When the C++ behind a
// port runs").
//
// Proved: every read inside `old` (the copy of min(length, old_length)
// words, old_length checked against old's length), every write inside the
// new array (the memcpy of the words as bytes, VeriFast's pointer and
// char chunks converted with the prelude's exact round trips, and the
// fill), the new array's elements (the copied prefix, the filler after
// it: all of them good references), the primitive heap contract
// (`grows`), and the retry rule `oom_clean`.
//
// Self-tests (run.sh): the check of old_length against old's length left
// out (the copy reads past old); the copy one word longer.
@include ../model/model.cfg
@verbatim
#include "../model/objects.gen.h"
#include "array_allocation.gen.h"
#include <stddef.h>
//@ #include "../model/arith.gh"

// From VeriFast's bin/string.h (chars: the array's words as bytes).
void *memcpy(void *array, void *array0, size_t count);
//@ requires chars_(array, count, _) &*& [?f]chars(array0, count, ?cs0);
//@ ensures chars(array, count, cs0) &*& [f]chars(array0, count, cs0) &*& result == array;

/*@
// The heap with the words of one object replaced (its header, length and
// auxiliary words kept).
fixpoint fixpoint(void *, oinfo) put_words(fixpoint(void *, oinfo) H, void *o, list<void *> ws) {
  return fupdate(H, o, oinfo(o_hw(H(o)), o_len(H(o)), ws, o_aux(H(o)), o_number(H(o))));
}

lemma void heap_rest_put_words(list<void *> xs, list<void *> objs, fixpoint(void *, oinfo) H, void *o, list<void *> ws)
  requires foreach(xs, heap_obj(objs, H)) &*& mem(o, xs) == false;
  ensures foreach(xs, heap_obj(objs, put_words(H, o, ws)));
{
  open foreach(xs, _);
  switch (xs) {
    case nil:
      close foreach(nil, heap_obj(objs, put_words(H, o, ws)));
    case cons(x, xs0):
      open heap_obj(objs, H)(x);
      close heap_obj(objs, put_words(H, o, ws))(x);
      heap_rest_put_words(xs0, objs, H, o, ws);
      close foreach(xs, heap_obj(objs, put_words(H, o, ws)));
  }
}

lemma void forall_kept_put_words(list<void *> xs, fixpoint(void *, oinfo) H, void *o, list<void *> ws)
  requires true;
  ensures forall(xs, (kept)(H, put_words(H, o, ws))) == true;
{
  switch (xs) { case nil: case cons(x, xs0): forall_kept_put_words(xs0, H, o, ws); }
}

lemma void forall_same_put_words(list<void *> xs, fixpoint(void *, oinfo) H, void *o, list<void *> ws)
  requires mem(o, xs) == false;
  ensures forall(xs, (same_obj)(H, put_words(H, o, ws))) == true;
{
  switch (xs) { case nil: case cons(x, xs0): forall_same_put_words(xs0, H, o, ws); }
}

lemma void forall_good_cons(list<void *> ws, list<void *> objs, void *r)
  requires forall(ws, (good)(objs)) == true;
  ensures forall(ws, (good)(cons(r, objs))) == true;
{
  switch (ws) { case nil: case cons(w, ws0): forall_good_cons(ws0, objs, r); }
}

lemma void forall_good_append(list<void *> xs, list<void *> ys, list<void *> objs)
  requires forall(xs, (good)(objs)) == true &*& forall(ys, (good)(objs)) == true;
  ensures forall(append(xs, ys), (good)(objs)) == true;
{
  switch (xs) { case nil: case cons(x, xs0): forall_good_append(xs0, ys, objs); }
}

lemma void forall_good_take(list<void *> xs, int n, list<void *> objs)
  requires forall(xs, (good)(objs)) == true;
  ensures forall(take(n, xs), (good)(objs)) == true;
{
  switch (xs) { case nil: case cons(x, xs0): if (n != 0) forall_good_take(xs0, n - 1, objs); }
}

lemma void forall_good_drop(list<void *> xs, int n, list<void *> objs)
  requires forall(xs, (good)(objs)) == true;
  ensures forall(drop(n, xs), (good)(objs)) == true;
{
  switch (xs) { case nil: case cons(x, xs0): if (n != 0) forall_good_drop(xs0, n - 1, objs); }
}

lemma void all_eq_good(list<void *> xs, void *v, list<void *> objs)
  requires all_eq(xs, v) == true &*& good(objs, v) == true;
  ensures forall(xs, (good)(objs)) == true;
{
  switch (xs) { case nil: case cons(x, xs0): all_eq_good(xs0, v, objs); }
}

lemma void all_eq_drop(list<void *> xs, int n, void *v)
  requires all_eq(xs, v) == true;
  ensures all_eq(drop(n, xs), v) == true;
{
  switch (xs) { case nil: case cons(x, xs0): if (n != 0) all_eq_drop(xs0, n - 1, v); }
}

lemma void all_eq_append(list<void *> xs, list<void *> ys, void *v)
  requires all_eq(xs, v) == true &*& all_eq(ys, v) == true;
  ensures all_eq(append(xs, ys), v) == true;
{
  switch (xs) { case nil: case cons(x, xs0): all_eq_append(xs0, ys, v); }
}

lemma void take_append_exact(list<void *> xs, list<void *> ys)
  requires true;
  ensures take(length(xs), append(xs, ys)) == xs &*& drop(length(xs), append(xs, ys)) == ys;
{
  switch (xs) { case nil: case cons(x, xs0): take_append_exact(xs0, ys); }
}

lemma void drop_beyond(list<void *> xs, int n)
  requires length(xs) <= n;
  ensures drop(n, xs) == nil;
{
  switch (xs) { case nil: case cons(x, xs0): drop_beyond(xs0, n - 1); }
}

// The number of words array_expand copies: min(length, old_length).
fixpoint int copied(void *old_length, void *length) {
  return smi_val((uword)length) <= smi_val((uword)old_length) ? smi_val((uword)length) : smi_val((uword)old_length);
}

// The words of an array after fill(from): those below `from` kept, the
// others the filler.
fixpoint bool filled_from(list<void *> before, list<void *> after, int from, void *filler) {
  return length(after) == length(before) && take(from, after) == take(from, before) && all_eq(drop(from, after), filler);
}

lemma void take_update_above(list<void *> xs, int n, int i, void *v)
  requires 0 <= n &*& n <= i;
  ensures take(n, update(i, v, xs)) == take(n, xs);
{
  switch (xs) { case nil: case cons(x, xs0): if (n > 0) take_update_above(xs0, n - 1, i - 1, v); }
}

lemma void drop_update_filled(list<void *> xs, int from, int i, void *v)
  requires 0 <= from &*& from <= i &*& i < length(xs) &*& all_eq(take(i - from, drop(from, xs)), v) == true;
  ensures all_eq(take(i + 1 - from, drop(from, update(i, v, xs))), v) == true;
{
  switch (xs) {
    case nil:
    case cons(x, xs0):
      if (from > 0) {
        drop_update_filled(xs0, from - 1, i - 1, v);
      } else if (i > 0) {
        drop_update_filled(xs0, 0, i - 1, v);
      }
  }
}
@*/

@prototypes
@render src/utils.h toit::Utils::min tu=src/primitive_core.cc type=long(long,long)|int(int,int)
  static inline T min(T x, T y)
  //@ requires true;
  //@ ensures result == (x <= y ? x : y);
  {
    return x < y ? x : y;
  }

@render src/objects.h toit::Array::content tu=src/primitive_core.cc
  uint8* content()
  //@ requires 1 <= (uword)self &*& (uword)self - 1 + Array_HEADER_SIZE <= UINTPTR_MAX;
  //@ ensures result == (uint8 *)((uword)self - 1 + Array_HEADER_SIZE);
  { return reinterpret_cast<uint8*>(_raw() + _offset_from(0)); }

@render src/objects.h toit::Array::copy_from tu=src/primitive_core.cc
  void copy_from(Array* other, word length)
  /*@ requires addr_ok(self) == true &*& addr_ok(other) == true &*& 0 <= length &*& length <= MAX_OBJECT_WORDS &*&
               pointers_((void **)raw(self) + LAYOUT_ARRAY_ELEMENTS_WORD, length, _) &*&
               [?f]pointers((void **)raw(other) + LAYOUT_ARRAY_ELEMENTS_WORD, length, ?ps); @*/
  /*@ ensures pointers((void **)raw(self) + LAYOUT_ARRAY_ELEMENTS_WORD, length, ps) &*&
              [f]pointers((void **)raw(other) + LAYOUT_ARRAY_ELEMENTS_WORD, length, ps); @*/
  {
    memcpy(content(), other->content(), length * WORD_SIZE);
  }

@render src/objects.h toit::Array::at_put_no_write_barrier tu=src/primitive_core.cc
  INLINE void at_put_no_write_barrier(word index, Object* value)
  /*@ requires 1 <= (uword)self &*& 0 <= index &*& index < MAX_OBJECT_WORDS &*&
               pointer_((void **)raw(self) + LAYOUT_ARRAY_ELEMENTS_WORD + index, _); @*/
  //@ ensures pointer((void **)raw(self) + LAYOUT_ARRAY_ELEMENTS_WORD + index, value);
  {
    ASSERT(index >= 0 && index < length());
    //@ div_rem_nonneg_unique(Array_HEADER_SIZE + index * WORD_SIZE, WORD_SIZE, 2 + index, 0);
    _at_put(_offset_from(index), value);
  }

@render src/objects_inline.h toit::Array::fill tu=src/primitive_core.cc
inline void Array::fill(word from, Object* filler)
/*@ requires heap(?objs, ?H) &*& mem(self, objs) == true &*& has_tag(H, self, ARRAY_TAG) == true &*&
             0 <= from &*& good(objs, filler) == true; @*/
