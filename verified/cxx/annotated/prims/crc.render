@include ../model/model.cfg
@verbatim
#include "integer.gen.h"
#include "argument_error.gen.h"
#include "blob_args.gen.h"
#include "../blob/borrow_slice.h"
//@ #include "../model/truncate.gh"

/*@
lemma void pow2_le(nat a, nat b)
  requires int_of_nat(a) <= int_of_nat(b);
  ensures pow_nat(2, a) <= pow_nat(2, b);
{
  switch (a) {
    case zero: pow2_pos(b);
    case succ(a0): switch (b) { case zero: case succ(b0): pow2_le(a0, b0); }
  }
}

@*/
@prototypes
@render src/primitive_core.cc toit::get_array_from_list
static Array* get_array_from_list(Object* object, Process* process)
//@ requires [?f]process(process, ?prog, ?ids) &*& [?g]heap(?objs, ?H) &*& good(objs, object) == true;
/*@ ensures [f]process(process, prog, ids) &*& [g]heap(objs, H) &*&
            (result == 0 || mem(result, objs) && has_tag(H, result, ARRAY_TAG)); @*/
{
  Array* result = null;
  if (is_instance(object)) {
    //@ good_heap(objs, object);
    Instance* list = Instance::cast(object);
    //@ heap_facts(list);
    if (list->class_id() == process->program()->list_class_id()) {
      Object* array_object = list->at(0);
      if (is_array(array_object)) {
        //@ good_heap(objs, array_object);
        result = Array::cast(array_object);
      }
    }
  }
  return result;
}

@render src/primitive_core.cc toit::primitive_crc truncating
PRIMITIVE(crc)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x0) &*& pointer(__args - 1, ?x1) &*& pointer(__args - 2, ?x2) &*&
             pointer(__args - 3, ?x3) &*& pointer(__args - 4, ?x4) &*& pointer(__args - 5, ?x5) &*&
             good(objs, x0) && good(objs, x1) && good(objs, x2) && good(objs, x3) && good(objs, x4) && good(objs, x5); @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& oom_clean(objs, H, objs2, H2, result) == true &*& grows(objs, H, objs2, H2) == true &*&
            pointer(__args, x0) &*& pointer(__args - 1, x1) &*& pointer(__args - 2, x2) &*&
            pointer(__args - 3, x3) &*& pointer(__args - 4, x4) &*& pointer(__args - 5, x5) &*&
            (good(objs2, result) || (uword)result % 4 == 3); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_WRONG_BYTES_TYPE_INDEX);
  //@ error_word(Program_INVALID_ARGUMENT_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  ARGS(int64, accumulator, word, width, Blob, data, word, from, word, to, Object, table_object);
  if ((width != 0 && width < 8) || width > 64) FAIL(INVALID_ARGUMENT);
  bool big_endian = width != 0;
  if (to == from) return _raw_accumulator;
  if (from < 0 || to > data.length() || from > to) FAIL(OUT_OF_BOUNDS);
  //@ assert [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, ?a, ?len, ?source);
  Array* table = get_array_from_list(table_object, process);
  const uint8* byte_table = null;
  if (table) {
    if (table->length() != 0x100) FAIL(INVALID_ARGUMENT);
  } else {
    Blob blob;
    if (!table_object->byte_content(process->program(), &blob, STRINGS_OR_BYTE_ARRAYS)) FAIL(WRONG_OBJECT_TYPE);
    if (blob.length() != 0x100) FAIL(INVALID_ARGUMENT);
    byte_table = blob.address();
    //@ assert [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, byte_table, 256, ?backing);
    //@ borrow_slice(backing, byte_table, 256);
    //@ open uchars(byte_table, 256, ?table_bytes);
    //@ u_character_limits(byte_table);
    //@ close uchars(byte_table, 256, table_bytes);
    //@ return_slice(backing, byte_table, 256);
  }
  uint64 checksum = static_cast<uint64>(accumulator);
  for (word i = from; i < to; i++)
  /*@ invariant from <= i &*& i <= to &*& heap(objs, H) &*& data.address_ |-> a &*&
                [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, a, len, source) &*&
                (byte_table != 0 ? [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, byte_table, 256, _) :
                 mem(table, objs) == true &*& has_tag(H, table, ARRAY_TAG) == true &*& o_len(H(table)) == 256); @*/
  {
    //@ borrow_slice(source, a, len);
    uint8 byte = data.address()[i];
    //@ return_slice(source, a, len);
    uint64 index = checksum;
    if (big_endian) index >>= width - 8;
    //@ bitand_limits(byte ^ index, 255, N8);
    index = (byte ^ index) & 0xff;
    int64 entry;
    if (byte_table) {
      //@ assert [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, byte_table, 256, ?table_source);
      //@ borrow_slice(table_source, byte_table, 256);
      entry = byte_table[index];
      //@ return_slice(table_source, byte_table, 256);
    } else {
      //@ truncate_signed_id(index, sizeof(word) == 8 ? N63 : N31);
      Object* table_entry = table->at(index);
      INT64_VALUE_OR_WRONG_TYPE(int_table_entry, table_entry);
      entry = int_table_entry;
    }
    checksum = (big_endian ? checksum << 8 : checksum >> 8) ^ static_cast<uint64>(entry);
  }
  if ((width & 63) != 0) {
    uint64 mask = 1;
    //@ bitand_limits(width, 63, N6);
    //@ nat k = nat_of_int(width & 63);
    //@ pow2_pos(k);
    //@ pow2_le(k, N63);
    //@ shiftleft_def(1, k);
    mask = (mask << (width & 63)) - 1;
    //@ bitand_limits(checksum, mask, N64);
    checksum &= mask;
  }
  return Primitive::integer(static_cast<int64>(checksum), process);
}
