}

@render src/primitive_core.cc toit::primitive_printf_style_int64_to_string truncating
PRIMITIVE(printf_style_int64_to_string)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*& pointer(__args, ?arg) &*& good(objs, arg) == true &*&
             pointer(__args - 1, ?radix) &*& good(objs, radix) == true; @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            pointer(__args, arg) &*& pointer(__args - 1, radix) &*&
            (radix_error(H, arg, radix, true) == 0 ?
              format_result(prog, objs, H, objs2, H2, result, format_arg(H, arg), smi_val((uword)radix), true) :
              objs2 == objs &*& H2 == H &*& (uword)result == 4 * radix_error(H, arg, radix, true) + 3); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ truncate_signed_limits(smi_val((uword)radix), N31);
  //@ if (INT_MIN <= smi_val((uword)radix) && smi_val((uword)radix) <= INT_MAX) truncate_signed_id(smi_val((uword)radix), N31);
  //@ close valid_arg(radix, objs);
  //@ leak valid_arg(radix, objs);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_INVALID_ARGUMENT_INDEX);
  ARGS(int64, receiver, int, base);
  if (base != 2 && base != 8 && base != 16) FAIL(INVALID_ARGUMENT);
  return format_integer(process, receiver, base, true);
}
