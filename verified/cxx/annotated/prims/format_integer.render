              objs2 == objs &*& H2 == H &*& (uword)result == 4 * Program_WRONG_OBJECT_TYPE_INDEX + 3); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  ARGS(word, receiver);
