@verbatim
#include "argument_error.gen.h"
#include <stddef.h>
//@ #include "../model/truncate.gh"

/*@
fixpoint int format_magnitude(int value, bool u) {
  return value >= 0 ? value : u ? 18446744073709551616 + value : -value;
}
fixpoint int digit_byte(int d) { return d < 10 ? '0' + d : 'a' + d - 10; }
fixpoint int read_digits(int base, list<unsigned char> bytes, int acc) {
  switch (bytes) {
    case nil: return acc;
    case cons(c, rest): return
      '0' <= c && c <= '9' && c - '0' < base ? read_digits(base, rest, base * acc + c - '0') :
      'a' <= c && c <= 'z' && c - 'a' + 10 < base ? read_digits(base, rest, base * acc + c - 'a' + 10) : -1;
  }
}
predicate format_result(Program *prog, list<void *> objs, fixpoint(void *, oinfo) H,
                        list<void *> after, fixpoint(void *, oinfo) H2, void *r, int value, int base, bool u) =
  exists<list<unsigned char> >(?digits) &*& digits != nil &*& (head(digits) != '0' || length(digits) == 1) &*&
  read_digits(base, digits, 0) == format_magnitude(value, u) &*&
  string_copy_result(prog, objs, H, after, H2, r, length(digits) + (value < 0 && !u ? 1 : 0)) == true;
fixpoint int format_arg(fixpoint(void *, oinfo) H, void *arg) {
  return is_smi_w((uword)arg) ? smi_val((uword)arg) : o_number(H(arg));
}
fixpoint int radix_error(fixpoint(void *, oinfo) H, void *receiver, void *arg, bool interpolation) {
  return !is_smi_w((uword)receiver) && !has_tag(H, receiver, LARGE_INTEGER_TAG) ? Program_WRONG_OBJECT_TYPE_INDEX :
    !is_smi_w((uword)arg) ? (has_tag(H, arg, LARGE_INTEGER_TAG) ? Program_OUT_OF_RANGE_INDEX : Program_WRONG_OBJECT_TYPE_INDEX) :
    smi_val((uword)arg) < INT_MIN || smi_val((uword)arg) > INT_MAX ? Program_OUT_OF_RANGE_INDEX :
    interpolation ? (smi_val((uword)arg) == 2 || smi_val((uword)arg) == 8 || smi_val((uword)arg) == 16 ? 0 : Program_INVALID_ARGUMENT_INDEX) :
    (2 <= smi_val((uword)arg) && smi_val((uword)arg) <= 36 ? 0 : Program_OUT_OF_RANGE_INDEX);
}
lemma void open_last_byte(uint8 *b, int n)
  requires uchars_(b, n, _) &*& n > 0;
  ensures uchars_(b, n-1, _) &*& uchar_(b+n-1, _);
{
  uchars__split(b, n-1);
  open uchars_(b+n-1, 1, _);
  open uchars_(b+n, 0, _);
}
@*/
@prototypes
@render src/primitive_core.cc toit::format_quotient
static uint64 format_quotient(uint64 value, int base)
//@ requires 2 <= base &*& base <= 36;
//@ ensures result == value / base;
//@ terminates;
{
  // Constant divisors let embedded targets use shifts or reciprocal multiplication.
  switch (base) {
    case 2: return value / 2;
    case 8: return value / 8;
    case 10: return value / 10;
    case 16: return value / 16;
    default: return value / base;
  }
}

@render src/primitive_core.cc toit::format_integer
static Object* format_integer(Process* process, int64 value, int base, bool unsigned_format)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*& 2 <= base &*& base <= 36; @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            format_result(prog, objs, H, objs2, H2, result, value, base, unsigned_format); @*/
{
  uint64 remaining;
  bool negative = value < 0 && !unsigned_format;
  if (value < 0) {
    uint64 complement = static_cast<uint64>(-(value + 1));
    remaining = negative ? complement + 1 : static_cast<uint64>(UINT64_MAX) - complement;
  } else {
    remaining = static_cast<uint64>(value);
  }
  // A 64-bit magnitude in base two and an optional minus sign.
  uint8 buffer[65];
  int start = sizeof(buffer);
  //@ close uchars(buffer + start, 0, nil);
  //@ nat_of_int_of_nat(N64);
  while (true)
    /*@ invariant 2 <= start &*& start <= 65 &*& uchars_(buffer, start, _) &*& uchars(buffer + start, 65-start, ?suffix) &*&
                  remaining < pow_nat(2, nat_of_int(start-1)) &*&
                  (remaining > 0 || suffix == nil) &*& read_digits(base, suffix, remaining) == format_magnitude(value, unsigned_format); @*/
    //@ decreases start;
  {
    //@ succ_int(start - 2);
    //@ pow2_pos(nat_of_int(start - 2));
    //@ uint64 previous = remaining;
    //@ div_rem_nonneg(previous, base);
    //@ mul_mono_l(2, base, previous / base);
    //@ open_last_byte(buffer, start);
    uint64 quotient = format_quotient(remaining, base);
    int digit = static_cast<int>(remaining - quotient * base);
    remaining = quotient;
    start--;
    buffer[start] = digit < 10 ? '0' + digit : 'a' + (digit - 10);
    //@ close uchars(buffer+start, 65-start, cons(digit_byte(digit), suffix));
    //@ assert read_digits(base, cons(digit_byte(digit), suffix), remaining) == format_magnitude(value, unsigned_format);
    if (remaining == 0) break;
  }
  //@ assert uchars(buffer+start, 65-start, ?digits);
  if (negative) {
    //@ open_last_byte(buffer, start);
    start--;
    buffer[start] = '-';
    //@ close uchars(buffer+start, 65-start, cons(45, digits));
  }
  //@ assert uchars(buffer+start, 65-start, ?bytes);
  //@ assert bytes == (negative ? cons(45, digits) : digits);
  //@ close string_source(native_bytes(1, bytes), objs, H, buffer+start, 65-start);
  Object* result = process->allocate_string_or_error(reinterpret_cast<const char*>(buffer + start), sizeof(buffer) - start);
  //@ open string_source(native_bytes(1, bytes), objs, H, buffer+start, 65-start);
  //@ uchars_to_uchars_(buffer+start);
  //@ uchars__to_chars_(buffer);
  //@ uchars__to_chars_(buffer+start);
  //@ chars__join((char *)buffer);
  //@ chars__to_uchars_(buffer);
  //@ close exists(digits);
  //@ assert heap(?after, ?contents);
  //@ close format_result(prog, objs, H, after, contents, result, value, base, unsigned_format);
  return result;
}

@render src/primitive_core.cc toit::primitive_int64_to_string truncating
PRIMITIVE(int64_to_string)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*& pointer(__args, ?arg) &*& good(objs, arg) == true &*&
             pointer(__args - 1, ?radix) &*& good(objs, radix) == true; @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            pointer(__args, arg) &*& pointer(__args - 1, radix) &*&
            (radix_error(H, arg, radix, false) == 0 ?
              format_result(prog, objs, H, objs2, H2, result, format_arg(H, arg), smi_val((uword)radix), false) :
              objs2 == objs &*& H2 == H &*& (uword)result == 4 * radix_error(H, arg, radix, false) + 3); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ truncate_signed_limits(smi_val((uword)radix), N31);
  //@ if (INT_MIN <= smi_val((uword)radix) && smi_val((uword)radix) <= INT_MAX) truncate_signed_id(smi_val((uword)radix), N31);
  //@ close valid_arg(radix, objs);
  //@ leak valid_arg(radix, objs);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  //@ error_word(Program_INVALID_ARGUMENT_INDEX);
  ARGS(int64, value, int, base);
  if (!(2 <= base && base <= 36)) FAIL(OUT_OF_RANGE);
  return format_integer(process, value, base, false);
}

@render src/primitive_core.cc toit::primitive_uint64_to_string
PRIMITIVE(uint64_to_string)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*& pointer(__args, ?arg) &*& good(objs, arg) == true; @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            pointer(__args, arg) &*& ((is_smi_w((uword)arg) || has_tag(H, arg, LARGE_INTEGER_TAG)) ? format_result(prog, objs, H, objs2, H2, result, format_arg(H, arg), 10, true) :
              objs2 == objs &*& H2 == H &*& (uword)result == 4 * Program_WRONG_OBJECT_TYPE_INDEX + 3); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  ARGS(int64, value);
  return format_integer(process, value, 10, true);
}

@render src/primitive_core.cc toit::primitive_smi_to_string_base_10
