// Copyright (C) 2026 Toit contributors.
//
// The float writers of src/primitive_core.cc: put_float_32_little_endian
// and put_float_64_little_endian (ported to Rust; the C++ runs when the
// port declines: a copy-on-write destination not yet copied, an opaque
// byte array).
//
// Each decodes a MutableBlob first (the proven mutable_byte_content: a
// copy-on-write byte array may be copied), then the offset and the double
// in the grown heap (`valid_arg`). Proved: the memcpy writes 4 (8) bytes
// inside the destination's content (a writable byte array outside the
// program heap) from the float (double) local, no overflow or lossy
// conversion but the modular ones the C++ means (`unsigned-word-conversion`:
// a negative offset becomes a large unsigned one and is rejected), the
// primitive heap contract (`grows`) and the retry rule `oom_unchanged`.
// The double-to-float conversion is VeriFast's (math.h: defined for every
// double, as IEC 60559 makes it: an out-of-range value becomes an
// infinity); the bytes written are not modelled.
//
// Self-tests (run.sh): the end check of the 32-bit writer made two bytes
// weaker (the C++ check `offset + 4 >= length` is one byte stricter than
// needed, so one byte weaker still fits); the 64-bit writer's offset check
// left out.
@include ../model/model.cfg
@verbatim
#include <math.h>
#include "../model/objects.gen.h"
#include "../blob/mutable_byte_content.gen.h"
//@ #include <listex.gh>
//@ #include "../model/arith.gh"

// From VeriFast's bin/string.h, for the two sources these primitives copy
// from: a float or a double local (the bytes copied are not modelled).
void *memcpy(void *dest, void *src, size_t count);
/*@ requires uchars_(dest, count, _) &*&
             count == sizeof(float) ? float_(src, ?v) : count == sizeof(double) &*& double_(src, ?w); @*/
/*@ ensures uchars(dest, count, _) &*& result == dest &*&
            count == sizeof(float) ? float_(src, _) : double_(src, _); @*/

/*@
lemma void unsigned_of_signed(int x, nat n)
  requires -pow_nat(2, n) <= x &*& x < pow_nat(2, n);
  ensures truncate_unsigned(x, int_of_nat(n)) == (x < 0 ? x + pow_nat(2, n) : x);
{
  pow2_pos(n);
  truncate_unsigned_def(x, n);
  assert [_]divrem(x, pow_nat(2, n), ?q, ?r);
}

lemma void pow2_32()
  requires true;
  ensures pow_nat(2, N32) == 4294967296 &*& pow_nat(2, N64) == 18446744073709551616;
{
  assert pow_nat(2, N16) == 65536;
  assert pow_nat(2, N32) == 4294967296;
  assert pow_nat(2, N64) == 18446744073709551616;
}
@*/
@prototypes
@render src/objects.h toit::MutableBlob::MutableBlob tu=src/primitive_core.cc params=0
  MutableBlob() : address_(null), length_(0)
  //@ requires self->address_ |-> _ &*& self->length_ |-> _;
  //@ ensures self->address_ |-> 0 &*& self->length_ |-> 0;
  {}

@render src/objects.h toit::MutableBlob::address tu=src/primitive_core.cc
  uint8* address()
  //@ requires [?f]self->address_ |-> ?a;
  //@ ensures [f]self->address_ |-> a &*& result == a;
  { return address_; }

@render src/objects.h toit::MutableBlob::length tu=src/primitive_core.cc
  word length()
  //@ requires [?f]self->length_ |-> ?l;
  //@ ensures [f]self->length_ |-> l &*& result == l;
  { return length_; }

@render src/primitive_core.cc toit::primitive_put_float_32_little_endian unsigned-word-conversion
PRIMITIVE(put_float_32_little_endian)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x0) &*& pointer(__args - 1, ?x1) &*& pointer(__args - 2, ?x2) &*& pointer(__args - 3, ?x3) &*&
             good(objs, x1) && good(objs, x3); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_unchanged(prog, objs, H, objs2, H2, result) == true &*&
            pointer(__args, x0) &*& pointer(__args - 1, x1) &*& pointer(__args - 2, x2) &*& pointer(__args - 3, x3); @*/
{
  // The retry rule: the copy-on-write copy can be installed before a later
  // argument or the range check fails; those errors are not out-of-memory
  // ones (the loader's error roots).
  //@ process_program(process);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ immediate_error_not_oom(prog, Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ immediate_error_not_oom(prog, Program_OUT_OF_BOUNDS_INDEX);
  //@ close valid_arg(x3, objs);
  //@ leak valid_arg(x3, objs);
  ARGS(Object, unused, MutableBlob, dest, word, offset, double, value);
  //@ assert heap(?objs2, ?H2) &*& [_]mutable_result(objs2, H2, process, ?da, ?dl, ?bd);
  //@ open [_]mutable_result(objs2, H2, process, da, dl, bd);
  //@ blob_facts(bd);
  USE(unused);
  //@ pow2_32();
  //@ unsigned_of_signed(offset, sizeof(word) == 8 ? N64 : N32);
  uword unsigned_offset = offset;
  //@ unsigned_of_signed(dl, sizeof(word) == 8 ? N64 : N32);
  uword length = dest.length();
  //@ if (unsigned_offset <= length) unsigned_of_signed(unsigned_offset + 4, sizeof(word) == 8 ? N64 : N32);
  // We don't need to check for <0 on unsigned values.  Can't have integer
  // overflow when they are both constrained in size (assuming the byte
  // array can't be close to 4Gbytes large).
  if (unsigned_offset > length || unsigned_offset + 4 >= length) {
    FAIL(OUT_OF_BOUNDS);
  }
  float raw = value;
  //@ heap_holes_open();
  //@ blob_take(bd);
  //@ uint8 *db = blob_base(H2, bd);
  //@ uchars_split(db, (uword)da - (uword)db);
  //@ uchars_split(da, dl);
  //@ uchars_split(da, offset);
  //@ uchars_split(da + offset, 4);
  memcpy(dest.address() + offset, &raw, sizeof raw);
  //@ uchars_join(da + offset);
  //@ uchars_join(da);
  //@ uchars_join(da);
  //@ uchars_join(db);
  //@ blob_give(bd);
  //@ heap_holes_close();
  return process->null_object();
}

@render src/primitive_core.cc toit::primitive_put_float_64_little_endian unsigned-word-conversion
PRIMITIVE(put_float_64_little_endian)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x0) &*& pointer(__args - 1, ?x1) &*& pointer(__args - 2, ?x2) &*& pointer(__args - 3, ?x3) &*&
             good(objs, x1) && good(objs, x3); @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_unchanged(prog, objs, H, objs2, H2, result) == true &*&
            pointer(__args, x0) &*& pointer(__args - 1, x1) &*& pointer(__args - 2, x2) &*& pointer(__args - 3, x3); @*/
{
  //@ process_program(process);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ immediate_error_not_oom(prog, Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ immediate_error_not_oom(prog, Program_OUT_OF_BOUNDS_INDEX);
  //@ close valid_arg(x3, objs);
  //@ leak valid_arg(x3, objs);
  ARGS(Object, unused, MutableBlob, dest, word, offset, double, value);
  //@ assert heap(?objs2, ?H2) &*& [_]mutable_result(objs2, H2, process, ?da, ?dl, ?bd);
  //@ open [_]mutable_result(objs2, H2, process, da, dl, bd);
  //@ blob_facts(bd);
  USE(unused);
  //@ pow2_32();
  //@ unsigned_of_signed(offset, sizeof(word) == 8 ? N64 : N32);
  uword unsigned_offset = offset;
  //@ unsigned_of_signed(dl, sizeof(word) == 8 ? N64 : N32);
  uword length = dest.length();
  //@ if (unsigned_offset <= length) unsigned_of_signed(unsigned_offset + 8, sizeof(word) == 8 ? N64 : N32);
  // We don't need to check for <0 on unsigned values.  Can't have integer
  // overflow when they are both constrained in size (assuming the byte
  // array can't be close to 4Gbytes large).
  if (unsigned_offset > length || unsigned_offset + 8 >= length) {
    FAIL(OUT_OF_BOUNDS);
  }
  //@ heap_holes_open();
  //@ blob_take(bd);
  //@ uint8 *db = blob_base(H2, bd);
  //@ uchars_split(db, (uword)da - (uword)db);
  //@ uchars_split(da, dl);
  //@ uchars_split(da, offset);
  //@ uchars_split(da + offset, 8);
  memcpy(dest.address() + offset, &value, sizeof value);
  //@ uchars_join(da + offset);
  //@ uchars_join(da);
  //@ uchars_join(da);
  //@ uchars_join(db);
  //@ blob_give(bd);
  //@ heap_holes_close();
  return process->null_object();
}
