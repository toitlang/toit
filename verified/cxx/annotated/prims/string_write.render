//
// PRIMITIVE(string_write_to_byte_array) of src/primitive_core.cc, end to
// end: the PRIMITIVE and ARGS macros as the compiler expands them (the
// rendering is of the expansion: Blob, MutableBlob and word argument
// decoding, FAIL), the Blob accessors and constructors (objects.h), and
// the body, with VeriFast annotations.
//
// The Blob and MutableBlob arguments are decoded by the proven
// Object::byte_content and Object::mutable_byte_content (../blob): the
// source range lies in the content of a live string or byte array, the
// destination range in a writable byte array outside the program heap,
// both in the heap after the decoding (which may have grown it: a
// copy-on-write byte array made mutable). Proved: the primitive heap
// contract in VeriFast terms (the heap only grows, every object keeps its
// class and length), the copy stays inside the two contents, its use of
// memmove is legal (the two ranges may be in one byte array), no overflow
// or lossy conversion.
//
// Self-test (run.sh): af4ba7ab reverted (memcpy for the same byte array):
// no proof for overlapping ranges; with non-overlap assumed, it verifies.
@include ../model/model.cfg
@verbatim
#include "../model/objects.gen.h"
#include "blob_args.gen.h"
#include "../blob/mutable_byte_content.gen.h"
//@ #include <listex.gh>
//@ #include "../model/arith.gh"

/*@
// memmove: one region holding both ranges, or two separate chunks.
inductive mm_mode = mm_one(uint8 *base, int len) | mm_two;
predicate mm_pre(mm_mode m, uint8 *dst, uint8 *src, int n) =
  switch (m) {
    case mm_one(base, len):
      return uchars(base, len, ?bs) &*& base <= src &*& src + n <= base + len &*&
             base <= dst &*& dst + n <= base + len &*& 0 <= n;
    case mm_two:
      return uchars(src, n, ?cs) &*& uchars_(dst, n, _);
  };
predicate mm_post(mm_mode m, uint8 *dst, uint8 *src, int n) =
  switch (m) {
    case mm_one(base, len): return uchars(base, len, _);
    case mm_two: return uchars(src, n, ?cs) &*& uchars(dst, n, cs);
  };
@*/

void *memmove(void *dest, void *src, size_t count);
//@ requires mm_pre(?m, dest, src, count);
//@ ensures mm_post(m, dest, src, count) &*& result == dest;
// From VeriFast's bin/string.h (there: chars; uchars here), for the
// self-tests that put af4ba7ab's memcpy back (the mutable decoder's header
// no longer declares it, wave 9).
void *memcpy(void *array, void *array0, size_t count);
//@ requires uchars_(array, count, _) &*& [?f]uchars(array0, count, ?cs0);
//@ ensures uchars(array, count, cs0) &*& [f]uchars(array0, count, cs0) &*& result == array;
@prototypes
@render src/objects.h toit::MutableBlob::MutableBlob tu=src/primitive_core.cc params=0
  MutableBlob() : address_(null), length_(0)
  //@ requires self->address_ |-> _ &*& self->length_ |-> _;
  //@ ensures self->address_ |-> 0 &*& self->length_ |-> 0;
  {}

@render src/objects.h toit::MutableBlob::address tu=src/primitive_core.cc
  uint8* address()
  //@ requires [?f]self->address_ |-> ?a;
  //@ ensures [f]self->address_ |-> a &*& result == a;
  { return address_; }

@render src/objects.h toit::MutableBlob::length tu=src/primitive_core.cc
  word length()
  //@ requires [?f]self->length_ |-> ?l;
  //@ ensures [f]self->length_ |-> l &*& result == l;
  { return length_; }

@render src/primitive_core.cc toit::primitive_string_write_to_byte_array
PRIMITIVE(string_write_to_byte_array)
/*@ requires [?fp]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?a0) &*& pointer(__args - 1, ?a1) &*& pointer(__args - 2, ?a2) &*&
             pointer(__args - 3, ?a3) &*& pointer(__args - 4, ?a4) &*&
             good(objs, a0) == true &*& good(objs, a1) == true; @*/
/*@ ensures [fp]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& grows(objs, H, objs2, H2) == true &*&
            oom_unchanged(prog, objs, H, objs2, H2, result) == true &*&
            pointer(__args, a0) &*& pointer(__args - 1, a1) &*& pointer(__args - 2, a2) &*&
            pointer(__args - 3, a3) &*& pointer(__args - 4, a4); @*/
{
  //@ grows_refl(objs, H);
  // The retry rule: the destination's copy-on-write copy can be installed
  // (mutable_byte_content) before a later argument or range check fails;
  // those errors are not out-of-memory ones (the loader's error roots).
  //@ process_program(process);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  //@ immediate_error_not_oom(prog, Program_WRONG_OBJECT_TYPE_INDEX);
  //@ error_word(Program_OUT_OF_BOUNDS_INDEX);
  //@ immediate_error_not_oom(prog, Program_OUT_OF_BOUNDS_INDEX);
  //@ if (mem(a1, objs)) heap_facts(a1);
  ARGS(Blob, source_bytes, MutableBlob, dest, word, from, word, to, word, dest_index);
  //@ assert [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, ?sa, ?sl, ?bs);
  //@ assert heap(?objs2, ?H2) &*& [_]mutable_result(objs2, H2, process, ?da, ?dl, ?bd);
  //@ blob_result_grows(objs, H, objs2, H2, STRINGS_OR_BYTE_ARRAYS, sa, sl, bs);
  //@ open [_]blob_result(objs2, H2, STRINGS_OR_BYTE_ARRAYS, sa, sl, bs);
  //@ open [_]mutable_result(objs2, H2, process, da, dl, bd);
  if (to == from) return _raw_dest;
  if (from < 0 || to > source_bytes.length() || from > to) FAIL(OUT_OF_BOUNDS);
  if (dest_index < 0 || to - from > dest.length() - dest_index) FAIL(OUT_OF_BOUNDS);
  //@ blob_facts(bs);
  //@ blob_facts(bd);
  //@ heap_holes_open();
  //@ blob_take(bd);
  //@ if (bs != bd) blob_take(bs);
  //@ uint8 *d = da + dest_index;
  //@ uint8 *s = sa + from;
  //@ uint8 *sb = blob_base(H2, bs);
  //@ uint8 *db = blob_base(H2, bd);
  /*@
  if (bs == bd) {
    close mm_pre(mm_one(db, blob_len(H2, bd)), d, s, to - from);
  } else {
    uchars_split(sb, (uword)s - (uword)sb);
    uchars_split(s, to - from);
    uchars_split(db, (uword)d - (uword)db);
    uchars_split(d, to - from);
    close mm_pre(mm_two, d, s, to - from);
  }
  @*/
  // The source and the destination may be the same byte array.
  memmove(&dest.address()[dest_index], &source_bytes.address()[from], to - from);
  /*@
  if (bs == bd) {
    open mm_post(_, _, _, _);
  } else {
    open mm_post(_, _, _, _);
    uchars_join(s);
    uchars_join(sb);
    uchars_join(d);
    uchars_join(db);
    blob_give(bs);
  }
  @*/
  //@ blob_give(bd);
  //@ heap_holes_close();
  return _raw_dest;
}
