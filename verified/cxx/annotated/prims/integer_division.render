@verbatim
#include "integer.gen.h"
//@ #include "../model/arith.gh"

// The division-by-zero accessor returns the corresponding Program root.
// harness/division_error_root.cc checks the index and accessor on both word sizes.
//@ fixpoint void *division_error_root(Program *prog) { return nth(11, program_roots(prog)); }
String *Program_division_by_zero(Program *self);
//@ requires [_]program(self, ?ids);
//@ ensures result == division_error_root(self);

/*@
fixpoint int division_operand(fixpoint(void *, oinfo) H, void *v) {
  return is_smi_w((uword)v) ? smi_val((uword)v) : o_number(H(v));
}
fixpoint int division_value(int x, int y, bool rem) {
  return x == -9223372036854775808 && y == -1 ? (rem ? 0 : x) : rem ? x % y : x / y;
}
lemma void quotient_bounds(int x, int y)
  requires -9223372036854775808 <= x &*& x <= 9223372036854775807 &*& y != 0 &*& !(x == -9223372036854775808 && y == -1);
  ensures -9223372036854775808 <= x / y &*& x / y <= 9223372036854775807;
{
  div_rem(x, y);
  int q = x / y;
  if (y > 1) {
    if (q > 0) mul_mono_l(2, y, q);
    else mul_mono_l(2, y, -q);
  } else if (y < -1) {
    if (q > 0) mul_mono_l(y, -2, q);
    else mul_mono_l(y, -2, -q);
  }
}
fixpoint bool division_result(Program *prog, list<void *> objs, fixpoint(void *, oinfo) H,
                              list<void *> objs2, fixpoint(void *, oinfo) H2, bool large, bool rem,
                              void *x, void *y, void *result) {
  return (large ? !has_tag(H, x, LARGE_INTEGER_TAG) : !is_smi_w((uword)x)) ||
         (!is_smi_w((uword)y) && !has_tag(H, y, LARGE_INTEGER_TAG)) ?
    objs2 == objs && H2 == H && (uword)result == 4 * Program_WRONG_OBJECT_TYPE_INDEX + 3 :
    division_operand(H, y) == 0 ? objs2 == objs && H2 == H && (uword)result == ((uword)division_error_root(prog) | 3) :
    integer_result(prog, objs, H, objs2, H2, division_value(division_operand(H, x), division_operand(H, y), rem), result);
}
@*/
@prototypes

@render src/primitive_core.cc toit::primitive_smi_divide
PRIMITIVE(smi_divide)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x) &*& pointer(__args - 1, ?y) &*& good(objs, x) == true &*& good(objs, y) == true; @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& pointer(__args, x) &*& pointer(__args - 1, y) &*&
            grows(objs, H, objs2, H2) == true &*& division_result(prog, objs, H, objs2, H2, false, false, x, y, result) == true; @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  ARGS(word, receiver, Object, arg);
  if (is_smi(arg)) {
    word other = Smi::value(arg);
    if (other == 0) return Primitive::mark_as_error(process->program()->division_by_zero());
    // MIN_SMI / -1 is not a smi; Primitive::integer promotes it.
    //@ quotient_bounds(receiver, other);
    return Primitive::integer((int64) receiver / other, process);
  }
  if (!is_large_integer(arg)) FAIL(WRONG_OBJECT_TYPE);
  int64 other = LargeInteger::cast(arg)->value();
  if (other == 0) return Primitive::mark_as_error(process->program()->division_by_zero());
  //@ quotient_bounds(receiver, other);
  return Primitive::integer((int64) receiver / other, process);
}

@render src/primitive_core.cc toit::primitive_smi_mod
PRIMITIVE(smi_mod)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x) &*& pointer(__args - 1, ?y) &*& good(objs, x) == true &*& good(objs, y) == true; @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& pointer(__args, x) &*& pointer(__args - 1, y) &*&
            grows(objs, H, objs2, H2) == true &*& division_result(prog, objs, H, objs2, H2, false, true, x, y, result) == true; @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  ARGS(word, receiver, Object, arg);
  if (is_smi(arg)) {
    word other = Smi::value(arg);
    if (other == 0) return Primitive::mark_as_error(process->program()->division_by_zero());
    //@ div_rem(receiver, other);
    return Smi::from(receiver % other);
  }
  if (!is_large_integer(arg)) FAIL(WRONG_OBJECT_TYPE);
  int64 other = LargeInteger::cast(arg)->value();
  if (other == 0) return Primitive::mark_as_error(process->program()->division_by_zero());
  //@ div_rem(receiver, other);
  return Primitive::integer((int64) receiver % other, process);
}

@render src/primitive_core.cc toit::wrapping_negate
static int64 wrapping_negate(int64 value)
//@ requires true;
//@ ensures result == (value == -9223372036854775808 ? value : -value);
{
  return value == INT64_MIN ? value : -value;
}

@render src/primitive_core.cc toit::primitive_large_integer_divide
PRIMITIVE(large_integer_divide)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x) &*& pointer(__args - 1, ?y) &*& good(objs, x) == true &*& good(objs, y) == true; @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& pointer(__args, x) &*& pointer(__args - 1, y) &*&
            grows(objs, H, objs2, H2) == true &*& division_result(prog, objs, H, objs2, H2, true, false, x, y, result) == true; @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  ARGS(LargeInteger, receiver, Object, arg);
  int64 result = receiver->value();
  int64 divisor;
  if (is_smi(arg)) {
    divisor = Smi::value(arg);
  } else if (is_large_integer(arg)) {
    divisor = LargeInteger::cast(arg)->value();
  } else FAIL(WRONG_OBJECT_TYPE);
  if (divisor == 0) return Primitive::mark_as_error(process->program()->division_by_zero());
  //@ if (divisor != -1) quotient_bounds(result, divisor); else div_rem(result, divisor);
  result = (divisor == -1) ? wrapping_negate(result) : result / divisor;
  return Primitive::integer(result, process);
}

@render src/primitive_core.cc toit::primitive_large_integer_mod
PRIMITIVE(large_integer_mod)
/*@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*&
             pointer(__args, ?x) &*& pointer(__args - 1, ?y) &*& good(objs, x) == true &*& good(objs, y) == true; @*/
/*@ ensures [f]process(process, prog, ids) &*& heap(?objs2, ?H2) &*& pointer(__args, x) &*& pointer(__args - 1, y) &*&
            grows(objs, H, objs2, H2) == true &*& division_result(prog, objs, H, objs2, H2, true, true, x, y, result) == true; @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_WRONG_OBJECT_TYPE_INDEX);
  ARGS(LargeInteger, receiver, Object, arg);
  int64 result = receiver->value();
  int64 divisor;
  if (is_smi(arg)) {
    divisor = Smi::value(arg);
  } else if (is_large_integer(arg)) {
    divisor = LargeInteger::cast(arg)->value();
  } else FAIL(WRONG_OBJECT_TYPE);
  if (divisor == 0) return Primitive::mark_as_error(process->program()->division_by_zero());
  //@ div_rem(result, divisor);
  result = (divisor == -1) ? static_cast<int64>(0) : result % divisor;
  return Primitive::integer(result, process);
}
