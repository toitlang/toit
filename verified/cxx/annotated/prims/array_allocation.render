@include ../model/model.cfg
@header array_allocation.gen.h
@verbatim
#include "integer.gen.h"
//@ #include "../model/arith.gh"

// The Program root accessor and its index are checked by the ESBMC root harness.
//@ fixpoint void *empty_array_root(Program *prog) { return nth(3, program_roots(prog)); }
Array *Program_empty_array(Program *self);
//@ requires [_]program(self, ?ids);
//@ ensures result == empty_array_root(self);

/*@
fixpoint bool filled_array_result(Program *prog, list<void *> objs, fixpoint(void *, oinfo) H,
                                  list<void *> after, fixpoint(void *, oinfo) H2,
                                  int length, void *filler, void *result) {
  return (uword)result % 4 == 3 ?
    (uword)result == ((uword)root_allocation_failed(prog) | 3) && after == objs && H2 == H :
    after == cons(result, objs) && !mem(result, objs) && has_tag(H2, result, ARRAY_TAG) &&
      o_len(H2(result)) == length && all_eq(o_words(H2(result)), filler) && forall(objs, (same_obj)(H, H2));
}
@*/
@prototypes
@render src/primitive.cc toit::Primitive::allocate_array
Object* Primitive::allocate_array(word length, Object* filler, Process* process)
//@ requires [?f]process(process, ?prog, ?ids) &*& heap(?objs, ?H) &*& good(objs, filler) == true;
/*@ ensures [f]process(process, prog, ids) &*& heap(?after, ?H2) &*& grows(objs, H, after, H2) == true &*&
            (length < 0 || length > PROCESS_ARRAY_LIMIT ? after == objs && H2 == H && (uword)result == 4 * Program_OUT_OF_RANGE_INDEX + 3 :
             length == 0 ? after == objs && H2 == H && (empty_array_root(prog) != 0 ? result == empty_array_root(prog) :
               (uword)result == ((uword)root_allocation_failed(prog) | 3)) :
             filled_array_result(prog, objs, H, after, H2, length, filler, result) == true); @*/
{
  //@ grows_refl(objs, H);
  //@ error_word(Program_OUT_OF_RANGE_INDEX);
  if (length < 0 || length > Array::max_length_in_process()) FAIL(OUT_OF_RANGE);
  Object* result = length == 0 ? process->program()->empty_array() :process->object_heap()->allocate_array(length, filler);
  //@ if (length != 0) { open allocated(objs, H, process, result, ?objs1, ?H1); if (result != 0) grows_alloc(objs, H, result, H1); }
  if (result != null) return result;
  return mark_as_error(process->program()->allocation_failed());
}
