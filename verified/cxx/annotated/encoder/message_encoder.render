// Copyright (C) 2026 Toit contributors.
//
// The message encoder of src/messaging.cc and messaging.h (MessageEncoder
// and TisonEncoder): encode_any, encode_array, encode_list, encode_map,
// encode_copy, encode_byte_array (transfers and their deduplication), the
// buffer writers, the size checks, reserve_external and TisonEncoder::encode
// (and the NestingTracker), rendered from the sources over the object model
// of ../model, with VeriFast annotations.
//
// Property: for any heap that satisfies the object model (every reference
// is a live object of the right layout; field VALUES arbitrary: sizes,
// bounds, backings are whatever a program stored), the encoder reads only
// inside objects (memory safety), has no signed overflow or lossy
// conversion, and does not change the heap (it holds only a fraction of
// it, given back unchanged). The counters stay below the size limit plus
// ENC_SLACK (`enc_out`): no overflow of cursor_ or external_bytes_ on
// either width. The tables of out-of-line data (copied_, transferred_) are
// written below their bounds (reserve_external). In the write pass every
// write lies in the buffer, under ONE assumption: `two_pass_room` (the
// write pass writes no further than the size pass counted; README, "The
// two-pass assumption"). Unbounded: any heap, any sizes, any nesting.
//
// Self-tests (run.sh): f708ad5d (encoder bounds) reverted; the size limit
// and the blob check of the 32-bit overflow fix taken out; the external
// table bound taken out.
@include ../model/model.cfg
@raii NestingTracker
@raii HeapTagScope
// The custom heap tags are negative numbers in a uword (src/os.h).
@modular-arguments HeapTagScope::HeapTagScope
@verbatim
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "../utf8/validator.gen.h"
#include "../model/byte_array_ownership.gen.h"
#include "../blob/byte_content.gen.h"
#include "cardinal.h"
//@ #include "../model/arith.gh"
//@ #include "../model/llong.gh"

// ---------------------------------------------------------------------------
// The encoder's state: the fields of src/messaging.h (TisonEncoder's
// payload_size_ included: the two classes are one struct here, as the
// derived-to-base conversions are not written). The nesting counter is
// outside the predicates: the NestingTracker holds its address.

typedef int MessageFormat;
struct PrimitivePolicy;
typedef struct PrimitivePolicy PrimitivePolicy;

struct MessageEncoder {
  Process *process_;
  Program *program_;
  MessageFormat format_;
  uint8 *buffer_;
  bool take_ownership_of_buffer_;
  word cursor_;
  word external_bytes_;
  int nesting_;
  int problematic_class_id_;
  bool nesting_too_deep_;
  bool too_many_externals_;
  bool too_large_;
  bool over_limit_;
  word max_total_size_;
  bool malloc_failed_;
  unsigned externals_count_;
  unsigned copied_count_;
  void *copied_[MESSAGING_ENCODING_MAX_EXTERNALS];
  unsigned transferred_count_;
  ByteArray *transferred_[MESSAGING_ENCODING_MAX_EXTERNALS];
  unsigned payload_size_;
};
typedef struct MessageEncoder MessageEncoder;
typedef struct MessageEncoder TisonEncoder;

struct NestingTracker {
  int *nesting_;
};
typedef struct NestingTracker NestingTracker;

struct HeapTagScope {
  uword old;
};
typedef struct HeapTagScope HeapTagScope;

// The most bytes written between two size checks: a tag, a cardinal and a
// pointer (an out-of-line blob), or the TISON marker and payload size.
#define ENC_SLACK 32

/*@
// The output (cursor_, external_bytes_ and, in the write pass, the buffer
// of cap bytes). The sizes stay below the limit plus ENC_SLACK.
predicate enc_buf(uint8 *b, int cap;) = b == 0 ? true : uchars_(b, cap, _);

predicate enc_out(MessageEncoder *e, int cap; int c, int x) =
  e->buffer_ |-> ?b &*& enc_buf(b, cap) &*& 0 <= cap &*&
  e->cursor_ |-> c &*& e->external_bytes_ |-> x &*&
  0 <= c &*& 0 <= x &*& c + x <= MESSAGING_ENCODING_MAX_SIZE + ENC_SLACK;

// The tables of out-of-line data: every entry is one reserved external;
// `reserved` externals are reserved but not entered yet.
predicate enc_tables(MessageEncoder *e, int reserved;) =
  e->externals_count_ |-> ?k &*& e->copied_count_ |-> ?cc &*& e->transferred_count_ |-> ?tc &*&
  k <= MESSAGING_ENCODING_MAX_EXTERNALS &*& cc + tc + reserved <= k &*&
  pointers(e->copied_, MESSAGING_ENCODING_MAX_EXTERNALS, _) &*&
  pointers(e->transferred_, MESSAGING_ENCODING_MAX_EXTERNALS, _);

predicate encoder(MessageEncoder *e; prog_ids ids) =
  e->program_ |-> ?p &*& [_]program(p, ids) &*& prog_ok(ids) == true &*&
  e->process_ |-> ?proc &*& e->format_ |-> ?fmt &*&
  e->nesting_too_deep_ |-> _ &*& e->problematic_class_id_ |-> _ &*& e->too_many_externals_ |-> _ &*&
  e->too_large_ |-> ?tl &*& e->over_limit_ |-> ?ol &*& e->max_total_size_ |-> ?mts &*& e->malloc_failed_ |-> _ &*&
  enc_tables(e, 0);

// After reserve_external: one external reserved.
predicate encoder_res(MessageEncoder *e; prog_ids ids) =
  e->program_ |-> ?p &*& [_]program(p, ids) &*& prog_ok(ids) == true &*&
  e->process_ |-> ?proc &*& e->format_ |-> ?fmt &*&
  e->nesting_too_deep_ |-> _ &*& e->problematic_class_id_ |-> _ &*& e->too_many_externals_ |-> _ &*&
  e->too_large_ |-> ?tl &*& e->over_limit_ |-> ?ol &*& e->max_total_size_ |-> ?mts &*& e->malloc_failed_ |-> _ &*&
  enc_tables(e, 1);

lemma void encoder_facts(MessageEncoder *e)
  requires encoder(e, ?ids);
  ensures encoder(e, ids) &*& prog_ok(ids) == true;
{
  open encoder(e, ids);
  close encoder(e, ids);
}

// A reservation that is not used (a failure after reserve_external).
lemma void encoder_unreserve(MessageEncoder *e)
  requires encoder_res(e, ?ids);
  ensures encoder(e, ids);
{
  open encoder_res(e, ids);
  open enc_tables(e, 1);
  close enc_tables(e, 0);
  close encoder(e, ids);
}

// THE TWO-PASS ASSUMPTION (README, "The two-pass assumption"; CONTRACTS.toml
// [[assumption]] two_pass_room). The callers run the encoder twice on the
// same heap: a size pass without a buffer, then a write pass into a buffer
// of the size the size pass returned (cap). The write pass makes the same
// decisions (the heap and the encoder's inputs are the same; it stops
// earlier, never later: its only extra failures are malloc failures, and
// TISON's payload size is written before the payload instead of after, so
// its sizes are ahead by at most that cardinal), so it writes no further
// than the size pass counted. Not proved: that needs a ghost encoding
// length shown equal in both passes.
lemma void two_pass_room(MessageEncoder *e, int n);
  requires [?f1]e->buffer_ |-> ?b &*& [?f2]enc_buf(b, ?cap) &*& [?f3]e->cursor_ |-> ?c &*& 0 <= n;
  ensures [f1]e->buffer_ |-> b &*& [f2]enc_buf(b, cap) &*& [f3]e->cursor_ |-> c &*& (b == 0 || c + n <= cap);

// A write of n bytes at offset c of the buffer: the range taken out, and
// put back written.
lemma void buf_take(uint8 *b, int c, int n)
  requires uchars_(b, ?cap, _) &*& 0 <= c &*& 0 <= n &*& c + n <= cap;
  ensures uchars_(b, c, _) &*& uchars_(b + c, n, _) &*& uchars_(b + c + n, cap - c - n, _);
{
  uchars__split(b, c);
  uchars__split(b + c, n);
}

lemma void buf_give(uint8 *b, int c, int n)
  requires uchars_(b, c, _) &*& chars((void *)(b + c), n, _) &*& uchars_(b + c + n, ?r, _);
  ensures uchars_(b, c + n + r, _);
{
  uchars__to_chars_(b);
  uchars__to_chars_(b + c + n);
  chars_chars__join((void *)(b + c));
  chars__join((void *)b);
  chars__to_uchars_(b);
}

// Every byte array's content length is in [0, MAX_BLOB].
lemma void byte_array_len(void *o)
  requires [?f]heap(?objs, ?H) &*& mem(o, objs) == true &*& has_tag(H, o, BYTE_ARRAY_TAG) == true;
  ensures [f]heap(objs, H) &*& 0 <= blob_len(H, o) &*& blob_len(H, o) <= MAX_BLOB;
{
  byte_array_open(o);
  open [f]byte_array_body(o, o_len(H(o)), o_aux(H(o)));
  close [f]byte_array_body(o, o_len(H(o)), o_aux(H(o)));
  byte_array_close(o);
}
@*/

// The checks of the policy (src/process.h, primitive_policy.h): reads of
// the process outside the object model.
PrimitivePolicy *Process_policy(Process *self);
//@ requires true;
//@ ensures true;
bool PrimitivePolicy_restricts_messaging(PrimitivePolicy *self);
//@ requires true;
//@ ensures true;

// src/os.h HeapTagScope: sets and restores the malloc tag of the thread
// (contract only: the OS layer).
void HeapTagScope_ctor(HeapTagScope *self, uword tag);
//@ requires self->old |-> _;
//@ ensures self->old |-> _;
void HeapTagScope_dtor(HeapTagScope *self);
//@ requires self->old |-> _;
//@ ensures self->old |-> _;

// src/utils.h bit_cast (memcpy of the value).
uint64 bit_cast_uint64__double(double src);
//@ requires true;
//@ ensures true;
// The template instance for int64: `long` on LP64, `long long` on ILP32.
uint64 bit_cast_uint64__long(int64 src);
//@ requires true;
//@ ensures true;
uint64 bit_cast_uint64__longlong(int64 src);
//@ requires true;
//@ ensures true;

@prototypes
@render src/messaging.cc toit::NestingTracker::NestingTracker
  NestingTracker(int* nesting) : nesting_(nesting)
  //@ requires self->nesting_ |-> _ &*& integer(nesting, ?n) &*& INT_MIN <= n &*& n < INT_MAX;
  //@ ensures self->nesting_ |-> nesting &*& integer(nesting, n + 1);
  {
    (*nesting)++;
  }

@render src/messaging.cc toit::NestingTracker::~NestingTracker
  ~NestingTracker()
  //@ requires self->nesting_ |-> ?p &*& integer(p, ?n) &*& INT_MIN < n &*& n <= INT_MAX;
  //@ ensures self->nesting_ |-> p &*& integer(p, n - 1);
  {
    (*nesting_)--;
  }

@render src/messaging.h toit::MessageEncoder::size tu=src/messaging.cc
  word size() const
  //@ requires [?f]enc_out(self, ?cap, ?c, ?x);
  //@ ensures [f]enc_out(self, cap, c, x) &*& result == c;
  {
    //@ open [f]enc_out(self, cap, c, x);
    return cursor_;
    //@ close [f]enc_out(self, cap, c, x);
  }

@render src/messaging.h toit::MessageEncoder::total_size tu=src/messaging.cc
  word total_size() const
  //@ requires [?f]enc_out(self, ?cap, ?c, ?x);
  //@ ensures [f]enc_out(self, cap, c, x) &*& result == c + x &*& 0 <= c &*& 0 <= x;
  {
    //@ open [f]enc_out(self, cap, c, x);
    return cursor_ + external_bytes_;
    //@ close [f]enc_out(self, cap, c, x);
  }

@render src/messaging.h toit::MessageEncoder::encoding_for_size tu=src/messaging.cc
  bool encoding_for_size() const
  //@ requires [?f]self->buffer_ |-> ?b;
  //@ ensures [f]self->buffer_ |-> b &*& result == (b == 0);
  { return buffer_ == null; }

@render src/messaging.h toit::MessageEncoder::encoding_tison tu=src/messaging.cc
  bool encoding_tison() const
  //@ requires [?f]encoder(self, ?ids);
  //@ ensures [f]encoder(self, ids);
  {
    //@ open [f]encoder(self, ids);
    return format_ == MESSAGE_FORMAT_TISON;
    //@ close [f]encoder(self, ids);
  }

@render src/messaging.h toit::TisonEncoder::payload_size tu=src/messaging.cc
  unsigned payload_size() const
  //@ requires [?f]self->payload_size_ |-> ?p;
  //@ ensures [f]self->payload_size_ |-> p &*& result == p;
  { return payload_size_; }

@render src/messaging.h toit::MessageEncoder::is_too_large tu=src/messaging.cc
  bool is_too_large()
  //@ requires encoder(self, ?ids) &*& enc_out(self, ?cap, ?c, ?x);
  //@ ensures encoder(self, ids) &*& enc_out(self, cap, c, x) &*& (result || c + x <= MESSAGING_ENCODING_MAX_SIZE);
  {
    //@ open encoder(self, ids);
    if (total_size() > MESSAGING_ENCODING_MAX_SIZE) too_large_ = true;
    //@ open enc_out(self, cap, c, x);
    if (max_total_size_ > 0 && cursor_ + external_bytes_ > max_total_size_) over_limit_ = true;
    return too_large_ || over_limit_;
    //@ close enc_out(self, cap, c, x);
    //@ close encoder(self, ids);
  }

@render src/messaging.h toit::MessageEncoder::write_uint8 tu=src/messaging.cc
  void write_uint8(uint8 value)
  //@ requires enc_out(self, ?cap, ?c, ?x) &*& c + x + 1 <= MESSAGING_ENCODING_MAX_SIZE + ENC_SLACK;
  //@ ensures enc_out(self, cap, c + 1, x);
  {
    //@ open enc_out(self, cap, c, x);
    //@ two_pass_room(self, 1);
    //@ open enc_buf(?b, cap);
    if (!encoding_for_size()) buffer_[cursor_] = value;
    cursor_++;
    //@ close enc_buf(b, cap);
    //@ close enc_out(self, cap, c + 1, x);
  }

@render src/messaging.cc toit::MessageEncoder::write_cardinal
void MessageEncoder::write_cardinal(uword value)
//@ requires enc_out(self, ?cap, ?c, ?x) &*& c + x + 10 <= MESSAGING_ENCODING_MAX_SIZE + ENC_SLACK;
//@ ensures enc_out(self, cap, ?c1, x) &*& c < c1 &*& c1 <= c + 10;
{
  //@ int k = 0;
  while (value >= 128)
  //@ invariant enc_out(self, cap, c + k, x) &*& 0 <= k &*& k <= 9 &*& value <= UINTPTR_MAX / p128(k);
  {
    //@ div_rem_nonneg(value, 128);
    //@ cardinal_step(value, k);
    write_uint8((uint8) (value % 128 + 128));
    //@ shiftright_div(value, succ(succ(succ(succ(succ(succ(succ(zero))))))));
    value >>= 7;
    //@ k++;
  }
  write_uint8((uint8) value);
}

@render src/messaging.cc toit::MessageEncoder::write_pointer
void MessageEncoder::write_pointer(void* value)
//@ requires enc_out(self, ?cap, ?c, ?x) &*& c + x + WORD_SIZE <= MESSAGING_ENCODING_MAX_SIZE + ENC_SLACK;
//@ ensures enc_out(self, cap, c + WORD_SIZE, x);
{
  //@ open enc_out(self, cap, c, x);
  //@ two_pass_room(self, WORD_SIZE);
  //@ open enc_buf(?b, cap);
  //@ if (b != 0) buf_take(b, c, WORD_SIZE);
  if (!encoding_for_size()) memcpy(&buffer_[cursor_], &value, WORD_SIZE);
  //@ if (b != 0) { chars_to_pointer(&value); buf_give(b, c, WORD_SIZE); }
  cursor_ += WORD_SIZE;
  //@ close enc_buf(b, cap);
  //@ close enc_out(self, cap, c + WORD_SIZE, x);
}

@render src/messaging.cc toit::MessageEncoder::write_uint32
void MessageEncoder::write_uint32(uint32 value)
//@ requires enc_out(self, ?cap, ?c, ?x) &*& c + x + 4 <= MESSAGING_ENCODING_MAX_SIZE + ENC_SLACK;
//@ ensures enc_out(self, cap, c + 4, x);
{
  //@ open enc_out(self, cap, c, x);
  //@ two_pass_room(self, 4);
  //@ open enc_buf(?b, cap);
  //@ if (b != 0) buf_take(b, c, 4);
  if (!encoding_for_size()) memcpy(&buffer_[cursor_], &value, sizeof(uint32));
  //@ if (b != 0) { chars_to_u_integer(&value); buf_give(b, c, 4); }
  cursor_ += sizeof(uint32);
  //@ close enc_buf(b, cap);
  //@ close enc_out(self, cap, c + 4, x);
}

@render src/messaging.cc toit::MessageEncoder::write_uint64
void MessageEncoder::write_uint64(uint64 value)
//@ requires enc_out(self, ?cap, ?c, ?x) &*& c + x + 8 <= MESSAGING_ENCODING_MAX_SIZE + ENC_SLACK;
//@ ensures enc_out(self, cap, c + 8, x);
{
  //@ open enc_out(self, cap, c, x);
  //@ two_pass_room(self, 8);
  //@ open enc_buf(?b, cap);
  //@ if (b != 0) buf_take(b, c, 8);
  if (!encoding_for_size()) memcpy(&buffer_[cursor_], &value, sizeof(uint64));
  //@ if (b != 0) { chars_to_integer_(&value, 8, false); close u_llong_integer(&value, _); buf_give(b, c, 8); }
  cursor_ += sizeof(uint64);
  //@ close enc_buf(b, cap);
  //@ close enc_out(self, cap, c + 8, x);
}

@render src/messaging.cc toit::MessageEncoder::reserve_external
bool MessageEncoder::reserve_external()
//@ requires encoder(self, ?ids);
//@ ensures result ? encoder_res(self, ids) : encoder(self, ids);
{
  //@ open encoder(self, ids);
  //@ open enc_tables(self, 0);
  if (externals_count_ >= MESSAGING_ENCODING_MAX_EXTERNALS) {
    too_many_externals_ = true;
    //@ close enc_tables(self, 0);
    //@ close encoder(self, ids);
    return false;
  }
  externals_count_++;
  //@ close enc_tables(self, 1);
  //@ close encoder_res(self, ids);
  return true;
}

@render src/messaging.cc toit::MessageEncoder::encode_copy
bool MessageEncoder::encode_copy(Object* object, int tag)
/*@ requires encoder(self, ?ids) &*& enc_out(self, ?cap, ?c, ?x) &*& c + x <= MESSAGING_ENCODING_MAX_SIZE &*&
             [?f]heap(?objs, ?H) &*& good(objs, object) == true &*& (tag == TAG_STRING || tag == TAG_BYTE_ARRAY); @*/
//@ ensures encoder(self, ids) &*& enc_out(self, cap, ?c1, ?x1) &*& c <= c1 &*& [f]heap(objs, H);
{
  ASSERT(tag == TAG_STRING || tag == TAG_BYTE_ARRAY);
  ASSERT(TAG_STRING_INLINE == TAG_STRING + 1);
  ASSERT(TAG_BYTE_ARRAY_INLINE == TAG_BYTE_ARRAY + 1);

  const uint8* source;
  word length = 0;
  //@ open encoder(self, ids);
  if (!object->byte_content(program_, &source, &length, STRINGS_OR_BYTE_ARRAYS)) {
    //@ close encoder(self, ids);
    // TODO(kasper): Report meaningful error.
    return false;
  }
  //@ assert [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, ?a, ?l, ?bl);
  //@ open [_]blob_result(objs, H, STRINGS_OR_BYTE_ARRAYS, a, l, bl);
  //@ blob_facts(bl);
  //@ uint8 *base = blob_base(H, bl);
  //@ heap_holes_open();
  //@ blob_take(bl);
  //@ if (a != base) uchars_split(base, (uword)a - (uword)base);
  //@ uchars_split(a, l);
  // A sandboxed program can hold strings that aren't valid UTF-8 (crafted
  // literals, or string slices with crafted bounds), and the receiver
  // relies on its strings being valid.
  if (tag == TAG_STRING && process_ != null && process_->policy()->restricts_messaging() &&
      !Utils::is_valid_utf_8(source, length)) {
    //@ uchars_join(a);
    //@ if (a != base) uchars_join(base);
    //@ blob_give(bl);
    //@ heap_holes_close();
    //@ close encoder(self, ids);
    return false;
  }
  //@ uchars_join(a);
  //@ if (a != base) uchars_join(base);
  //@ blob_give(bl);
  //@ heap_holes_close();
  //@ close encoder(self, ids);
  // The content goes into the encoding or out of line: check it against
  // what is left, so that the sizes can't overflow a 32-bit word.
  if (length > MESSAGING_ENCODING_MAX_SIZE - total_size()) {
    //@ open encoder(self, ids);
    too_large_ = true;
    //@ close encoder(self, ids);
    return false;
  }

  // To avoid too many small allocations, we inline the content of the small strings or byte arrays.
  if (encoding_tison() || length <= MESSAGING_ENCODING_MAX_INLINED_SIZE) {
    write_uint8(tag + 1);
    write_cardinal(length);
    //@ open enc_out(self, cap, ?c2, x);
    //@ two_pass_room(self, l);
    //@ open enc_buf(?b, cap);
    if (!encoding_for_size()) {
      //@ heap_holes_open();
      //@ blob_take(bl);
      //@ if (a != base) uchars_split(base, (uword)a - (uword)base);
      //@ uchars_split(a, l);
      //@ buf_take(b, c2, l);
      memcpy(&buffer_[cursor_], source, length);
      //@ buf_give(b, c2, l);
      //@ chars_to_uchars(a);
      //@ uchars_join(a);
      //@ if (a != base) uchars_join(base);
      //@ blob_give(bl);
      //@ heap_holes_close();
    }
    cursor_ += length;
    //@ close enc_buf(b, cap);
    //@ close enc_out(self, cap, c2 + l, x);
    return true;
  }

  ASSERT(!encoding_tison());
  // Reserve during the size pass too. Check before malloc so quota failure
  // cannot leak an allocation that has not entered the cleanup table yet.
  if (!reserve_external()) return false;
  //@ open enc_out(self, cap, c, x);
  external_bytes_ += length;
  //@ close enc_out(self, cap, c, x + l);
  void* data = null;
  //@ open enc_out(self, cap, c, x + l);
  //@ assert self->buffer_ |-> ?b;
  if (!encoding_for_size()) {
    //@ close enc_out(self, cap, c, x + l);
    // Strings are '\0'-terminated, so we need to make sure the allocated
    // memory is big enough for that.
    int extra = (tag == TAG_STRING) ? 1 : 0;
    int heap_tag = (tag == TAG_STRING) ? EXTERNAL_STRING_MALLOC_TAG : EXTERNAL_BYTE_ARRAY_MALLOC_TAG;
    HeapTagScope scope(ITERATE_CUSTOM_TAGS + heap_tag);
    data = malloc(length + extra);
    if (data == null) {
      //@ open encoder_res(self, ids);
      malloc_failed_ = true;
      //@ close encoder_res(self, ids);
      //@ encoder_unreserve(self);
      return false;
    }
    //@ open encoder_res(self, ids);
    //@ open enc_tables(self, 1);
    copied_[copied_count_++] = data;
    //@ close enc_tables(self, 0);
    //@ close encoder(self, ids);
    //@ heap_holes_open();
    //@ blob_take(bl);
    //@ if (a != base) uchars_split(base, (uword)a - (uword)base);
    //@ uchars_split(a, l);
    // A string slice's content isn't followed by a '\0' (and a crafted
    // slice can wrap a byte array): copy the content and terminate it.
    memcpy(data, source, length);
    //@ chars_to_uchars(a);
    //@ uchars_join(a);
    //@ if (a != base) uchars_join(base);
    //@ blob_give(bl);
    //@ heap_holes_close();
    //@ if (extra != 0) chars__to_uchars_((uint8 *)data + l);
    if (extra != 0) static_cast<uint8*>(data)[length] = 0;
    // The copy is owned by the table copied_ (freed by the destructor, or
    // by the receiver after take_buffer): not modelled.
    //@ leak malloc_block(data, _) &*& chars(data, l, _);
    //@ if (extra != 0) leak u_character((uint8 *)data + l, _);
  }
  //@ if (b == 0) { close enc_out(self, cap, c, x + l); encoder_unreserve(self); }
  write_uint8(tag);
  write_cardinal(length);
  write_pointer(data);
  return true;
}

@render src/messaging.cc toit::MessageEncoder::encode_byte_array
bool MessageEncoder::encode_byte_array(ByteArray* object)
/*@ requires encoder(self, ?ids) &*& enc_out(self, ?cap, ?c, ?x) &*& c + x <= MESSAGING_ENCODING_MAX_SIZE &*&
             [?f]heap(?objs, ?H) &*& has_tag(H, object, BYTE_ARRAY_TAG) == true &*& mem(object, objs) == true; @*/
//@ ensures encoder(self, ids) &*& enc_out(self, cap, ?c1, ?x1) &*& c <= c1 &*& [f]heap(objs, H);
{
  if (encoding_tison() || !object->has_owned_external_memory()) {
    return encode_copy(object, TAG_BYTE_ARRAY);
  }

  //@ open encoder(self, ids);
  //@ open enc_tables(self, 0);
  // A repeated reference must not give two decoded arrays ownership of the
  // same allocation. Copy subsequent occurrences before the first transfer
  // is committed and the original array is neutered.
  for (unsigned i = 0; i < transferred_count_; i++)
  /*@ invariant self->program_ |-> ?p &*& [_]program(p, ids) &*& prog_ok(ids) == true &*&
        self->process_ |-> ?proc &*& self->format_ |-> ?fmt &*&
        self->nesting_too_deep_ |-> _ &*& self->problematic_class_id_ |-> _ &*& self->too_many_externals_ |-> _ &*&
        self->too_large_ |-> ?tl &*& self->over_limit_ |-> ?ol &*& self->max_total_size_ |-> ?mts &*& self->malloc_failed_ |-> _ &*&
        self->externals_count_ |-> ?k &*& self->copied_count_ |-> ?cc &*& self->transferred_count_ |-> ?tc &*&
        k <= MESSAGING_ENCODING_MAX_EXTERNALS &*& cc + tc <= k &*&
        pointers(self->copied_, MESSAGING_ENCODING_MAX_EXTERNALS, _) &*&
        pointers(self->transferred_, MESSAGING_ENCODING_MAX_EXTERNALS, _) &*&
        enc_out(self, cap, c, x) &*& [f]heap(objs, H) &*& 0 <= i; @*/
  {
    if (transferred_[i] == object)
      //@ close enc_tables(self, 0);
      //@ close encoder(self, ids);
      return encode_copy(object, TAG_BYTE_ARRAY);
  }
  //@ close enc_tables(self, 0);
  //@ close encoder(self, ids);

  ASSERT(!encoding_tison());
  if (!reserve_external()) return false;
  ByteArray::Bytes bytes(object);
  //@ byte_array_len(object);
  if (bytes.length() > MESSAGING_ENCODING_MAX_SIZE - total_size()) {
    //@ encoder_unreserve(self);
    //@ open encoder(self, ids);
    too_large_ = true;
    //@ close encoder(self, ids);
    return false;
  }
  //@ open enc_out(self, cap, c, x);
  external_bytes_ += bytes.length();
  //@ close enc_out(self, cap, c, x + blob_len(H, object));
  write_uint8(TAG_BYTE_ARRAY);
  write_cardinal(bytes.length());
  write_pointer(bytes.address());
  //@ open encoder_res(self, ids);
  //@ open enc_tables(self, 1);
  transferred_[transferred_count_++] = object;
  //@ close enc_tables(self, 0);
  //@ close encoder(self, ids);
  return true;
}

@render src/messaging.cc toit::TisonEncoder::encode
bool TisonEncoder::encode(Object* object)
/*@ requires encoder(self, ?ids) &*& enc_out(self, ?cap, 0, 0) &*& self->payload_size_ |-> ?ps &*& self->nesting_ |-> 0 &*&
             [?f]heap(?objs, ?H) &*& good(objs, object) == true; @*/
//@ ensures encoder(self, ids) &*& enc_out(self, cap, ?c1, ?x1) &*& self->payload_size_ |-> _ &*& self->nesting_ |-> 0 &*& [f]heap(objs, H);
{
  ASSERT(encoding_tison());
  //@ shiftleft_def(1, succ(succ(succ(succ(succ(succ(succ(succ(zero)))))))));
  uint32 marker = TISON_MARKER | (TISON_VERSION << TISON_VERSION_SHIFT);
  write_uint32(marker);
  //@ open enc_out(self, cap, 4, 0);
  if (!encoding_for_size()) {
    //@ close enc_out(self, cap, 4, 0);
    ASSERT(payload_size() > 0);
    write_cardinal(payload_size());
    //@ open enc_out(self, cap, _, 0);
  }
  //@ close enc_out(self, cap, _, 0);
  bool result = encode_any(object);
  if (!result || is_too_large()) return false;
  // Compute the number of bytes we need to encode the payload size.
  // Later, when we're not encoding for size, we know the payload size
  // and will encode this before the payload.
  //@ open enc_out(self, cap, ?c2, ?x2);
  if (encoding_for_size()) {
    //@ close enc_out(self, cap, c2, x2);
    uword payload_size = size() - sizeof(uint32);
    ASSERT(payload_size > 0 && payload_size_ == 0);
    // Make the payload size available to the outside.
    payload_size_ = payload_size;
    // Encode the payload size, so the full size is correct.
    write_cardinal(payload_size);
    //@ open enc_out(self, cap, _, x2);
  }
  //@ close enc_out(self, cap, _, x2);
  return true;
}

@render src/messaging.cc toit::MessageEncoder::encode_any
bool MessageEncoder::encode_any(Object* object)
//@ requires encoder(self, ?ids) &*& enc_out(self, ?cap, ?c, ?x) &*& self->nesting_ |-> ?n &*& 0 <= n &*& n <= MESSAGING_ENCODING_MAX_NESTING &*& [?f]heap(?objs, ?H) &*& good(objs, object) == true;
//@ ensures encoder(self, ids) &*& enc_out(self, cap, ?c1, ?x1) &*& c <= c1 &*& self->nesting_ |-> n &*& [f]heap(objs, H);
{
  NestingTracker tracking(&nesting_);
  if (nesting_ > MESSAGING_ENCODING_MAX_NESTING) {
    //@ open encoder(self, ids);
    nesting_too_deep_ = true;
    //@ close encoder(self, ids);
    return false;
  }
  if (is_too_large()) return false;

  if (is_smi(object)) {
    encode_smi(object);
    return true;
  }

  //@ good_mem(objs, object);
  //@ encoder_facts(self);
  //@ open encoder(self, ids);
  Program* program = program_;
  //@ close encoder(self, ids);
  if (is_instance(object)) {
    Instance* instance = Instance::cast(object);
    Smi* class_id = instance->class_id();
    //@ heap_facts(instance);
    if (class_id == program->list_class_id()) {
      Object* size = instance->at(Instance::LIST_SIZE_INDEX);
      if (!is_smi(size)) return false;
      return encode_list(instance, 0, Smi::value(size));
    } else if (class_id == program->list_slice_class_id()) {
      return encode_list_slice(instance);
    } else if (class_id == program->map_class_id()) {
      return encode_map(instance);
    } else if (class_id == program->byte_array_cow_class_id()) {
      return encode_copy(object, TAG_BYTE_ARRAY);
    } else if (class_id == program->byte_array_slice_class_id()) {
      return encode_copy(object, TAG_BYTE_ARRAY);
    } else if (class_id == program->string_byte_slice_class_id()) {
      return encode_copy(object, TAG_BYTE_ARRAY);
    } else if (class_id == program->string_slice_class_id()) {
      return encode_copy(object, TAG_STRING);
    } else {
      //@ open encoder(self, ids);
      problematic_class_id_ = Smi::value(class_id);
      //@ close encoder(self, ids);
    }
  } else if (object == program->null_object()) {
    write_uint8(TAG_NULL);
    return true;
  } else if (object == program->true_object()) {
    write_uint8(TAG_TRUE);
    return true;
  } else if (object == program->false_object()) {
    write_uint8(TAG_FALSE);
    return true;
  } else if (is_byte_array(object)) {
    return encode_byte_array(ByteArray::cast(object));
  } else if (is_double(object)) {
    write_uint8(TAG_DOUBLE);
    write_uint64(bit_cast<uint64>(Double::cast(object)->value()));
    return true;
  } else if (is_string(object)) {
    return encode_copy(object, TAG_STRING);
  } else if (is_array(object)) {
    Array* array = Array::cast(object);
    return encode_array(array, 0, array->length());
  } else if (is_large_integer(object)) {
    write_uint8(TAG_LARGE_INTEGER);
    write_uint64(bit_cast<uint64>(LargeInteger::cast(object)->value()));
    return true;
  } else if (is_heap_object(object)) {
    if (!encoding_tison()) {
      printf("[message encoder: cannot encode object with class tag = %d]\n", HeapObject::cast(object)->class_tag());
    }
  }
  return false;
}

@render src/messaging.cc toit::MessageEncoder::encode_smi
void MessageEncoder::encode_smi(Object* object)
//@ requires enc_out(self, ?cap, ?c, ?x) &*& c + x <= MESSAGING_ENCODING_MAX_SIZE &*& is_smi_w((uword)object) == true;
//@ ensures enc_out(self, cap, ?c1, x) &*& c < c1;
{
  word value = Smi::value(object);
  if (value >= 0) {
    write_uint8(TAG_POSITIVE_SMI);
    write_cardinal(value);
  } else {
    write_uint8(TAG_NEGATIVE_SMI);
    write_cardinal(-value);
  }
}

@render src/messaging.cc toit::MessageEncoder::encode_array
bool MessageEncoder::encode_array(Array* object, word from, word to)
//@ requires encoder(self, ?ids) &*& enc_out(self, ?cap, ?c, ?x) &*& c + x <= MESSAGING_ENCODING_MAX_SIZE &*& self->nesting_ |-> ?n &*& 0 <= n &*& n <= MESSAGING_ENCODING_MAX_NESTING &*& [?f]heap(?objs, ?H) &*& mem(object, objs) == true &*& has_tag(H, object, ARRAY_TAG) == true &*& smi_range(from) == true &*& smi_range(to) == true;
//@ ensures encoder(self, ids) &*& enc_out(self, cap, ?c1, ?x1) &*& c <= c1 &*& self->nesting_ |-> n &*& [f]heap(objs, H);
{
  if (from < 0 || from > to || to > object->length()) return false;
  // The receiver can't decode an array longer than a process heap holds (a
  // crafted program can have one in its program heap).
  if (to - from > Array::max_length_in_process()) return false;
  write_uint8(TAG_ARRAY);
  write_cardinal(to - from);
  for (word i = from; i < to; i++)
  //@ invariant encoder(self, ids) &*& enc_out(self, cap, ?ci, ?xi) &*& c <= ci &*& self->nesting_ |-> n &*& [f]heap(objs, H) &*& from <= i &*& to <= o_len(H(object));
  {
    if (!encode_any(object->at(i))) return false;
  }
  return true;
}

@render src/messaging.cc toit::MessageEncoder::encode_list_slice
bool MessageEncoder::encode_list_slice(Instance* instance)
//@ requires encoder(self, ?ids) &*& enc_out(self, ?cap, ?c, ?x) &*& c + x <= MESSAGING_ENCODING_MAX_SIZE &*& self->nesting_ |-> ?n &*& 0 <= n &*& n <= MESSAGING_ENCODING_MAX_NESTING &*& [?f]heap(?objs, ?H) &*& mem(instance, objs) == true &*& has_tag(H, instance, INSTANCE_TAG) == true &*& header_cid(o_hw(H(instance))) == list_slice_cid(ids);
//@ ensures encoder(self, ids) &*& enc_out(self, cap, ?c1, ?x1) &*& c <= c1 &*& self->nesting_ |-> n &*& [f]heap(objs, H);
{
  //@ encoder_facts(self);
  //@ heap_facts(instance);
  Object* from_object = instance->at(Instance::LIST_SLICE_FROM_INDEX);
  Object* to_object = instance->at(Instance::LIST_SLICE_TO_INDEX);
  if (!is_smi(from_object) || !is_smi(to_object)) return false;
  word from = Smi::value(from_object);
  word to = Smi::value(to_object);
  Object* backing_object = instance->at(Instance::LIST_SLICE_LIST_INDEX);
  if (is_array(backing_object)) {
    //@ good_heap(objs, backing_object);
    Array* backing = Array::cast(backing_object);
    return encode_array(backing, from, to);
  } else if (is_instance(backing_object)) {
    //@ good_heap(objs, backing_object);
    Instance* backing = Instance::cast(backing_object);
    Smi* backing_class_id = backing->class_id();
    //@ open encoder(self, ids);
    if (backing_class_id != program_->list_class_id()) {
      problematic_class_id_ = Smi::value(backing_class_id);
      //@ close encoder(self, ids);
      return false;
    }
    //@ close encoder(self, ids);
    return encode_list(backing, from, to);
  } else {
    return false;
  }
}

@render src/messaging.cc toit::MessageEncoder::encode_list
bool MessageEncoder::encode_list(Instance* instance, word from, word to)
//@ requires encoder(self, ?ids) &*& enc_out(self, ?cap, ?c, ?x) &*& c + x <= MESSAGING_ENCODING_MAX_SIZE &*& self->nesting_ |-> ?n &*& 0 <= n &*& n <= MESSAGING_ENCODING_MAX_NESTING &*& [?f]heap(?objs, ?H) &*& mem(instance, objs) == true &*& has_tag(H, instance, INSTANCE_TAG) == true &*& header_cid(o_hw(H(instance))) == list_cid(ids) &*& smi_range(from) == true &*& smi_range(to) == true;
//@ ensures encoder(self, ids) &*& enc_out(self, cap, ?c1, ?x1) &*& c <= c1 &*& self->nesting_ |-> n &*& [f]heap(objs, H);
{
  //@ encoder_facts(self);
  //@ heap_facts(instance);
  Object* size = instance->at(Instance::LIST_SIZE_INDEX);
  if (!is_smi(size) || to > Smi::value(size)) return false;
  Object* backing = instance->at(Instance::LIST_ARRAY_INDEX);
  if (is_smi(backing)) return false;
  //@ good_mem(objs, backing);
  Smi* class_id = HeapObject::cast(backing)->class_id();
  //@ heap_facts(backing);
  //@ open encoder(self, ids);
  if (class_id == program_->array_class_id()) {
    //@ close encoder(self, ids);
    Array* array = Array::cast(backing);
    return encode_array(array, from, to);
  } else if (class_id == program_->large_array_class_id()) {
    //@ close encoder(self, ids);
    if (!encoding_tison()) {
      printf("[message encoder: cannot encode large array]\n");
    }
    //@ open encoder(self, ids);
  }
  //@ close encoder(self, ids);
  return false;
}

@render src/messaging.cc toit::MessageEncoder::encode_map
bool MessageEncoder::encode_map(Instance* instance)
//@ requires encoder(self, ?ids) &*& enc_out(self, ?cap, ?c, ?x) &*& c + x <= MESSAGING_ENCODING_MAX_SIZE &*& self->nesting_ |-> ?n &*& 0 <= n &*& n <= MESSAGING_ENCODING_MAX_NESTING &*& [?f]heap(?objs, ?H) &*& mem(instance, objs) == true &*& has_tag(H, instance, INSTANCE_TAG) == true &*& header_cid(o_hw(H(instance))) == map_cid(ids);
//@ ensures encoder(self, ids) &*& enc_out(self, cap, ?c1, ?x1) &*& c <= c1 &*& self->nesting_ |-> n &*& [f]heap(objs, H);
{
  write_uint8(TAG_MAP);

  //@ encoder_facts(self);
  //@ heap_facts(instance);
  Object* object = instance->at(Instance::MAP_BACKING_INDEX);
  if (is_smi(object)) return false;
  //@ good_mem(objs, object);
  HeapObject* backing = HeapObject::cast(object);

  object = instance->at(Instance::MAP_SIZE_INDEX);
  if (!is_smi(object)) return false;
  word size = Smi::value(object);
  if (size < 0) return false;
  // Nor a map whose backing is longer than that.
  if (size > Array::max_length_in_process() / 2) return false;

  write_cardinal(size);
  if (size == 0) return true;
  word limit = -1;
  Smi* class_id = backing->class_id();
  //@ heap_facts(backing);
  //@ open encoder(self, ids);
  if (class_id == program_->list_class_id()) {
    //@ close encoder(self, ids);
    Instance* list = Instance::cast(backing);
    object = list->at(Instance::LIST_SIZE_INDEX);
    if (!is_smi(object)) return false;
    limit = Smi::value(object);
    if (limit < 0) return false;
    object = list->at(Instance::LIST_ARRAY_INDEX);
    if (is_smi(object)) return false;
    //@ good_mem(objs, object);
    backing = HeapObject::cast(object);
    //@ open encoder(self, ids);
  }
  //@ close encoder(self, ids);
  class_id = backing->class_id();
  //@ heap_facts(backing);
  //@ open encoder(self, ids);
  if (class_id != program_->array_class_id()) {
    if (class_id == program_->large_array_class_id()) {
      printf("[message encoder: cannot encode large map]\n");
    }
    //@ close encoder(self, ids);
    return false;
  }
  //@ close encoder(self, ids);
  Array* array = Array::cast(backing);
  if (limit < 0) {
    limit = array->length();
  } else if (limit > array->length()) {
    return false;
  }
  word count = 0;
  for (word i = 0; count < size && i + 1 < limit; i += 2)
  //@ invariant encoder(self, ids) &*& enc_out(self, cap, ?ci, ?xi) &*& c <= ci &*& self->nesting_ |-> n &*& [f]heap(objs, H) &*& 0 <= i &*& i <= o_len(H(array)) + 1 &*& 0 <= count &*& count <= size &*& limit <= o_len(H(array));
  {
    Object* key = array->at(i);
    Object* value = array->at(i + 1);
    //@ if (!is_smi_w((uword)key)) good_mem(objs, key);
    if (is_smi(key) || HeapObject::cast(key)->class_id() != program_->tombstone_class_id()) {
      if (!encode_any(key)) return false;
      if (!encode_any(value)) return false;
      count++;
    }
  }
  return count == size;
}
