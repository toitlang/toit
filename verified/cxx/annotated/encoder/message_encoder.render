//
// MessageEncoder::encode_any, encode_array, encode_list and encode_map of
// src/messaging.cc (and the NestingTracker they use), rendered from the
// sources over the object model of ../model, with VeriFast annotations.
//
// Property: for any heap that satisfies the object model (every reference
// is a live object of the right layout; field VALUES arbitrary: sizes,
// bounds, backings are whatever a program stored), the encoder reads only
// inside objects (memory safety), has no signed overflow or lossy
// conversion, and does not change the heap (it holds only a fraction of
// it, given back unchanged). Unbounded: any heap, any sizes, any nesting.
//
// The f708ad5d self-test (run.sh) re-renders this from a copy of
// messaging.cc with the commit's three checks taken out.
@include ../model/model.cfg
@raii NestingTracker
@verbatim
#include <stdio.h>
#include "../model/objects.gen.h"

// ---------------------------------------------------------------------------
// The program's roots (src/program.h, generated by macros there): trusted
// accessors.

struct Program;
typedef struct Program Program;

//@ predicate program(Program *p; prog_ids ids);

Smi *Program_array_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids) &*& result == smi_ptr(array_cid(ids));
Smi *Program_list_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids) &*& result == smi_ptr(list_cid(ids));
Smi *Program_list_slice_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids) &*& result == smi_ptr(list_slice_cid(ids));
Smi *Program_map_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids) &*& result == smi_ptr(map_cid(ids));
Smi *Program_large_array_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids) &*& result == smi_ptr(large_array_cid(ids));
Smi *Program_tombstone_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids) &*& result == smi_ptr(tombstone_cid(ids));
// The other classes the encoder tests for: their ids, any values.
Smi *Program_byte_array_cow_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids);
Smi *Program_byte_array_slice_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids);
Smi *Program_string_byte_slice_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids);
Smi *Program_string_slice_class_id(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids);
// null_object, true_object, false_object: only compared, never read.
HeapObject *Program_null_object(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids);
HeapObject *Program_true_object(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids);
HeapObject *Program_false_object(Program *self);
//@ requires [?f]program(self, ?ids);
//@ ensures [f]program(self, ids);

// ---------------------------------------------------------------------------
// The encoder's state: the fields the rendered functions use (src/
// messaging.h); the output buffer and its counters are the abstract
// `encoder_buffer`. The nesting counter is outside the predicate: the
// NestingTracker holds its address.

struct MessageEncoder {
  Program *program_;
  int nesting_;
  int problematic_class_id_;
  bool nesting_too_deep_;
};
typedef struct MessageEncoder MessageEncoder;

struct NestingTracker {
  int *nesting_;
};
typedef struct NestingTracker NestingTracker;

/*@
predicate encoder_buffer(MessageEncoder *e;);

predicate encoder(MessageEncoder *e; prog_ids ids) =
  e->program_ |-> ?p &*& [_]program(p, ids) &*& prog_ok(ids) == true &*&
  e->nesting_too_deep_ |-> _ &*& e->problematic_class_id_ |-> _ &*&
  encoder_buffer(e);

lemma void encoder_facts(MessageEncoder *e)
  requires encoder(e, ?ids);
  ensures encoder(e, ids) &*& prog_ok(ids) == true;
{
  open encoder(e, ids);
  close encoder(e, ids);
}
@*/

// The writers and checks of src/messaging.h and messaging.cc (bounds of the
// output buffer: not in scope, see README "Trusted").
void MessageEncoder_write_uint8(MessageEncoder *self, uint8 value);
//@ requires encoder(self, ?ids);
//@ ensures encoder(self, ids);
void MessageEncoder_write_cardinal(MessageEncoder *self, uword value);
//@ requires encoder(self, ?ids);
//@ ensures encoder(self, ids);
void MessageEncoder_write_uint64(MessageEncoder *self, uint64 value);
//@ requires encoder(self, ?ids);
//@ ensures encoder(self, ids);
bool MessageEncoder_is_too_large(MessageEncoder *self);
//@ requires encoder(self, ?ids);
//@ ensures encoder(self, ids);
bool MessageEncoder_encoding_tison(MessageEncoder *self);
//@ requires encoder(self, ?ids);
//@ ensures encoder(self, ids);

// The leaves that copy blobs (encode_copy, encode_byte_array): assumed to
// read only the given object.
bool MessageEncoder_encode_copy(MessageEncoder *self, Object *object, int tag);
//@ requires encoder(self, ?ids) &*& [?f]heap(?objs, ?H) &*& mem(object, objs) == true;
//@ ensures encoder(self, ids) &*& [f]heap(objs, H);
bool MessageEncoder_encode_byte_array(MessageEncoder *self, ByteArray *object);
//@ requires encoder(self, ?ids) &*& [?f]heap(?objs, ?H) &*& has_tag(H, object, BYTE_ARRAY_TAG) == true &*& mem(object, objs) == true;
//@ ensures encoder(self, ids) &*& [f]heap(objs, H);

// src/utils.h bit_cast (memcpy of the value).
uint64 bit_cast_uint64__double(double src);
//@ requires true;
//@ ensures true;
// The template instance for int64: `long` on LP64, `long long` on ILP32.
uint64 bit_cast_uint64__long(int64 src);
//@ requires true;
//@ ensures true;
uint64 bit_cast_uint64__longlong(int64 src);
//@ requires true;
//@ ensures true;

@prototypes
@render src/messaging.cc toit::NestingTracker::NestingTracker
  NestingTracker(int* nesting) : nesting_(nesting)
  //@ requires self->nesting_ |-> _ &*& integer(nesting, ?n) &*& INT_MIN <= n &*& n < INT_MAX;
  //@ ensures self->nesting_ |-> nesting &*& integer(nesting, n + 1);
  {
    (*nesting)++;
  }

@render src/messaging.cc toit::NestingTracker::~NestingTracker
  ~NestingTracker()
  //@ requires self->nesting_ |-> ?p &*& integer(p, ?n) &*& INT_MIN < n &*& n <= INT_MAX;
  //@ ensures self->nesting_ |-> p &*& integer(p, n - 1);
  {
    (*nesting_)--;
  }

@render src/messaging.cc toit::MessageEncoder::encode_any
bool MessageEncoder::encode_any(Object* object)
//@ requires encoder(self, ?ids) &*& self->nesting_ |-> ?n &*& 0 <= n &*& n <= MESSAGING_ENCODING_MAX_NESTING &*& [?f]heap(?objs, ?H) &*& good(objs, object) == true;
//@ ensures encoder(self, ids) &*& self->nesting_ |-> n &*& [f]heap(objs, H);
{
  NestingTracker tracking(&nesting_);
  if (nesting_ > MESSAGING_ENCODING_MAX_NESTING) {
    //@ open encoder(self, ids);
    nesting_too_deep_ = true;
    //@ close encoder(self, ids);
    return false;
  }
  if (is_too_large()) return false;

  if (is_smi(object)) {
    word value = Smi::value(object);
    if (value >= 0) {
      write_uint8(TAG_POSITIVE_SMI);
      write_cardinal(value);
    } else {
      write_uint8(TAG_NEGATIVE_SMI);
      write_cardinal(-value);
    }
    return true;
  }

  //@ good_mem(objs, object);
  //@ encoder_facts(self);
  //@ open encoder(self, ids);
  Program* program = program_;
  //@ close encoder(self, ids);
  if (is_instance(object)) {
    Instance* instance = Instance::cast(object);
    Smi* class_id = instance->class_id();
    //@ heap_facts(instance);
    if (class_id == program->list_class_id()) {
      Object* size = instance->at(Instance::LIST_SIZE_INDEX);
      if (!is_smi(size)) return false;
      return encode_list(instance, 0, Smi::value(size));
    } else if (class_id == program->list_slice_class_id()) {
      Object* from_object = instance->at(Instance::LIST_SLICE_FROM_INDEX);
      Object* to_object = instance->at(Instance::LIST_SLICE_TO_INDEX);
      if (!is_smi(from_object) || !is_smi(to_object)) return false;
      word from = Smi::value(from_object);
      word to = Smi::value(to_object);
      Object* backing_object = instance->at(Instance::LIST_SLICE_LIST_INDEX);
      if (is_array(backing_object)) {
        //@ good_heap(objs, backing_object);
        Array* backing = Array::cast(backing_object);
        return encode_array(backing, from, to);
      } else if (is_instance(backing_object)) {
        //@ good_heap(objs, backing_object);
        Instance* backing = Instance::cast(backing_object);
        Smi* backing_class_id = backing->class_id();
        if (backing_class_id != program->list_class_id()) {
          //@ open encoder(self, ids);
          problematic_class_id_ = Smi::value(backing_class_id);
          //@ close encoder(self, ids);
          return false;
        }
        return encode_list(backing, from, to);
      } else {
        return false;
      }
    } else if (class_id == program->map_class_id()) {
      return encode_map(instance);
    } else if (class_id == program->byte_array_cow_class_id()) {
      return encode_copy(object, TAG_BYTE_ARRAY);
    } else if (class_id == program->byte_array_slice_class_id()) {
      return encode_copy(object, TAG_BYTE_ARRAY);
    } else if (class_id == program->string_byte_slice_class_id()) {
      return encode_copy(object, TAG_BYTE_ARRAY);
    } else if (class_id == program->string_slice_class_id()) {
      return encode_copy(object, TAG_STRING);
    } else {
      //@ open encoder(self, ids);
      problematic_class_id_ = Smi::value(class_id);
      //@ close encoder(self, ids);
    }
  } else if (object == program->null_object()) {
    write_uint8(TAG_NULL);
    return true;
  } else if (object == program->true_object()) {
    write_uint8(TAG_TRUE);
    return true;
  } else if (object == program->false_object()) {
    write_uint8(TAG_FALSE);
    return true;
  } else if (is_byte_array(object)) {
    return encode_byte_array(ByteArray::cast(object));
  } else if (is_double(object)) {
    write_uint8(TAG_DOUBLE);
    write_uint64(bit_cast<uint64>(Double::cast(object)->value()));
    return true;
  } else if (is_string(object)) {
    return encode_copy(object, TAG_STRING);
  } else if (is_array(object)) {
    Array* array = Array::cast(object);
    return encode_array(array, 0, array->length());
  } else if (is_large_integer(object)) {
    write_uint8(TAG_LARGE_INTEGER);
    write_uint64(bit_cast<uint64>(LargeInteger::cast(object)->value()));
    return true;
  } else if (is_heap_object(object)) {
    if (!encoding_tison()) {
      printf("[message encoder: cannot encode object with class tag = %d]\n", HeapObject::cast(object)->class_tag());
    }
  }
  return false;
}

@render src/messaging.cc toit::MessageEncoder::encode_array
bool MessageEncoder::encode_array(Array* object, word from, word to)
//@ requires encoder(self, ?ids) &*& self->nesting_ |-> ?n &*& 0 <= n &*& n <= MESSAGING_ENCODING_MAX_NESTING &*& [?f]heap(?objs, ?H) &*& mem(object, objs) == true &*& has_tag(H, object, ARRAY_TAG) == true &*& smi_range(from) == true &*& smi_range(to) == true;
//@ ensures encoder(self, ids) &*& self->nesting_ |-> n &*& [f]heap(objs, H);
{
  if (from < 0 || from > to || to > object->length()) return false;
  write_uint8(TAG_ARRAY);
  write_cardinal(to - from);
  for (word i = from; i < to; i++)
  //@ invariant encoder(self, ids) &*& self->nesting_ |-> n &*& [f]heap(objs, H) &*& from <= i &*& to <= o_len(H(object));
  {
    if (!encode_any(object->at(i))) return false;
  }
  return true;
}

@render src/messaging.cc toit::MessageEncoder::encode_list
bool MessageEncoder::encode_list(Instance* instance, word from, word to)
//@ requires encoder(self, ?ids) &*& self->nesting_ |-> ?n &*& 0 <= n &*& n <= MESSAGING_ENCODING_MAX_NESTING &*& [?f]heap(?objs, ?H) &*& mem(instance, objs) == true &*& has_tag(H, instance, INSTANCE_TAG) == true &*& header_cid(o_hw(H(instance))) == list_cid(ids) &*& smi_range(from) == true &*& smi_range(to) == true;
//@ ensures encoder(self, ids) &*& self->nesting_ |-> n &*& [f]heap(objs, H);
{
  //@ encoder_facts(self);
  //@ heap_facts(instance);
  Object* size = instance->at(Instance::LIST_SIZE_INDEX);
  if (!is_smi(size) || to > Smi::value(size)) return false;
  Object* backing = instance->at(Instance::LIST_ARRAY_INDEX);
  if (is_smi(backing)) return false;
  //@ good_mem(objs, backing);
  Smi* class_id = HeapObject::cast(backing)->class_id();
  //@ heap_facts(backing);
  //@ open encoder(self, ids);
  if (class_id == program_->array_class_id()) {
    //@ close encoder(self, ids);
    Array* array = Array::cast(backing);
    return encode_array(array, from, to);
  } else if (class_id == program_->large_array_class_id()) {
    //@ close encoder(self, ids);
    if (!encoding_tison()) {
      printf("[message encoder: cannot encode large array]\n");
    }
    //@ open encoder(self, ids);
  }
  //@ close encoder(self, ids);
  return false;
}

@render src/messaging.cc toit::MessageEncoder::encode_map
bool MessageEncoder::encode_map(Instance* instance)
//@ requires encoder(self, ?ids) &*& self->nesting_ |-> ?n &*& 0 <= n &*& n <= MESSAGING_ENCODING_MAX_NESTING &*& [?f]heap(?objs, ?H) &*& mem(instance, objs) == true &*& has_tag(H, instance, INSTANCE_TAG) == true &*& header_cid(o_hw(H(instance))) == map_cid(ids);
//@ ensures encoder(self, ids) &*& self->nesting_ |-> n &*& [f]heap(objs, H);
{
  write_uint8(TAG_MAP);

  //@ encoder_facts(self);
  //@ heap_facts(instance);
  Object* object = instance->at(Instance::MAP_BACKING_INDEX);
  if (is_smi(object)) return false;
  //@ good_mem(objs, object);
  HeapObject* backing = HeapObject::cast(object);

  object = instance->at(Instance::MAP_SIZE_INDEX);
  if (!is_smi(object)) return false;
  word size = Smi::value(object);
  if (size < 0) return false;

  write_cardinal(size);
  if (size == 0) return true;
  word limit = -1;
  Smi* class_id = backing->class_id();
  //@ heap_facts(backing);
  //@ open encoder(self, ids);
  if (class_id == program_->list_class_id()) {
    //@ close encoder(self, ids);
    Instance* list = Instance::cast(backing);
    object = list->at(Instance::LIST_SIZE_INDEX);
    if (!is_smi(object)) return false;
    limit = Smi::value(object);
    if (limit < 0) return false;
    object = list->at(Instance::LIST_ARRAY_INDEX);
    if (is_smi(object)) return false;
    //@ good_mem(objs, object);
    backing = HeapObject::cast(object);
    //@ open encoder(self, ids);
  }
  //@ close encoder(self, ids);
  class_id = backing->class_id();
  //@ heap_facts(backing);
  //@ open encoder(self, ids);
  if (class_id != program_->array_class_id()) {
    if (class_id == program_->large_array_class_id()) {
      printf("[message encoder: cannot encode large map]\n");
    }
    //@ close encoder(self, ids);
    return false;
  }
  //@ close encoder(self, ids);
  Array* array = Array::cast(backing);
  if (limit < 0) {
    limit = array->length();
  } else if (limit > array->length()) {
    return false;
  }
  word count = 0;
  for (word i = 0; count < size && i + 1 < limit; i += 2)
  //@ invariant encoder(self, ids) &*& self->nesting_ |-> n &*& [f]heap(objs, H) &*& 0 <= i &*& i <= o_len(H(array)) + 1 &*& 0 <= count &*& count <= size &*& limit <= o_len(H(array));
  {
    Object* key = array->at(i);
    Object* value = array->at(i + 1);
    //@ if (!is_smi_w((uword)key)) good_mem(objs, key);
    if (is_smi(key) || HeapObject::cast(key)->class_id() != program_->tombstone_class_id()) {
      if (!encode_any(key)) return false;
      if (!encode_any(value)) return false;
      count++;
    }
  }
  return count == size;
}
