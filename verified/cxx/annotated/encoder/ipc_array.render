//
// The same contract applies to the sizing and writing traversal. The
// observer checks each call against the original array. Its child failure
// index can be any integer (outside the slice means every child succeeds).
@include ../model/model.cfg
@verbatim
#include <stdio.h>
#include "../model/objects.gen.h"
struct MessageEncoder { Program *program_; int format_; int problematic_class_id_; };
typedef struct MessageEncoder MessageEncoder;

/*@
fixpoint void *list_backing(fixpoint(void *, oinfo) H, void *list) {
  return nth(Instance_LIST_ARRAY_INDEX, o_words(H(list)));
}
fixpoint bool readable_slice(fixpoint(void *, oinfo) H, prog_ids ids, void *list, int from, int to) {
  return is_smi_w((uword)nth(Instance_LIST_SIZE_INDEX, o_words(H(list)))) &&
         to <= smi_val((uword)nth(Instance_LIST_SIZE_INDEX, o_words(H(list)))) &&
         !is_smi_w((uword)list_backing(H, list)) &&
         smi_ptr(header_cid(o_hw(H(list_backing(H, list))))) == smi_ptr(array_cid(ids)) &&
         0 <= from && from <= to && to <= o_len(H(list_backing(H, list))) && to - from <= PROCESS_ARRAY_LIMIT;
}
fixpoint void *slice_field(fixpoint(void *, oinfo) H, void *slice, int index) {
  return nth(index, o_words(H(slice)));
}
fixpoint bool tagged_bounds(fixpoint(void *, oinfo) H, void *slice) {
  return is_smi_w((uword)slice_field(H, slice, Instance_LIST_SLICE_FROM_INDEX)) &&
         is_smi_w((uword)slice_field(H, slice, Instance_LIST_SLICE_TO_INDEX));
}
fixpoint bool readable_backing(fixpoint(void *, oinfo) H, prog_ids ids, void *b, int lo, int hi) {
  return has_tag(H, b, ARRAY_TAG) ?
    0 <= lo && lo <= hi && hi <= o_len(H(b)) && hi - lo <= PROCESS_ARRAY_LIMIT :
    has_tag(H, b, INSTANCE_TAG) && header_cid(o_hw(H(b))) == list_cid(ids) && readable_slice(H, ids, b, lo, hi);
}
fixpoint list<void *> backing_slots(fixpoint(void *, oinfo) H, void *backing) {
  return o_words(H(has_tag(H, backing, ARRAY_TAG) ? backing : list_backing(H, backing)));
}
fixpoint int backing_diagnostic(fixpoint(void *, oinfo) H, prog_ids ids, void *b, int previous) {
  return has_tag(H, b, INSTANCE_TAG) && header_cid(o_hw(H(b))) != list_cid(ids) ? header_cid(o_hw(H(b))) : previous;
}
predicate trace(MessageEncoder *self, list<void *> slots, int from, int to,
                int fail, int phase, int next);
@*/

void MessageEncoder_write_uint8(MessageEncoder *self, uint8 tag);
//@ requires trace(self, ?ws, ?lo, ?hi, ?fail, 0, lo) &*& tag == TAG_ARRAY;
//@ ensures trace(self, ws, lo, hi, fail, 1, lo);

void MessageEncoder_write_cardinal(MessageEncoder *self, uword length);
//@ requires trace(self, ?ws, ?lo, ?hi, ?fail, 1, lo) &*& length == hi - lo;
//@ ensures trace(self, ws, lo, hi, fail, 2, lo);

bool MessageEncoder_encode_any(MessageEncoder *self, Object *child);
//@ requires trace(self, ?ws, ?lo, ?hi, ?fail, 2, ?i) &*& lo <= i &*& i < hi &*& child == nth(i, ws);
//@ ensures trace(self, ws, lo, hi, fail, 2, i + 1) &*& result == (i != fail);

@render src/messaging.cc toit::MessageEncoder::encode_array
bool MessageEncoder::encode_array(Array* object, word from, word to)
/*@ requires [?f]heap(?objs, ?H) &*& mem(object, objs) == true &*& has_tag(H, object, ARRAY_TAG) == true &*&
             trace(self, ?ws, from, to, ?fail, 0, from) &*& ws == o_words(H(object)) &*&
             smi_range(from) == true &*& smi_range(to) == true; @*/
/*@ ensures [f]heap(objs, H) &*& trace(self, ws, from, to, fail, ?phase, ?next) &*&
            (phase == 0 ? !result && next == from &&
                (from < 0 || from > to || to > o_len(H(object)) || to - from > PROCESS_ARRAY_LIMIT) :
             phase == 2 && to - from <= PROCESS_ARRAY_LIMIT && 0 <= from && from <= to && to <= o_len(H(object)) &&
                (result ? next == to && (fail < from || to <= fail) :
                          from <= fail && fail < to && next == fail + 1)); @*/
{
  if (from < 0 || from > to || to > object->length()) return false;
  // The receiver can't decode an array longer than a process heap holds (a
  // crafted program can have one in its program heap).
  if (to - from > Array::max_length_in_process()) return false;
  write_uint8(TAG_ARRAY);
  write_cardinal(to - from);
  for (word i = from; i < to; i++)
  //@ invariant trace(self, ws, from, to, fail, 2, i) &*& [f]heap(objs, H) &*& from <= i &*& i <= to &*& to <= o_len(H(object)) &*& (i <= fail || fail < from);
  {
    if (!encode_any(object->at(i))) return false;
  }
  return true;
}

@render src/messaging.h toit::MessageEncoder::encoding_tison tu=src/messaging.cc
  bool encoding_tison() const
  //@ requires [_]self->format_ |-> ?fmt;
  //@ ensures result == (fmt == MESSAGE_FORMAT_TISON);
  { return format_ == MESSAGE_FORMAT_TISON; }

@render src/messaging.cc toit::MessageEncoder::encode_list
bool MessageEncoder::encode_list(Instance* instance, word from, word to)
/*@ requires [?f]heap(?objs, ?H) &*& mem(instance, objs) == true &*& has_tag(H, instance, INSTANCE_TAG) == true &*&
             [_]self->program_ |-> ?prog &*& [_]program(prog, ?ids) &*& prog_ok(ids) == true &*& [_]self->format_ |-> ?fmt &*&
             header_cid(o_hw(H(instance))) == list_cid(ids) &*& smi_range(from) == true &*& smi_range(to) == true &*&
             trace(self, ?ws, from, to, ?fail, 0, from) &*& ws == o_words(H(list_backing(H, instance))); @*/
/*@ ensures [f]heap(objs, H) &*& trace(self, ws, from, to, fail, ?phase, ?next) &*&
            (readable_slice(H, ids, instance, from, to) ?
              phase == 2 && result == (fail < from || to <= fail) && next == (result ? to : fail + 1) :
              !result && phase == 0 && next == from); @*/
{
  //@ heap_facts(instance);
  Object* size = instance->at(Instance::LIST_SIZE_INDEX);
  if (!is_smi(size) || to > Smi::value(size)) return false;
  Object* backing = instance->at(Instance::LIST_ARRAY_INDEX);
  if (is_smi(backing)) return false;
  //@ good_mem(objs, backing);
  Smi* class_id = HeapObject::cast(backing)->class_id();
  //@ heap_facts(backing);
  if (class_id == program_->array_class_id()) {
    Array* array = Array::cast(backing);
    return encode_array(array, from, to);
  } else if (class_id == program_->large_array_class_id()) {
    if (!encoding_tison()) {
      printf("[message encoder: cannot encode large array]\n");
    }
  }
  return false;
}

@render src/messaging.cc toit::MessageEncoder::encode_list_slice
bool MessageEncoder::encode_list_slice(Instance* instance)
/*@ requires [?f]heap(?objs, ?H) &*& mem(instance, objs) == true &*& has_tag(H, instance, INSTANCE_TAG) == true &*&
             [_]self->program_ |-> ?prog &*& [_]program(prog, ?ids) &*& header_cid(o_hw(H(instance))) == list_slice_cid(ids) &*& prog_ok(ids) == true &*& [_]self->format_ |-> ?fmt &*&
             self->problematic_class_id_ |-> ?previous &*& trace(self, ?ws, ?lo, ?hi, ?fail, 0, lo) &*&
             ws == backing_slots(H, slice_field(H, instance, Instance_LIST_SLICE_LIST_INDEX)) &*&
             lo == smi_val((uword)slice_field(H, instance, Instance_LIST_SLICE_FROM_INDEX)) &*&
             hi == smi_val((uword)slice_field(H, instance, Instance_LIST_SLICE_TO_INDEX)); @*/
/*@ ensures [f]heap(objs, H) &*& trace(self, ws, lo, hi, fail, ?phase, ?next) &*&
            self->problematic_class_id_ |-> (tagged_bounds(H, instance) ?
              backing_diagnostic(H, ids, slice_field(H, instance, Instance_LIST_SLICE_LIST_INDEX), previous) : previous) &*&
            (tagged_bounds(H, instance) && readable_backing(H, ids, slice_field(H, instance, Instance_LIST_SLICE_LIST_INDEX), lo, hi) ?
              phase == 2 && result == (fail < lo || hi <= fail) && next == (result ? hi : fail + 1) :
              !result && phase == 0 && next == lo); @*/
{
  //@ heap_facts(instance);
  Object* from_object = instance->at(Instance::LIST_SLICE_FROM_INDEX);
  Object* to_object = instance->at(Instance::LIST_SLICE_TO_INDEX);
  if (!is_smi(from_object) || !is_smi(to_object)) return false;
  word from = Smi::value(from_object);
  word to = Smi::value(to_object);
  Object* backing_object = instance->at(Instance::LIST_SLICE_LIST_INDEX);
  if (is_array(backing_object)) {
    //@ good_heap(objs, backing_object);
    Array* backing = Array::cast(backing_object);
    return encode_array(backing, from, to);
  } else if (is_instance(backing_object)) {
    //@ good_heap(objs, backing_object);
    Instance* backing = Instance::cast(backing_object);
    Smi* backing_class_id = backing->class_id();
    if (backing_class_id != program_->list_class_id()) {
      problematic_class_id_ = Smi::value(backing_class_id);
      return false;
    }
    return encode_list(backing, from, to);
  } else {
    return false;
  }
}
