//
// Record the actual child calls in reverse order so each new call is a cons.
// A successful traversal matches the live key/value pairs of the original
// backing slots up to the point at which the declared count is reached.
@include ../model/model.cfg
@verbatim
#include <stdio.h>
#include "../model/objects.gen.h"
//@ #include <nat.gh>
struct MessageEncoder { Program *program_; };
typedef struct MessageEncoder MessageEncoder;

/*@
fixpoint void *slot(fixpoint(void *, oinfo) H, void *obj, int i) {
  return nth(i, o_words(H(obj)));
}
fixpoint bool list_backing(fixpoint(void *, oinfo) H, prog_ids ids, void *obj) {
  return smi_ptr(header_cid(o_hw(H(obj)))) == smi_ptr(list_cid(ids));
}
fixpoint void *map_array(fixpoint(void *, oinfo) H, prog_ids ids, void *map) {
  return list_backing(H, ids, slot(H, map, Instance_MAP_BACKING_INDEX)) ?
    slot(H, slot(H, map, Instance_MAP_BACKING_INDEX), Instance_LIST_ARRAY_INDEX) : slot(H, map, Instance_MAP_BACKING_INDEX);
}
fixpoint int scan_limit(fixpoint(void *, oinfo) H, prog_ids ids, void *map) {
  return list_backing(H, ids, slot(H, map, Instance_MAP_BACKING_INDEX)) ?
    smi_val((uword)slot(H, slot(H, map, Instance_MAP_BACKING_INDEX), Instance_LIST_SIZE_INDEX)) :
    o_len(H(map_array(H, ids, map)));
}
fixpoint bool readable_map(fixpoint(void *, oinfo) H, prog_ids ids, void *map) {
  return !is_smi_w((uword)slot(H, map, Instance_MAP_BACKING_INDEX)) &&
    is_smi_w((uword)slot(H, map, Instance_MAP_SIZE_INDEX)) &&
    0 <= smi_val((uword)slot(H, map, Instance_MAP_SIZE_INDEX)) &&
    smi_val((uword)slot(H, map, Instance_MAP_SIZE_INDEX)) <= PROCESS_ARRAY_LIMIT / 2 &&
    (smi_val((uword)slot(H, map, Instance_MAP_SIZE_INDEX)) == 0 ||
     ((!list_backing(H, ids, slot(H, map, Instance_MAP_BACKING_INDEX)) ||
       is_smi_w((uword)slot(H, slot(H, map, Instance_MAP_BACKING_INDEX), Instance_LIST_SIZE_INDEX))) &&
      !is_smi_w((uword)map_array(H, ids, map)) &&
      smi_ptr(header_cid(o_hw(H(map_array(H, ids, map))))) == smi_ptr(array_cid(ids)) &&
      0 <= scan_limit(H, ids, map) && scan_limit(H, ids, map) <= o_len(H(map_array(H, ids, map)))));
}
fixpoint bool live_key(fixpoint(void *, oinfo) H, prog_ids ids, void *key) {
  return is_smi_w((uword)key) || smi_ptr(header_cid(o_hw(H(key)))) != smi_ptr(tombstone_cid(ids));
}
fixpoint list<void *> map_prefix(nat pairs, fixpoint(void *, oinfo) H, prog_ids ids, void *array) {
  switch (pairs) {
    case zero: return nil;
    case succ(p):
      return live_key(H, ids, slot(H, array, 2 * int_of_nat(p))) ?
        cons(slot(H, array, 2 * int_of_nat(p) + 1), cons(slot(H, array, 2 * int_of_nat(p)), map_prefix(p, H, ids, array))) :
        map_prefix(p, H, ids, array);
  }
}
fixpoint bool failed_pair(nat pairs, fixpoint(void *, oinfo) H, prog_ids ids, void *array, list<void *> seen) {
  return live_key(H, ids, slot(H, array, 2 * int_of_nat(pairs))) &&
         (seen == cons(slot(H, array, 2 * int_of_nat(pairs)), map_prefix(pairs, H, ids, array)) ||
          seen == map_prefix(succ(pairs), H, ids, array));
}
predicate trace(MessageEncoder *self, int phase, int size, list<void *> seen, bool failed);
@*/

void MessageEncoder_write_uint8(MessageEncoder *self, uint8 tag);
//@ requires trace(self, 0, 0, nil, false) &*& tag == TAG_MAP;
//@ ensures trace(self, 1, 0, nil, false);
void MessageEncoder_write_cardinal(MessageEncoder *self, uword size);
//@ requires trace(self, 1, 0, nil, false);
//@ ensures trace(self, 2, size, nil, false);
bool MessageEncoder_encode_any(MessageEncoder *self, Object *child);
//@ requires trace(self, 2, ?size, ?seen, false);
//@ ensures trace(self, 2, size, cons(child, seen), !result);

@render src/messaging.cc toit::MessageEncoder::encode_map
bool MessageEncoder::encode_map(Instance* instance)
/*@ requires [?f]heap(?objs, ?H) &*& mem(instance, objs) == true &*& has_tag(H, instance, INSTANCE_TAG) == true &*&
             [_]self->program_ |-> ?prog &*& [_]program(prog, ?ids) &*& prog_ok(ids) == true &*&
             header_cid(o_hw(H(instance))) == map_cid(ids) &*& trace(self, 0, 0, nil, false); @*/
/*@ ensures [f]heap(objs, H) &*& trace(self, ?phase, ?size, ?seen, ?failed) &*& length(seen) <= 2 * size &*&
    (result ? !failed && readable_map(H, ids, instance) : true) &*&
    (result ? exists<nat>(?pairs) &*& phase == 2 &*& size == smi_val((uword)slot(H, instance, Instance_MAP_SIZE_INDEX)) &*&
      0 <= size &*& size <= PROCESS_ARRAY_LIMIT / 2 &*& length(seen) == 2 * size &*&
      seen == map_prefix(pairs, H, ids, map_array(H, ids, instance)) &*&
      (size == 0 || 2 * int_of_nat(pairs) <= scan_limit(H, ids, instance)) :
     failed ? exists<nat>(?pairs) &*& phase == 2 &*& readable_map(H, ids, instance) == true &*&
       size == smi_val((uword)slot(H, instance, Instance_MAP_SIZE_INDEX)) &*&
       2 * int_of_nat(pairs) + 2 <= scan_limit(H, ids, instance) &*&
       failed_pair(pairs, H, ids, map_array(H, ids, instance), seen) == true :
     readable_map(H, ids, instance) ?
       exists<nat>(?pairs) &*& phase == 2 &*& size == smi_val((uword)slot(H, instance, Instance_MAP_SIZE_INDEX)) &*&
       length(seen) < 2 * size &*& seen == map_prefix(pairs, H, ids, map_array(H, ids, instance)) &*&
       2 * int_of_nat(pairs) <= scan_limit(H, ids, instance) &*& scan_limit(H, ids, instance) < 2 * int_of_nat(pairs) + 2 :
       seen == nil); @*/
{
  write_uint8(TAG_MAP);

  //@ heap_facts(instance);
  Object* object = instance->at(Instance::MAP_BACKING_INDEX);
  if (is_smi(object)) return false;
  //@ good_mem(objs, object);
  HeapObject* backing = HeapObject::cast(object);

  object = instance->at(Instance::MAP_SIZE_INDEX);
  if (!is_smi(object)) return false;
  word size = Smi::value(object);
  if (size < 0) return false;
  // Nor a map whose backing is longer than that.
  if (size > Array::max_length_in_process() / 2) return false;

  write_cardinal(size);
  //@ if (size == 0) close exists(zero);
  if (size == 0) return true;
  word limit = -1;
  Smi* class_id = backing->class_id();
  //@ heap_facts(backing);
  if (class_id == program_->list_class_id()) {
    Instance* list = Instance::cast(backing);
    object = list->at(Instance::LIST_SIZE_INDEX);
    if (!is_smi(object)) return false;
    limit = Smi::value(object);
    if (limit < 0) return false;
    object = list->at(Instance::LIST_ARRAY_INDEX);
    if (is_smi(object)) return false;
    //@ good_mem(objs, object);
    backing = HeapObject::cast(object);
  }
  class_id = backing->class_id();
  //@ heap_facts(backing);
  if (class_id != program_->array_class_id()) {
    if (class_id == program_->large_array_class_id()) {
      printf("[message encoder: cannot encode large map]\n");
    }
    return false;
  }
  Array* array = Array::cast(backing);
  if (limit < 0) {
    limit = array->length();
  } else if (limit > array->length()) {
    return false;
  }
  //@ nat pairs = zero;
  word count = 0;
  for (word i = 0; count < size && i + 1 < limit; i += 2)
  /*@ invariant [f]heap(objs, H) &*& [_]self->program_ |-> prog &*& [_]program(prog, ids) &*&
                trace(self, 2, size, ?seen, false) &*& seen == map_prefix(pairs, H, ids, array) &*&
                i == 2 * int_of_nat(pairs) &*& 0 <= i &*& i <= limit &*& limit <= o_len(H(array)) &*&
                length(seen) == 2 * count &*& 0 <= count &*& count <= size; @*/
  {
    Object* key = array->at(i);
    Object* value = array->at(i + 1);
    //@ if (!is_smi_w((uword)key)) good_mem(objs, key);
    if (is_smi(key) || HeapObject::cast(key)->class_id() != program_->tombstone_class_id()) {
      //@ close exists(pairs);
      if (!encode_any(key)) return false;
      if (!encode_any(value)) return false;
      //@ open exists(_);
      count++;
    }
    //@ pairs = succ(pairs);
  }
  //@ close exists(pairs);
  return count == size;
}
