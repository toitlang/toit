// Stand-in for <functional> in the verification harnesses (verified/cxx).
// ESBMC's C++ operational model deletes std::function's copy constructor,
// which src/utils.h (AsyncThread, Defer) needs to parse. No harnessed
// function calls a std::function; a call would reach the undefined
// operator() and ESBMC would report it (no body: nondeterministic result).
#pragma once

#include <utility>

namespace std {

template <typename T> class function;

template <typename R, typename... Args>
class function<R(Args...)> {
 public:
  function() {}
  function(const function&) {}
  template <typename F> function(F) {}
  function& operator=(const function&) { return *this; }
  R operator()(Args... args) const;
};

}  // namespace std
