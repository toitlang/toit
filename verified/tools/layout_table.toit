/**
Checks verified/LAYOUT.toml, the layout facts of the VM's objects that the
  Verus heap model and the VeriFast object model share:
* every `verus` name is a constant of verified/core/src/layout.rs with the
  table's value on both widths (a `#[cfg(target_pointer_width = ...)]`
  constant per width);
* the static assertions that tie every `cxx` expression and every
  `verifast` macro (verified/cxx/annotated/model/constants.h) to the
  table's value are what the table gives
  (verified/cxx/annotated/model/layout.gen.constants.cc; constants-check.sh
  compiles them for x86_64 and i686). Without --check the file is
  (re)written.

Usage: toit run verified/tools/layout_table.toit -- [--check] [--root DIR]
Exit status 1 on a difference.
*/

import cli
import fs
import host.file
import system
import .toml

main args:
  command := cli.Command "layout_table"
      --help="Checks verified/LAYOUT.toml against layout.rs and generates its C++ checks."
      --options=[
        cli.Flag "check" --help="Fail if the generated C++ checks are not up to date.",
        cli.Option "root" --default=(fs.dirname (fs.dirname system.program-path))
            --help="The verified/ directory.",
      ]
      --run=:: run it["root"] (it["check"] == true)
  command.run args

/** The constants of layout.rs: name -> {64: value, 32: value}. */
verus-constants path/string -> Map:
  result := {:}
  width := null
  ((file.read-contents path).to-string.split "\n").do: | raw/string |
    line := raw.trim
    if line.starts-with "#[cfg(target_pointer_width = \"64\")]":
      width = 64
    else if line.starts-with "#[cfg(target_pointer_width = \"32\")]":
      width = 32
    else if line.starts-with "pub const ":
      colon := line.index-of ":"
      eq := line.index-of "="
      semi := line.index-of ";"
      if colon > 0 and eq > colon and semi > eq:
        name := line[10..colon].trim
        value := parse-int line[eq + 1..semi].trim
        entry := result.get name --init=: {:}
        if value != null:
          if width: entry[width] = value
          else:
            entry[64] = value
            entry[32] = value
      width = null
    else if not line.starts-with "///" and not line.starts-with "//" and line != "":
      width = null
  return result

parse-int text/string -> int?:
  t := text.replace --all "_" ""
  negative := t.starts-with "-"
  if negative: t = t[1..]
  value := null
  if t.starts-with "0x": value = int.parse t[2..] --radix=16 --if-error=: null
  else: value = int.parse t --if-error=: null
  if value == null: return null
  return negative ? -value : value

run root/string check/bool:
  table := parse-toml (file.read-contents "$root/LAYOUT.toml").to-string
  facts := table["fact"]
  verus := verus-constants "$root/core/src/layout.rs"
  failures := 0
  facts.do: | f/Map |
    name := f.get "verus"
    if name:
      have := verus.get name
      if not have:
        print "FAIL  $f["kind"] / $f["name"]: no constant $name in core/src/layout.rs"
        failures++
      else if (have.get 64) != f["value64"] or (have.get 32) != f["value32"]:
        print "FAIL  $f["kind"] / $f["name"]: layout.rs $name is $(have.get 64) / $(have.get 32), the table says $f["value64"] / $f["value32"]"
        failures++
  // The C++ checks.
  out := [
    "// GENERATED by verified/tools/layout_table.toit from verified/LAYOUT.toml: do not edit.",
    "// Each layout fact, evaluated by the C++ compiler: the C++ expression and",
    "// the VeriFast model's macro (constants.h) against the table's value.",
    "#include <stdint.h>",
    "#include <top.h>",
    "#include <objects.h>",
    "#include <tags.h>",
    "namespace toit {",
    "static const bool vf_64 = sizeof(word) == 8;",
  ]
  value-of := :: | f/Map | "(vf_64 ? $(f["value64"]) : $(f["value32"]))"
  label-of := :: | f/Map | "$f["kind"]: $f["name"]"
  // The C++ expressions first: the macros of constants.h would replace the
  // C++ names they share.
  facts.do: | f/Map |
    out.add "static_assert(($(f["cxx"])) == $(value-of.call f), \"C++ $(label-of.call f)\");"
  out.add "}  // namespace toit"
  out.add "#include \"constants.h\""
  out.add "namespace toit {"
  facts.do: | f/Map |
    vf := f.get "verifast"
    if vf: out.add "static_assert(($vf) == $(value-of.call f), \"VeriFast $(label-of.call f)\");"
  out.add "}  // namespace toit"
  text := (out.join "\n") + "\n"
  path := "$root/cxx/annotated/model/layout.gen.constants.cc"
  if check:
    old := file.is-file path ? (file.read-contents path).to-string : ""
    if old != text:
      print "FAIL  $path is not what LAYOUT.toml generates (run layout_table.toit without --check)"
      failures++
  else:
    file.write-contents text --path=path
  if failures == 0:
    print "ok    layout table: $facts.size facts; $((facts.filter: it.contains "verus").size) against layout.rs, $((facts.filter: it.contains "verifast").size) against the VeriFast model, all against the C++ (constants-check.sh)"
  exit (failures == 0 ? 0 : 1)
