/**
Mutation campaign of the structural verifier (Phase 3 exit criterion).

Runs toit_spec_mutate on the format-2 dumps of the spec test programs and
  of the suite tests that pass on the reference interpreter in format 2
  (verified/spec/tests/suite-status.txt), in parallel, and adds up the
  results. The dumps come from verify_suite.toit (run it first).

Usage: toit run verified/tools/mutation_campaign.toit -- [--count N]
  [--jobs N] [--max-steps M] [--seed S] [--programs P] [--out FILE]
*/

import cli
import fs

import .harness

MUTATE ::= fs.join SPEC-CRATE "target/release/toit_spec_mutate"
DUMPS ::= fs.join SPEC-CRATE "target/verify-suite"

main args:
  command := cli.Command "mutation_campaign"
      --help="Mutation campaign of the structural verifier."
      --options=[
        cli.OptionInt "count" --default=12000
            --help="The total number of mutants.",
        cli.OptionInt "jobs" --default=cpu-count
            --help="The number of programs mutated in parallel.",
        cli.OptionInt "max-steps" --default=100000
            --help="The step limit of each run of an accepted mutant.",
        cli.OptionInt "seed" --default=1
            --help="The seed of the first program (the others use the following seeds).",
        cli.OptionInt "programs" --default=60
            --help="The maximum number of programs.",
        cli.Option "out" --default=(fs.join SPEC-CRATE "tests/mutation-results.txt")
            --help="The results file.",
        cli.Option "dumps" --default=DUMPS
            --help="The directory of the dumps (verify_suite.toit --out).",
        cli.Flag "certificates"
            --help="Check the mutants with shipped certificates (v2::cert): half keep the program and mutate its certificate, half mutate the program and keep or mutate the original's certificate.",
      ]
      --run=:: | invocation/cli.Invocation |
        exit (campaign invocation)
  command.run args

/**
The dumps of the spec test programs, then those of the suite tests that
  pass in format 2, at most $limit.
*/
programs limit/int --dir/string=DUMPS -> List:
  dumps := (list-files dir --suffix=".dump").filter: it.starts-with "verified_spec_tests_toit_"
  dumps = dumps.map: fs.join dir it
  (split-lines (read-file (fs.join SPEC-CRATE "tests/suite-status.txt"))).do: | line/string |
    parts := (line.split " ").filter: it != ""
    if parts.size >= 3 and parts[0] == "2" and parts[1] == "pass":
      name := parts[2].replace --all "/" "_"
      d := fs.join dir "$(name[..name.size - 5]).dump"
      if exists d: dumps.add d
  return dumps[..(min limit dumps.size)]

campaign invocation/cli.Invocation -> int:
  out := absolute invocation["out"]
  seed := invocation["seed"]
  max-steps := invocation["max-steps"]
  enter-repo
  cargo-build SPEC-CRATE --bin="toit_spec_mutate"
  dumps := programs invocation["programs"] --dir=(absolute invocation["dumps"])
  extra := invocation["certificates"] ? ["--certificates"] : []
  per := max 1 (invocation["count"] / dumps.size)
  outputs := parallel-map (List dumps.size: it) --jobs=invocation["jobs"]:: | i |
    r := run [MUTATE, "--count", "$per", "--seed", "$(seed + i)", "--max-steps", "$max-steps"] + extra + [dumps[i]]
    r.stdout-string
  totals := {:}
  ends := {:}
  findings := []
  outputs.do: | output |
    section := null
    (split-lines output).do: | line/string |
      m := count-line line "  "
      m2 := count-line line "    "
      if line.starts-with "  accepted mutants by":
        section = "ends"
      else if line.starts-with "  soundness findings":
        section = "findings"
      else if section == "findings" and line.starts-with "    ":
        findings.add line.trim
      else if section == "ends" and m2:
        ends[m2[0]] = (ends.get m2[0] --if-absent=: 0) + m2[1]
      else if m and section == null:
        totals[m[0]] = (totals.get m[0] --if-absent=: 0) + m[1]
  mutants := 0
  totals.do: | k v | if k.ends-with "mutants": mutants += v
  lines := []
  mode := invocation["certificates"] ? ", shipped certificates" : ""
  lines.add "# Generated by verified/tools/mutation_campaign.toit (seed $seed, $dumps.size programs, max $max-steps steps per run$mode)."
  lines.add "mutants: $mutants"
  (totals.keys.sort).do: lines.add "  $it: $totals[it]"
  lines.add "accepted mutants by how the run ended:"
  (ends.keys.sort).do: lines.add "  $it: $ends[it]"
  lines.add "soundness findings (accepted and stuck or interpreter panic): $findings.size"
  findings.do: lines.add "  $it"
  lines.add "programs:"
  dumps.do: lines.add "  $(fs.basename it)"
  text := (lines.join "\n") + "\n"
  print text
  write-file out text
  return findings.is-empty ? 0 : 1

/**
Matches $line against `^PREFIX([^:]+): (\d+)$`: returns the key and the
  count, or null.
*/
count-line line/string prefix/string -> List?:
  if not line.starts-with prefix: return null
  colon := line.index-of ":" prefix.size
  if colon <= prefix.size: return null
  rest := line[colon..]
  if not rest.starts-with ": " or rest.size == 2: return null
  digits := rest[2..]
  if not (digits.to-byte-array.every: '0' <= it <= '9'): return null
  return [line[prefix.size..colon], int.parse digits]
