/**
Runs the structural verifier (toit_spec_verify) on every test program of
  the suite compiled in format 2 (the program discovery of run_suite.toit)
  and on the spec test programs in verified/spec/tests/toit.

Usage: toit run verified/tools/verify_suite.toit -- [--jobs N]
  [--filter SUBSTRING]... [--out DIR] [--results FILE]
*/

import cli
import fs

import .harness

VERIFY ::= fs.join SPEC-CRATE "target/release/toit_spec_verify"

main args:
  command := cli.Command "verify_suite"
      --help="""
        Runs the structural verifier on every suite program compiled in
        format 2 and on the spec test programs.
        """
      --options=[
        cli.OptionInt "jobs" --default=cpu-count
            --help="The number of programs checked in parallel.",
        cli.Option "filter" --multi
            --help="Only programs whose path contains this string.",
        cli.Option "out" --default=(fs.join SPEC-CRATE "target/verify-suite")
            --help="The output directory (snapshots and dumps).",
        cli.Option "results"
            --help="Write one line per program: status program.",
      ]
      --run=:: | invocation/cli.Invocation |
        exit (verify-suite invocation)
  command.run args

verify-suite invocation/cli.Invocation -> int:
  out := absolute invocation["out"]
  results-path := invocation["results"]
  if results-path: results-path = absolute results-path
  filters := invocation["filter"]
  enter-repo
  make-dirs out
  cargo-build SPEC-CRATE --bin="toit_spec_verify"
  dumper := fs.join out "spec_dump.snapshot"
  compile-dumper dumper --if-missing
  files := suite-and-spec-programs filters
  results := parallel-map files --jobs=invocation["jobs"]:: | src |
    verify-one src out dumper
  counts := {:}
  results.do: | r |
    status := r[1]
    if status != "accepted":
      print "$status $(repo-relative r[0])"
      lines := split-lines r[2]
      (lines[(min 1 lines.size)..(min 6 lines.size)]).do: print "    $it"
    counts[status] = (counts.get status --if-absent=: 0) + 1
  summary := (counts.keys.sort).map: "$it $counts[it]"
  print "programs: $results.size; $(summary.join ", ")"
  if results-path:
    sorted := results.sort: | a b | a[0].compare-to b[0] --if-equal=: a[1].compare-to b[1]
    lines := ["# Generated by verified/tools/verify_suite.toit: status, program.\n"]
    sorted.do: lines.add "$it[1] $(repo-relative it[0])\n"
    write-file results-path (lines.join "")
  return (counts.get "rejected" --if-absent=: 0) == 0 ? 0 : 1

/** Verifies one program: [source, status, verifier output]. */
verify-one src/string out/string dumper/string -> List:
  dump-error := compile-and-dump src out dumper
  if not dump-error[0]: return [src, dump-error[1], ""]
  r := run [VERIFY, "--quiet", "--time", dump-error[0]]
  status := r.code == 0 ? "accepted" : (r.code == 1 ? "rejected" : "load-error")
  return [src, status, r.stdout-string]
