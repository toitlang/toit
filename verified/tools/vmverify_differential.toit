/**
Differential test of the trusted conversion from VM memory
  (verified/vmverify/src/from_vm.rs).

For every program of the suite (the list of verify_suite.toit: the program
  discovery of run_suite.toit plus verified/spec/tests/toit), compiled in
  format 2:

- the VM path: `toit.run --verify --emit-canonical=F snapshot` loads the
  snapshot as the VM does, decodes the method table, fills the tables the
  core executes and builds the abstract program from that memory;
- the dump path: tools/spec_dump.toit writes the dump, the reference
  loader (toit_spec::interp::loader) reads it (toit_vmverify_canonical).

Both write the canonical form (canonical.rs); they must be identical. A
  mismatch keeps both files (and a diff) under --out.

Usage: toit run verified/tools/vmverify_differential.toit -- [--jobs N]
  [--filter S]... [--out DIR] [--results FILE]
*/

import cli
import fs
import host.file

import .harness

CANONICAL ::= fs.join VMVERIFY-CRATE "target/release/toit_vmverify_canonical"

main args:
  command := cli.Command "vmverify_differential"
      --help="""
        Compares the canonical program built from VM memory with the one
        built from the dump, for every suite and spec test program.
        """
      --options=[
        cli.OptionInt "jobs" --default=cpu-count
            --help="The number of programs compared in parallel.",
        cli.Option "filter" --multi
            --help="Only programs whose path contains this string.",
        cli.Option "out" --default=(fs.join VMVERIFY-CRATE "target/differential")
            --help="The output directory (snapshots, dumps, mismatches).",
        cli.Option "results"
            --help="Write one line per program: status program.",
      ]
      --run=:: | invocation/cli.Invocation |
        exit (differential invocation)
  command.run args

differential invocation/cli.Invocation -> int:
  out := absolute invocation["out"]
  results-path := invocation["results"]
  if results-path: results-path = absolute results-path
  filters := invocation["filter"]
  enter-repo
  make-dirs out
  cargo-build VMVERIFY-CRATE --bin="toit_vmverify_canonical"
  dumper := fs.join out "spec_dump.snapshot"
  compile-dumper dumper --if-missing
  files := suite-and-spec-programs filters
  results := parallel-map files --jobs=invocation["jobs"]:: | src |
    compare-one src out dumper
  counts := {:}
  results.do: | r |
    status := r[1]
    if status != "equal":
      print "$status $(repo-relative r[0])"
      lines := split-lines r[2]
      (lines[..(min 12 lines.size)]).do: print "    $it"
    counts[status] = (counts.get status --if-absent=: 0) + 1
  summary := (counts.keys.sort).map: "$it $counts[it]"
  print "programs: $results.size; $(summary.join ", ")"
  if results-path:
    sorted := results.sort: | a b | a[0].compare-to b[0] --if-equal=: a[1].compare-to b[1]
    lines := ["# Generated by verified/tools/vmverify_differential.toit: status, program.\n"]
    sorted.do: lines.add "$it[1] $(repo-relative it[0])\n"
    write-file results-path (lines.join "")
  bad := 0
  counts.do: | status n |
    if status != "equal" and status != "compile-error": bad += n
  return bad == 0 ? 0 : 1

/** Compares the two canonical forms of one program: [source, status, detail]. */
compare-one src/string out/string dumper/string -> List:
  dump-error := compile-and-dump src out dumper
  dump := dump-error[0]
  if not dump: return [src, dump-error[1], ""]
  snapshot := "$(dump[..dump.size - 5]).snapshot"
  from-dump := "$(dump).canonical-dump"
  from-vm := "$(dump).canonical-vm"
  r := run [CANONICAL, dump, from-dump]
  if r.code != 0: return [src, "dump-load-error", r.stderr-string]
  r = run [toit-run-bin, "--verify", "--emit-canonical=$from-vm", snapshot]
  if r.code != 0: return [src, "vm-error", r.stderr-string]
  a := read-file from-dump
  b := read-file from-vm
  if a == b:
    file.delete from-dump
    file.delete from-vm
    return [src, "equal", "$a.size bytes"]
  diff := (run ["diff", "-U1", "--label", "dump", "--label", "vm", from-dump, from-vm]).stdout-string
  write-file "$(dump).canonical-diff" diff
  end := min 2000 diff.size
  while end < diff.size and diff[end] == null: end--
  return [src, "different", diff[..end]]
