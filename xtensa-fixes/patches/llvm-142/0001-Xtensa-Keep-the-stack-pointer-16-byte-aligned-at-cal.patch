diff --git a/llvm/test/CodeGen/Xtensa/call-frame-align.ll b/llvm/test/CodeGen/Xtensa/call-frame-align.ll
new file mode 100644
index 000000000..0e5d7a404
--- /dev/null
+++ b/llvm/test/CodeGen/Xtensa/call-frame-align.ll
@@ -0,0 +1,55 @@
+; RUN: llc -mtriple=xtensa -mcpu=esp32 -O2 -verify-machineinstrs < %s \
+; RUN:   | FileCheck %s --check-prefix=WINDOWED
+; RUN: llc -mtriple=xtensa -O2 -verify-machineinstrs < %s \
+; RUN:   | FileCheck %s --check-prefix=CALL0
+
+; The stack pointer stays 16-byte aligned at calls that pass arguments on
+; the stack when the call frame is not reserved (frame pointer or
+; variable-sized object). A callee may compute the address of a field of
+; an 8- or 16-byte aligned local with `or` (espressif/llvm-project#142).
+
+declare void @fill(ptr)
+declare i32 @take7(i32, i32, i32, i32, i32, i32, i32)
+declare i32 @take9(i32, i32, i32, i32, i32, i32, i32, i32, i32)
+
+; Three stack words: SP moves by 16, not 12.
+define i32 @outer_fp(i32 %a) "frame-pointer"="all" {
+; WINDOWED-LABEL: outer_fp:
+; WINDOWED:       addi [[T:a[0-9]+]], a1, -16
+; WINDOWED-NEXT:  movsp a1, [[T]]
+; WINDOWED:       callx8
+; WINDOWED-NEXT:  addi{{(.n)?}} [[U:a[0-9]+]], a1, 16
+; WINDOWED-NEXT:  movsp a1, [[U]]
+; CALL0-LABEL:    outer_fp:
+; CALL0-NOT:      addi {{a[0-9]+}}, a1, -12
+; CALL0:          callx0
+  %r = call i32 @take9(i32 %a, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9)
+  ret i32 %r
+}
+
+; A variable-sized object forces a frame pointer even without the
+; attribute: one stack word still moves SP by 16.
+define i32 @outer_vla(i32 %a, i32 %n) {
+; WINDOWED-LABEL: outer_vla:
+; WINDOWED:       callx8
+; WINDOWED:       addi [[T:a[0-9]+]], a1, -16
+; WINDOWED-NEXT:  movsp a1, [[T]]
+; WINDOWED:       callx8
+; WINDOWED-NEXT:  addi{{(.n)?}} [[U:a[0-9]+]], a1, 16
+; WINDOWED-NEXT:  movsp a1, [[U]]
+  %v = alloca i8, i32 %n, align 4
+  call void @fill(ptr %v)
+  %r = call i32 @take7(i32 %a, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7)
+  ret i32 %r
+}
+
+; The size of a variable-sized object is rounded to keep SP aligned.
+define ptr @vla_size(i32 %n) {
+; WINDOWED-LABEL: vla_size:
+; WINDOWED:       addi{{(.n)?}} [[S:a[0-9]+]], a2, 15
+; WINDOWED-NEXT:  movi{{(.n)?}} [[M:a[0-9]+]], -16
+; WINDOWED-NEXT:  and {{a[0-9]+}}, [[S]], [[M]]
+  %v = alloca i8, i32 %n, align 1
+  call void @fill(ptr %v)
+  ret ptr %v
+}
