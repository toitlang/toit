diff --git a/llvm/lib/Target/Xtensa/XtensaFrameLowering.cpp b/llvm/lib/Target/Xtensa/XtensaFrameLowering.cpp
index 4533be5d3..c47a33b29 100644
--- a/llvm/lib/Target/Xtensa/XtensaFrameLowering.cpp
+++ b/llvm/lib/Target/Xtensa/XtensaFrameLowering.cpp
@@ -31,9 +31,13 @@ using namespace llvm;
 #define UNITS_PER_WORD 4
 #define MIN_FRAME_SIZE (8 * UNITS_PER_WORD)
 
+// The Xtensa ABIs keep the stack pointer 16-byte aligned (GCC:
+// STACK_BOUNDARY 128). The prologue rounds every frame to 16 bytes, and
+// code may rely on the alignment of stack objects of up to 16 bytes (an
+// address computed with `or`), so a call frame must keep it too.
 XtensaFrameLowering::XtensaFrameLowering(const XtensaSubtarget &STI)
-    : TargetFrameLowering(TargetFrameLowering::StackGrowsDown, Align(4), 0,
-                          Align(4)),
+    : TargetFrameLowering(TargetFrameLowering::StackGrowsDown, Align(16), 0,
+                          Align(16)),
       STI(STI), TII(*STI.getInstrInfo()), TRI(STI.getRegisterInfo()) {}
 
 bool XtensaFrameLowering::hasFPImpl(const MachineFunction &MF) const {
diff --git a/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp b/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
index 1f136d85e..c75334849 100644
--- a/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
+++ b/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
@@ -1232,8 +1232,11 @@ XtensaTargetLowering::LowerCall(CallLoweringInfo &CLI,
                       DL, NodeTys, Ops);
   Glue = Chain.getValue(1);
 
-  // Mark the end of the call, which is glued to the call itself.
-  Chain = DAG.getCALLSEQ_END(Chain, DAG.getConstant(NumBytes, DL, PtrVT, true),
+  // Mark the end of the call, which is glued to the call itself. It
+  // releases what CALLSEQ_START reserved: the stack arguments rounded to the
+  // stack alignment.
+  Chain = DAG.getCALLSEQ_END(Chain,
+                             DAG.getConstant(NextStackOffset, DL, PtrVT, true),
                              DAG.getConstant(0, DL, PtrVT, true), Glue, DL);
   Glue = Chain.getValue(1);
 
