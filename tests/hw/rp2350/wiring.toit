/** Physical wiring of the WeAct RP2350B and classic ESP32 test rig. */

ESP32-UART-RX-PIN ::= 34  // RP GP16 -> ESP32.
ESP32-UART-TX-PIN ::= 4   // ESP32 -> RP GP1.
RP2350-UART-TX-PIN ::= 16
RP2350-UART-RX-PIN ::= 1

// Disjoint I2C, SPI and GPIO lanes for concurrent target tests.
RP2350-I2C-TARGET-SDA-PIN ::= 10
RP2350-I2C-TARGET-SCL-PIN ::= 11
ESP32-I2C-CONTROLLER-SDA-PIN ::= 32
ESP32-I2C-CONTROLLER-SCL-PIN ::= 33
RP2350-SPI-TARGET-MOSI-PIN ::= 4
RP2350-SPI-TARGET-MISO-PIN ::= 7
RP2350-SPI-TARGET-CLOCK-PIN ::= 6
RP2350-SPI-TARGET-CS-PIN ::= 5
ESP32-SPI-CONTROLLER-MOSI-PIN ::= 19
ESP32-SPI-CONTROLLER-MISO-PIN ::= 23
ESP32-SPI-CONTROLLER-CLOCK-PIN ::= 18
ESP32-SPI-CONTROLLER-CS-PIN ::= 27
RP2350-SPI1-TARGET-MOSI-PIN ::= 8
RP2350-SPI1-TARGET-MISO-PIN ::= 11
RP2350-SPI1-TARGET-CLOCK-PIN ::= 10
RP2350-SPI1-TARGET-CS-PIN ::= 9
ESP32-SPI1-CONTROLLER-MOSI-PIN ::= 13
ESP32-SPI1-CONTROLLER-MISO-PIN ::= 33
ESP32-SPI1-CONTROLLER-CLOCK-PIN ::= 32
ESP32-SPI1-CONTROLLER-CS-PIN ::= 14
RP2350-EVENT-PIN ::= 32
ESP32-EVENT-PIN ::= 22

// Each entry is [RP2350 GPIO, ESP32 GPIO].
DIGITAL-WIRES ::= [
  [4, 19],
  [5, 27],
  [6, 18],
  [7, 23],
  [8, 13],
  [9, 14],
  [10, 32],
  [11, 33],
  [32, 22],
]

RP2350-WEAK-PIN ::= 33
ESP32-WEAK-STIMULUS-PIN ::= 17
ESP32-WEAK-OBSERVE-PIN ::= 35

RP2350-ADC-PINS ::= [40, 41]
ESP32-DAC-PINS ::= [25, 26]

ESP32-RUN-PIN ::= 21
ESP32-BOOT-PIN ::= 16
