--- a/src/gpspi/spi_slave.c
+++ b/src/gpspi/spi_slave.c
@@ -36,0 +37,28 @@
+volatile uint32_t ec618_spi_length_before, ec618_spi_length_after;
+volatile uint32_t ec618_spi_dma_bytes, ec618_spi_dma_owned, ec618_spi_dma_errors;
+
+// Private continuous-capture diagnostic. A CPU-owned descriptor is copied
+// before it is returned to DMA; owner checking prevents silent overwrite.
+volatile bool ec618_spi_ring_enabled;
+static volatile spi_dma_desc_t *ec618_spi_ring;
+static unsigned ec618_spi_ring_count, ec618_spi_ring_index;
+int ec618_spi_ring_take(uint8_t *destination, unsigned capacity) {
+    if (!ec618_spi_ring || !ec618_spi_ring_count) return -1;
+    volatile spi_dma_desc_t *d = &ec618_spi_ring[ec618_spi_ring_index];
+    if (d->dw0.owner != DMA_DESCRIPTOR_BUFFER_OWNER_CPU) return 0;
+    unsigned owned = 0;
+    for (unsigned i = 0; i < ec618_spi_ring_count; i++)
+        owned += ec618_spi_ring[i].dw0.owner == DMA_DESCRIPTOR_BUFFER_OWNER_DMA;
+    if (owned < 3) return -2;
+    __asm__ __volatile__("memw" ::: "memory");
+    unsigned length = d->dw0.length;
+    if (d->dw0.err_eof || length != d->dw0.size || length > capacity) return -1;
+    memcpy(destination, (const void *)d->buffer, length);
+    d->dw0.length = 0;
+    d->dw0.suc_eof = 0;
+    __asm__ __volatile__("memw" ::: "memory");
+    d->dw0.owner = DMA_DESCRIPTOR_BUFFER_OWNER_DMA;
+    ec618_spi_ring_index = (ec618_spi_ring_index + 1) % ec618_spi_ring_count;
+    return length;
+}
+
@@ -676,0 +705,15 @@
+        ec618_spi_ring = NULL;
+        if (ec618_spi_ring_enabled) {
+            unsigned count = 0;
+            while (dma_ctx->dmadesc_rx[count].next) count++;
+            count++;
+            configASSERT(count >= 3 && count <= dma_ctx->dma_desc_num);
+            for (unsigned i = 0; i < count; i++) dma_ctx->dmadesc_rx[i].dw0.suc_eof = 0;
+            dma_ctx->dmadesc_rx[count - 1].next = dma_ctx->dmadesc_rx;
+            ec618_spi_ring_count = count;
+            ec618_spi_ring_index = 0;
+            ec618_spi_ring = dma_ctx->dmadesc_rx;
+            gdma_strategy_config_t strategy = {.owner_check = true};
+            ESP_ERROR_CHECK(gdma_apply_strategy(dma_ctx->rx_dma_chan, &strategy));
+        }
+
@@ -810,0 +854,3 @@
+#ifdef CONFIG_IDF_TARGET_ESP32S3
+            ec618_spi_length_before = hal->hw->slave1.data_bitlen;
+#endif
@@ -815,0 +862,15 @@
+#ifdef CONFIG_IDF_TARGET_ESP32S3
+            ec618_spi_length_after = hal->hw->slave1.data_bitlen;
+            ec618_spi_dma_bytes = ec618_spi_dma_owned = ec618_spi_dma_errors = 0;
+            if (use_dma && hal->rx_buffer) {
+                for (int i = 0; i < host->dma_ctx->dma_desc_num; i++) {
+                    volatile spi_dma_desc_t *d = &host->dma_ctx->dmadesc_rx[i];
+                    if (d->dw0.owner == DMA_DESCRIPTOR_BUFFER_OWNER_CPU)
+                        ec618_spi_dma_bytes += d->dw0.length;
+                    else ec618_spi_dma_owned++;
+                    ec618_spi_dma_errors |= d->dw0.err_eof;
+                    if (!d->next) break;
+                }
+            }
+
+#endif
