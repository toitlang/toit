# Use the configured SDK headers and definitions without requiring Python or
# substituting host stubs for the modem's notification layout.
cmake_minimum_required(VERSION 3.20)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT DEFINED COMPILE_COMMANDS)
  set(COMPILE_COMMANDS "${ROOT}/build/ec618/compile_commands.json")
endif()
if(NOT DEFINED CXX)
  find_program(CXX NAMES c++ g++ clang++ REQUIRED)
endif()
file(READ "${COMPILE_COMMANDS}" database)
string(JSON count LENGTH "${database}")
set(found FALSE)
if(count GREATER 0)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON source GET "${database}" ${index} file)
    if(NOT source MATCHES "/resources/cellular_ec618\\.cc$")
      continue()
    endif()
    set(found TRUE)
    string(JSON working_directory GET "${database}" ${index} directory)
    string(JSON argument_count ERROR_VARIABLE error LENGTH "${database}" ${index} arguments)
    if(NOT error)
      set(arguments)
      math(EXPR argument_last "${argument_count} - 1")
      foreach(arg_index RANGE ${argument_last})
        string(JSON argument GET "${database}" ${index} arguments ${arg_index})
        list(APPEND arguments "${argument}")
      endforeach()
    else()
      string(JSON command GET "${database}" ${index} command)
      separate_arguments(arguments UNIX_COMMAND "${command}")
    endif()
    break()
  endforeach()
endif()
if(NOT found)
  message(FATAL_ERROR "No cellular_ec618.cc entry in ${COMPILE_COMMANDS}")
endif()
set(flags)
set(include_next FALSE)
foreach(argument IN LISTS arguments)
  if(include_next)
    list(APPEND flags -isystem "${argument}")
    set(include_next FALSE)
  elseif(argument STREQUAL "-isystem")
    set(include_next TRUE)
  elseif(argument MATCHES "^-D" AND NOT argument MATCHES "^-D(MBEDTLS|configUSE_NEWLIB)")
    string(REPLACE "\\\"" "\"" argument "${argument}")
    list(APPEND flags "${argument}")
  endif()
endforeach()
if(include_next)
  message(FATAL_ERROR "Missing -isystem path in compile database")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
get_filename_component(build_directory "${COMPILE_COMMANDS}" DIRECTORY)
set(binary "${build_directory}/cellular-state-test-${suffix}")
execute_process(
  COMMAND "${CXX}" -std=c++11 -Wall -Wextra -Werror ${flags}
    "${CMAKE_CURRENT_LIST_DIR}/cellular-state-test.cc" -o "${binary}"
  WORKING_DIRECTORY "${working_directory}"
  RESULT_VARIABLE result)
if(result EQUAL 0)
  execute_process(COMMAND "${binary}" RESULT_VARIABLE result)
endif()
file(REMOVE "${binary}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cellular state regression failed: ${result}")
endif()
