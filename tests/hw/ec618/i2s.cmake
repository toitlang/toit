option(EC618_TEST_I2S_RX "Enable paired I2S receive matrix with the resident S3 source; disconnect DS18B20 DQ" "$ENV{EC618_TEST_I2S_RX}")
option(EC618_TEST_I2S_TX "Enable paired I2S transmit matrix with the resident S3 sink; disconnect DS18B20 DQ" "$ENV{EC618_TEST_I2S_TX}")
option(EC618_TEST_I2S_DUPLEX "Enable paired I2S duplex tests with the resident S3 duplex peer; disconnect DS18B20 DQ" "$ENV{EC618_TEST_I2S_DUPLEX}")
set(EC618_I2S_PEER_PORT "$ENV{EC618_I2S_PEER_PORT}" CACHE FILEPATH "Persistent console path of the resident S3 I2S fixture")

if(EC618_TEST_I2S_RX OR EC618_TEST_I2S_TX OR EC618_TEST_I2S_DUPLEX)
  if(NOT EC618_BOARD_PORT OR NOT EC618_I2S_PEER_PORT OR NOT EC618_EXPECT_BASE)
    message(FATAL_ERROR "Paired I2S tests require EC618_BOARD_PORT, EC618_I2S_PEER_PORT and EC618_EXPECT_BASE")
  endif()
  if(EC618_TEST_BUSES)
    message(FATAL_ERROR "The I2S source and FPC bus target require different resident S3 fixtures")
  endif()
  if((EC618_TEST_I2S_RX AND EC618_TEST_I2S_TX) OR
     (EC618_TEST_I2S_DUPLEX AND (EC618_TEST_I2S_RX OR EC618_TEST_I2S_TX)))
    message(FATAL_ERROR "I2S receive, transmit and duplex tests require different resident S3 fixtures")
  endif()
  find_program(EC618_FLOCK flock REQUIRED)
  get_filename_component(i2s_root "${CMAKE_CURRENT_SOURCE_DIR}/../../.." ABSOLUTE)
  set(i2s_lock "${EC618_RIG_LOCK}")
  if(NOT i2s_lock)
    set(i2s_lock "/tmp/toit-ec618-rig.lock")
  endif()
  function(ec618_i2s_test direction rate bits format role slots)
    set(name "i2s-${direction}-${role}-${rate}-${bits}-${format}-${slots}")
    add_test(NAME "${name}"
        COMMAND "${EC618_FLOCK}" -n "${i2s_lock}"
            "${TOIT_EXE_HW}" run "${i2s_root}/tests/hw/esp-tester/run-ec618-i2s.toit" --
            --port "${EC618_BOARD_PORT}" --peer-port "${EC618_I2S_PEER_PORT}"
            --toit-exe "${TOIT_EXE_HW}" --expected-base "${EC618_EXPECT_BASE}"
            --case "${rate},${bits},${format},${role},${slots}" --direction "${direction}" --sensor-disconnected
        CONFIGURATIONS ec618)
    set_tests_properties("${name}" PROPERTIES
        WORKING_DIRECTORY "${i2s_root}" TIMEOUT 150 RESOURCE_LOCK ec618-rig
        LABELS "ec618;hardware;i2s-${direction}")
    if(TEST rig-preflight-ec618)
      set_tests_properties("${name}" PROPERTIES FIXTURES_REQUIRED ec618-ready)
    endif()
  endfunction()
  if(EC618_TEST_I2S_RX)
  foreach(role master slave)
    foreach(bits 8 16 24 32)
      foreach(format 0 1 2)
        foreach(slots 0 4 5)
          ec618_i2s_test(rx 16000 ${bits} ${format} ${role} ${slots})
        endforeach()
      endforeach()
    endforeach()
    foreach(rate 8000 44100 48000)
      foreach(bits 16 24 32)
        ec618_i2s_test(rx ${rate} ${bits} 0 ${role} 0)
      endforeach()
    endforeach()
  endforeach()
  endif()
  if(EC618_TEST_I2S_TX)
    foreach(role master slave)
      foreach(bits 8 16 24 32)
        foreach(format 0 1 2)
          ec618_i2s_test(tx 16000 ${bits} ${format} ${role} 0)
        endforeach()
      endforeach()
    endforeach()
  endif()
  if(EC618_TEST_I2S_DUPLEX)
    foreach(role master slave)
      foreach(rate 16000 48000)
        foreach(bits 16 32)
          ec618_i2s_test(duplex ${rate} ${bits} 0 ${role} 0)
        endforeach()
      endforeach()
    endforeach()
  endif()
endif()
