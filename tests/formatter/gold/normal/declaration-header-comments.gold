typed -> /* Describes the return type. */ any:
  return null

empty:  // Intentionally empty.

next: print 1

class Child
    extends /* Describes the base type. */ Base:
  run: print 1

class Other /* Describes the inheritance. */
    extends Base:
  run: print 2
